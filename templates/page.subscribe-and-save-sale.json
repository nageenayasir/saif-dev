            "stars": "<i class=\"fa fa-star active\"></i>\n                                                <i class=\"fa fa-star active\"></i>\n                                                <i class=\"fa fa-star active\"></i>\n                                                <i class=\"fa fa-star active\"></i>\n                                                <i class=\"fa fa-star active\"></i>",
            "date_text": "",
            "title": "Awesome Ashwagandha!",
            "sub_title": "<p>I love this stuff. I take it every day and notice a big difference in energy and mood.</p><p><strong>- Sage</strong></p>",
            "bottom_text": "Results may vary by individual."
          }
        },
        "97c395c5-d330-4635-9f7e-06718cfe4535": {
