    "373865f1-6234-4c58-a7af-54a7fbab0241": {
      "type": "subscribe-save-faqs",
      "blocks": {
        "template--16783372976351__373865f1-6234-4c58-a7af-54a7fbab0241-faq-1": {
          "type": "faq",
          "settings": {
            "title": "What is a subscription? ",
            "content": "A subscription will ensure that you always have your products arriving at your door at a set frequency.  We know a healthy lifestyle requires some consistency, which is why we created our subscription program. \n \nSubscriptions are easy to manage, and you are never locked in. You are always notified a few days before your order will go through so you can skip, cancel or swap out products anytime!"
          }
        },
        "template--16783372976351__373865f1-6234-4c58-a7af-54a7fbab0241-faq-2": {
          "type": "faq",
          "settings": {
            "title": "How does the subscription option work?",
            "content": "When you subscribe, you choose how often you’d like your products delivered every 30, 45, or 60 days, and enjoy automatic savings that increase with each successful delivery.\n\nHere’s how it works:\n\n1st order: Get 10% off (apply your welcome coupon for an extra 5% off).\n\n2nd order: Enjoy 15% off automatically — no coupon needed.\n\n3rd order: Your discount increases to 20% off.\n\n4th order: Unlock our maximum discount of 25% off.\n\n5th order: Receive a surprise gift and free shipping for life as a thank-you for staying subscribed.\n\nYou’re always in control; you can skip, pause, or manage your deliveries anytime from your account.\n\nPlease note that canceling your subscription resets your discount progress and removes access to exclusive perks."
          }
        },
        "template--16783372976351__373865f1-6234-4c58-a7af-54a7fbab0241-faq-3": {
          "type": "faq",
          "settings": {
            "title": "How do I cancel my subscription?",
            "content": "Sorry to see you go. We’ll miss you. \n \nYou can cancel your subscription at any time by logging in to your account and managing it. Simply scroll down to the bottom of your subscription page, where you’ll see the options to “Pause Subscription” or “Cancel Subscription.”\n\nIf you need help, you can also contact us at info@tribe-organics.com, and our team will be happy to assist."
          }
        },
        "0c97a6a0-98e7-4119-97e9-3a5562138f9b": {
          "type": "faq",
          "settings": {
            "title": "How do discounts work on subscription orders?",
            "content": "Sorry, coupons cannot be combined with subscription purchases at this time."
          }
        },
        "23a3c54d-2bb9-40a7-be0a-57c69ea0dafe": {
          "type": "faq",
          "settings": {
            "title": "Can I reschedule my next shipment?",
            "content": "Yes! You can reschedule your next shipment at any time by logging into your account and selecting the “Re-Schedule” option to choose a new processing date. Any future shipments will automatically adjust based on your updated schedule.\n\nIf you need help, feel free to email us at info@tribe-organics.com, and we’ll be happy to assist."
          }
        },
        "e07dd1b5-07e2-4828-9e6f-ea15d864c8da": {
          "type": "faq",
          "settings": {
            "title": "How do I change my shipping address on my subscription?",
            "content": "You can update your shipping address by logging into your account, going to your profile, and editing your default address.\n\nPlease note that changing your address will not update an order that has already been processed. Once an order is in processing, the shipping address cannot be modified.\n\nIf you need help or want us to confirm the update, feel free to email us at info@tribe-organics.com, and our team will be happy to assist."
          }
        },
        "a807c57f-9c51-405a-9df6-2dcc3328a222": {
          "type": "faq",
          "settings": {
            "title": "Can I have multiple subscriptions?",
            "content": "Yes! When subscribed to multiple items each will show up as a uniquely manageable item within your subscription dashboard."
          }
        }
      },
