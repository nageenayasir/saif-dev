    "358f92ec-e991-4543-acb6-3996b346bdfd": {
      "type": "custom-testimonial-slider",
      "blocks": {
        "content_Vfwg6j": {
          "type": "content",
          "settings": {
            "image": "shopify://shop_images/lion_s_mane.webp",
            "button_link": "shopify://products/lions-mane-mushroom",
            "stars": "<i class=\"fa fa-star active\"></i>\n                                                <i class=\"fa fa-star active\"></i>\n                                                <i class=\"fa fa-star active\"></i>\n                                                <i class=\"fa fa-star active\"></i>\n                                                <i class=\"fa fa-star active\"></i>",
            "date_text": "",
            "title": "Must have!",
            "sub_title": "<p>I absolutely have had an awesome experience taking these. So has my partner. We both feel so clear minded, natural energy, and have had a TON of anxiety released. I subscribed because of the impact it’s had on my life! I’m able to take a step back & think from a higher awareness now!! Love their product & how pure of mushroom it is.<br/></p><p><strong>- Carly C.</strong></p>",
