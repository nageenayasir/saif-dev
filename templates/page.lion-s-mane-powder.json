    "dgf_img_and_text_tW8t4r": {
      "type": "dgf-img-and-text",
      "name": "[DGF] Image and Text",
      "settings": {
        "text_1": "<p>OVER 10,000 HAPPY CUSTOMERS</p>",
        "text_2": "<h1>Tired of Forgetting Things &amp; Having <br>brain fog?</h1>",
        "text_3": "<p>You’re not broken — and it’s not about drinking more stimulants. What your mind needs is real nutrition to restore balance and clarity.</p>",
