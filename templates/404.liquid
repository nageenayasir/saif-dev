{{ 'base.css' | asset_url | stylesheet_tag }}

<div style="text-align:center; padding:8rem 2rem;">
  <div class="page-width">
    <h1 style="font-family:var(--font-heading-family); font-size:8rem; font-weight:800; color:rgb(var(--color-base-text)); margin:0 0 0.5rem; line-height:1;">404</h1>
    <h2 style="font-family:var(--font-heading-family); font-size:2.4rem; font-weight:700; color:rgb(var(--color-base-text)); margin:0 0 1.6rem;">Page not found</h2>
    <p style="font-size:1.7rem; color:rgba(var(--color-base-text),0.65); margin:0 0 3rem;">
      The page you were looking for doesn't exist. <a href="{{ routes.root_url }}">Return home</a>
    </p>
    <a href="{{ routes.root_url }}" class="button button--primary">Back to home</a>
  </div>
</div>
