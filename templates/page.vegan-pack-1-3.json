        },
        "content_HrVCPh": {
          "type": "content",
          "settings": {
            "the_text": "<p>“This product is a game changer. It does not make me sleepy but it does help with mood and focus. Stress eating is down, and positivity is up. If you need a shovel to get out of the funk, pick this up.”</p><p>-<strong>Zainab</strong><em><strong> </strong></em></p>"
