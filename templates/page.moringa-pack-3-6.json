    "ashwagandha_pack_reviews_mTCEB8": {
      "type": "ashwagandha-pack-reviews",
      "blocks": {
        "content_hhWweC": {
          "type": "content",
          "settings": {
            "the_text": "<p><em>“</em><em><strong>These capsules are perfect for busy mornings. </strong></em><em>I don’t always have time to prep food or smoothies, so this is a quick win for my health. </em><em><strong>No side effects, just good energy.</strong></em><em>”</em></p><p><strong>- Marina P</strong></p>"
          }
        },
        "content_Kpg8TW": {
          "type": "content",
          "settings": {
            "the_text": "<p><em>“This is my third bottle—I take these every day. I’ve had fewer colds, more steady energy, and I just feel good. </em><em><strong>It’s one of those ‘quietly powerful’ supplements that you don’t really notice until you forget to take it.</strong></em><em>”</em></p><p>- <strong>Kristy C</strong></p>"
          }
        },
        "content_UerEJb": {
          "type": "content",
          "settings": {
            "the_text": "<p><em><strong>\"This supplement has become a non-negotiable in my routine.</strong></em><em> I’m someone who’s sensitive to supplements, but these are gentle and easy on my system. In return,</em><em><strong> I get better sleep, increased stamina, and a clear mind. </strong></em><em>It’s everything I was looking for — and then some.\"</em></p><p>- <strong>Rebecca H</strong></p>"
          }
        },
        "content_CmXnwU": {
          "type": "content",
          "settings": {
            "the_text": "<p><em>\"One word: consistency. That’s what I’ve gotten from these capsules. </em><em><strong>Consistent energy, consistent focus, and more consistent digestion.</strong></em><em> It’s such a great feeling knowing I’m fueling my body with something </em><em><strong>truly natural and effective.\"</strong></em></p><p>- <strong>Dave Coen</strong></p>"
          }
        },
        "content_6kjEM3": {
          "type": "content",
          "settings": {
            "the_text": "<p><em><strong>\"This Moringa has helped bring balance back to my body.</strong></em><em> I didn’t expect such noticeable results, but I’ve had fewer headaches, less bloating, and even my PMS symptoms have eased. It’s a subtle shift, but a powerful one.\"</em></p><p>- <strong>Amy M</strong></p>"
          }
        },
        "content_kaXD8X": {
          "type": "content",
          "settings": {
            "the_text": "<p>\"<em>I started taking Tribe Organics’ Moringa mainly for inflammation and energy support. Two weeks in and I’m feeling lighter, with way less joint stiffness and more motivation throughout the day.</em><em><strong> It’s quickly become my go-to morning supplement.\"</strong></em></p><p><strong>- Crystal C</strong></p>"
          }
        },
        "content_bH9VFY": {
          "type": "content",
          "settings": {
            "the_text": "<p><em>\"I’m all about natural wellness, and Tribe Organics’ Moringa fits right into my lifestyle. </em><em><strong>It’s a gentle yet powerful supplement.</strong></em><em> I’m feeling more energetic, mentally sharp, and less achy after workouts. Super convenient to take and doesn’t upset my stomach like some supplements do.\"</em></p><p>- <strong>Nova G</strong></p>"
          }
        },
        "content_eT8MXC": {
          "type": "content",
          "settings": {
            "the_text": "<p>\"<em>After reading so many good things about moringa, I decided to try Tribe Organics, and it definitely lived up to the hype. </em><em><strong>My energy has been way more consistent</strong></em><em>, and I even feel like </em><em><strong>my immune system is stronger </strong></em><em>— haven’t caught a cold all winter. Really satisfied with the results.\"</em></p><p>- <strong>Clara Moore</strong></p>"
          }
        },
        "content_dEaCMm": {
          "type": "content",
          "settings": {
            "the_text": "<p><strong>\"</strong><em>This product is amazing. I’ve noticed less anxiety, better focus, and even my afternoon slumps have disappeared. </em><em><strong>Tribe Organics clearly cares about quality and transparency.</strong></em><em> I love that it’s all organic and made without any additives.\"</em></p><p><strong>- Remy King</strong><br/><br/></p>"
          }
        },
        "content_V3FiVp": {
          "type": "content",
          "settings": {
            "the_text": "<p><em>\"I’ve tried a lot of supplements and was skeptical at first, but Tribes Organics’ Moringa blew me away. Within 10 days, I was more productive, less bloated, and even my skin started looking clearer.</em><em><strong> No side effects, just steady, gentle improvements.</strong></em><em> Super grateful I gave this a shot.\"</em></p><p><strong>- Dana Avery</strong></p>"
          }
        },
        "content_EGcPzn": {
          "type": "content",
          "settings": {
            "the_text": "<p>\"<em>I started taking this to support hormonal balance and energy levels, and I’m genuinely impressed. </em><em><strong>It feels like my body is running smoother</strong></em><em> — less brain fog, no more sugar cravings, and more endurance during workouts.</em><em><strong> It’s now one of my top three daily supplements.\"</strong></em></p><p>- <strong>Jackie C</strong></p>"
          }
        },
        "content_gJerF6": {
          "type": "content",
          "settings": {
            "the_text": "<p><em>\"Tribe Organics’ Moringa is the real deal. My digestion has improved noticeably, and I feel lighter and more alert. </em><em><strong>It’s such a simple addition to my routine with impressive results.\"</strong></em></p><p><strong>- Lily R</strong></p>"
