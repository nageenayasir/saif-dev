    "ashwagandha_pack_benefits_QgLdBB": {
      "type": "ashwagandha-pack-benefits",
      "blocks": {
        "tex_blocks_kHkqRi": {
          "type": "tex_blocks",
          "settings": {
            "the_text": "<h3>Stay energized and on-task, always</h3><p>Get the most out of your days. Packed with protein, fiber, vitamins, and minerals, Moringa provides the nutritional backbone for optimal productivity. It also boasts a potent blend of 46 antioxidants, which help shield mitochondria from oxidative stress — enhancing energy production in every cell of your body</p>"
          }
        },
        "tex_blocks_rfTCBn": {
          "type": "tex_blocks",
          "settings": {
            "the_text": "<h3>Support normal blood sugar metabolism</h3><p>Thanks to its high concentration of polyphenol compounds, Moringa has been shown to promote insulin sensitivity and glucose metabolism, encouraging the maintenance of healthy blood glucose levels. Moringa may also support optimal cholesterol levels.</p>"
          }
        },
        "tex_blocks_Lr8WeA": {
          "type": "tex_blocks",
          "settings": {
            "the_text": "<h3>Maintain a happy, healthy weight</h3><p>Weight loss is never easy. But Moringa smooths the process by upregulating metabolism, promoting normal inflammatory responses, and optimizing the body’s natural detoxification system. You’ll be closer to your weight loss goal than ever before.</p>"
          }
        },
        "tex_blocks_RpArnM": {
          "type": "tex_blocks",
          "settings": {
            "the_text": "<h3>Unlock your milk supply’s potential (for new moms, of course!)</h3><p>Make that liquid gold flow. Moringa is scientifically recognized as an herbal galactagogue due to its nutrient density and ability to support healthy prolactin (a hormone responsible for lactation) levels in nursing mothers, including those of preterm infants.</p>"
          }
        }
      },
