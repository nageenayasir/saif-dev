    "faq_e8gc3A": {
      "type": "faq",
      "blocks": {
        "faq_Afpyiw": {
          "type": "faq",
          "settings": {
            "title": "What makes Tribe Organics Turmeric Complex different from other turmeric supplements?",
            "content": "Our Turmeric Complex features Curcumin C3 Complex®, the most clinically studied form of curcumin, combined with Boswellin®, the only Boswellia Serrata extract shown to work directly within joint cartilage to support comfort and mobility. This powerful duo, enhanced with Ginger Root Extract and BioPerine® for superior absorption, helps improve blood flow, reduce inflammation and deliver long-lasting joint support and overall vitality.*"
          }
        },
        "faq_pc3RVk": {
          "type": "faq",
          "settings": {
            "title": "What are the benefits of taking Turmeric Complex daily?",
            "content": "Daily use helps reduce inflammation, ease joint stiffness, enhance mobility and support recovery and overall vitality. It also promotes antioxidant protection for long-term wellness.*"
          }
        },
        "faq_wVL3PX": {
          "type": "faq",
          "settings": {
            "title": "How long does it take for Turmeric Complex to work?",
            "content": "Most people notice improved comfort and flexibility within 2 to 4 weeks, with deeper joint and mobility benefits building after 6 to 8 weeks of consistent use."
          }
        },
        "faq_cReHAw": {
          "type": "faq",
          "settings": {
            "title": "Should I take Turmeric Complex with food?",
            "content": "Yes — taking Turmeric Complex with food helps boost curcumin absorption and maximize results. Pair it with your morning or lunchtime meal for best effects."
          }
        },
        "faq_JNQih7": {
          "type": "faq",
          "settings": {
            "title": "Is Turmeric Complex safe for daily use?",
            "content": "Yes. Our formula is Non-GMO Verified, Gluten-Free, and Kosher Certified, made in a GMP-certified facility and third-party tested for purity and potency — safe for long-term daily use."
          }
        }
      },
