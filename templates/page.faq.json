    "main": {
      "type": "main-faq",
      "blocks": {
        "4a7aea95-890b-4f56-b81e-2fc900e2697a": {
          "type": "faq",
          "settings": {
            "title": "Can I take TRIIBE Organics’ products everyday?",
            "content": "Yes! In fact, herbs and mushrooms work better when taken consistently over a long period of time."
          }
        },
        "f876558c-29b7-412f-8e83-472331ba981e": {
          "type": "faq",
          "settings": {
            "title": "Can I take TRIIBE Organics’ products together?",
            "content": "Yes! In fact, many of the herbs and mushrooms are combined to work synergistically with others to give better results."
          }
        },
        "f4a75b7c-9a5f-4345-8138-b6e6b04b09e0": {
          "type": "faq",
          "settings": {
            "title": "How do I store my products?",
            "content": "We recommend storing them in a cool, dry place that is out of direct sunlight."
          }
        },
        "69376d1f-c32f-4537-872a-55472ec6f62f": {
          "type": "faq",
          "settings": {
            "title": "Can I take these products if I’m pregnant, breastfeeding or under 18?",
            "content": "Please consult your health professional before using our products if you are pregnant/breastfeeding and before you provide our products to children."
          }
        },
        "be74f6cb-a511-4ed7-bd44-477353f4ed42": {
          "type": "faq",
          "settings": {
            "title": "Are your products third- party tested?",
            "content": "Yes, they all are. What’s inside your supplement is every bit as important as what’s not. That’s why all our products are third-party tested for heavy metals, pathogens, and contaminants. And then we share those results with you. You can check them out here."
          }
        },
        "8813bc3f-a24d-4c93-8608-ab72561b1202": {
          "type": "faq",
          "settings": {
            "title": "Do I need to cycle the consumption of any product?",
            "content": "Following traditional Ayurvedic and Chinese Medicine methods, we suggest taking any of our product(s) for 2-3 months and then pausing for a few days to a week max. to give your body a rest.\n <br><br>\nIf we observe nature, we can see that everything is cyclic. Following this cyclic pattern, herbs and mushrooms are best taken in cycles. Tonic herbs, such as Ashwagandha, Shatavari, Amla,  are generally taken in a rotational cycle; these herbs are classified as “superior medicine” because they are safe, gentle and meant to be used over a prolonged period. The cycle often suggested for tonics is five days on and two days off. This cycle can be repeated as long as necessary because there are no side effects or contraindications for long-term use."
          }
        },
        "2d8bd61e-1c59-438e-8714-d191023ec7ff": {
          "type": "faq",
          "settings": {
            "title": "What is the right dosage for supplements?",
            "content": "The dosage varies by product. Please check the bottle/website for recommended use."
          }
        },
        "2d630847-64ca-4787-9acd-182d58d0e45d": {
          "type": "faq",
          "settings": {
            "title": "Can I exceed your recommended dosage?",
            "content": "We recommend working with a practitioner before choosing to increase dosages. Recommended dosages are meant to optimally support the average person. TRIIBE Organics recommends working with a health professional or Ayurvedic or TCM practitioner to determine individualized dosages and to create a health plan that is suited to individual needs."
          }
        },
        "69d40b6c-f506-4807-acf4-0e97ac2ee84a": {
          "type": "faq",
          "settings": {
            "title": "Are all your products safe for children?",
            "content": "Because most of our supplements are made from 100% herbs and mushrooms and are completely natural (no artificial anything) many parents love to share their supplements with their children.\nKeep in mind that, depending on the age of your child, some supplements may be more appropriate than others. Children can also require different doses than you do as an adult. \n<br><br>\nAs with any new supplement, we always recommend consulting with your healthcare professional first before adding any supplement to your children’s wellness regimen."
          }
        },
        "fa3fcc96-862b-4dc9-9fa5-d7f3b6c067ae": {
          "type": "faq",
          "settings": {
            "title": "Do your products have any drug interactions or contra-indications? ",
            "content": "We do not advise on the safety of taking our supplements with prescription medications. Please consult your health care practitioner if you are currently under other prescription medication protocols."
          }
        },
        "cde968bd-bb82-43b4-8c83-15b5c9f190a9": {
          "type": "faq",
          "settings": {
            "title": "Are your products approved by the FDA?",
            "content": "The FDA does not approve herbal supplements, but rather regulates them as food products. The responsibility for safety and quality lies with the manufacturer. \n<br><br>\nTRIIBE Organics’ supplements are manufactured in the highest quality manner, tested for potency and purity by independent third-party labs, and structure-function claims are supported by clinical research from our partner suppliers."
          }
        },
        "a84c61ef-90dc-4525-99ec-18bf5be09661": {
          "type": "faq",
          "settings": {
            "title": "​​Where can I find the full list of ingredients?",
            "content": "All of the ingredients can be found on each tribe-organics.com product page. If you scroll half way down the page you will find the full ingredient list.\n<br><br>\nYou can also find all the ingredients on the bottle in the Supplement Facts panel."
          }
        },
        "84a67e8a-2378-45bf-832a-da010a701e23": {
          "type": "faq",
          "settings": {
            "title": "Do you sell at any retail locations?",
            "content": "No, currently all of our products are sold through our website, Amazon.com, Walmart.com, and Evitamins.com which has excellent international shipping if you live outside the US. \n<br><br>\nWe also sell through select health practitioners."
          }
        },
        "6b628b38-8ccf-4d61-a20f-b68821802960": {
          "type": "faq",
          "settings": {
            "title": "Are your products gluten-free?",
            "content": "All of our products are gluten-free."
          }
        },
        "debb326b-7a44-464c-be17-f73a211e303b": {
          "type": "faq",
          "settings": {
            "title": "Are your products certified organic?",
            "content": "All of our products are Certified Organic with the exception of Turmeric Complex, Alma Complex and Boswellia Complex."
          }
        },
        "4f590cfc-c207-465b-bdad-405c8b1a0c6b": {
          "type": "faq",
          "settings": {
            "title": "Are your products non-GMO verified?",
            "content": "All of our products are non-GMO verified."
          }
        },
        "f4faeca3-c7bc-4bb8-a421-c2c128141f1b": {
          "type": "faq",
          "settings": {
            "title": "Are your products vegan?",
            "content": "All of our products are vegan with the exception of our KSM-66 Ashwagandha Full Spectrum. For this product, the Ashwagandha roots are pre-treated with grass-fed cow’s milk before the extraction process and being turned into powder."
          }
        }
      },
