        "0a49c767-52ea-43a2-b427-4b6c8b73982d": {
          "type": "general_question",
          "settings": {
            "faq_qus": "Do you sell at any retail locations?",
            "faq_ans": "<p>No, currently all of our products are sold through our website, <a href=\"https://www.amazon.com/stores/page/F5692F74-2F15-4D12-A333-F696B35CF6C4?ingress=0&visitId=5f21cf55-37e4-4f99-9274-1e06df5a19a7&lp_slot=auto-sparkle-hsa-tetris&store_ref=SB_A0515287883HJ4YBOXY&ref_=sbx_be_s_sparkle_mcd_cta\"><span style=\"text-decoration:underline\">Amazon.com</span></a>, Walmart.com, and <a href=\"https://www.evitamins.com/s/search?keywords=tribe\"><span style=\"text-decoration:underline\">Evitamins.com</span></a> which has excellent international shipping if you live outside the US. </p><p>We also sell through select health practitioners and health/wellness centers.</p>"
          }
        },
        "a84f3b50-9c15-4eba-ad17-5be4ac48ac92": {
          "type": "manufacture_question",
          "settings": {
            "faq_qus": "Where are your products manufactured?",
            "faq_ans": "<p>All of our products are manufactured in the USA using GMP (Good Manufacturing Practices) certified facilities. You can learn more about our manufacturing partners on the <a href=\"https://www.tribe-organics.com/pages/transparency\" title=\"https://www.tribe-organics.com/pages/transparency\"><span style=\"text-decoration:underline\"><strong>Transparency</strong></span></a> section of our website.</p>"
          }
        },
        "2b17209d-bec1-49c9-80d0-f019013c4c26": {
          "type": "manufacture_question",
          "settings": {
            "faq_qus": "What are the capsules made of?",
            "faq_ans": "<p>Most of our capsules are made from organic tapioca which is naturally fermented into pullulan, a starch-free, gluten-free, preservative-free, Non-GMO, USDA Organic vegetarian capsule. It is naturally derived and environment friendly with strong oxygen barrier properties that ensures the shelf life of our supplements. Pullulan capsules also protect encapsulated herbs from oxidation. </p><p>Our other capsules are produced from hydroxypropyl methylcellulose (HPMC), hypromellose for short. This is a completely plant-based material, making it ideal for consumption by vegetarians, vegans, or those who for cultural reasons cannot consume animal byproducts.</p>"
          }
        },
        "b5e78f11-9c19-41fc-9eb5-195e2b624228": {
          "type": "manufacture_question",
          "settings": {
            "faq_qus": "Can the capsule products be taken in powder form?",
            "faq_ans": "<p>Yes; it is not necessary to leave the product in the capsule if you prefer to take the product in powder form. You can easily open the capsules and add the powder to juices, smoothies, water and some can be added to some meals without losing their nutrients.</p>"
          }
        },
        "77d26684-caa0-4cb0-ad01-08ad92fdbc76": {
          "type": "manufacture_question",
          "settings": {
            "faq_qus": "What is the shelf life of your products?",
            "faq_ans": "<p>The shelf life on most of our products is 2 years. The \"Best Used By\" information, located under each bottle, represents the date by which the product is best used by and the product code. Tribe Organics only guarantees product potency through the “Best Used By” date. </p>"
          }
        },
        "6533e9fa-6d8b-4e08-8060-235823efff3a": {
          "type": "manufacture_question",
          "settings": {
            "faq_qus": "Do products have a longer shelf life if they are unopened?",
            "faq_ans": "<p>No, the shelf life is the same.</p>"
          }
        },
        "14086855-d2ae-4fad-ab8f-c9c077a6f6c8": {
          "type": "manufacture_question",
          "settings": {
            "faq_qus": "Can I use Tribe Organics products after the expiration date (“Best Used By”)?",
            "faq_ans": "<p>While it is unlikely that there would be any safety issue, we do not recommend using our products past the expiration date on the packaging, as we can no longer guarantee the efficacy or potency of the herbs and mushrooms.</p>"
          }
        },
        "5f79c0df-bd2d-4c5a-a0ab-8d3ac4fddae5": {
          "type": "order_inquries",
          "settings": {
            "faq_qus": "Where's my order?",
            "faq_ans": "<p>Once you place an order, you will receive a confirmation email from us. Orders typically ship within 1-2 business days. Once shipped, you can log into your account and track your order or go <a href=\"https://www.tribe-organics.com/apps/tracktor/track\" title=\"https://www.tribe-organics.com/apps/tracktor/track\"><span style=\"text-decoration:underline\"><strong>here</strong></span></a> and add the order number and email address of the order and you can track it.</p><p>If you did not receive an email, please check your junk/promotions folder and ensure you are using the same email address that was associated with your order.</p><p>If you cannot find your confirmation email, please reach out to us at <a href=\"mailto:info@tribe-organics.com\"><span style=\"text-decoration:underline\">info@tribe-organics.com</span></a> or by phone at +1 (917) 934-3078</p>"
          }
        },
        "d9d2772a-48e8-483f-b68d-a5f95a364088": {
          "type": "order_inquries",
          "settings": {
            "faq_qus": "What do I do if my order is incorrect?",
            "faq_ans": "<p>Send us an email at <a href=\"mailto:info@tribe-organics.com\"><span style=\"text-decoration:underline\">info@tribe-organics.com</span></a> ASAP and we will work it out!</p>"
          }
        },
        "b74dcfbd-5b5a-48a4-80e1-6497a9cadfc2": {
          "type": "order_inquries",
          "settings": {
            "faq_qus": "Can I cancel my order? ",
            "faq_ans": "<p>All orders can be canceled up to one hour after your order is placed. Once an order is processed, it cannot be canceled. Once an order is received, you can ask for a return with a shipping fee.</p><p>Please review our <a href=\"https://www.tribe-organics.com/policies/refund-policy\" title=\"https://www.tribe-organics.com/policies/refund-policy\"><span style=\"text-decoration:underline\"><strong>Refund policy</strong></span></a> if you fall in this category. </p>"
          }
        },
        "444290ad-675e-4bd3-9240-b750d6f5c003": {
          "type": "order_inquries",
          "settings": {
            "faq_qus": "Can I make changes to an order?",
            "faq_ans": "<p>Once your order is placed, we can no longer make any changes. If you have any issues with your order, please contact us at <a href=\"mailto:info@tribe-organics.com\"><span style=\"text-decoration:underline\">info@tribe-organics.com</span></a></p><p>If you notice an error with your shipping address please contact us as soon as possible. We cannot guarantee we will be able to successfully update an address error before our fulfillment team pulls the order. The shipping address is the responsibility of the customer.</p><p><strong>NOTE: Updating your shipping address in your account will not update the shipping address on orders that have been processed.</strong></p>"
          }
        },
        "41edcf84-72ec-4788-ab96-2feb0b45646a": {
          "type": "order_inquries",
          "settings": {
            "faq_qus": "Where can I add a discount code to my order?",
            "faq_ans": "<p>At checkout, you will find a place to add your discount code underneath the product(s) in your order. You can add the code in the input field where it says “Discount Code” and then click Apply.</p>"
          }
        },
        "90644051-fe6c-493f-84e0-55f0e6791ca8": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "What forms of payment do you accept?",
            "faq_ans": "<p>We accept all major credit cards and PayPal. </p>"
          }
        },
        "21a58932-88c7-4a68-a2b0-0f9ed9086671": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "Where do you ship from? ",
            "faq_ans": "<p>All orders are shipped from our warehouse in Phoenix, Arizona</p>"
          }
        },
        "c1524203-20c3-44e2-be60-74c2e7d7f12d": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "Where do you ship to? ",
            "faq_ans": "<p>We currently ship across the US and some countries outside of the US.</p><p>Please check our International section to see if your country is eligible for international shipping <a href=\"/policies/shipping-policy\" title=\"Shipping Policy\"><span style=\"text-decoration:underline\"><strong>here</strong></span></a> and check the international shipping policy. </p>"
          }
        },
        "d6347937-f482-47ba-acb4-99a4e0f52b6b": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "How do I get FREE shipping?",
            "faq_ans": "<p>If your order totals $75 or more, you apply for FREE shipping. Note that this only applies to<em> Standard Shipping </em>inside the US, which usually takes 5-7 business days. </p><p>Please use code <strong>FREESHIP75</strong> at checkout for free shipping to be applied.</p>"
          }
        },
        "ffdb62b4-667d-46b6-aa46-c575c15ccd45": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "Do you offer expedited shipping?",
            "faq_ans": "<p>Depending on your location, we do offer 2-day shipping options. Use our Shipping Calculator on the <a href=\"https://www.tribe-organics.com/checkouts/c/28819970c7e3e4b5ed81c0281b446eee/shipping\"><span style=\"text-decoration:underline\">Shopping Cart page</span></a> to show shipping options. </p><p>Expedited shipping usually starts at $12.99.</p>"
          }
        },
        "9df836cf-5c07-4d1d-a6e1-15f8c8f5bdb9": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "How can I check the shipping status of my order?",
            "faq_ans": "<p>Shipping tracking details will be emailed to you after the order has shipped from our warehouse. </p><p>If you can't find the email, Once the order has shipped, you can log into your account and track your order by clicking on the button \"TRACK YOUR ORDER\". You can also click <a href=\"https://www.tribe-organics.com/apps/tracktor/track\" title=\"https://www.tribe-organics.com/apps/tracktor/track\"><span style=\"text-decoration:underline\"><strong>here,</strong></span></a> add the order number and email address registered with the order and you can check tracking info.</p>"
          }
        },
        "28117162-1b32-40b8-b6bb-609d2736aacb": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "How are packages shipped?",
            "faq_ans": "<p>Orders are shipped via UPS, USPS or FedEx. We are currently unable to ship to PO Boxes.</p>"
          }
        },
        "cb0d8383-864b-4521-b0e7-0910f5570d2c": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "What do I do if I receive broken or damaged product(s)?",
            "faq_ans": "<p>Oh no! So sorry that happened. For broken or damaged products, please reach out to our Customer Service team at <a href=\"mailto:info@tribe-organics.com\"><span style=\"text-decoration:underline\">info@tribe-organics.com</span></a>. </p><p>Please provide photos of the damage and we’ll be happy to make things right!</p>"
          }
        },
        "7015718b-f50b-4752-8c7d-b0a0e785e917": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "How long will it take to receive my order?",
            "faq_ans": "<p>Orders are generally processed within 24-48 hours of receipt, Monday through Friday. If your order is received after our daily shipping cutoff time or after business hours it may be processed the following business day. </p><p>Shipping times will vary based on your location. Orders placed on Friday may not ship until the following Monday. No orders are processed on Saturday, Sunday or any federal holidays.</p><p>We strive to ship all orders out as soon as possible!! We cannot guarantee a delivery date, but the standard transit time provided by our delivery service is 5-7 business days (often sooner!) after the order has been placed and processed. </p><p>If there are any delays, please contact us at <a href=\"mailto:info@tribe-organics.com\"><span style=\"text-decoration:underline\">info@tribe-organics.com</span></a></p>"
          }
        },
        "1f354738-9feb-427f-b522-aceb380bfcaa": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "How can I trust that my payment and personal information is secure?",
            "faq_ans": "<p>We work with a PCI DSS compliant service provider. This means we take your security very seriously and never disclose your personal identity or information with anyone. You can read our full Privacy Policy <a href=\"https://www.tribe-organics.com/policies/privacy-policy\" title=\"https://www.tribe-organics.com/policies/privacy-policy\"><span style=\"text-decoration:underline\"><strong>here</strong></span></a>.</p>"
          }
        },
        "f09ac31b-53b2-4db6-9c90-8480ea87f4b3": {
          "type": "shipping_billing",
          "settings": {
            "faq_qus": "What sales tax am I charged?",
            "faq_ans": "<p>All items shipped to the state of New York will be charged a sales tax of 8-8.9% depending on your ZIP code.</p>"
          }
        },
        "dc17e288-494a-4c4f-89d8-209d0bcb9a71": {
          "type": "international",
          "settings": {
            "faq_qus": "Do you ship Internationally?",
            "faq_ans": "<p>Yes we do,  but it depends if your country is eligible or not. Please note prices are listed in USD and Tribe Organics is not responsible for customs, duties, or exchange rates.</p><p>If your country is not mentioned in the list below, please contact us at <a href=\"mailto:info@tribe-organics.com\"><span style=\"text-decoration:underline\">info@tribe-organics.com</span></a> to see if we could ship to your country. We would need you to let us know whether your country allows supplements to be imported.</p>"
          }
        },
        "636c1055-ac83-4170-a097-8a33f3e9585c": {
          "type": "international",
          "settings": {
            "faq_qus": "Which countries are eligible for international shipping?",
            "faq_ans": "<p>We ship to the countries included in this list: </p><ul><li>Canada</li><li>Australia</li><li>Belgium</li><li>Croatia</li><li>India</li><li>Indonesia</li><li>Ireland</li><li>Israel</li><li>New Zealand</li><li>Oman</li><li>Singapore</li><li>Switzerland</li><li>Thailand</li><li>United Kingdom</li><li>Norway</li></ul>"
          }
        },
        "a4621f60-de19-46b2-9b02-96db921b9ab1": {
          "type": "international",
          "settings": {
            "faq_qus": "How long does international shipping take?",
            "faq_ans": "<p>International orders generally arrive 15-20 business days after they’ve shipped if everything in customs works out perfectly. But, sometimes it can take longer (21-40 business days) as there may be custom delays beyond our control depending on your country. We do everything we can to avoid that, but it can still happen.</p>"
          }
        },
        "a97d6bd7-58c8-4e25-992b-7a1a30405084": {
          "type": "international",
          "settings": {
            "faq_qus": "How much does international shipping cost? ",
            "faq_ans": "<p>International shipping is calculated at checkout. It usually starts at $16.99 for one bottle depending on your country location.</p>"
          }
        },
        "7eed65d9-2d64-4c3f-be60-07791c0aa69f": {
          "type": "international",
          "settings": {
            "faq_qus": "What is your international return policy?",
            "faq_ans": "<p>Unfortunately, we don’t provide international returns at this point in time.</p>"
          }
        },
        "f4513136-2b7e-47d6-9618-1e221fb5e136": {
          "type": "order_inquries",
          "settings": {
            "faq_qus": "Can I change or cancel my corder once it's been placed?",
            "faq_ans": "<p>Be fast! If you email us and we are able to catch your order before our fulfillment team does, we will try our best to help you out. Reach us at <em>info@tribe-organics.com</em></p><p>*If your order has shipped, we are not able to offer any modifications or cancellations.</p>"
          }
        }
      },
