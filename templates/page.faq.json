    "3ee05d5c-18c9-4c25-bc38-a6b24723ed04": {
      "type": "custom-faq-tabs-2",
      "blocks": {
        "d216f081-48b9-4f86-b631-2733736c7cbc": {
          "type": "refunds",
          "settings": {
            "faq_qus": "Can I return the product I ordered?",
            "faq_ans": "<p>If for any reason you are not satisfied with your purchase, you may request a refund within 30 days of delivery of your first order. We’ll refund you for the full cost of the product, less shipping. We can do this once we get the product returned to our warehouse. </p>"
          }
        },
        "a0fd8c4a-189a-422a-8414-f9b231514df2": {
          "type": "refunds",
          "settings": {
            "faq_qus": "Can I get a refund?",
            "faq_ans": "<p>Refunds apply to your first order only. Simply email us at <a href=\"mailto:info@tribe-organics.com\"><span style=\"text-decoration:underline\">info@tribe-organics.com</span></a> to begin the process. In your email, please add your order number, a photo that shows that your product is entirely unopened, with an unbroken safety seal and the reason for your return. If your return is accepted, we will send you a return shipping label, as well as instructions on how and where to send your package. If you would like to make a return, please reach out to us directly for more information.</p>"
          }
        },
        "0be7fc32-d464-44e2-baa2-42911dc024ed": {
          "type": "refunds",
          "settings": {
            "faq_qus": "Is there a shipping fee to return the product?",
            "faq_ans": "<p>In most cases, a processing fee and a shipping fee depending on your ZIP code will be deducted from your refund unless the product is damaged, or it is our mistake. We may request a photo of the incorrect or damaged product prior to waiving the return shipping fee.</p>"
          }
        },
        "85c1da24-ac17-42b3-850a-2708628a30b2": {
          "type": "refunds",
          "settings": {
            "faq_qus": "When will I receive my refund?",
            "faq_ans": "<p>Please allow approximately 1-2 weeks for return processing. Once the product is returned to our warehouse, it will take an additional 5-7 business days to credit back to your original form of payment. You will receive a refund notification from us on your email when your return has been processed.</p>"
          }
        },
        "b0adbc66-8701-45b6-8d44-d0dfaad01afb": {
          "type": "subscriptions",
          "settings": {
            "faq_qus": "What is a subscription?",
            "faq_ans": "<p>A subscription will ensure that you always have your products arriving at your door at a set frequency. </p><p>We know a healthy lifestyle requires some consistency, which is why we created our subscription program. </p><p>Subscriptions are easy to manage, and you are never locked in. You are always notified a few days before your order will go through so you can skip, cancel or swap out products anytime!</p>"
          }
        },
        "329097d9-56fc-4dad-92c3-634b9bf52cf7": {
          "type": "subscriptions",
          "settings": {
            "faq_qus": "How does the subscription option work?",
            "faq_ans": "<p>For all products available on subscription, simply choose the time period in which you would like your products to be shipped — every 30, 45, or 60 days — and you’ll unlock increasing rewards the longer you stay subscribed:</p><p>1st order: 10% off + extra 5% just for subscribing<br/>2nd order: 15% off<br/>3rd order: 20% off<br/>4th order: 25% off<br/>5th order: 25% off + free gift + free shipping for life</p><p>Depending on your selection, you will be billed accordingly and your products will be shipped to your door.<br/><br/>All subscription orders over $75 ship for free.</p><p>To manage your subscription: Login to your <a href=\"https://www.tribe-organics.com/account/login\" title=\"https://www.tribe-organics.com/account/login\"><strong>account</strong></a> and locate the Subscriptions tab!</p>"
          }
        },
        "6f7a3551-1e4f-4781-b9cc-f5e03b00f422": {
          "type": "subscriptions",
          "settings": {
            "faq_qus": "How do I cancel my subscription?",
            "faq_ans": "<p>Sorry to see you go—we’ll miss you. </p><p>Your subscription can be canceled at any time! Just go to your <a href=\"https://www.tribe-organics.com/account/login\" title=\"https://www.tribe-organics.com/account/login\"><span style=\"text-decoration:underline\"><strong>account</strong></span><strong> </strong></a>or by contacting info@tribe-organics.com. </p><p>Simply delete any unwanted scheduled orders from your account and you will no longer be billed for future renewals.</p><p>Please note that requests <em><strong>must </strong></em>be sent at least one full business day before your subscription is set to renew. If you are cancelling, please use the word CANCEL in your subject line.</p>"
          }
        },
        "subscriptions_RrknWH": {
          "type": "subscriptions",
          "settings": {
            "faq_qus": "What Happens to My Perks if I Cancel My Subscription?",
            "faq_ans": "<p>If you cancel your subscription, all perks earned through the program — including free shipping for life and eligibility for the free gift — will end immediately. </p><p>If you re-subscribe in the future, you’ll start again from Tier 1, with the rewards and discounts restarting from your first order.</p>"
          }
        },
        "b74f22ac-626b-4ed4-9659-0c2211d97954": {
          "type": "subscriptions",
          "settings": {
            "faq_qus": "Can I reschedule my next shipment?",
            "faq_ans": "<p>Absolutely! Simply navigate to your <a href=\"https://www.tribe-organics.com/account/login\" title=\"https://www.tribe-organics.com/account/login\"><span style=\"text-decoration:underline\"><strong>account</strong></span></a> and reschedule your upcoming shipment for any date in the future. Once you do, we’ll automatically update any further monthly shipments. If you need any assistance, kindly email us at <a href=\"mailto:info@tribe-organics.com\"><span style=\"text-decoration:underline\">info@tribe-organics.com</span></a> and we’ll be happy to assist. </p>"
          }
        },
        "8bbe65c6-31e3-4171-9a8d-43c4da722729": {
          "type": "subscriptions",
          "settings": {
            "faq_qus": "How do I change my shipping address on my subscription?",
            "faq_ans": "<p>You can change your address on your account, go to your profile and edit the default address. We will also ask you to please do a test order just so we can see if the address has been changed successfully. All  you need to do is add any item to your cart and proceed with the order until the payment section during checkout.  Then you can exit the website and it will automatically appear on our abandoned checkouts with the order details. Please send us an email so we can confirm it was changed successfully. Thank you :) </p><p><strong>Note: Updating the shipping address on your account will not update an already processed order. Addresses cannot be modified on orders that have already been processed.</strong></p>"
          }
        },
        "7476b95c-6ca1-4bf0-87b1-3e347458d09a": {
          "type": "subscriptions",
          "settings": {
            "faq_qus": "How do discounts work on subscription orders?",
            "faq_ans": "<p>Subscription discounts are built right in and increase over your first four orders — no coupon needed. Additional promo codes cannot be combined with subscription purchases at this time.</p>"
          }
        },
        "20ceafaf-511d-4826-9e36-c61be8e74733": {
          "type": "subscriptions",
          "settings": {
            "faq_qus": "Will I get an email before you ship?",
            "faq_ans": "<p>Yes you will! We want you to have time to make updates to your shipment and/or order. You will receive a three-day reminder email before your subscription ships out, and that’s your time to log in and make any changes you need. </p><p>On the day of, you will receive a processing email followed by a shipping confirmation email.</p>"
          }
        },
        "9fe5ac0b-6c74-4865-94a5-c5a5508914c7": {
          "type": "account",
          "settings": {
            "faq_qus": "How do I create a customer account?",
            "faq_ans": "<p>You can create a customer account when you checkout. There will be an option to save your information during checkout which creates an account for you. You can also set up an account before you complete any purchases by <a href=\"https://www.tribe-organics.com/account/register\" title=\"https://www.tribe-organics.com/account/register\"><strong>creating an account here.</strong></a> You can setup your billing and shipping information ahead of time, as well as save your carts with a customer account.</p>"
          }
        },
        "07a5e439-dd8c-4f8c-b096-bcfa95c91a60": {
          "type": "account",
          "settings": {
            "faq_qus": "How do I log in to my customer account?",
            "faq_ans": "<p>There is a link in the top right of our shop that goes to our <a href=\"https://www.tribe-organics.com/account/login\" title=\"https://www.tribe-organics.com/account/login\"><span style=\"text-decoration:underline\"><strong>Login page</strong></span></a>.</p>"
          }
        },
        "aca21c96-2027-4434-92d8-48302a90a02e": {
          "type": "account",
          "settings": {
            "faq_qus": "How do I reset my password?",
            "faq_ans": "<p>Click on the \"Forgot Password?\" link on the customer login page or go <a href=\"https://www.tribe-organics.com/pages/account-forgot\" title=\"https://www.tribe-organics.com/pages/account-forgot\"><span style=\"text-decoration:underline\"><strong>here</strong></span><strong>.</strong></a></p>"
          }
        }
      },
