<section class="section-banner section-title section-form bg-line-02 customer-account-details">
    <div class="leaf-box right-top">
        <img class="leaf" src="{{ 'leaf-n02.svg' | asset_url }}">
    </div>
    <div class="content">
        <div class="container">
            <h1 class="text-uppercase" data-aos="fade-up">{{ 'customer.addresses.title' | t }}</h1>
            <div class="subtitle" data-aos="fade-up" data-aos-delay="200">
                <ul class="nav nav-tabs">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ routes.account_url }}">Order</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ routes.account_addresses_url }}">Address</a>
                    </li>
<!--                     <li class="nav-item">
                        <a class="nav-link" href="#">Change Password</a>
                    </li> -->
                    <li class="nav-item">
                        <a class="nav-link" href="{{ routes.account_logout_url }}">Logout</a>
                    </li>
                </ul>
            </div>
            {% assign path = request.path | split: "/"   %} 
            {% assign address = path | last  %}
            {% assign address_name = address | handle  %}
            {% for address in customer.addresses %}
            {% assign address_first = address.first_name | handle  %}
             {% if address_name == address_first %}
              {%- form 'customer_address', address, class : 'form form-big pb-3' -%}
                  <div class="text-start mt-5 mb-4">
                      <h5>{{ 'customer.addresses.edit' | t }}</h5>
                  </div>
                  <div class="form-group" data-aos="fade-up">
                      <div class="row">
                          <div class="col-md-6">
                              <input class="form-default" type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder="{{ 'customer.addresses.first_name' | t }}">
                          </div>
                          <div class="col-md-6">
                              <input class="form-default" type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder="{{ 'customer.addresses.last_name' | t }}">
                          </div>
                      </div>
                  </div>
                  <div class="form-group" data-aos="fade-up">
                      <input class="form-default" type="text" id="AddressCompany_{{ form.id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder="{{ 'customer.addresses.company' | t }}">
                  </div>
                  <div class="form-group" data-aos="fade-up">
                      <input class="form-default" type="text" id="AddressAddress1_{{ form.id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="{{ 'customer.addresses.address1' | t }}">
                  </div>
                  <div class="form-group" data-aos="fade-up">
                      <input class="form-default" type="text" id="AddressAddress2_{{ form.id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="{{ 'customer.addresses.address2' | t }}">
                  </div>
                  <div class="form-group" data-aos="fade-up">
                      <input class="form-default" type="text" id="AddressCity_{{ form.id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="{{ 'customer.addresses.city' | t }}">
                  </div>
                  <div class="form-group" data-aos="fade-up">
                      <input class="form-default" type="text" id="AddressZip_{{ form.id }}" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="{{ 'customer.addresses.zip' | t }}">
                  </div>
                  <div class="form-group" data-aos="fade-up">
                      <input class="form-default" type="tel" id="AddressPhone_{{ form.id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="{{ 'customer.addresses.phone' | t }}">
                  </div>
                  <div class="form-group d-flex" data-aos="fade-up"> 
                     {{ form.set_as_default_checkbox }}
                      <label class="button-checkbox ms-2" data-aos="fade-up">{{ 'customer.addresses.set_default' | t }}</label>
                  </div>
                  <input type="hidden" name="return_to" value="/account/addresses">
                  <div class="form-group last d-flex" data-aos="fade-up">
                      <button type="submit" class="btn btn-bg me-3">{{ 'customer.addresses.edit' | t }}</button>
                      <button type="button" class="btn btn-trans" onclick="location.href='{{ routes.account_addresses_url }}'">{{ 'customer.addresses.cancel' | t }}</button>
                  </div>
            {% endform %}
           {% endif %}
          {% endfor %}
        </div>
    </div>
</section>
