<section class="section-banner section-title section-form bg-line-02 customer-account-details">
  <div class="leaf-box right-top">
      <img class="leaf" src="{{ 'leaf-n02.svg' | asset_url }}">
  </div>
  <div class="content">
      <div class="container">
          <h1 class="text-uppercase" data-aos="fade-up">{{ 'customer.activate_account.title' | t }}</h1>
          <div class="subtitle" data-aos="fade-up" data-aos-delay="200">
                {{ 'customer.activate_account.subtext' | t }}
          </div>
           {%- form 'activate_customer_password', class : 'form' -%}
                  {%- if form.errors -%}
                      <h2 class="form__message" tabindex="-1" autofocus>
                        <svg aria-hidden="true" focusable="false" role="presentation">
                          <use href="#icon-error" />
                        </svg>
                        {{ 'templates.contact.form.error_heading' | t }}
                      </h2>
                      <ul>
                        {%- for field in form.errors -%}
                          <li>
                            {%- if field == 'form' -%}
                              {{ form.errors.messages[field] }}
                            {%- else -%}
                              <a href="#{{ field }}">
                                {{ form.errors.translated_fields[field] | capitalize }}
                                {{ form.errors.messages[field] }}
                              </a>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                {%- endif -%}
              <div class="form-group" data-aos="fade-up">     
                   <input class="form-default" type="password" name="customer[password]" id="password" placeholder="{{ 'customer.activate_account.password' | t }}">
              </div>
              <div class="form-group" data-aos="fade-up">     
                   <input class="form-default" type="password" name="customer[password_confirmation]"  id="password_confirmation" placeholder="{{ 'customer.reset_password.password_confirm' | t }}">
              </div>           
              <div class="form-group last" data-aos="fade-up">
                  <button type="submit" class="btn btn-bg-full"> {{ 'customer.activate_account.submit' | t }}</button>
              </div>
          {% endform %}
      </div>
  </div>
</section>