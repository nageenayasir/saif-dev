        "811654a5-8a16-42a5-b08e-ddca93cfbd9e": {
          "type": "logo",
          "settings": {
            "logo": "shopify://shop_images/gmo.png",
            "the_title": "non-gmo verified",
            "the_text": "As North America’s premier and most trusted verification and labeling organization for non-GMO food and products, the Non-GMO Project’s goal is to preserve and build sources of non-GMO products, educate consumers, and provide choices that are verified non-GMO. The Non-GMO Project seal provides assurance to customers that a product has been manufactured using best practices for GMO avoidance.",
            "button": "NON-GMO CERTIFICATION",
            "url": "https://drive.google.com/file/d/1i02gHRNOYi4GtFh-SIRoFKjUnnmznHTt/view?usp=drive_link"
          }
        },
        "logo_yUQJaM": {
          "type": "logo",
          "settings": {
            "logo": "shopify://shop_images/U-Kosher.png",
            "the_title": "OU kosher certified",
            "the_text": "The Orthodox Union Kosher Certification the world’s best-known and most widely accepted kosher trademark, the OU Kosher Symbol. This symbol certifies that the product contains neither dairy nor meat, nor any dairy or meat derivatives. The product was not made on dairy equipment. The product was not made on equipment used for making meat products.",
            "button": "OU Kosher certification",
            "url": "https://drive.google.com/file/d/1zqAbCnDuvgorGcaK36kaUJN8lP31rhzV/view?usp=sharing"
          }
        },
        "175ccb2c-8ad8-4e53-bd7f-b10fd4e4a72b": {
          "type": "logo",
          "settings": {
            "logo": "shopify://shop_images/guten.png",
            "the_title": "GFCO GLUTEN-FREE certified",
            "the_text": "The Gluten-Free Certification Organization (GFCO) is a program of the Gluten Intolerance Group (GIG), a non-profit empowering the gluten-free community since 1974. Unlike other certifications which only audit record-keeping, GFCO reviews the manufacturer’s products and ingredients, and individually tailors testing requirements based on risk.",
            "button": "GLUTEN-FREE CERTIFICATION",
            "url": "https://drive.google.com/file/d/1DamCYcQGCNaenMSxHo1tEABMbdGx2WAU/view?usp=drive_link"
          }
        },
        "b6a6c657-a411-4174-9d50-fab764f06ca0": {
          "type": "logo",
          "settings": {
            "logo": "shopify://shop_images/beveg-04.svg",
            "the_title": "BeVeg CERTIFIED",
            "the_text": "The BeVeg logo means your product has been independently reviewed and certified by BeVeg, a globally recognized third-party vegan certifier. BeVeg is the only vegan certification standard accredited to international quality requirements (ISO 17065), which means an impartial authority has verified that every certified product meets strict vegan criteria — from ingredient sourcing and manufacturing processes to no animal testing and controls against cross-contamination. That gives consumers real transparency and confidence when choosing vegan products.",
            "button": "VEGAN CERTIFICATION",
            "url": ""
          }
        },
        "62b15d22-2d1f-47e2-92e8-2265bc0aaeab": {
          "type": "logo",
          "settings": {
            "logo": "shopify://shop_images/Vegan_Color_no_background_1.png",
            "the_title": "VegeCert Certified",
            "the_text": "VegeCert is a third party certification that assures consumers that what they are purchasing is 100% vegan. Their \"certified vegan\" designation is for products that do not contain any animal or animal by-products including dairy and eggs and no animal testing.",
            "button": "VegeCert Certification",
            "url": "https://drive.google.com/file/d/1U0gt8UhQcOdcy0xMOf1kVIhKMIl2XGWM/view?usp=sharing"
          }
