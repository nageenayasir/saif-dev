{
  "sections": {
    "15b76e3e-f4af-4d0c-a845-28a89e25a6e9": {
      "type": "banner-subpage",
      "settings": {
        "enable_breadcrumb": true,
        "title": "QUALITY AND TESTING",
        "sub_title": "Built on standards. Proven by testing. True wellness starts with trust. <br>\nHere’s how we honor it — through third-party certifications, independent lab testing, and full transparency from source to end product.",
        "image": "shopify://shop_images/Screen_Shot_2022-12-08_at_10.37-optimized.png"
      }
    },
    "main": {
      "type": "impact-reward",
      "settings": {
        "text": "WHAT WE DO, WHY WE DO IT,  WHO WE DO IT WITH",
        "title": "WHAT WE DO, WHY WE DO IT,  WHO WE DO IT WITH",
        "content": "TRIIBE Organics was created with the purpose of enhancing people’s health and lives, and that of course includes the health and life of our planet. \n\nWhen we started the company in 2018 we were already clear that business needed to operate in a way that helped Mother Earth and society. \n<br>\n<br>\nOur wish is to help educate our values to our planet’s future inhabitants and everyone else in conscious ways by providing organic products that are derived sustainably to enhance our mind, body, and inner energies. To help make all the members of TRIIBE enjoy the greatest adventure of all: LIFE.\n<br>\n<br>\nAll of our products come from this planet, it has everything that we need, right here for the taking. But... for that to be sustainable, for that to be true in our old age and for future generations, we have to take care of the planet that takes such good care of us.\n<br><br>\nHuman beings seem to forget sometimes that we are part of an ecosystem and if we destroy it, we are pretty much doomed.",
        "image": "shopify://shop_images/IMPACT_SUSTAINABILITY-optimized.png"
      }
    },
    "a86d4da9-a629-4c57-8233-ac91a42226d0": {
      "type": "ingredient-eclipse-title",
      "settings": {
        "the_title": "TRIIBE has sustainability at the very forefront\nof what we stand for and how we operate."
      }
    },
    "ingredient-background-text": {
      "type": "ingredient-background-text",
      "settings": {
        "show_icon": true,
        "text": "All of our products are derived sustainably and with great respect for the traditional and ancient origins of the practices that inspire us. We are constantly chasing more sustainable methods of manufacturing. \n\nRight now, most of our products are USDA Organic Certified, all are Non-GMO Project Verified and we donate 1% of everything we make (not just profit) to environmental and social causes. \nOh, and we plant trees. \n<br><br>\nWe vote with our wallets. The companies you choose to support should stand for what you believe in and we want to be the very best option, so you can shop for a better life totally guilt free, knowing that good for you is good for the world.",
        "image": "shopify://shop_images/Ellipse_72.png"
      }
    },
