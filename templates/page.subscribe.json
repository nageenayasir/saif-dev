    "373865f1-6234-4c58-a7af-54a7fbab0241": {
      "type": "subscribe-save-faqs",
      "blocks": {
        "template--16783372976351__373865f1-6234-4c58-a7af-54a7fbab0241-faq-1": {
          "type": "faq",
          "settings": {
            "title": "What is a subscription? ",
            "content": "A subscription will ensure that you always have your products arriving at your door at a set frequency.  We know a healthy lifestyle requires some consistency, which is why we created our subscription program. \n \nSubscriptions are easy to manage, and you are never locked in. You are always notified a few days before your order will go through so you can skip, cancel or swap out products anytime!"
          }
        },
        "template--16783372976351__373865f1-6234-4c58-a7af-54a7fbab0241-faq-2": {
          "type": "faq",
          "settings": {
            "title": "How does the subscription option work?",
            "content": "Simply choose the time period in which you would like your products to be shipped – every 30-45-60 days– and you’ll receive a discount up to 20%. Depending on your selection, you will be billed accordingly and your products will be shipped to your door! All subscription orders over $75 ship for free."
          }
        },
        "template--16783372976351__373865f1-6234-4c58-a7af-54a7fbab0241-faq-3": {
          "type": "faq",
          "settings": {
            "title": "How do I cancel my subscription?",
            "content": "Sorry to see you go—we’ll miss you. \n \nYour subscription can be canceled at any time! Just go to your account or by contacting info@tribe-organics.com. \n \nSimply delete any unwanted scheduled orders from your account and you will no longer be billed for future renewals."
          }
        },
        "0c97a6a0-98e7-4119-97e9-3a5562138f9b": {
          "type": "faq",
          "settings": {
            "title": "How do discounts work on subscription orders?",
            "content": "Sorry, coupons cannot be combined with subscription purchases at this time."
          }
        },
        "23a3c54d-2bb9-40a7-be0a-57c69ea0dafe": {
          "type": "faq",
          "settings": {
            "title": "Can I reschedule my next shipment?",
            "content": "Absolutely! Simply navigate to your account and reschedule your upcoming shipment for any date in the future. Once you do, we’ll automatically update any further monthly shipments. If you need any assistance, kindly email us at info@tribe-organics.com and we’ll be happy to assist."
          }
        },
        "e07dd1b5-07e2-4828-9e6f-ea15d864c8da": {
          "type": "faq",
          "settings": {
            "title": "How do I change my shipping address on my subscription?",
            "content": "You can change your address on your account, go to your profile and edit the default address. We will also ask you to please do a test order just so we can see if the address has been changed successfully. All  you need to do is add any item to your cart and proceed with the order until the payment section during checkout.  Then you can exit the website and it will automatically appear on our abandoned checkouts with the order details. Please send us an email so we can confirm it was changed successfully. Thank you :) \n<br><br>\nNote: Updating the shipping address on your account will not update an already processed order. Addresses cannot be modified on orders that have already been processed."
          }
