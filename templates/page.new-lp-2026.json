    "dgf_title_and_text_dCNNmh": {
      "type": "dgf-title-and-text",
      "name": "[DGF] Title and Text",
      "settings": {
        "title": "WHAT “CLINICALLY STUDIED STRESS SUPPORT” ACTUALLY MEANS",
        "text": "<p style=\"text-align: left;\">\n  Stress isn't just \"feeling busy.\"<br>\n  When stress is constant, your body releases cortisol, a hormone meant for short-term survival — not everyday life.</p>\n  <br>\n\n  <p style=\"text-align: left;\">Chronically elevated cortisol is associated with:</p>\n  <ul style=\"text-align: left; padding-left: 20px;\">\n    <li>Feeling constantly on edge</li>\n    <li>Trouble sleeping</li>\n    <li>Mental fatigue</li>\n    <li>Difficulty focusing</li>\n    <li>Emotional reactivity</li>\n  </ul>\n\n <p style=\"text-align: left; margin-bottom: 2rem;\"> KSM-66<sup>®</sup> is studied for its ability to:</p>\n  <ul style=\"text-align: left; padding-left: 20px;\">\n    <li>Support healthy cortisol levels already within the normal range<sup>*</sup>\n</li>\n    <li>Help the body adapt to stress instead of overreacting to it<sup>*</sup>\n</li>\n  </ul>\n\n <p style=\"text-align: left;\"> This is not sedation.<br>\n  <b>This is stress resilience.</b></p>",
        "text_alignment": "center",
        "background_color": "#f3d9cf",
