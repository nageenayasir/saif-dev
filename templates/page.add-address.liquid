<section class="section-banner section-title section-form bg-line-02 customer-account-details">
    <div class="leaf-box right-top">
        <img class="leaf" src="{{ 'leaf-n02.svg' | asset_url }}">
    </div>
    <div class="content">
        <div class="container">
            <h1 class="text-uppercase" data-aos="fade-up">{{ 'customer.addresses.title' | t }}</h1>
            <div class="subtitle" data-aos="fade-up" data-aos-delay="200">
                <ul class="nav nav-tabs">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ routes.account_url }}">Order</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ routes.account_addresses_url }}">Address</a>
                    </li>
<!--                     <li class="nav-item">
                        <a class="nav-link" href="#">Change Password</a>
                    </li> -->
                    <li class="nav-item">
                        <a class="nav-link" href="{{ routes.account_logout_url }}">Logout</a>
                    </li>
                </ul>
            </div>
           {%- form 'customer_address', customer.new_address, aria-labelledBy: 'AddressNewHeading',class : 'form form-big pb-3' -%}
                <div class="text-start mt-5 mb-4">
                    <h5>{{ 'customer.addresses.add_new' | t }}</h5>
                </div>
                <div class="form-group" data-aos="fade-up">
                    <div class="row">
                        <div class="col-md-6">
                            <input class="form-default" type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder="{{ 'customer.addresses.first_name' | t }}">
                        </div>
                        <div class="col-md-6">
                            <input class="form-default" type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder="{{ 'customer.addresses.last_name' | t }}">
                        </div>
                    </div>
                </div>
                <div class="form-group" data-aos="fade-up">
                    <input class="form-default" type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder="{{ 'customer.addresses.company' | t }}">
                </div>
                <div class="form-group" data-aos="fade-up">
                    <input class="form-default" type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="{{ 'customer.addresses.address1' | t }}">
                </div>
                <div class="form-group" data-aos="fade-up">
                    <input class="form-default" type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="{{ 'customer.addresses.address2' | t }}">
                </div>
                <div class="form-group" data-aos="fade-up">
                    <input class="form-default" type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="{{ 'customer.addresses.city' | t }}">
                </div>
                <div class="form-group" data-aos="fade-up">
                    <input class="form-default" type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="{{ 'customer.addresses.zip' | t }}">
                </div>
                <div class="form-group" data-aos="fade-up">
                    <input class="form-default" type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="{{ 'customer.addresses.phone' | t }}">
                </div>
                <div class="form-group" data-aos="fade-up"> 
          
                    <label class="button-checkbox" data-aos="fade-up">{{ form.set_as_default_checkbox }} <span class="checkbox"></span>
                                    <span>{{ 'customer.addresses.set_default' | t }}</span></label>
                </div>
                <div class="form-group last d-flex" data-aos="fade-up">
                    <button type="submit" class="btn btn-bg me-3">{{ 'customer.addresses.add' | t }}</button>
                    <button type="button" class="btn btn-trans" onclick="location.href='{{ routes.account_addresses_url }}'">{{ 'customer.addresses.cancel' | t }}</button>
                </div>
            {% endform %}
        </div>
    </div>
</section>
