{%- comment -%}
  Renders a product card.
  Accepts:
  - product: {Object} Product object
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true
  - show_quick_add: {Boolean} Show quick add button
  - section_id: {String} The ID of the section that contains this card.
{%- endcomment -%}

{%- liquid
  assign lazy_load = lazy_load | default: true
  assign show_quick_add = show_quick_add | default: true
  assign card_product = product
-%}

<div class="card product-card" tabindex="0">
  <div class="card__media">
    <div class="card__media-wrapper">
      <!-- Badges -->
      {%- if card_product.compare_at_price > card_product.price -%}
        <div class="card__badges">
          <span class="badge badge--sale">
            {%- liquid
              assign savings = card_product.compare_at_price | minus: card_product.price
              assign savings_pct = savings | times: 100 | divided_by: card_product.compare_at_price
            -%}
            -{{ savings_pct }}%
          </span>
        </div>
      {%- elsif card_product.tags contains 'New' or card_product.tags contains 'new' -%}
        <div class="card__badges">
          <span class="badge badge--new">New</span>
        </div>
      {%- endif -%}

      <a href="{{ card_product.url }}" tabindex="-1" aria-label="{{ card_product.title | escape }}">
        {%- if card_product.featured_media -%}
          {{
            card_product.featured_media
            | image_url: width: 540
            | image_tag:
              loading: lazy_load | ternary: 'lazy', 'eager',
              widths: '270, 400, 540',
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
              alt: card_product.featured_media.alt | escape
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="card__content">
    {%- if card_product.type != blank -%}
      <span class="card__category">{{ card_product.type }}</span>
    {%- elsif card_product.collections.first -%}
      <span class="card__category">{{ card_product.collections.first.title }}</span>
    {%- endif -%}

    <h3 class="card__title">
      <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
    </h3>

    {%- if card_product.metafields.reviews.rating != blank -%}
      <div class="card__rating" aria-label="{{ card_product.metafields.reviews.rating.value }} out of 5 stars">
        <div class="card__rating-stars">
          {%- assign rating_val = card_product.metafields.reviews.rating.value | times: 1 | round -%}
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 12 12" fill="{% if i <= rating_val %}#f4a224{% else %}#e5e5e5{% endif %}" aria-hidden="true">
              <path d="M6 1l1.39 2.81L10.5 4.3l-2.25 2.19.53 3.09L6 7.97l-2.78 1.61.53-3.09L1.5 4.3l3.11-.48L6 1z"/>
            </svg>
          {%- endfor -%}
        </div>
        {%- if card_product.metafields.reviews.rating_count.value != blank -%}
          <span class="card__rating-count">{{ card_product.metafields.reviews.rating_count.value }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="card__price-wrapper">
      {%- render 'price', product: card_product -%}
    </div>
  </div>

  {%- if show_quick_add -%}
    <div class="card__footer">
      <a href="{{ card_product.url }}" class="button button--secondary button--full-width button--small card__quick-add">
        View product
      </a>
    </div>
  {%- endif -%}
</div>
