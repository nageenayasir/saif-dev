            priceSale.textContent = formatMoney(currentVariant.price);
          }

          // Update add-to-cart button price for one-time purchases
          updateButtonPrice(currentVariant.price);
        }
      } catch (e) {
        __DGF.logError('updateWidgetPrices', e);
      }
    }

    // Update main price blocks when widget changes variant
    function refreshThemePriceBlocks(variantId) {
      try {
        const variantElement = document.querySelector('variant-radios, variant-selects');

        // Get section key
        let sectionKey = null;
        let baseUrl = window.location.pathname;
        if (variantElement) {
          sectionKey = variantElement.dataset.originalSection || variantElement.dataset.section;
          baseUrl = variantElement.dataset.url || baseUrl;
        }
        if (!sectionKey) {
          const sectionRoot = widgetContainer.closest('section[id^="shopify-section-"]');
          if (sectionRoot && sectionRoot.id) {
            sectionKey = sectionRoot.id.replace('shopify-section-', '');
          }
        }
        if (!sectionKey) return;

        // Get effective variant ID
        const idInput = document.querySelector('input[name="id"]');
        const effectiveVariantId = (idInput && idInput.value) ? idInput.value : variantId;
        if (!effectiveVariantId) return;

        fetch(`${baseUrl}?variant=${effectiveVariantId}&section_id=${sectionKey}`)
          .then((response) => response.text())
          .then((responseText) => {
            try {
              const html = new DOMParser().parseFromString(responseText, 'text/html');

              const subsId = `suscribe-price-button-${sectionKey}`;
              const destSubs = document.getElementById(subsId);
              const srcSubs = html.getElementById(subsId);
              if (destSubs && srcSubs) destSubs.innerHTML = srcSubs.innerHTML;

              const oneId = `price-button-${sectionKey}`;
              const destOne = document.getElementById(oneId);
              const srcOne = html.getElementById(oneId);
              if (destOne && srcOne) destOne.innerHTML = srcOne.innerHTML;

              const priceId = `price-${sectionKey}`;
              const destPrice = document.getElementById(priceId);
              const srcPrice = html.getElementById(priceId);
              if (destPrice && srcPrice) destPrice.innerHTML = srcPrice.innerHTML;

              // For Pack variants, prevent extra discount on subscribe price
              const cur = getCurrentVariantFromSystem();
              const isPackVariant = cur && cur.title && cur.title.indexOf('Pack') >= 0;

              if (isPackVariant && destSubs && destOne) {
                destSubs.innerHTML = destOne.innerHTML;
              }
            } catch (e2) {
              __DGF.logError('refreshThemePriceBlocks->parse', e2);
            }
          })
          .catch((e) => { __DGF.logError('refreshThemePriceBlocks->fetch', e); });
      } catch (e) {
        __DGF.logError('refreshThemePriceBlocks', e);
      }
    }


