{%- liquid
  comment
    Define selected index for selling plans based on product handle like original widget
  endcomment
  assign selected_index = 0
  if product.handle == 'ashwagandha-ksm-66'
    if product.selected_or_first_available_variant.title contains '120'
      assign selected_index = 2
    else
      assign selected_index = 2
    endif
  elsif product.handle == 'ashwagandha-vegan'
    assign selected_index = 2
  elsif product.handle == 'amla-complex'
    assign selected_index = 3
  elsif product.handle == 'lions-mane-mushroom'
    assign selected_index = 3
  elsif product.handle == 'mushroom-complex'
    assign selected_index = 3
  elsif product.handle == 'boswellia-complex'
    assign selected_index = 3
  elsif product.handle == 'turmeric-complex'
    assign selected_index = 1
  elsif product.handle == 'organic-moringa'
    assign selected_index = 2
  elsif product.handle == 'organic-shatavari'
    assign selected_index = 3  
  elsif product.handle == 'mushroom-golden-blend'
    assign selected_index = 1
  elsif product.handle contains 'shatavari'
    assign selected_index = 3
  elsif product.handle == 'adrenal-support-duo'
    assign selected_index = 3
  elsif product.handle == 'ashwagandha-ksm-66-powder'
    if product.selected_or_first_available_variant.title contains '90'
      assign selected_index = 3
    else
      assign selected_index = 3
    endif
  elsif product.handle == 'balance-duo'
    assign selected_index = 3
  elsif product.handle == 'nootropic-duo'
    assign selected_index = 3
  elsif product.handle == 'warrior-trio'
    assign selected_index = 2
  elsif product.handle == 'boost-duo'
    assign selected_index = 2
  elsif product.handle == 'resilience-duo'
    assign selected_index = 3
  elsif product.handle == 'recovery-trio'
    assign selected_index = 3
  elsif product.handle == 'endurance-duo'
    assign selected_index = 2
  elsif product.handle == 'functional-duo'
    assign selected_index = 3
  elsif product.handle == 'revitalize-trio'
    assign selected_index = 3
  elsif product.handle == 'new-mom-bundle'
    assign selected_index = 2
  elsif product.handle == 'hormonal-balance-duo'
    assign selected_index = 3
  elsif product.handle == 'immunity-bundle'
    assign selected_index = 2
  elsif product.handle == 'ashwagandha-gummies-kids'
    assign selected_index = 1
  elsif product.handle == 'ashwagandha-ksm-66-gummies'
    assign selected_index = 1
  elsif product.handle == 'testing-loop-ashwagandha-ksm-66'
    assign selected_index = 2
  elsif product.handle == 'lions-mane-mushroom-extract-powder'
  assign selected_index = 3
  elsif product.handle == 'organic-moringa-powder'
  assign selected_index = 3
  elsif product.handle == 'mushroom-golden-blend-powder'
  assign selected_index = 3
  elsif product.handle == 'ashwagandha-ksm-66-powder-version'
  assign selected_index = 3
  endif
-%}

