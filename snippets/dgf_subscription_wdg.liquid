<script>
// Utilitário simples de log
(function(){
  if (!window.__DGF) window.__DGF = {};
  window.__DGF.logError = function(context, err){
    try {
      console.error(`[SubscriptionWidget] ${context}:`, err);
    } catch(_) {}
  };
})();



// Initialize widget when DOM is ready or immediately if already loaded
// Make it global for modal access
window.initializeSubscriptionWidget = function initializeSubscriptionWidget() {
  try {
    const widgetContainer = document.querySelector('.subscription-widget-container');

    if (!widgetContainer) {
      console.warn('Widget container not found');
      return;
    }

    // Prevent double initialization
    if (widgetContainer.dataset.initialized === 'true') {
      console.log('[WIDGET] Already initialized, skipping...');
      return;
    }

    // Mark as initialized
    widgetContainer.dataset.initialized = 'true';
    console.log('[WIDGET] Initializing subscription widget...');

    // Get current variant from the main VariantRadios system
    let currentVariant = null;
    let currentSellingPlan = null;
    
    // Store the 1-pack variant for subscription calculations
    let onePackVariantForSubscription = null;
    
    // Flag to control when to update URL (only for user interactions, not initial load)
    let isInitializing = true;
    
    // URL management functions
    function updateVariantURL(variantId, forceUpdate = false) {
      try {
        if (!variantId) return;

        // Only update URL if not initializing or if explicitly forced
        if (isInitializing && !forceUpdate) return;

        // Don't update URL if we're in a collection page
        if (window.location.pathname.includes('/collections/')) {
          console.log('[WIDGET] Skipping URL update for collection page');
          return;
        }

        const url = new URL(window.location);
        url.searchParams.set('variant', variantId);

        // Use replaceState to avoid adding entries to browser history
        window.history.replaceState({}, '', url.toString());
      } catch (e) {
        __DGF.logError('updateVariantURL', e);
      }
    }
    
    function getVariantFromURL() {
      try {
        const params = new URLSearchParams(window.location.search);
        return params.get('variant');
      } catch (e) {
        __DGF.logError('getVariantFromURL', e);
        return null;
      }
    }
    
    function removeVariantFromURL() {
      try {
        const url = new URL(window.location);
        url.searchParams.delete('variant');
        window.history.replaceState({}, '', url.toString());
      } catch (e) {
        __DGF.logError('removeVariantFromURL', e);
      }
    }
    
    function initializeVariantFromURL() {
      try {
        const urlVariantId = getVariantFromURL();
        if (!urlVariantId) return false;
        
        // Find the variant data from scripts
