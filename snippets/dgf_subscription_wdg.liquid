        const priceOriginal = widgetContainer.querySelector('.widget-price-original');
        const priceSale = widgetContainer.querySelector('.widget-price-sale');

        if (!priceOriginal || !priceSale) {
          return;
        }

        if (activeTab === 'subscribe') {
          // Subscribe & Save pricing - get discount from selling plan + 5% coupon if checked
          const couponRadio = document.getElementById('coupanMineCode');
          const isCouponChecked = couponRadio && couponRadio.checked;
          
          // Get discount multiplier from selling plan
          const planId = getCurrentSellingPlanId();
          const baseDiscountMultiplier = getSellingPlanDiscount(planId);
          
          let subscriptionPrice;
          if (isCouponChecked) {
            // Apply selling plan discount + 5% additional coupon discount
            const totalDiscountMultiplier = baseDiscountMultiplier * 0.95;
            // For products without 90/120 capsule variants, always use 1-pack variant price for subscription
            const variantForPricing = onePackVariantForSubscription || getOnePackVariantForSubscription() || currentVariant;
            subscriptionPrice = Math.round(variantForPricing.price * totalDiscountMultiplier);
          } else {
            // Apply only selling plan discount
            // For products without 90/120 capsule variants, always use 1-pack variant price for subscription
            const variantForPricing = onePackVariantForSubscription || getOnePackVariantForSubscription() || currentVariant;
            subscriptionPrice = Math.round(variantForPricing.price * baseDiscountMultiplier);
          }
          
          // For subscription tab, show compare_at_price if available, otherwise show regular price
          if (currentVariant.compare_at_price && currentVariant.compare_at_price > subscriptionPrice) {
            priceOriginal.style.display = 'block';
            priceOriginal.textContent = formatMoney(currentVariant.compare_at_price);
          } else if (currentVariant.price > subscriptionPrice) {
            priceOriginal.style.display = 'block';
            priceOriginal.textContent = formatMoney(currentVariant.price);
          } else {
            priceOriginal.style.display = 'none';
          }
          priceSale.textContent = formatMoney(subscriptionPrice); // Show discounted price
          
          // Update add-to-cart button price to reflect subscription discount
          updateButtonPrice(subscriptionPrice);
        } else {
          // One-time purchase pricing - prioritize compare_at_price over calculated prices
          if (currentVariant.compare_at_price && currentVariant.compare_at_price > currentVariant.price) {
            // Always show compare_at_price when available and higher than current price
            priceOriginal.style.display = 'block';
            priceOriginal.textContent = formatMoney(currentVariant.compare_at_price);
            priceSale.textContent = formatMoney(currentVariant.price);
          } else if (currentVariant.title.indexOf('Pack') >= 0) {
            // Fallback to calculated pack pricing if no compare_at_price
            let originalPrice = currentVariant.price;

            // Calculate original price based on pack type - matching global.js logic
            if (currentVariant.title.indexOf('3-Pack') >= 0) {
              originalPrice = Math.round(originalPrice / 0.85); // Reverse the 15% discount to get original
            } else if (currentVariant.title.indexOf('4-Pack') >= 0) {
              originalPrice = Math.round(originalPrice / 0.88); // Reverse the 12% discount to get original
            } else if (currentVariant.title.indexOf('6-Pack') >= 0) {
              originalPrice = Math.round(originalPrice / 0.8); // Reverse the 20% discount to get original
            }

            // Only show original price if it's greater than current price
