<script>
  $(document).ready(function () {
    
    
    $(document).on('click', '.pdp-widget', function (e) {
      if (e.target == this) {
        if (!$(this).hasClass('pdp-widget--active')) {
          $('.pdp-widget--active').removeClass('pdp-widget--active');
          $(this).addClass('pdp-widget--active');
          if ($('.pdp-widget--subscription').hasClass('pdp-widget--active')) {
            $('.selling-plan-id').val($('.widget-body__select').val());
            $('.pdp-widget--onetime .col-6:nth-child(1) label').trigger('click');
            $('.coupanCodeMine').removeClass('hide');
          }
          else {
            $('.coupanCodeMine').addClass('hide');
            const couponRadio = document.getElementById('coupanMineCode');
            if (couponRadio && couponRadio.checked) {
              couponRadio.checked = false;
              
              // Remove cupom da sessão Rebuy quando aba é trocada
              $('input[name="properties[coupon]"]').remove();
              if (window.Rebuy && window.Rebuy.Cart && typeof window.Rebuy.Cart.removeShopifyDiscount === 'function') {
                window.Rebuy.Cart.removeShopifyDiscount('FIRSTTIMESUB5');
              }
            }
            $('.selling-plan-id').val('');
            $('.pdp-widget--onetime .col-6:nth-child(2) label').trigger('click');
          }
        }
      }
    });
    $(document).on('change', '.widget-body__select', function () {
      $('.selling-plan-id').val($(this).val());
    });

    $('body').on('click', '.subscriptionData', function(){
      var value = $(this).attr('value');
      $('.subscriptionData').removeClass('selected');
      $(this).addClass('selected');
      $('select[name="selling_plan_id"]').val(value).change();
    });
    
    $('.pdp-widget--onetime .col-6:nth-child(1) label').trigger('click');
    $('.pdp-widget--active').removeClass('pdp-widget--active');
    $('.pdp-widget--subscription').addClass('pdp-widget--active');

    $('.selling-plan-id').val($('.widget-body__select').val());

    $('body').on('change', 'input[name="coupanMine"]', function(e){
      e.preventDefault();
      if($(this).prop('checked') == true){
        setTimeout(function(){
          var a = $('button .subscribe-price-wrap').html();
          a = a.split('|')[1];
          $('.pdp-widget--subscription .widget-head__price--sale').html(a);
        }, 500);
        $('label[for="coupanMineCode"] span').html('5% coupon applied at checkout. For Subscribe & Save orders only');
        $('form[action="/cart/add"]').prepend('<input type="hidden" name="properties[coupon]" value="true" />');
        window.Rebuy.Cart.applyShopifyDiscount('FIRSTTIMESUB5');
      } else {
        // Remove cupom quando desmarcado
        $('input[name="properties[coupon]"]').remove();
        $('label[for="coupanMineCode"] span').html('Save an extra 5% on your first Subscribe and Save order.');
        
        // Remove cupom da sessão Rebuy
        if (window.Rebuy && window.Rebuy.Cart && typeof window.Rebuy.Cart.removeShopifyDiscount === 'function') {
          window.Rebuy.Cart.removeShopifyDiscount('FIRSTTIMESUB5');
        }
      }
    });

    // Função para aguardar elemento estar disponível
    function waitForElement(elementId, timeout = 10000) {
      return new Promise((resolve, reject) => {
        const element = document.getElementById(elementId);
        if (element) {
          resolve(element);
          return;
        }
        
        const startTime = Date.now();
        const checkInterval = setInterval(() => {
          const element = document.getElementById(elementId);
          if (element) {
            clearInterval(checkInterval);
            resolve(element);
          } else if (Date.now() - startTime >= timeout) {
            clearInterval(checkInterval);
            reject(new Error('Element ' + elementId + ' not found after ' + timeout + 'ms'));
          }
        }, 100);
      });
    }

    // Função para aguardar Rebuy.Cart estar disponível
    function waitForRebuyCart(timeout = 10000) {
      return new Promise((resolve, reject) => {
        if (window.Rebuy && window.Rebuy.Cart && typeof window.Rebuy.Cart.removeShopifyDiscount === 'function') {
          resolve(window.Rebuy.Cart);
          return;
        }
        
        const startTime = Date.now();
        const checkInterval = setInterval(() => {
          if (window.Rebuy && window.Rebuy.Cart && typeof window.Rebuy.Cart.removeShopifyDiscount === 'function') {
            clearInterval(checkInterval);
            resolve(window.Rebuy.Cart);
          } else if (Date.now() - startTime >= timeout) {
            clearInterval(checkInterval);
            reject(new Error('Rebuy.Cart not available after ' + timeout + 'ms'));
          }
        }, 100);
      });
    }
    
    // Verificar estado do cupom ao carregar a página
    async function checkCouponOnLoad() {
      try {
        const couponRadio = await waitForElement('coupanMineCode');
        
        if (!couponRadio.checked) {
          try {
            await waitForRebuyCart();
            window.Rebuy.Cart.removeShopifyDiscount('FIRSTTIMESUB5');
          } catch(rebuyError) {
            // Rebuy não disponível
          }
          
          // Garantir que elementos relacionados estejam limpos
          try {
            $('input[name="properties[coupon]"]').remove();
            $('label[for="coupanMineCode"] span').html('Save an extra 5% on your first Subscribe and Save order.');
          } catch (e) {
            // Erro na limpeza
          }
        }
      } catch(elementError) {
        // Elemento não encontrado
      }
    }
    
    setTimeout(() => checkCouponOnLoad(), 500);

    // $('.recommendedPro').insertAfter('.subscriptionRadioMine .nonRecommended:nth-child(1)');
    //setInterval(function(){
      //$('.sezzle-shopify-info-button').parents('.shopify-app-block').insertAfter('.pdp-widget--onetime .pdp-widget__head');
    //}, 500);
  });
</script>