{% assign discount = 0 %}
{% assign discount_percentage = 0 %}
{% for selling_plan_group in product.selling_plan_groups %}
  {% for plan in selling_plan_group.selling_plans %}
    {% assign discount = 100 | minus: plan.price_adjustments[0].value | divided_by: 100.0 %}
    {% assign discount_percentage = plan.price_adjustments[0].value %}
    {% break %}
  {% endfor %}
{% endfor %}

<variant-radios class="no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}" {{ block.shopify_attributes }}>
  {% if product.options_with_values.size > 1 %}
    <fieldset class="js product-form__input">
      {% assign current_variant = product.selected_or_first_available_variant %}
      {% assign option = product.options_with_values[0] %}
      {%- for value in option.values -%}
        {% if value != 'Default Title' %}
            <div class="col-6 col-sm-4 mt-3">
                <label class="button-radio" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" id="label-{{ value | escape }}">
                    <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          name="{{ option.name }}"
                          value="{{ value | escape }}"
                          form="{{ product_form_id }}"
                          {% if option.selected_value == value %}checked{% endif %}
                    >
                    <span class="radio-bg"><span class="varaint-wrap">{{ value }}</span></span>
                </label>
            </div>
        {% endif %}
      {%- endfor -%}
    </fieldset>
  {% endif %}
  {% if product.handle == "ashwagandha-ksm-66" or product.handle == "testing-loop-ashwagandha-ksm-66" %}
  <div class="product-custom-text">
           <p>Choose Your Price</p>
  </div>
  {% endif %}
  <div class="coupanCodeMine">
    <div class="coupanTitle">
      <svg width="87px" height="33px" viewBox="0 0 87 33" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
        <title>Rectangle</title>
        <g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
        <path d="M85.8632788,0.75 L79.1235707,16.5 L85.8632788,32.25 L0.75,32.25 L0.75,0.75 L85.8632788,0.75 Z" id="Rectangle" stroke="#000000" stroke-width="1.5" fill="#7E4047"></path>
        </g>
      </svg>
      <p>COUPON</p>
    </div>
    <div class="couponSelection">
      <input type="radio" name="coupanMine" value="FIRSTTIMESUB5" id="coupanMineCode" />
      <label for="coupanMineCode">
        <span>Save an extra 5% on your first Subscribe and Save order.</span>
      </label>
