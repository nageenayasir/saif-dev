    // Price protection observer to prevent theme from overriding widget prices
    function initializePriceProtection() {
      try {
        const priceElements = document.querySelectorAll('#suscribe-price-button-{{ section.id }}, #price-button-{{ section.id }}, .add-to-cart-block .subscribe-price-wrap, .add-to-cart-block .one-time-price-wrap');
        
        priceElements.forEach(element => {
          if (element && window.MutationObserver) {
            const observer = new MutationObserver(mutations => {
              mutations.forEach(mutation => {
                if (mutation.type === 'childList' || mutation.type === 'characterData') {
                  // Always protect onetime price since we only have onetime tab now
                  if (window.lastWidgetPrice && element.hasAttribute('data-custom-price')) {
                    const currentText = element.textContent || element.innerText;
                    const expectedText = '| ' + window.lastWidgetPrice;
                    const originalPrice = element.getAttribute('data-onetime-price');
                    
                    // If the text doesn't match our widget price, restore it immediately
                    if (currentText !== expectedText) {
                      element.textContent = expectedText;
                      
                      // Clear any selling plan that might be interfering
                      const sellingPlanInputs = document.querySelectorAll('input[name="selling_plan"], select[name="selling_plan"]');
                      sellingPlanInputs.forEach(input => input.value = '');
                    }
                  }
                }
              });
            });
            
            observer.observe(element, {
              childList: true,
              subtree: true,
              characterData: true
            });
          }
        });
      } catch (e) {null;
      }
    }


