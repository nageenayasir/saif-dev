    }
    
    // Add repositioning class and move to placeholder
    sezzleWidget.classList.add('sezzle-repositioned');
    
    // Clear any existing inline styles that might hide it
    sezzleWidget.style.cssText = '';
    
    // Remove any inline font-size styles from Sezzle child elements
    const sezzleElements = sezzleWidget.querySelectorAll('*');
    sezzleElements.forEach(el => {
      if (el.style.fontSize) {
        el.style.fontSize = '';
      }
      if (el.style.lineHeight) {
        el.style.lineHeight = '';
      }
    });
    
    // Move the Sezzle widget into the placeholder
    placeholder.appendChild(sezzleWidget);
    
    // Remove any other Sezzle widgets
    allSezzleWidgets.forEach((widget, index) => {
      if (index > 0) {
        widget.remove();
      }
    });
    
    return true;
  } catch (e) {
    return false;
  }
}

// Fallback vanilla JS version
function moveSezzleVanilla() {
  try {
    const paymentTermsContent = document.querySelector('.payment-terms-content');
    if (!paymentTermsContent) return false;
    
    // Check if already moved
    if (paymentTermsContent.querySelector('.sezzle-shopify-info-button')) {
      return true;
    }
    
    // Find all Sezzle elements
    const allSezzleElements = document.querySelectorAll('.sezzle-shopify-info-button');
    if (allSezzleElements.length === 0) {
      return false;
    }
    
    // Find visible one or first one
    let sezzleElement = null;
    for (let element of allSezzleElements) {
      if (element.style.display !== 'none' && element.offsetParent !== null) {
        sezzleElement = element;
        break;
      }
    }
    
    if (!sezzleElement) {
      sezzleElement = allSezzleElements[0];
    }
    
    // Remove duplicates (keep only the one we're moving)
    allSezzleElements.forEach(element => {
      if (element !== sezzleElement) {
        element.remove();
      }
    });
    
    
    // Make sure the one we're keeping is visible
    sezzleElement.style.display = '';
    
    // Create wrapper
    const wrapper = document.createElement('div');
    wrapper.className = 'sezzle-moved-wrapper';
    wrapper.style.marginTop = '8px';
    
    // Move original element
    wrapper.appendChild(sezzleElement);
    paymentTermsContent.appendChild(wrapper);
    
    return true;
  } catch (e) {
    return false;
  }
}

// Global flag to prevent multiple simultaneous attempts
let sezzleMoveInProgress = false;

// Try to move Sezzle multiple times as it loads asynchronously
function attemptSezzleMove() {
  if (sezzleMoveInProgress) {
    return;
  }
  
  sezzleMoveInProgress = true;
  
  if (moveSezzleToPaymentTerms()) {
    sezzleMoveInProgress = false;
    return; // Exit if successful
  }
  
  // Keep trying for up to 10 seconds
  let attempts = 0;
  const maxAttempts = 20;
  
  const interval = setInterval(() => {
    attempts++;
    
    if (moveSezzleToPaymentTerms() || attempts >= maxAttempts) {
      clearInterval(interval);
      sezzleMoveInProgress = false;
    }
  }, 500);
}

// Start attempting to reposition Sezzle when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', throttledRepositionSezzle);
} else {
  throttledRepositionSezzle();
}

// Additional attempt after a delay to catch late-loading Sezzle widgets
setTimeout(() => {
  const sezzleWidgets = document.querySelectorAll('.sezzle-shopify-info-button');
  if (sezzleWidgets.length > 0) {
    throttledRepositionSezzle();
  }
}, 2000);

// Function to ensure Sezzle is properly repositioned
function ensureSezzleLocation() {
  const paymentTermsContent = document.querySelector('.payment-terms-content');
  if (!paymentTermsContent) return false;
  
  // Check if we already have a repositioned Sezzle in the placeholder
  const placeholder = paymentTermsContent.querySelector('.sezzle-placeholder');
  const repositionedSezzle = placeholder ? placeholder.querySelector('.sezzle-repositioned') : null;
  
  if (repositionedSezzle) {
    
    // Clean up inline styles from repositioned Sezzle
    const sezzleElements = repositionedSezzle.querySelectorAll('*');
    sezzleElements.forEach(el => {
      if (el.style.fontSize) {
        el.style.fontSize = '';
      }
      if (el.style.lineHeight) {
        el.style.lineHeight = '';
      }
    });
    
    // Clean up any other Sezzle elements that aren't repositioned
    const otherSezzleElements = document.querySelectorAll('.sezzle-shopify-info-button:not(.sezzle-repositioned)');
    let removed = 0;
    otherSezzleElements.forEach(element => {
      element.remove();
      removed++;
    });
    
    if (removed > 0) {
    }
    
    return true;
  }
  
  // If no repositioned Sezzle, create one
  return repositionSezzle();
}

// Throttle function to prevent excessive calls
let lastRepositionTime = 0;
function throttledRepositionSezzle() {
  const now = Date.now();
  if (now - lastRepositionTime < 200) {
    return;
  }
  lastRepositionTime = now;
  
  // Execute immediately since we're not moving DOM elements
  ensureSezzleLocation();
}

// Listen for variant changes to ensure Sezzle location
document.addEventListener('variant:change', function() {
  // Immediate execution - no DOM movement, just repositioning
  throttledRepositionSezzle();
});

// Also listen for form changes (backup method)
const productForm = document.querySelector('product-form form, form[action*="/cart/add"]');
if (productForm) {
  productForm.addEventListener('change', function() {
    throttledRepositionSezzle();
  });
}

// Listen for variant radios changes
document.addEventListener('change', function(e) {
  if (e.target.matches('input[name*="options"], input[name="id"], select[name*="options"], select[name="id"]')) {
    throttledRepositionSezzle();
  }
});

// Listen for widget variant changes specifically
document.addEventListener('change', function(e) {
  if (e.target.matches('.variant-option-input')) {
    throttledRepositionSezzle();
  }
});

// Optimized observer for Sezzle detection (CSS does the hiding)
const sezzleObserver = new MutationObserver((mutations) => {
  let foundNewSezzle = false;
  
  mutations.forEach((mutation) => {
    if (mutation.type === 'childList') {
      mutation.addedNodes.forEach((node) => {
        if (node.nodeType === Node.ELEMENT_NODE) {
          // Skip our own wrapper elements
          if (node.classList && node.classList.contains('sezzle-moved-wrapper')) {
            return;
          }
          
          // Check if this node contains a Sezzle widget (CSS already hides it)
          if ((node.classList && node.classList.contains('sezzle-shopify-info-button')) || 
              (node.querySelector && node.querySelector('.sezzle-shopify-info-button'))) {
            foundNewSezzle = true;
          }
        }
      });
    }
  });
  
  if (foundNewSezzle) {
    // Immediate execution since CSS already hides it
    throttledRepositionSezzle();
  }
});

// Função para aplicar o estilo
function aplicarEstilo() {
    return new Promise((resolve, reject) => {
        try {
            const seletores = [
                '.sezzle-button-text.sezzle-left.szl-light',
                '.sezzle-payment-amount.sezzle-button-text.sezzleindex-1'
            ];
            
            let elementosEncontrados = 0;
            
            seletores.forEach(seletor => {
                const elementos = document.querySelectorAll(seletor);
                elementos.forEach(elemento => {
                    // Remove inline font-size instead of setting it
                    if (elemento.style.fontSize) {
                        elemento.style.fontSize = '';
                    }
                    elementosEncontrados++;
                });
            });
            
            elementosEncontrados > 0 ? resolve() : reject();
        } catch (e) {
            null;
        }
    });
}

// Função para aguardar elementos
function aguardarElemento(timeout = 10000) {
    return new Promise((resolve, reject) => {
        try {
            const seletores = [
                '.sezzle-button-text.sezzle-left.szl-light',
                '.sezzle-payment-amount.sezzle-button-text.sezzleindex-1'
            ];
            
            for (const seletor of seletores) {
                if (document.querySelector(seletor)) {
                    resolve();
                    return;
                }
            }

            const observer = new MutationObserver(() => {
                try {
                    for (const seletor of seletores) {
                        if (document.querySelector(seletor)) {
                            observer.disconnect();
                            clearTimeout(timeoutId);
                            resolve();
                            return;
                        }
                    }
                } catch (e) {
                    null;
                }
            });

            const timeoutId = setTimeout(() => {
                observer.disconnect();
                reject();
            }, timeout);

            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
        } catch (e) {
            null;
        }
    });
}

// Função principal
async function inicializarSezzleStyle() {
    try {
        await aplicarEstilo();
    } catch {
        await aguardarElemento();
        await aplicarEstilo();
    }

    // Monitor contínuo
    const observer = new MutationObserver(async () => {
        try {
            await aplicarEstilo();
        } catch {}
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['class', 'style']
    });

    // Para após 30 segundos
    setTimeout(() => observer.disconnect(), 30000);
}

// Execução
(async () => {
    if (document.readyState === 'loading') {
        await new Promise(resolve => {
            document.addEventListener('DOMContentLoaded', resolve);
        });
    }
    await inicializarSezzleStyle();
})();
