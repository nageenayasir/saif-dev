    .subscription-benefits-image {
      display: none;
    }

    .subscription-benefits-image-mobile {
      display: block;
    }

    .learn-more-modal-close {
      right: -14px;
      top: -7px;
    }
  }

</style>


<div class="subscription-widget-container">
  <!-- Seção de Seleção de Variantes -->
  {% if product.options_with_values.size > 1 %}
  <div class="widget-variant-selection">
    {% assign option = product.options_with_values[0] %}
    <div class="variant-options-grid">
      {%- for value in option.values -%}
        {% if value != 'Default Title' %}
          <div class="variant-option col-6 col-lg-4 col-sm-4">
            <input type="radio" 
                   id="widget-variant-{{ forloop.index0 }}"
                   name="widget-variant-{{ option.name }}"
                   value="{{ value | escape }}"
                   data-variant-value="{{ value | escape }}"
                   {% if option.selected_value == value %}checked{% endif %}
                   class="variant-option-input">
            <label for="widget-variant-{{ forloop.index0 }}" class="variant-option-label">
              <span class="variant-option-text">{{ value }}</span>
            </label>
          </div>
        {% endif %}
      {%- endfor -%}
    </div>
  </div>
  {% endif %}

  <!-- Seção de Preço -->
  <div class="widget-price-section" id="dgf-widget-price-section">
    <div class="widget-price-display">
      <span class="widget-price-original">{{ product.selected_or_first_available_variant.price | money }}</span>
      <span class="widget-price-sale">{{ product.selected_or_first_available_variant.price | money }}</span>
    </div>
  </div>


  <!-- Widget Content -->
  <div class="widget-tabs-container">
    <!-- One-Time Purchase Content -->
    <div class="widget-tab-content active" data-content="onetime">
      
      <!-- Purchase Type Header -->
      <div class="widget-purchase-header">
        <span class="widget-tab-radio"></span>
        <span class="widget-tab-label">One-Time Purchase</span>
      </div>
      
      <!-- Payment Terms (ShopPay, etc.) -->
      <div class="widget-payment-terms">
        <div class="payment-option">
          <div class="widget-feature-icon">
            <img src="https://cdn.shopify.com/s/files/1/0499/0425/5134/files/subs-icon-li.webp?v=1754636635" alt="Feature icon" width="14" height="14">
          </div>
          <div class="payment-terms-content">
            {%- assign product_form_installment_id = 'product-form-installment-dgf-' | append: section.id -%}
            {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              {{ form | payment_terms }}
            {%- endform -%}
          </div>
        </div>
      </div>

      {% if product.options_with_values.size > 1 %}
      <div class="widget-selection-grid">
        {% assign option = product.options_with_values[0] %}
        {% if product.options_with_values.size > 1 %}
          {% assign option = product.options_with_values[1] %}
        {% endif %}
        {%- for value in option.values -%}
          {% if value != 'Default Title' %}
            <div class="widget-selection-option {% if option.selected_value == value %}selected{% endif %}" data-variant-value="{{ value | escape }}">
              <span class="widget-selection-radio"></span>
              {% if value contains '3-Pack' %}
                <span class="widget-selection-badge">Save 10%</span>
              {% elsif value == '4-Pack' %}
                <span class="widget-selection-badge">Save 12%</span>
              {% elsif value == '6-Pack' %}
                <span class="widget-selection-badge">Save 15%</span>
              {% endif %}
              <div class="widget-selection-title">{{ value }}</div>
              <div class="widget-selection-subtitle" data-variant-value="{{ value | escape }}">
                <!-- Dynamic pricing will be populated by JavaScript -->
              </div>
            </div>
          {% endif %}
        {%- endfor -%}
      </div>
      {% endif %}

             <ul class="widget-features">
         <li class="widget-feature">
           <div class="widget-feature-icon">
             <img src="https://cdn.shopify.com/s/files/1/0499/0425/5134/files/subs-icon-li.webp?v=1754636635" alt="Feature icon" width="14" height="14">
           </div>
           30 Day Moneyback Guarantee
         </li>
       </ul>
    </div>
  </div>
</div>


<script>
// Utilitário simples de log
(function(){
  if (!window.__DGF) window.__DGF = {};
  window.__DGF.logError = function(context, err){
    try {
      console.error(`[SubscriptionWidget] ${context}:`, err);
    } catch(_) {}
  };
})();



// Initialize widget when DOM is ready or immediately if already loaded
function initializeSubscriptionWidget() {
  try {
    
    const widgetContainer = document.querySelector('.subscription-widget-container');
    
    if (!widgetContainer) {
      console.warn('Widget container not found');
      return;
    }

    // Get current variant from the main VariantRadios system
    let currentVariant = null;
    let currentSellingPlan = null;
    
    // Function to get current variant from multiple sources
    function getCurrentVariantFromSystem() {
      try {
        let foundVariant = null;
        
        // Method 1: Try VariantRadios system
        const variantRadios = document.querySelector('variant-radios');
        if (variantRadios && variantRadios.currentVariant) {
          foundVariant = variantRadios.currentVariant;
          return foundVariant;
        }
        
        // Method 1.5: Try VariantSelects system
        const variantSelects = document.querySelector('variant-selects');
        if (variantSelects && variantSelects.currentVariant) {
          foundVariant = variantSelects.currentVariant;
          return foundVariant;
        }
        
        // Method 2: Get from form input with variant data
        const selectedVariantInput = document.querySelector('input[name="id"]');
        if (selectedVariantInput && selectedVariantInput.value) {
          const variantId = parseInt(selectedVariantInput.value);
          
          // Try multiple script sources
          const scripts = document.querySelectorAll('script[type="application/json"]');
          for (let script of scripts) {
            try {
              const data = JSON.parse(script.textContent);
              let variants = [];
              
              if (Array.isArray(data)) {
                variants = data;
              } else if (data.variants && Array.isArray(data.variants)) {
                variants = data.variants;
              }
              
              if (variants.length > 0) {
                const variant = variants.find(v => v.id == variantId);
                if (variant) {
                  return variant;
                }
              }
            } catch (_) {
              // Continue to next script
            }
          }
        }
        
        // Method 3: Try to get from URL params
        const urlParams = new URLSearchParams(window.location.search);
        const variantParam = urlParams.get('variant');
        if (variantParam) {
          const scripts = document.querySelectorAll('script[type="application/json"]');
          for (let script of scripts) {
            try {
              const data = JSON.parse(script.textContent);
              let variants = Array.isArray(data) ? data : (data.variants || []);
              const variant = variants.find(v => v.id == variantParam);
              if (variant) {
                return variant;
              }
            } catch (_) {
              // Continue
            }
          }
        }
        
        // Method 4: Get first available variant as fallback
        const scripts = document.querySelectorAll('script[type="application/json"]');
        for (let script of scripts) {
          try {
            const data = JSON.parse(script.textContent);
            let variants = Array.isArray(data) ? data : (data.variants || []);
            if (variants.length > 0 && variants[0].available) {
              return variants[0];
            }
          } catch (_) {
            // Continue
          }
        }
        
        
        // Last resort: try to reconstruct variant from form input
        const variantInput = document.querySelector('input[name="id"]');
        if (variantInput && variantInput.value) {
          const variantId = parseInt(variantInput.value);
          
          // Search through scripts for variant data
          const scripts = document.querySelectorAll('script[type="application/json"]');
          for (let script of scripts) {
            try {
              const data = JSON.parse(script.textContent);
              let variants = Array.isArray(data) ? data : (data.variants || []);
              const variant = variants.find(v => v.id == variantId);
              if (variant) {
                return variant;
              }
            } catch (_) {
              continue;
            }
          }
        }
        
        return null;
      } catch (e) {null;
        return null;
      }
    }

    // Initialize current variant with retry mechanism
    function initializeCurrentVariant() {
      try {
        currentVariant = getCurrentVariantFromSystem();
        
        if (!currentVariant) {
          setTimeout(() => {
            try {
              currentVariant = getCurrentVariantFromSystem();
              if (currentVariant) {
                initializeWidget();
                refreshThemePriceBlocks(currentVariant.id);
              } else {
                setTimeout(() => {
                  try {
                    currentVariant = getCurrentVariantFromSystem();
                    if (currentVariant) {
                      initializeWidget();
                      refreshThemePriceBlocks(currentVariant.id);
                    }
                  } catch (e3) {null;
                  }
                }, 500);
              }
            } catch (e2) {null;
            }
          }, 200);
        } else {
          initializeWidget();
          refreshThemePriceBlocks(currentVariant.id);
        }
      } catch (e) {null;
      }
    }
    
    initializeCurrentVariant();


    // Get the VariantSelects element to use its toggleAddButton method
    function getVariantElement() {
      try {
        return document.querySelector('variant-radios') || document.querySelector('variant-selects');
      } catch (e) {null;
        return null;
      }
    }

    // Disable add to cart button using the same method as global.js
    function disableAddToCartButton() {
      try {
        const variantElement = getVariantElement();
        
        if (variantElement && typeof variantElement.toggleAddButton === 'function') {
          variantElement.toggleAddButton(true, '', false);
        } else {
          // Fallback: direct button manipulation
          const addToCartButton = document.querySelector('.subscription-addtocartMine');
          if (addToCartButton) {
            addToCartButton.setAttribute('disabled', 'disabled');
            addToCartButton.style.opacity = '0.6';
            addToCartButton.style.cursor = 'not-allowed';
          }
        }
      } catch (e) {null;
      }
    }

    // Enable add to cart button using the same method as global.js
    function enableAddToCartButton() {
      try {
        const variantElement = getVariantElement();
        
        if (variantElement && typeof variantElement.toggleAddButton === 'function') {
          variantElement.toggleAddButton(false, '', false);
        } else {
          // Fallback: direct button manipulation
          const addToCartButton = document.querySelector('.subscription-addtocartMine');
          if (addToCartButton) {
            addToCartButton.removeAttribute('disabled');
            addToCartButton.style.opacity = '1';
            addToCartButton.style.cursor = 'pointer';
          }
        }
      } catch (e) {null;
      }
    }

    // Listen for variant changes from the main VariantRadios/VariantSelects system
    document.addEventListener('change', function(e) {
      try {
        // Check if the change is from a variant input or select
        if (e.target.matches('variant-radios input[type="radio"]') || 
            e.target.matches('variant-selects select') ||
            e.target.matches('input[name="id"]') ||
            e.target.closest('variant-radios') ||
            e.target.closest('variant-selects')) {
          
          // Disable add to cart button immediately during variant change
          disableAddToCartButton();
          
          // Small delay to ensure the VariantSelects has updated currentVariant
          setTimeout(() => {
            try {
              // Update current variant
              currentVariant = getCurrentVariantFromSystem();
              
              if (currentVariant) {
                // If Subscribe & Save tab is active, force 1-Pack
                // No tab switching logic needed since we only have onetime
                
                updateWidgetPrices();
                updateOnetimeOptions();
                syncWidgetVariants();
                refreshThemePriceBlocks(currentVariant.id);
                
                // Re-enable add to cart button after updates
                setTimeout(() => {
                  try { enableAddToCartButton(); } catch(e){null;}
                }, 100);
              } else {
                // Re-enable button even if we couldn't get variant
                setTimeout(() => {
                  try { enableAddToCartButton(); } catch(e){null;}
                }, 100);
              }
            } catch (e1) {null;
              // tentar reabilitar
              try { enableAddToCartButton(); } catch(_) {}
            }
          }, 50);
        }
      } catch (e) {null;
        try { enableAddToCartButton(); } catch(_) {}
      }
    });


    // Also listen for custom variant-changed event (fallback)
    window.addEventListener('variant-changed', function(e) {
      try {
        currentVariant = e.detail.variant;
        if (currentVariant) {
          // If Subscribe & Save tab is active, force 1-Pack
          // No tab switching logic needed since we only have onetime
          
          updateWidgetPrices();
          updateOnetimeOptions();
          syncWidgetVariants();
          refreshThemePriceBlocks(currentVariant.id);
        }
      } catch (err) {null;
      }
    });

    // Listen for widget's own variant option changes
    try {
      const variantOptions = widgetContainer.querySelectorAll('.variant-option-input');
      variantOptions.forEach(option => {
        try {
          option.addEventListener('change', function() {
            try {
              if (this.checked) {
                updateMainVariantSystem(this.value);
              }
            } catch (err) {null;
            }
          });
        } catch (err) {null;
        }
      });
    } catch (e) {null;
    }

    // No tab switching needed since we only have one tab

    // Selection option handler - works for both subscribe and one-time options
    const selectionOptions = widgetContainer.querySelectorAll('.widget-selection-option');
    
    selectionOptions.forEach(option => {
      try {
        option.addEventListener('click', function() {
          try {
            // Disable add to cart button during option change
            disableAddToCartButton();
            
            // Find parent tab content
            const parentContent = this.closest('.widget-tab-content');
            const isSubscribe = parentContent.dataset.content === 'subscribe';
            
            // Clear selection in same group
            parentContent.querySelectorAll('.widget-selection-option').forEach(opt => {
              opt.classList.remove('selected');
            });
            
            // Add selected class
            this.classList.add('selected');
            
            // Handle different actions based on tab
            if (isSubscribe) {
              const planId = this.dataset.sellingPlan;
              updateSellingPlan(planId);
              // Re-enable button after subscription selection
              setTimeout(() => {
                try { enableAddToCartButton(); } catch(e){null;}
              }, 100);
            } else {
              // For one-time purchases, update variant in the main system
              const variantValue = this.dataset.variantValue;
              if (variantValue) {
                // Update main variant system using standard pattern
                updateMainVariantSystem(variantValue);
                // Re-enable button will be handled by the main variant change listener
              } else {
                // Re-enable if no variant update needed
                setTimeout(() => {
                  try { enableAddToCartButton(); } catch(e){null;}
                }, 100);
              }
            }
            
            // Always update prices after selection
            updateWidgetPrices();

          } catch (e) {null;
            try { enableAddToCartButton(); } catch(_) {}
          }
        });
      } catch (err) {null;
      }
    });

    // Update prices based on current variant - similar to global.js logic
    function updateWidgetPrices() {
      try {
        // Try to get current variant if we don't have one
        if (!currentVariant) {
          currentVariant = getCurrentVariantFromSystem();
        }
        
        
        if (!currentVariant) {
          // Retry after a short delay
          setTimeout(() => {
            try {
              currentVariant = getCurrentVariantFromSystem();
              if (currentVariant) {
                updateWidgetPrices(); // Recursive call after getting variant
              } else {
              }
            } catch (e2) {null;
            }
          }, 100);
          return;
        }

        // Update installment form variant ID
        updateInstallmentForm();

        const priceOriginal = widgetContainer.querySelector('.widget-price-original');
        const priceSale = widgetContainer.querySelector('.widget-price-sale');

        if (!priceOriginal || !priceSale) {
          return;
        }

        // Always use onetime purchase pricing
        // One-time purchase pricing - based on pack type, similar to global.js logic
        if (currentVariant.title.indexOf('Pack') >= 0) {
          let originalPrice = currentVariant.price;
          
          // Calculate original price based on pack type - matching global.js logic
          if (currentVariant.title.indexOf('3-Pack') >= 0) {
            originalPrice = Math.round(originalPrice / 0.85); // Reverse the 15% discount to get original
          } else if (currentVariant.title.indexOf('4-Pack') >= 0) {
            originalPrice = Math.round(originalPrice / 0.88); // Reverse the 12% discount to get original
          } else if (currentVariant.title.indexOf('6-Pack') >= 0) {
            originalPrice = Math.round(originalPrice / 0.8); // Reverse the 20% discount to get original
          }
          
          // Only show original price if it's greater than current price
          if (originalPrice > currentVariant.price) {
            priceOriginal.style.display = 'block';
            priceOriginal.textContent = formatMoney(originalPrice);
          } else {
            priceOriginal.style.display = 'none';
          }
          priceSale.textContent = formatMoney(currentVariant.price);
        } else {
          // Single pack - check for compare_at_price first
          if (currentVariant.compare_at_price && currentVariant.compare_at_price > currentVariant.price) {
            priceOriginal.style.display = 'block';
            priceOriginal.textContent = formatMoney(currentVariant.compare_at_price);
          } else {
            priceOriginal.style.display = 'none';
          }
          priceSale.textContent = formatMoney(currentVariant.price);
        }
        
        // Always update button price to current variant price (no subscription discount)
        updateButtonPrice(currentVariant.price);
      } catch (e) {null;
      }
    }

    // Update main price blocks when widget changes variant
    function refreshThemePriceBlocks(variantId) {
      try {
        const variantElement = document.querySelector('variant-radios, variant-selects');

        // Get section key
        let sectionKey = null;
        let baseUrl = window.location.pathname;
        if (variantElement) {
          sectionKey = variantElement.dataset.originalSection || variantElement.dataset.section;
          baseUrl = variantElement.dataset.url || baseUrl;
        }
        if (!sectionKey) {
          const sectionRoot = widgetContainer.closest('section[id^="shopify-section-"]');
          if (sectionRoot && sectionRoot.id) {
            sectionKey = sectionRoot.id.replace('shopify-section-', '');
          }
        }
        if (!sectionKey) return;

        // Get effective variant ID
        const idInput = document.querySelector('input[name="id"]');
        const effectiveVariantId = (idInput && idInput.value) ? idInput.value : variantId;
        if (!effectiveVariantId) return;

        fetch(`${baseUrl}?variant=${effectiveVariantId}&section_id=${sectionKey}`)
          .then((response) => response.text())
          .then((responseText) => {
            try {
              const html = new DOMParser().parseFromString(responseText, 'text/html');

              const subsId = `suscribe-price-button-${sectionKey}`;
              const destSubs = document.getElementById(subsId);
              const srcSubs = html.getElementById(subsId);
              if (destSubs && srcSubs) destSubs.innerHTML = srcSubs.innerHTML;

              const oneId = `price-button-${sectionKey}`;
              const destOne = document.getElementById(oneId);
              const srcOne = html.getElementById(oneId);
              if (destOne && srcOne) destOne.innerHTML = srcOne.innerHTML;

              const priceId = `price-${sectionKey}`;
              const destPrice = document.getElementById(priceId);
              const srcPrice = html.getElementById(priceId);
              if (destPrice && srcPrice) destPrice.innerHTML = srcPrice.innerHTML;

              // For Pack variants, prevent extra discount on subscribe price
              const cur = getCurrentVariantFromSystem();
              const isPackVariant = cur && cur.title && cur.title.indexOf('Pack') >= 0;

              if (isPackVariant && destSubs && destOne) {
                destSubs.innerHTML = destOne.innerHTML;
              }
            } catch (e2) {null;
            }
          })
          .catch((e) => {null;});
      } catch (e) {null;
      }
    }


    function updateOnetimeOptions() {
      try {
        // Update the one-time purchase options based on current variant
        const onetimeOptions = widgetContainer.querySelectorAll('.widget-tab-content[data-content="onetime"] .widget-selection-option');
        
        onetimeOptions.forEach(option => {
          try {
            const variantValue = option.dataset.variantValue;
            if (variantValue && currentVariant && 
                (currentVariant.option1 === variantValue || currentVariant.option2 === variantValue)) {
              option.classList.add('selected');
            } else {
              option.classList.remove('selected');
            }
          } catch (e2) {null;
          }
        });
        
        // Update subtitle prices dynamically
        updateOnetimeSubtitles();
      } catch (e) {null;
      }
    }

    function updateOnetimeSubtitles() {
      try {
        // Get all variants data
        const scripts = document.querySelectorAll('script[type="application/json"]');
        let variants = [];
        
        for (let script of scripts) {
          try {
            const data = JSON.parse(script.textContent);
            if (Array.isArray(data) && data[0] && data[0].id && data[0].title) {
              variants = data;
              break;
            } else if (data.variants && Array.isArray(data.variants)) {
              variants = data.variants;
              break;
            }
          } catch (_) {
            continue;
          }
        }
        
        if (variants.length === 0) return;
        
        // Update subtitles for one-time purchase options
        const subtitleElements = widgetContainer.querySelectorAll('.widget-tab-content[data-content="onetime"] .widget-selection-subtitle[data-variant-value]');
        
        subtitleElements.forEach(subtitle => {
          try {
            const variantValue = subtitle.dataset.variantValue;
            
            // Find the variant that matches this option value
            let matchingVariant = null;
            
            if (currentVariant) {
              // Determine which option to maintain (capsule count)
              const currentCapsuleOption = currentVariant.option1?.includes('Capsules') ? currentVariant.option1 : 
                                         currentVariant.option2?.includes('Capsules') ? currentVariant.option2 : null;
              
              if (currentCapsuleOption) {
                // Find variant with same capsule option and desired pack option
                matchingVariant = variants.find(v => {
                  const hasCapsuleOption = v.option1 === currentCapsuleOption || v.option2 === currentCapsuleOption;
                  const hasPackOption = v.option1 === variantValue || v.option2 === variantValue;
                  return hasCapsuleOption && hasPackOption;
                });
              }
            }
            
            // Fallback to any matching variant
            if (!matchingVariant) {
              matchingVariant = variants.find(v => 
                v.option1 === variantValue || 
                v.option2 === variantValue || 
                v.title.includes(variantValue)
              );
            }
            
            if (matchingVariant) {
              let subtitleHTML = '';
              
              // Calculate subtitle based on pack type
              if (variantValue.includes('3-Pack')) {
                const unitPrice = Math.round(matchingVariant.price / 3);
                subtitleHTML = `(${formatMoney(unitPrice)} each)`;
                
                // Add best seller badge for organic-moringa
                const productHandle = window.location.pathname.split('/').pop() || '';
                if (productHandle === 'organic-moringa') {
                  subtitleHTML += '<span class="best-seller-badge">Best Seller</span>';
                }
              } else if (variantValue.includes('4-Pack')) {
                const unitPrice = Math.round(matchingVariant.price / 4);
                subtitleHTML = `(${formatMoney(unitPrice)} each)`;
              } else if (variantValue.includes('6-Pack')) {
                const unitPrice = Math.round(matchingVariant.price / 6);
                subtitleHTML = `(${formatMoney(unitPrice)} each)`;
              } else {
                // For 1-Pack, just show the total price
                subtitleHTML = "";
              }
              
              subtitle.innerHTML = subtitleHTML;
            }
          } catch (e2) {null;
          }
        });
      } catch (e) {null;
      }
    }

    function syncWidgetVariants() {
      try {
        // Sync the widget's variant options with the current variant
        if (!currentVariant) return;
        
        const variantOptions = widgetContainer.querySelectorAll('.variant-option-input');
        variantOptions.forEach(option => {
          try {
            const optionValue = option.dataset.variantValue;
            if (optionValue && (currentVariant.option1 === optionValue || currentVariant.option2 === optionValue)) {
              option.checked = true;
            } else {
              option.checked = false;
            }
          } catch (e2) {null;
          }
        });
      } catch (e) {null;
      }
    }

    // Apply a full variant (all option values) to native controls so global handler runs
    function applyVariantToNativeControls(matchingVariant) {
      try {
        const variantElement = document.querySelector('variant-radios, variant-selects');
        if (!variantElement || !matchingVariant) return false;

        const desiredOptions = matchingVariant.options || [matchingVariant.option1, matchingVariant.option2, matchingVariant.option3].filter(Boolean);
        if (!desiredOptions || desiredOptions.length === 0) return false;

        const isRadios = variantElement.tagName.toLowerCase() === 'variant-radios';
        if (isRadios) {
          const fieldsets = Array.from(variantElement.querySelectorAll('fieldset'));
          fieldsets.forEach((fieldset, idx) => {
            try {
              const desired = desiredOptions[idx];
              if (!desired) return;
              const input = Array.from(fieldset.querySelectorAll('input[type="radio"]')).find(r => r.value === desired);
              if (input) {
                if (!input.checked) input.checked = true;
                // Use input.click() to better emulate user interaction and trigger any bound listeners
                input.click();
              }
            } catch (e2) {null;
            }
          });
          return true;
        } else {
          const selects = Array.from(variantElement.querySelectorAll('select'));
          selects.forEach((select, idx) => {
            try {
              const desired = desiredOptions[idx];
              if (!desired) return;
              const opt = Array.from(select.options).find(o => o.value === desired);
              if (opt) {
                select.value = opt.value;
                // Use native change event and also blur/focus to mimic real selection
                select.dispatchEvent(new Event('change', { bubbles: true }));
                // In some themes, a second microtask ensures price render; queue a refresh
                setTimeout(() => {
                  try {
                    const idInput = document.querySelector('input[name="id"]');
                    if (idInput && idInput.value) {
                      refreshThemePriceBlocks(idInput.value);
                    }
                  } catch (e3) {null;
                  }
                }, 0);
              }
            } catch (e2) {null;
            }
          });
          return true;
        }
      } catch (e) {null;
        return false;
      }
    }

    function updateMainVariantSystem(variantValue) {
      try {
        // Support both variant-radios and variant-selects
        let variantElement = document.querySelector('variant-radios');
        let isRadios = true;
        
        if (!variantElement) {
          variantElement = document.querySelector('variant-selects');
          isRadios = false;
        }
        
        if (!variantElement) {
          // Try fallback approach using form input directly; global will still pick up change
          tryDirectVariantUpdate(variantValue);
          return;
        }
        
        
        // Try to find the exact input or select with this value
        let mainVariantInput = null;
        
        if (isRadios) {
          mainVariantInput = variantElement.querySelector(`input[value="${variantValue}"]`);
          if (mainVariantInput && !mainVariantInput.checked) {
            mainVariantInput.checked = true;
            mainVariantInput.dispatchEvent(new Event('change', { bubbles: true }));
            return;
          }
        } else {
          // For variant-selects, look for select option
          const selectElement = variantElement.querySelector('select');
          if (selectElement) {
            const option = selectElement.querySelector(`option[value="${variantValue}"]`);
            if (option) {
              selectElement.value = variantValue;
              selectElement.dispatchEvent(new Event('change', { bubbles: true }));
              return;
            }
          }
        }
        
        // If not found by exact value, try alternative approach
        
        // Get variant data from script tag inside variant element
        const variantScript = variantElement.querySelector('script[type="application/json"]');
        if (!variantScript) {
          return;
        }
        
        try {
          const variants = JSON.parse(variantScript.textContent);
          
          // Find variant that matches the option value while maintaining consistency
          let matchingVariant = null;
          
          // Get current variant for consistency check
          if (currentVariant) {
            
            // Find variant that matches desired option AND maintains consistency
            matchingVariant = variants.find(v => {
              const hasDesiredOption = v.option1 === variantValue || v.option2 === variantValue || v.option3 === variantValue;
              if (!hasDesiredOption) return false;
              
              // Maintain capsule consistency (90 vs 120)
              const currentCapsuleOption = currentVariant.option1?.includes('Capsules') ? currentVariant.option1 : 
                                         currentVariant.option2?.includes('Capsules') ? currentVariant.option2 : null;
              
              if (currentCapsuleOption) {
                return (v.option1 === currentCapsuleOption || v.option2 === currentCapsuleOption);
              }
              
              return true;
            });
          }
          
          // Fallback to any match if no consistent variant found
          if (!matchingVariant) {
            matchingVariant = variants.find(v => 
              v.option1 === variantValue || 
              v.option2 === variantValue || 
              v.option3 === variantValue ||
              v.title.includes(variantValue)
            );
          }
          
          if (matchingVariant) {

              // Apply all option values to native controls so global handler runs
              if (applyVariantToNativeControls(matchingVariant)) return;
            
            // Last resort: update form input directly
            const variantInput = document.querySelector('input[name="id"]');
            if (variantInput) {
              variantInput.value = matchingVariant.id;
              variantInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
          } else {
          }
        } catch (e2) {null;
        }
      } catch (e) {null;
      }
    }

    function tryDirectVariantUpdate(variantValue) {
      try {
        // Get variant data from any available script tag
        const scripts = document.querySelectorAll('script[type="application/json"]');
        let variants = [];
        
        for (let script of scripts) {
          try {
            const data = JSON.parse(script.textContent);
            if (Array.isArray(data) && data[0] && data[0].id && data[0].title) {
              variants = data;
              break;
            } else if (data.variants && Array.isArray(data.variants)) {
              variants = data.variants;
              break;
            }
          } catch (_) {
            continue;
          }
        }
        
        if (variants.length === 0) {
          return;
        }
        
        
        // Get current variant to maintain consistency (e.g., keep 90 vs 120 Capsules)
        const currentVariantInput = document.querySelector('input[name="id"]');
        let cur = null;
        
        if (currentVariantInput && currentVariantInput.value) {
          const currentVariantId = parseInt(currentVariantInput.value);
          cur = variants.find(v => v.id === currentVariantId);
        }
        
        // Find variant that matches the option value while maintaining consistency
        let matchingVariant = null;
        
        if (cur) {
          // First, try to find a variant that matches the desired option AND keeps other options consistent
          matchingVariant = variants.find(v => {
            // Check if this variant has the desired pack option
            const hasDesiredOption = v.option1 === variantValue || v.option2 === variantValue || v.option3 === variantValue;
            
            if (!hasDesiredOption) return false;
            
            // If current variant has multiple options, try to maintain the non-pack option (like 90 vs 120 Capsules)
            if (cur.option1 && cur.option2) {
              // Determine which option is the "capsules" option and which is the "pack" option
              const currentCapsuleOption = cur.option1.includes('Capsules') ? cur.option1 : 
                                         cur.option2.includes('Capsules') ? cur.option2 : null;
              
              if (currentCapsuleOption) {
                // Look for variant that has same capsule count but different pack option
                return (v.option1 === currentCapsuleOption || v.option2 === currentCapsuleOption) && hasDesiredOption;
              }
            }
            
            return true; // fallback if we can't determine consistency rules
          });
        }
        
        // If no consistent match found, fall back to any match
        if (!matchingVariant) {
          matchingVariant = variants.find(v => 
            v.option1 === variantValue || 
            v.option2 === variantValue || 
            v.option3 === variantValue ||
            v.title.includes(variantValue)
          );
        }
        
        if (matchingVariant) {
          
          // Update the form input directly
          const variantInput = document.querySelector('input[name="id"]');
          if (variantInput) {
            const oldValue = variantInput.value;
            variantInput.value = matchingVariant.id;
            
            // Trigger change event
            variantInput.dispatchEvent(new Event('change', { bubbles: true }));
            
            // Also trigger a custom event that might be listened to
            window.dispatchEvent(new CustomEvent('variant-changed', { 
              detail: { 
                variant: matchingVariant,
                oldVariantId: oldValue,
                newVariantId: matchingVariant.id
              } 
            }));
          } else {
          }
        } else {
        }
      } catch (e) {null;
      }
    }

    function forceOnePack() {
      try {
        if (!currentVariant) {
          currentVariant = getCurrentVariantFromSystem();
        }
        
        if (!currentVariant) {
          return;
        }
        
        // Determine what capsule option to maintain (90 vs 120)
        const currentCapsuleOption = currentVariant.option1?.includes('Capsules') ? currentVariant.option1 : 
                                   currentVariant.option2?.includes('Capsules') ? currentVariant.option2 : null;
        
        if (!currentCapsuleOption) {
          return;
        }
        
        // Find the 1-Pack variant for this capsule option
        const scripts = document.querySelectorAll('script[type="application/json"]');
        let variants = [];
        
        for (let script of scripts) {
          try {
            const data = JSON.parse(script.textContent);
            if (Array.isArray(data) && data[0] && data[0].id && data[0].title) {
              variants = data;
              break;
            } else if (data.variants && Array.isArray(data.variants)) {
              variants = data.variants;
              break;
            }
          } catch (_) {
            continue;
          }
        }
        
        if (variants.length === 0) {
          console.error('No variants found for 1-Pack forcing');
          return;
        }
        
        // Find the 1-Pack variant that matches the current capsule option
        const onePackVariant = variants.find(v => {
          const hasCapsuleOption = v.option1 === currentCapsuleOption || v.option2 === currentCapsuleOption;
          const isOnePack = v.title.includes('1-Pack') || 
                            (!v.title.includes('3-Pack') && !v.title.includes('4-Pack') && !v.title.includes('6-Pack'));
          return hasCapsuleOption && isOnePack;
        });
        
        if (onePackVariant) {

          // Prefer updating via native variant controls so global onVariantChange runs
          const variantElement = document.querySelector('variant-radios, variant-selects');
          let updatedViaControls = false;
          if (variantElement) {
            updatedViaControls = applyVariantToNativeControls(onePackVariant);
            // If native controls were applied, also force a price refresh explicitly (theme can be async)
            if (updatedViaControls) {
              refreshThemePriceBlocks(onePackVariant.id);
            }
          }

          if (!updatedViaControls) {
            // Fallback to updating the hidden input, and manually refresh price blocks
            const variantInput = document.querySelector('input[name="id"]');
            if (variantInput && variantInput.value != onePackVariant.id) {
              variantInput.value = onePackVariant.id;
              variantInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
            refreshThemePriceBlocks(onePackVariant.id);
          }

          // Keep local state in sync
          currentVariant = onePackVariant;
        } else {
          console.error('Could not find 1-Pack variant for capsule option:', currentCapsuleOption);
        }
      } catch (e) {null;
      }
    }

    function formatMoney(cents) {
      try {
        // Shopify prices are always in cents
        let amount = cents;
        if (typeof cents === 'string') {
          amount = parseInt(cents);
        }
        if (isNaN(amount) || amount < 0) {
          console.warn('Invalid price value:', cents);
          return '$0.00';
        }
        
        // Convert cents to dollars
        const dollars = amount / 100;
        return '$' + dollars.toFixed(2);
      } catch (e) {null;
        return '$0.00';
      }
    }

