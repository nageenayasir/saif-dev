// Function to get discount from selling plan
function getSellingPlanDiscount(planId) {
  try {
    const sellingPlansData = document.getElementById('selling-plans-data');
    if (!sellingPlansData) return 0.9; // fallback to 10% discount
    
    const planGroups = JSON.parse(sellingPlansData.textContent);
    
    for (let group of planGroups) {
      for (let plan of group.selling_plans) {
        if (plan.id == planId) {
          // Check if plan has price adjustments
          if (plan.price_adjustments && plan.price_adjustments.length > 0) {
            const adjustment = plan.price_adjustments[0];
            if (adjustment.value_type === 'percentage') {
              // Return the multiplier (e.g., 10% off = 0.9)
              return (100 - adjustment.value) / 100;
            } else if (adjustment.value_type === 'fixed_amount') {
              // For fixed amounts, we'll need the original price to calculate
              // This is more complex, so we'll stick with percentage for now
              console.warn('Fixed amount discounts not yet supported');
            }
          }
          break;
        }
      }
    }
  } catch (e) {null;
  }
  
  // Fallback to 10% discount if we can't determine from selling plan
  return 0.9;
}

