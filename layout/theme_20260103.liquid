  </script>
  {% comment %} HEAD: Async Performance Scripts {% endcomment %}
  <script src="{{ 'lazysizes.min.js' | asset_url }}" defer></script>

  {% comment %} HEAD: Default Scripts {% endcomment %}
  {% render "scripts" %}

  {% comment %} HEAD: Conditional Scripts {% endcomment %}
  {% if template contains "collection" %}
    <script type="text/lazyload" src="{{ 'globo-checkout-mobile.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {% if template contains "collection" %}
    {% render "nonFlickerCode" %}
  {% endif %}

  {% comment %} HEAD: Lazyload Scripts {% endcomment %}
  <script type="text/lazyload" src="{{ 'global.js' | asset_url }}" defer="defer"></script>

