      function isVisible(rect) {
        try { return !!(rect && rect.width > 0 && rect.top < window.innerHeight && rect.bottom > 0); }
        catch (e) { return false; }
      }

      function managePriority(img, rect) {
        try {
          const priorityClass = !!(img.classList && img.classList.contains(PRIORITY_CLASS));
          const visible = isVisible(rect);

          // Only ONE image gets high + eager
          if ((priorityClass || visible) && highUsed < HIGH_LIMIT) {
            img.setAttribute('fetchpriority', 'high');
            img.setAttribute('loading', 'eager');
            try { img.classList.remove('lazyload'); } catch (e) {}
            highUsed++;
            return;
          }

          // Visible but not high: do NOT force eager; if theme/app set lazy, remove it
          if (visible) {
            try {
              if (img.getAttribute('loading') === 'lazy') img.removeAttribute('loading');
            } catch (e) {}
            if (!img.getAttribute('fetchpriority')) img.setAttribute('fetchpriority', 'auto');
            return;
          }

          // Below fold: lazy is ok
          if (!img.getAttribute('loading')) img.setAttribute('loading', 'lazy');
          if (!img.getAttribute('fetchpriority')) img.setAttribute('fetchpriority', 'auto');
        } catch (e) {}
      }

      function processImg(img) {
        try {
          if (!img || img.nodeType !== 1) return;
          if (img.hasAttribute(FLAG)) return;

          const s = getSignals(img);

          // Ignore anything not Shopify-related (including third-party srcset)
          if (!s.anyShopify) return;

          reserveAspectRatio(img);
          hookLoadHandlers(img);

          try { img.classList.add(CLASS_LOADING); } catch (e) {}

          const rect = (function(){ try { return img.getBoundingClientRect(); } catch(e){ return null; } })();

          // Priority logic applies to all Shopify images (even lite mode)
          managePriority(img, rect);

          // If srcset exists, do lite-mode (do not rewrite src => avoids double downloads)
          if (!s.hasSrcset) {
            const rawSrc = s.dataSrc || s.srcAttr || s.cur || '';
            if (isShopifyUrl(rawSrc)) {
              const dpr = (function(){ try { return window.devicePixelRatio || 1; } catch(e){ return 1; } })();
              let w = 0;
              try { w = (rect && rect.width) ? rect.width : (img.clientWidth || 0); } catch (e) { w = 0; }
              if (!w || w < 10) w = (window.innerWidth <= 768 ? 600 : 1200);

              let targetWidth = Math.ceil(w * dpr);
              if (targetWidth > 2000) targetWidth = 2000;
              if (targetWidth < 200) targetWidth = 200;

              img.setAttribute('src', getOptimizedUrl(rawSrc, targetWidth));
            }
          }

          img.setAttribute(FLAG, 'true');

          // Cache-safe: if already loaded, apply now
          try { if (img.complete && img.naturalWidth > 0) applyLoadedState(img); } catch (e) {}

        } catch (e) {}
      }

      // Queue / batch for non-critical
      const queue = [];
      let flushing = false;

      function enqueue(img) {
        try {
          if (!img || img.nodeType !== 1) return;
          if (img.hasAttribute(FLAG)) return;
          queue.push(img);
          if (flushing) return;
          flushing = true;

          const flush = function (deadline) {
            try {
              let count = 0;
              while (queue.length && count < 25) {
                const el = queue.shift();
                count++;
                try { processImg(el); } catch (e) {}
                try {
                  if (deadline && typeof deadline.timeRemaining === 'function' && deadline.timeRemaining() < 8) break;
                } catch (e) {}
              }

              if (queue.length) {
                if ('requestIdleCallback' in window) window.requestIdleCallback(flush, { timeout: 200 });
                else setTimeout(function(){ flush(null); }, 50);
              } else {
                flushing = false;
              }
            } catch (e) { flushing = false; }
          };

          if ('requestIdleCallback' in window) window.requestIdleCallback(flush, { timeout: 200 });
          else setTimeout(function(){ flush(null); }, 0);

        } catch (e) {}
      }

      let io = null;
      try {
        if ('IntersectionObserver' in window) {
          io = new IntersectionObserver(function (entries) {
            try {
              entries.forEach(function (entry) {
                try {
                  if (entry.isIntersecting) {
                    try { io.unobserve(entry.target); } catch (e) {}
                    enqueue(entry.target);
                  }
                } catch (e) {}
              });
            } catch (e) {}
          }, { rootMargin: '600px 0px', threshold: 0.01 });
        }
      } catch (e) { io = null; }

      function init() {
        try {
          const imgs = document.querySelectorAll('img:not([' + FLAG + '])');
          for (let i = 0; i < imgs.length; i++) {
            const img = imgs[i];
            const s = getSignals(img);
            if (!s.anyShopify) continue;

            const rect = (function(){ try { return img.getBoundingClientRect(); } catch(e){ return null; } })();
            const critical = (function(){
              try {
                const p = img.classList && img.classList.contains(PRIORITY_CLASS);
                return p || isVisible(rect);
              } catch (e) { return false; }
            })();

            if (critical) processImg(img);
            else if (io) io.observe(img);
            else enqueue(img);
          }

          new MutationObserver(function (mutations) {
            try {
              mutations.forEach(function (m) {
                m.addedNodes.forEach(function (node) {
                  try {
                    if (!node || node.nodeType !== 1) return;
                    if (node.tagName === 'IMG') {
                      if (io) io.observe(node); else enqueue(node);
                    } else if (node.querySelectorAll) {
                      node.querySelectorAll('img').forEach(function (im) {
                        if (io) io.observe(im); else enqueue(im);
                      });
                    }
                  } catch (e) {}
                });
              });
            } catch (e) {}
          }).observe(document.body || document.documentElement, { childList: true, subtree: true });

        } catch (e) {}
      }

      return { init };
    })();

    // Start ASAP but safely
    try {
      if (document.readyState === 'interactive' || document.readyState === 'complete') {
        dgf_image_opmitizer.init();
      } else {
        document.addEventListener('DOMContentLoaded', function () {
          try { dgf_image_opmitizer.init(); } catch (e) {}
        });
      }
    } catch (e) {}
  </script>

