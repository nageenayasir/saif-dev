          let urlStr = String(src || '').replace(/&amp;/g, '&');

          // Fast path: if already forced
          if (urlStr.indexOf('format=webp') !== -1 && urlStr.indexOf('quality=80') !== -1) return urlStr;

          try {
            const u = new URL(urlStr, window.location.origin);
            if (!u.searchParams.get('format'))  u.searchParams.set('format', 'webp');
            if (!u.searchParams.get('quality')) u.searchParams.set('quality', '80');
            if (!u.searchParams.get('width'))   u.searchParams.set('width', String(width));
            return u.toString();
          } catch (e) {
            const conn = urlStr.indexOf('?') !== -1 ? '&' : '?';
            if (urlStr.indexOf('format=') === -1)  urlStr += `${conn}format=webp`;
            if (urlStr.indexOf('quality=') === -1) urlStr += `&quality=80`;
            if (urlStr.indexOf('width=') === -1)   urlStr += `&width=${String(width)}`;
            return urlStr;
          }
        } catch (e) { return src || ''; }
