          const srcsetProp = (function(){ try { return img.srcset || ''; } catch(e){ return ''; } })();

          const anyShopify =
            isShopifyUrl(dataSrc) ||
            isShopifyUrl(srcAttr) ||
            isShopifyUrl(cur) ||
            isShopifyUrl(srcsetAttr) ||
            isShopifyUrl(srcsetProp);

          const hasSrcset = !!(
            (srcsetProp && srcsetProp.length > 0) ||
            (srcsetAttr && srcsetAttr.length > 0)
          );

          return { dataSrc, srcAttr, cur, srcsetAttr, srcsetProp, anyShopify, hasSrcset };
        } catch (e) {
          return { dataSrc:'', srcAttr:'', cur:'', srcsetAttr:'', srcsetProp:'', anyShopify:false, hasSrcset:false };
        }
      }

      function reserveAspectRatio(img) {
        try {
          const w = img.getAttribute('width');
          const h = img.getAttribute('height');
          if (w && h && !img.style.aspectRatio) {
            img.style.aspectRatio = `${w} / ${h}`;
            img.style.height = 'auto';
          }
        } catch (e) {}
      }

      function applyLoadedState(img) {
        try {
          img.classList.remove(CLASS_LOADING);
          img.classList.add(CLASS_LOADED, 'lazyloaded');
          try {
            if (!img.getAttribute('width') && img.naturalWidth) img.setAttribute('width', String(img.naturalWidth));
            if (!img.getAttribute('height') && img.naturalHeight) img.setAttribute('height', String(img.naturalHeight));
            if (!img.style.aspectRatio && img.naturalWidth && img.naturalHeight) {
              img.style.aspectRatio = `${img.naturalWidth} / ${img.naturalHeight}`;
            }
          } catch (e) {}
        } catch (e) {}
      }

      function hookLoadHandlers(img) {
        try {
          if (!img || img.nodeType !== 1) return;
          if (img.hasAttribute(FLAG_HOOKED)) return;
          img.setAttribute(FLAG_HOOKED, 'true');

          img.addEventListener('load', function () {
            try { applyLoadedState(img); } catch (e) {}
