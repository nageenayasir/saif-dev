  {% comment %} HEAD: SHOPIFY HEADER (content_for_header) - keep required tag + filter Recharge {% endcomment %}
  {% # theme-check-disable ContentForHeaderModification %}
  {%- capture cfh_required -%}{{ content_for_header }}{%- endcapture -%}
  {%- liquid
    assign cfh_filtered = cfh_required
    assign recharge_marker = 'widget.min.js?shop=tribe-supplements.myshopify.com'
    if cfh_filtered contains recharge_marker
      assign parts = cfh_filtered | split: '<script'
      capture out
        echo parts[0]
        for p in parts offset: 1
          assign block = '<script' | append: p
          unless block contains recharge_marker
            echo block
          endunless
        endfor
      endcapture
      assign cfh_filtered = out
    endif
  -%}
  {% # theme-check-enable ContentForHeaderModification %}

