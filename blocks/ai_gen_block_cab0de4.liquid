{% doc %}
  @prompt
    a simple featured products product list, with 4 collumns and 2 rows. it must have an h2 title at the top and a cta at the bottom
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /*Product card + hover CTA layering */

  .ai-featured-products__item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  /* full-card clickable layer */
  .ai-featured-products__card-link-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* content above card link */
  .ai-featured-products__image-wrapper-{{ ai_gen_id }},
  .ai-featured-products__info-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
  }

  /*Hover CTA (View product)*/

  .ai-featured-products__atc-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    z-index: 5;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease;
    margin: 0;
  }

  .ai-featured-products__item-{{ ai_gen_id }}:hover
  .ai-featured-products__atc-{{ ai_gen_id }} {
    opacity: 1;
    pointer-events: auto;
  }

  /*Section wrapper*/

  .ai-featured-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-featured-products__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  /*Header*/

  .ai-featured-products__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: {{ block.settings.title_spacing }}px;
  }

  .ai-featured-products__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 600;
  }

  /*Grid*/

  .ai-featured-products__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.cta_spacing }}px;
  }

  /*Image*/

  .ai-featured-products__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
    margin-bottom: 12px;
  }

  .ai-featured-products__image-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-products__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-products__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  /*Product info*/

  .ai-featured-products__info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-featured-products__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
    color: {{ block.settings.product_title_color }};
    margin: 0;
  }

  .ai-featured-products__price-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.product_price_color }};
    font-weight: 600;
  }

  /*Bottom CTA*/

  .ai-featured-products__footer-{{ ai_gen_id }} {
    text-align: {{ block.settings.cta_alignment }};
  }

  .ai-featured-products__cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.cta_padding_vertical }}px {{ block.settings.cta_padding_horizontal }}px;
    background-color: {{ block.settings.cta_background_color }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_font_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-featured-products__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_color }};
  }

  /* Responsive */

  @media screen and (max-width: 989px) {
    .ai-featured-products__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-products__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-featured-products__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}


<featured-products-{{ ai_gen_id }} class="ai-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-products__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <div class="ai-featured-products__header-{{ ai_gen_id }}">
        <h2 class="ai-featured-products__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="ai-featured-products__grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign product = block.settings[product_key]
        %}

        {% if product != blank %}
  <div class="ai-featured-products__item-{{ ai_gen_id }}">

    {%- comment -%} Full-card clickable layer {%- endcomment -%}
    <a
      class="ai-featured-products__card-link-{{ ai_gen_id }}"
      href="{{ product.url }}"
      aria-label="{{ product.title | escape }}"
    ></a>

    <div class="ai-featured-products__image-wrapper-{{ ai_gen_id }}">
  {% liquid
    assign image_key = 'image_' | append: i
    assign custom_image = block.settings[image_key]
  %}

  {% if custom_image != blank %}
    <img
      src="{{ custom_image | image_url: width: 400 }}"
      alt="{{ product.title | escape }}"
      class="ai-featured-products__image-{{ ai_gen_id }}"
      loading="lazy"
      width="400"
      height="400"
    >
  {% elsif product.featured_image %}
    <img
      src="{{ product.featured_image | image_url: width: 400 }}"
      alt="{{ product.featured_image.alt | escape }}"
      class="ai-featured-products__image-{{ ai_gen_id }}"
      loading="lazy"
      width="400"
      height="400"
    >
  {% else %}
    <div class="ai-featured-products__image-placeholder-{{ ai_gen_id }}">
      {{ 'product-1' | placeholder_svg_tag }}
    </div>
  {% endif %}

      {%- comment -%} Hover CTA → product page {%- endcomment -%}
      <a
        class="ai-featured-products__atc-{{ ai_gen_id }} btn"
        href="{{ product.url }}"
        aria-label="View {{ product.title | escape }}"
      >
        ADD TO CART
      </a>
    </div>

    <div class="ai-featured-products__info-{{ ai_gen_id }}">
      <h3 class="ai-featured-products__product-title-{{ ai_gen_id }}">
        {{ product.title }}
      </h3>
      <div class="ai-featured-products__price-{{ ai_gen_id }}">
  {% assign v = product.selected_or_first_available_variant %}

  {% if v.compare_at_price and v.compare_at_price > v.price %}
    <span class="ai-featured-products__compare-at-{{ ai_gen_id }}">
      {{ v.compare_at_price | money }}
    </span>
  {% endif %}

  <span class="ai-featured-products__current-price-{{ ai_gen_id }}">
    {{ v.price | money }}
  </span>
</div>

    </div>

  </div>
{% else %}
          <div class="ai-featured-products__item-{{ ai_gen_id }}">
            <div class="ai-featured-products__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-featured-products__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-featured-products__info-{{ ai_gen_id }}">
              <h3 class="ai-featured-products__product-title-{{ ai_gen_id }}">Product {{ i }}</h3>
              <div class="ai-featured-products__price-{{ ai_gen_id }}">$0.00</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.cta_text != blank %}
      <div class="ai-featured-products__footer-{{ ai_gen_id }}">
        <a href="{{ block.settings.cta_link }}" class="btn btn-bg">
  {{ block.settings.cta_text }}
</a>
      </div>
    {% endif %}
  </div>
</featured-products-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('featured-products-{{ ai_gen_id }}', FeaturedProducts{{ ai_gen_id }});
  })();
</script>

