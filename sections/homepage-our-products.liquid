                        {% if block.settings.icon_6 != blank %}<img loading="lazy"  src="{{ block.settings.icon_6 | img_url: '40x' }}" alt="Product feature icon" width="40" height="40">{% endif %}
                      </div>
                      <div class="our-product-icon-content">
                        {{ block.settings.the_text_6 }}
