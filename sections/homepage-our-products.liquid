                    <div class="our-products-icon-wrapper">
                      <div class="our-products-icon">
                        {% if block.settings.icon_1 != blank %}<img loading="lazy"  src="{{ block.settings.icon_1 | img_url: '40x' }}" alt="Product feature icon" width="40" height="40">{% endif %}
                      </div>
