<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{ section.id }}" class="homepage-our-products-section">
  <div class="homepage-our-products-wrapper">
    {% if section.settings.left_image != blank %}
    <div class="homepage-our-products-left-top">
        {%- assign img = section.settings.left_image -%}
        <img
          src="{{ img | image_url: width : img.width }}" 
          alt="Decorative graphic 01"
          width="{{ img.width }}"
          height="{{ img.height }}"
          style="aspect-ratio: {{ img.width }} / {{ img.height }};"
        >
        {% comment %} <img loading="lazy" src="{{ section.settings.left_image | img_url : '170x' }}" alt="Decorative graphic" width="170" height="170"> {% endcomment %} 
    </div>
    {% endif %}
    {% if section.settings.right_image != blank %}
    <div class="homepage-our-products-right-top">
        {%- assign img = section.settings.right_image -%}
        <img
          src="{{ img | image_url: width : img.width }}" 
          alt="Decorative graphic 02"
          width="{{ img.width }}"
          height="{{ img.height }}"
          style="aspect-ratio: {{ img.width }} / {{ img.height }};"
        >
        {% comment %} <img loading="lazy" src="{{ section.settings.right_image | img_url : '170x' }}" alt="Decorative graphic" width="170" height="170"> {% endcomment %} 
    </div>
    {% endif %}
    <div class="container">
      <h2 class="text-center text-uppercase" data-aos="fade-up" data-aos-delay="000">{{ section.settings.title }}</h2>
      <div class="row">
        {% for block in section.blocks %}
          {% case block.type %}
             {% when 'left_coloumn_content' %}
            <div class="col-sm-12 col-md- col-lg-6 our-products-left-column">
              <div class="our-products-icon-lists-wrapper">
                <h3>
                  {{ block.settings.the_title }}
                </h3>
                <ul class="our-products-icon-lists">
                  <li>
                    <div class="our-products-icon-wrapper">
                      <div class="our-products-icon">
                        {% if block.settings.icon_1 != blank %}<img loading="lazy"  src="{{ block.settings.icon_1 | img_url: '40x' }}" alt="Product feature icon" width="40" height="40">{% endif %}
                      </div>
                      <div class="our-product-icon-content">
                        {{ block.settings.the_text_1 }}
                      </div>
                    </div>
                  </li>
                  <li>
                    <div class="our-products-icon-wrapper">
                      <div class="our-products-icon">
                        {% if block.settings.icon_2 != blank %}<img loading="lazy"  src="{{ block.settings.icon_2 | img_url: '40x' }}" alt="Product feature icon" width="40" height="40">{% endif %}
                      </div>
                      <div class="our-product-icon-content">
                        {{ block.settings.the_text_2 }}
                      </div>
                    </div>
                  </li>
                  <li>
                    <div class="our-products-icon-wrapper">
                      <div class="our-products-icon">
                        {% if block.settings.icon_3 != blank %}<img loading="lazy"  src="{{ block.settings.icon_3 | img_url: '40x' }}" alt="Product feature icon" width="40" height="40">{% endif %}
                      </div>
                      <div class="our-product-icon-content">
                        {{ block.settings.the_text_3 }}
                      </div>
                    </div>
                  </li>
                  <li>
                    <div class="our-products-icon-wrapper">
                      <div class="our-products-icon">
                        {% if block.settings.icon_4 != blank %}<img loading="lazy"  src="{{ block.settings.icon_4 | img_url: '40x' }}" alt="Product feature icon" width="40" height="40">{% endif %}
                      </div>
                      <div class="our-product-icon-content">
                        {{ block.settings.the_text_4 }}
                      </div>
                    </div>
                  </li>
                  <li>
