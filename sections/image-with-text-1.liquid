<section class="section section-bund homepage-section-bund">
    <div class="leaf-box right-bot">
        <img class="leaf lazyload" data-src="{{ 'leaf-n04.svg' | asset_url }}" alt="Decorative leaf graphic">
    </div>
    <div class="container">
        <h2 class="text-uppercase text-center d-block d-md-none" data-aos="fade-up">{{ section.settings.title }}</h2>
        <div class="row">
            <div class="col-md-6 mt-4 mt-md-0">
                <div style="max-width: 550px;">
                    <h2 class="text-uppercase d-none d-md-block" data-aos="fade-up">{{ section.settings.title }}</h2>
                    <p data-aos="fade-up">{{ section.settings.sub_title }}</p>
                    <p data-aos="fade-up">{{ section.settings.content }}</p>
                  {%  if section.settings.button_1 != empty %}
                    <div class="btn-group mt-4">
                        <div data-aos="fade-up" data-aos-delay="400">
                            <a class="btn btn-bg" href="{{ section.settings.url_1 }}" target="_self">
                               {{ section.settings.button_1 }}
                            </a>
                        </div>
                        <div data-aos="fade-up" data-aos-delay="500">
                            <a class="btn btn-trans" href="{{ section.settings.url_2 }}" target="_self">
                                {{ section.settings.button_2 }}
                            </a>
                        </div>
                    </div>
                  {% endif %}
                </div>
            </div>
            <div class="col-md-6 order-first order-md-last">
                <div data-aos="fade-up" data-aos-delay="400">
                    <img class="lazyload" data-src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title }}">
                </div>
            </div>
        </div>
    </div>
</section>
{% schema %}
  {
    "name": "Image with text 1",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default" : "Bundles of love, energy and  anti inflammatory favourites"
      },
      {
        "type": "text",
        "id": "sub_title",
        "label": "Subtitle",
        "default" : "From €20"
      },
      {
        "type": "textarea",
        "id": "content",
        "label": "Content",
        "default" : "A bundle of love, try a concoction of our naturally derived, organic and sustainably sourced supplements. Either build your own based on what your body is asking you for or, if you need a little help, explore our existing bundles or take our quiz!"
      },
      {
      "type": "text",
      "id": "button_1",
      "label": "Button 1",
      "default" : "Explore"
    },
    {
      "type": "url",
      "id": "url_1",
      "label": "Url 1"
    },
    {
      "type": "text",
      "id": "button_2",
      "label": "Button 2",
      "default" : "Take the Quiz"
    },
    {
      "type": "url",
      "id": "url_2",
      "label": "Url 2"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
	],
     "presets": [
    {
      "name": "Image with text 1"
    }
  ]
  }
{% endschema %}