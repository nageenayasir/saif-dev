{% unless collection.title == 'Products' or  collection.title == 'All products' or collection.metafields.custom.default_banner_image == true %}
  <section id="id-{{section.id}}" class="custom-collection-top-banner {{ collection.metafields.custom.banner_background_color_class }}">
    {% if section.settings.enable_breadcrumb == true %}
    <div class="collection-breadcrumb common-page-breadcrumb">
      {%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
      {%- assign t = template | split: '.' | first -%}
      <div class="container">
      <nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
        <ol class="breadcrumbs__list">
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="/">Home</a>
          </li>
          {%- case t -%}
            {%- when 'page' -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ page.url }}" aria-current="page">{{ page.title }}</a>
              </li>
            {%- when 'product' -%}
              {%- if collection.url -%}
                <li class="breadcrumbs__item">
                  {{ collection.title | link_to: collection.url }}
                </li>
              {%- endif -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ product.url }}" aria-current="page">{{ product.title }}</a>
              </li>
            {%- when 'collection' and collection.handle -%}
              {%- if current_tags -%}
                <li class="breadcrumbs__item">
                  {{ collection.title | link_to: collection.url }}
                </li>
                <li class="breadcrumbs__item">
                  {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+"}}{%- endcapture -%}
                  <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + "}}</a>
                </li>
              {%- else -%}
                <li class="breadcrumbs__item">
                  <a class="breadcrumbs__link" href="{{ collection.url }}" aria-current="page">{{ collection.title }}</a>
                </li>
              {%- endif -%}
            {%- when 'blog' -%}
              {%- if current_tags -%}
                <li class="breadcrumbs__item">
                  {{ blog.title | link_to: blog.url }}
                </li>
                <li class="breadcrumbs__item">
                  {%- capture tag_url -%}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
                  <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + " }}</a>
                </li>
              {%- else -%}
                <li class="breadcrumbs__item">
                  <a class="breadcrumbs__link" href="{{ blog.url }}" aria-current="page">{{ blog.title }}</a>
                </li>
              {%- endif -%}
            {%- when 'article' -%}
              <li class="breadcrumbs__item">
                {{ blog.title | link_to: blog.url }}
              </li>
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ article.url }}" aria-current="page">{{ article.title }}</a>
              </li>
            {%- else -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ request.path }}" aria-current="page">{{ page_title }}</a>
              </li>
          {%- endcase -%}
        </ol>
      </nav>
      </div>
      {%- endunless -%}
    </div>
  {% endif %}
  <div class="collection-top-banner-content">
    <div class="collection-image-banner-content-wrap">
      <div class="custom-collection-bnr-content">
         <h1 class="toptitle text-uppercase" data-aos="fade-up">{{ section.settings.title }}</h1>
          <p data-aos="fade-up">{{ section.settings.the_desc }}</p>
      </div>
      <div class="custom-collection-banr-image">
        {% if collection.metafields.custom.collection_banner_image != blank %}
          <img src="{{ collection.metafields.custom.collection_banner_image| image_url: width: 2000}}">
        {% endif %}
      </div>
    </div>
  </div>
  </section>
{% endunless %}
{% schema %}
  {
    "name": "Collection Top Banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_breadcrumb",
        "label": "Enable Breadcrumb",
        "default": true
      },
      {
        "type": "header",
        "content": "Banner Image Will handle from Collection Metafield"
      },
      {
        "type": "liquid",
        "id": "title",
        "label": "Collection Title"
      },
      {
        "type": "liquid",
        "id": "the_desc",
        "label": "Collection Description"
      },
      {
        "type": "image_picker",
        "id": "default_image",
        "label": "Default Banner Image",
        "info": "This default Image when image is not added on collection banner metafield"
      }
    ],
     "presets": [
      {
        "name": "Collection Top Banner"
      }
    ]
    
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}