<section id="id-{{section.id}}" class="custom-article-top-banner">
  {% if section.settings.enable_breadcrumb == true %}
    <div class="article-breadcrumb common-page-breadcrumb">
      {%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
      {%- assign t = template | split: '.' | first -%}
      <div class="container">
      <nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
        <ol class="breadcrumbs__list">
          <li class="breadcrumbs__item">
            <!-- DGF -->
            <a class="breadcrumbs__link" href="{{ routes.root_url }}">Home</a>
          </li>
          {%- case t -%}
            {%- when 'page' -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ page.url }}" aria-current="page">{{ page.title }}</a>
              </li>
            {%- when 'product' -%}
              {%- if collection.url -%}
                <li class="breadcrumbs__item">
                  {{ collection.title | link_to: collection.url }}
                </li>
              {%- endif -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ product.url }}" aria-current="page">{{ product.title }}</a>
              </li>
            {%- when 'collection' and collection.handle -%}
              {%- if current_tags -%}
                <li class="breadcrumbs__item">
                  {{ collection.title | link_to: collection.url }}
                </li>
                <li class="breadcrumbs__item">
                  {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+"}}{%- endcapture -%}
                  <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + "}}</a>
                </li>
              {%- else -%}
                <li class="breadcrumbs__item">
                  <a class="breadcrumbs__link" href="{{ collection.url }}" aria-current="page">{{ collection.title }}</a>
                </li>
              {%- endif -%}
            {%- when 'blog' -%}
              {%- if current_tags -%}
                <li class="breadcrumbs__item">
                  {{ blog.title | link_to: blog.url }}
                </li>
                <li class="breadcrumbs__item">
                  {%- capture tag_url -%}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
                  <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + " }}</a>
                </li>
              {%- else -%}
                <li class="breadcrumbs__item">
                  <a class="breadcrumbs__link" href="{{ blog.url }}" aria-current="page">{{ blog.title }}</a>
                </li>
              {%- endif -%}
            {%- when 'article' -%}
              <li class="breadcrumbs__item">
                {{ blog.title | link_to: blog.url }}
              </li>
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ article.url }}" aria-current="page">{{ article.title }}</a>
              </li>
            {%- else -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ request.path }}" aria-current="page">{{ page_title }}</a>
              </li>
          {%- endcase -%}
        </ol>
      </nav>
      </div>
      {%- endunless -%}
    </div>
  {% endif %}
  <div class="article-top-banner-content">
    <div class="article-image-banner-content-wrap">
      <div class="custom-article-bnr-content">
         <h1 class="toptitle text-uppercase" data-aos="fade-up">{{ section.settings.title }}</h1>
      </div>
      <div class="custom-article-banr-image">
        {% if article.metafields.custom.blog_banner_image != blank %}
          <img
            src="{{ article.metafields.custom.blog_banner_image | image_url: width: 700 }}"
            srcset="{{ article.metafields.custom.blog_banner_image | image_url: width: 400 }} 400w,
                    {{ article.metafields.custom.blog_banner_image | image_url: width: 700}} 700w,
                    {{ article.metafields.custom.blog_banner_image | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 768px) 100vw, 700px"
            alt="{{ article.title }}"
            class="meta-blog-banner-image"
            fetchpriority="high"
            width="700"
            height="400"
            loading="eager"
          >
        {% elsif article.image != blank %}
          <img
            src="{{ article.image | image_url: width: 700 }}"
            srcset="{{ article.image | image_url: width: 400 }} 400w,
                    {{ article.image | image_url: width: 700 }} 700w,
                    {{ article.image | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 768px) 100vw, 700px"
            alt="{{ article.title }}"
            fetchpriority="high"
            width="700"
            height="400"
            loading="eager"
          >
        {% endif %}
      </div>
    </div>
  </div>
   <div class="leaf-box custom-article-banner-box-left-bot left-bot">
        <img class="leaf custom-article-banner-bot" src="{{ 'article-leaf-vector.svg' | asset_url }}" alt="Image Over: {{ article.title }}" width="134" height="221" loading="lazy">
    </div>
  {%- if section.settings.show_social -%}
    <div class="social-banner article-social-banner">
        <span>{{ section.settings.text }}</span>
        {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}">{%- render 'icon-instagram' -%}</a>
        {%- endif -%}
         {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}">{%- render 'icon-facebook' -%}</a>
        {%- endif -%}
        <a href="{{ section.settings.social_spotify_link }}" target="_blank"><i class="fab fa-spotify"></i> </a>
        {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}">{%- render 'icon-youtube' -%}</a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}">{%- render 'icon-twitter' -%}</a>
        {%- endif -%}
        
        {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}">{%- render 'icon-pinterest' -%}</a>
        {%- endif -%}
        
        {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}">{%- render 'icon-tiktok' -%}</a>
        {%- endif -%}
        {%- if settings.social_tumblr_link != blank -%}
            <a href="{{ settings.social_tumblr_link }}">{%- render 'icon-tumblr' -%}</a>
        {%- endif -%}
        {%- if settings.social_snapchat_link != blank -%}
            <a href="{{ settings.social_snapchat_link }}">{%- render 'icon-snapchat' -%}</a>
        {%- endif -%}
        
        {%- if settings.social_vimeo_link != blank -%}
            <a href="{{ settings.social_vimeo_link }}">{%- render 'icon-vimeo' -%} </a>
        {%- endif -%}
    </div>
  {% endif %}
</section>
{% schema %}
  {
    "name": "Article Top Banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_breadcrumb",
        "label": "Enable Breadcrumb",
        "default": true
      },
      {
        "type": "liquid",
        "id": "title",
        "label": "Article Title"
      },
       {
          "type": "header",
          "content": "Social"
        },
         {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "Show social"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default" : "Visit"
        },
        {
          "type": "text",
          "id": "social_spotify_link",
          "label": "Link Social spotify",
          "default": "https://open.spotify.com/user/8yaaywq2a4gtbxl0w7csryv2o?si=28d61f70a2cc496c"
        }
    ],
     "presets": [
      {
        "name": "Article Top Banner"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}