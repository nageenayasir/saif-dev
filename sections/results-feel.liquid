{% assign icons = product.metafields.custom.feel_results_icons.value  %}
{% assign contents =  product.metafields.custom.feel_results_text.value  %}
{% if icons != blank or contents != blank %}
<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
{% comment %} RGD: 2026-01-04 {% endcomment %} 
{% comment %} 
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.0.7/css/swiper.min.css" media="all" />
{% endcomment %} 
<link rel="stylesheet" href="{{ 'swiper.min.css' | asset_url }}" type="text/css" media="all"/>
<section id="id-{{ section.id }}" class="reults-feel-section">
  <div class="container">
    <div class="results-feel-wrapper">
      <div class="results-feel-head">
        <h2 class="text-center text-uppercase" data-aos="fade-up" data-aos-delay="000">{{ section.settings.the_title }}</h2>
      </div>
      <div class="results-feel-blocks-wrapper" data-aos="fade-in" data-aos-delay="400" data-aos-duration="800">
        <div class="swiper results-feel-slider">
          <div class="swiper-wrapper">
            {% for icon in icons %}
                <div class="swiper-slide">
                  <div class="results-feel-content">
                    <div class="results-feel-icon">
                      <img src="{{ icon | img_url: "master" }}">
                    </div>
                    <div class="results-feel-icon">
                      <p>{{ contents[forloop.index0] }}</p>
                    </div>
                  </div>
                </div>
            {% endfor %}
          </div>
          <!-- If we need navigation buttons -->
            <div class="swiper-button-prev results-feel-button-prev"></div>
            <div class="swiper-button-next results-feel-button-next"></div>  
        </div>
      </div>
      <div class="results-feel-button">
        <a href="{{ section.settings.the_url }}">{{ section.settings.btn_text }}</a>
      </div>
    </div>
  </div>
</section>
{% comment %} RGD: 2026-01-04 {% endcomment %} 
{% comment %} 
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script> 
<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.5.1/js/swiper.min.js"></script> 
{% endcomment %}
{% # theme-check-disable ParserBlockingScript %}
<script type="text/javascript" src="{{ 'jquery-3.5.1.min.js' | asset_url }}"></script>
<script type="text/javascript" src="{{ 'swiper.min.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}
<script>
  new Swiper('.results-feel-slider', {
        loop: false,
        slidesPerView: 6,
       navigation: {
          nextEl: '.results-feel-button-next',
          prevEl: '.results-feel-button-prev',
        },
        spaceBetween: 20,
        breakpoints: {
            1920: {
                slidesPerView: 6,
                spaceBetween: 20
            },
            1199: {
                slidesPerView: 4,
                spaceBetween: 20
            },
            1028: {
                slidesPerView: 3,
                spaceBetween: 10
            },
            576: {
                slidesPerView: 1,
                spaceBetween: 10
            }
        }
    });
</script>
{% endif %}
{% schema %}
  {
    "name": "Results Feel",
    "settings": [
      {
            "type": "header",
            "content": "Content Style"
      },
  	  {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
      },
      {
        "type": "text",
        "id": "the_title",
        "label": "Title"
      },
      {
        "type": "text",
        "id": "btn_text",
        "label": "Button Text"
      },
      {
        "type": "url",
        "id": "the_url",
        "label": "Url"
      }
    ],
    "presets": [{
      "name": "Results Feel"
    }]
  }
{% endschema %}