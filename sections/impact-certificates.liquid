<section class="section section-bund bg-cream color-dark">
        <div class="leaf-box left-top">
            <img loading="lazy"  class="leaf" src="{{ 'leaf-n08.svg' | asset_url }}">
        </div>

        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-12">
                  <div class="col-sm-12 col-md-12 col-lg-12">
                        <h2 class="text-center text-uppercase pt-5">{{ section.settings.the_title }}</h2>
                   </div>
                  <div class="col-md-8 coa-paragraph-wrapper">
                    {{ section.settings.content }}
                  </div>
                    <div class="row COA-cstm-icons">
                    {% for block in section.blocks %}  
                        <div class="col-lg-3 col-md-3 col-sm-12">
                            {% if block.settings.logo != blank %}<img loading="lazy"  src="{{ block.settings.logo | img_url: 'master' }}">{% endif %}
                            <div data-aos="fade-up" data-aos-delay="400">
                                <a class="btn btn-bg" href="{{ block.settings.url }}" target="_self">
                                    {{ block.settings.button }}
                                </a>
                            </div>
                        </div>
                    {% endfor %}   
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="row">
                      <div class="col-sm-12 col-md-12 col-lg-12">
                        <h2 class="text-center text-uppercase pt-5">{{ section.settings.title }}</h2>
                      </div>
                        <div class="col-md-6">
                            {{ section.settings.content_1 }}
                        </div>
                        <div class="col-md-6">
                            {{ section.settings.content_2 }}
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="text-center mt-5">
                        <img loading="lazy"  src="{{ section.settings.image | image_url : width: 800 }}" alt="{{ section.settings.title }}">
                    </div>
                </div>
            </div>
        </div>

    </section>
{% schema %}
  {
    "name": "Certificates of Analysis",
    "settings": [ 
      {
        "type": "text",
        "id": "the_title",
        "label": "Title",
        "default" : "Title Here"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default" : "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor. .</p>"
      },
      {
        "type": "text",
        "id": "button_1",
        "label": "Button Title 1",
        "default" : "Download Impact Report"
      },
      {
        "type": "url",
        "id": "url_1",
        "label": "Url 1"
      },
       {
        "type": "text",
        "id": "button_2",
        "label": "Button Title 2",
        "default" : "B Corp Certification"
      },
      {
        "type": "url",
        "id": "url_2",
        "label": "Url 2"
      },
      {
        "type" : "header",
        "content": "Certificates of Analysis"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default" : "Certificates of Analysis"
      },
      {
        "type": "textarea",
        "id": "content_1",
        "label": "Content 1"
      },
      {
        "type": "textarea",
        "id": "content_2",
        "label": "Content 2"
      },
       {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      }
	],
    "blocks": [
     {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
        "type": "text",
        "id": "button",
        "label": "Button Title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Button Url"
        }
      ]
     }
	]
  }
{% endschema %}