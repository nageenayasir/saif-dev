                <div class="row d-block d-md-none">

                    <div class="col-md-6 text-center" data-aos="fade-up">
                        {{ section.settings.sub_title }}
                    </div>
                    <div class="col-md-6">
                        <div data-aos="fade-up">
                            <a class="btn btn-trans mx-auto mt-4" href="{{ section.settings.url }}" target="_self">
                                {{ section.settings.button }}
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="qta">
            <div class="row justify-content-center">
                <div class="col-md-12 col-lg-8">
                    <div class="row">
                      {% for block in section.blocks %}
                        <div class="col-4">
                            <div class="qta-item text-center" data-aos="fade-up" data-aos-delay="000">
                                <img loading="lazy"  src="{{ block.settings.logo | image_url : width: 300 }}">
                            </div>
                        </div>
                      {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% schema %}
  {
    "name": "Section Why",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default" : "Our Why"
      },
      {
        "type": "richtext",
        "id": "sub_title",
        "label": "Subtitle" 
      },
      {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default" : "Meet Our Ingredients"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Url"
    }
	]
  }
{% endschema %}