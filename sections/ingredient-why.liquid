<section class="section section-why">
    <div class="leaf-box left-bot">
        <img loading="lazy"  class="leaf" src="{{ 'leaf-n03.svg' | asset_url }}">
    </div>
    <div class="container">
        <div class="row justify-content-center">
            <h2 class="text-uppercase text-center d-block d-md-none" data-aos="fade-up">{{ section.settings.title }}</h2>
            <div class="col-md-12 col-lg-10">
                <div class="row d-none d-md-flex">
                    <div class="col-md-6">
                        <h2 class="text-uppercase" data-aos="fade-up">{{ section.settings.title }}</h2>
                        <div data-aos="fade-up">
                            <a class="btn btn-trans" href="{{ section.settings.url }}" target="_self">
                                {{ section.settings.button }}
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 mt-3" data-aos="fade-up">
                        {{ section.settings.sub_title }}
                    </div>
                </div>

                <div class="map" id="end-sticky" data-aos="fade-in" data-aos-delay="100">
                            <img loading="lazy"  data-aos="fade-in" data-aos-delay="100" src="{{ 'map.png' | asset_url }}">

