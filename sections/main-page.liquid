<div class="page-section section-padding">
  <div class="page-width">
    <div style="max-width:80rem; margin:0 auto;">
      <h1 style="font-family:var(--font-heading-family); font-size:clamp(3rem, 5vw, 5rem); font-weight:800; color:rgb(var(--color-base-text)); margin:0 0 2.4rem; text-transform:uppercase; letter-spacing:-0.02em;">
        {{ page.title }}
      </h1>
      <div class="rte" style="font-size:1.6rem; line-height:1.75; color:rgba(var(--color-base-text),0.75);">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section-main-page",
  "settings": [],
  "presets": [{ "name": "Page" }]
}
{% endschema %}
