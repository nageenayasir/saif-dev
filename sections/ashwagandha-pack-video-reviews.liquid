<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
{% comment %} RGD: 2026-01-04 {% endcomment %} 
{% comment %} 
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.0.7/css/swiper.min.css" media="all" />
{% endcomment %} 
<link rel="stylesheet" href="{{ 'swiper.min.css' | asset_url }}" type="text/css" media="all"/>
<section id="id-{{ section.id }}" class="ashwagandha-pack-video-reviews">
  <div class="container">
    <div class="row">
      <div class="swiper ashwagandha-pach-video-slider {% if section.blocks.size == 1 %}single-slide--center{% endif %}">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide">
                <div class="prduct-video-wrapper">
                  <div class="installation-video-inner">
                    <div class="installation-video">
                      <video
                        style="display:block;"
                        id="myVideo"
                        width="100%"
                        poster="{% if block.settings.video_poster != blank %} {{ block.settings.video_poster | image_url: width: 2000 }} {% endif %}"
                        playsinline
                      >
                        <source src="{{ block.settings.bg_video }}" type="video/mp4">
                      </video>
                      <div class="play-button">
                        <img src="https://cdn.shopify.com/s/files/1/0499/0425/5134/files/Button.png?v=1715327588">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
        </div>
        <!-- If we need navigation buttons -->
            <div class="swiper-button-prev ashwagandha-pack-button-prev"></div>
            <div class="swiper-button-next ashwagandha-pack-button-next"></div>
      </div>
    </div>
  </div>
</section>
{% comment %} RGD: 2026-01-04 {% endcomment %} 
{% comment %} 
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script> 
<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.5.1/js/swiper.min.js"></script> 
{% endcomment %}
{% # theme-check-disable ParserBlockingScript %}
<script type="text/javascript" src="{{ 'jquery-3.5.1.min.js' | asset_url }}"></script>
<script type="text/javascript" src="{{ 'swiper.min.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}
<script>
  $(document).ready(function() {
    function toggleVideo(video) {
      if (video.paused) {
        video.play();
      } else {
        video.pause();
      }
    }

    function pauseOtherVideos(clickedVideo) {
      $('.installation-video').each(function() {
        var video = $(this).find('video')[0];
        if (video !== clickedVideo && !video.paused) {
          video.pause();
        }
      });
    }

    $('.installation-video').each(function() {
      var video = $(this).find('video')[0];
      var playButton = $(this).find('.play-button');

      playButton.click(function(e) {
        e.stopPropagation();
        toggleVideo(video);
        pauseOtherVideos(video);
      });

      video.addEventListener('play', function() {
        playButton.hide();
      });

      video.addEventListener('pause', function() {
        playButton.show();
      });

      $(video).click(function() {
        toggleVideo(video);
        pauseOtherVideos(video);
      });
    });
  });
  var slides = document.querySelectorAll('.ashwagandha-pach-video-slider .swiper-slide');
    
    if (slides.length <= 3) {
      if (window.innerWidth >= 992) {
        document.querySelector('.ashwagandha-pack-button-prev').style.display = 'none';
        document.querySelector('.ashwagandha-pack-button-next').style.display = 'none';
      }
    }

  new Swiper('.ashwagandha-pach-video-slider', {
        loop: false,
        slidesPerView: 3,
        navigation: {
          nextEl: '.ashwagandha-pack-button-next',
          prevEl: '.ashwagandha-pack-button-prev',
        },
        spaceBetween: 20,
        breakpoints: {
            1028: {
                slidesPerView: 2,
                spaceBetween: 30
            },
            576: {
                slidesPerView: 1,
                spaceBetween: 10
            }
        }
    });
</script>
{% schema %}
  {
    "name": "Ashwagandha Video Reviews",
    "settings": [
      {
            "type": "header",
            "content": "Content Style"
         },
  	     {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
        }
    ],
	"blocks": [
     {
      "type": "video_reviews",
      "name": "Video Reviews",
      "settings": [
        {
          "type": "image_picker",
          "id": "video_poster",
          "label": "Poster Image"
      	 },
        {
          "type": "url",
          "id": "bg_video",
          "label": "Video Url"
        }
      ]
     }
	],
	"presets": [{
      "name": "Ashwagandha Video Reviews"
    }]
  }
{% endschema %}