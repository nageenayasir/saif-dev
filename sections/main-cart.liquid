<section class="section-padding cart-page" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <h1 style="font-family:var(--font-heading-family); font-size:clamp(3rem,5vw,5rem); font-weight:800; color:rgb(var(--color-base-text)); margin:0 0 4rem; text-transform:uppercase; letter-spacing:-0.02em;">
      {{ 'sections.cart.title' | t | default: 'Your cart' }}
    </h1>

    {%- if cart.item_count == 0 -%}
      <div style="text-align:center; padding:6rem 0;">
        <p style="font-size:1.8rem; color:rgba(var(--color-base-text),0.6); margin:0 0 2.4rem;">Your cart is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">Continue shopping</a>
      </div>
    {%- else -%}
      <div style="display:grid; grid-template-columns:1fr; gap:4rem;">
        <!-- Cart Items -->
        <div>
          {%- for item in cart.items -%}
            <div style="display:flex; gap:2rem; padding:2rem 0; border-bottom:1px solid rgba(var(--color-base-text),0.1); align-items:start;">
              <a href="{{ item.url }}" style="flex-shrink:0;">
                {{
                  item.image
                  | image_url: width: 200
                  | image_tag:
                    loading: 'lazy',
                    width: 100,
                    height: 100,
                    style: 'width:10rem;height:10rem;object-fit:cover;border-radius:0.6rem;'
                }}
              </a>
              <div style="flex:1; display:flex; flex-direction:column; gap:0.8rem;">
                <h3 style="font-size:1.6rem; font-weight:600; color:rgb(var(--color-base-text)); margin:0;">
                  <a href="{{ item.url }}" style="color:inherit;">{{ item.product.title }}</a>
                </h3>
                {%- unless item.product.has_only_default_variant -%}
                  <p style="font-size:1.3rem; color:rgba(var(--color-base-text),0.55); margin:0;">{{ item.variant.title }}</p>
                {%- endunless -%}
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-top:auto;">
                  <form action="{{ routes.cart_change_url }}" method="post">
                    <input type="hidden" name="id" value="{{ item.key }}">
                    <div class="quantity" style="height:3.6rem;">
                      <button type="button" class="quantity__button" style="width:3.6rem;height:3.6rem;">−</button>
                      <input type="number" name="quantity" class="quantity__input" value="{{ item.quantity }}" min="0" style="width:4rem;height:3.6rem;" aria-label="Quantity">
                      <button type="button" class="quantity__button" style="width:3.6rem;height:3.6rem;">+</button>
                    </div>
                  </form>
                  <span style="font-family:var(--font-heading-family); font-size:1.6rem; font-weight:700; color:rgb(var(--color-base-text));">{{ item.final_line_price | money }}</span>
                </div>
              </div>
              <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="color:rgba(var(--color-base-text),0.4); flex-shrink:0;" aria-label="Remove {{ item.product.title | escape }}">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M12 4L4 12M4 4l8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </a>
            </div>
          {%- endfor -%}
        </div>

        <!-- Cart Summary -->
        <div style="background:rgb(var(--color-base-background-2)); border-radius:1.2rem; padding:3rem; height:fit-content;">
          <h2 style="font-family:var(--font-heading-family); font-size:2rem; font-weight:700; color:rgb(var(--color-base-text)); margin:0 0 2rem; text-transform:uppercase;">Order Summary</h2>

          <div style="display:flex; flex-direction:column; gap:1rem; margin-bottom:2rem;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span style="font-size:1.5rem; color:rgba(var(--color-base-text),0.7);">Subtotal</span>
              <span style="font-size:1.6rem; font-weight:600; color:rgb(var(--color-base-text));">{{ cart.total_price | money }}</span>
            </div>
            {%- if cart.total_discounts > 0 -%}
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:1.5rem; color:rgb(var(--color-base-accent-1));">Savings</span>
                <span style="font-size:1.5rem; font-weight:600; color:rgb(var(--color-base-accent-1));">−{{ cart.total_discounts | money }}</span>
              </div>
            {%- endif -%}
          </div>

          <p style="font-size:1.3rem; color:rgba(var(--color-base-text),0.5); margin:0 0 2rem;">Shipping and taxes calculated at checkout.</p>

          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="button button--primary button--full-width button--large">
              Checkout — {{ cart.total_price | money }}
            </button>
          </form>

          <a href="{{ routes.all_products_collection_url }}" style="display:block; text-align:center; font-size:1.4rem; color:rgba(var(--color-base-text),0.55); margin-top:1.4rem; text-decoration:underline; text-underline-offset:2px;">
            Continue shopping
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [],
  "presets": [{ "name": "Cart" }]
}
{% endschema %}
