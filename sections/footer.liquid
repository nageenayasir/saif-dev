                              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                            </li>
                        {%- endfor -%}
                      {% endif %}
                      {% if block.settings.image %}
                        <img loading="lazy"  src="{{ block.settings.image | image_url : width: 600 }}" alt="Payment methods accepted" data-aos="fade-up" data-aos-delay="000" data-aos-anchor="#here-anchor">
                      {% endif %}
                      <p class="font-s text-uppercase" data-aos="fade-up" data-aos-delay="000" data-aos-anchor="#here-anchor">{{ block.settings.copyright }}</p>
                                          <p class="font-s disclaimer-text" style="text-transform: none !important;">{{ block.settings.content }}</p>
              {% endif %}
            {% endfor %}
          </div>
          {% if section.settings.the_text != blank %}
          <div class="col-sm-12 col-md-12 col-lg-12">
            <div class="footer-bottom-developed">
              {{ section.settings.the_text }}
            </div>
          </div>
        {% endif %}
    </div>
</footer>
 
{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        }
      ]
    },
    {
      "type": "copyright",
      "name": "Copyright",
      "limit" : 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show Social",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "default": "Follow",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "social_spotify_link",
          "label": "Link Social spotify" 
        },
        {
          "type": "checkbox",
          "id": "show_icon_payment",
          "label": "Show icon payment auto",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "html",
          "id": "copyright",
          "label": "Copyright"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "icon_1",
          "label": "Icon-1"
        },
        {
          "type": "image_picker",
          "id": "icon_2",
          "label": "Icon-2"
        }
      ]
    },
    {
      "type": "subscribe",
      "name": "Subscribe",
      "limit" : 1,
      "settings": [
        {
            "type": "text",
            "id": "title",
            "default": "Subscribe",
            "label": "Title"
        },
        {
            "type": "text",
            "id": "the_text",
            "label": "Text"
        },
        {
            "type": "textarea",
            "id": "content",
            "default": "You agree with the privacy policy and terms of use by subscibing.",
            "label": "Content"
        }
      ]
    }
    
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
       "type": "richtext",
       "id": "the_text",
        "label": "Text"
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "subscribe"
      },
      {
        "type": "copyright"
      }, 
      {
        "type": "link_list"
      },
      {
        "type": "link_list"
      },
      {
        "type": "link_list"
      },
      {
        "type": "link_list"
      }
    ]
  }
}
{% endschema %}