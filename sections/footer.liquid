            </a>
        </div>
        <div id="here-anchor" class="row">
              <div class="col-lg-6 left-side-footer">
              {%- for block in section.blocks -%}
                {% if block.type == 'subscribe' %}
                  <h2 class="text-uppercase footer-join-subscribe-text" data-aos="fade-up" data-aos-delay="000">{{ block.settings.title }}</h2>
                  <p class="footer-lifestyle-text" data-aos="fade-up" data-aos-delay="000">{{ block.settings.the_text }}</p>
                   {%- form 'customer', id: 'ContactFooter', class: 'newsletter-footer d-flex',data-aos : 'fade-up',data-aos-delay : '000'  -%}
                    <input id="NewsletterForm--{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'newsletter.label' | t }}" required>
                    <button type="submit" class="btn btn-bg" name="commit" id="Subscribe">{{ 'newsletter.button_label' | t }}</button>
                  {% endform %}
                  <p class="note font-s text-uppercase mt-3" data-aos="fade-up" data-aos-delay="000">{{ block.settings.content }}</p>
                {% endif %}
                {% if block.type == 'copyright' %}
                  <div class="d-none d-lg-block footer-social-right">
                     <div class="footer-social-media-custom-icons">
                <div class="footer-custom-new-icons">
                  <ul class="footer-iconnew-icons-lists">
                    <li>
                       {% if block.settings.icon_1 != blank %}<img loading="lazy" src="{{ block.settings.icon_1 | image_url: width: 2000 }}" alt="Certification badge">{% endif %}
                    </li>
                    <li>
                       {% if block.settings.icon_2 != blank %}<img loading="lazy" src="{{ block.settings.icon_2 | image_url: width: 2000 }}" alt="Certification badge">{% endif %}
                    </li>
                  </ul>
                </div>
                <div class="footer-social-media-icons">
                <h2 class="text-uppercase mt-4 pt-4 mt-md-5 pt-md-5 mb-2" data-aos="fade-up" data-aos-delay="000"  data-aos-anchor="#here-anchor">{{ block.settings.title }}</h2>
                <div class="socials mb-5 pb-lg-5" data-aos="fade-up" data-aos-delay="000"
                     data-aos-anchor="#here-anchor">


                              <a href="{{ settings.social_instagram_link }}" aria-label="Follow us on Instagram" target="_blank" rel="noopener">{%- render 'icon-instagram' -%}</a>


                              <a href="{{ settings.social_facebook_link }}" aria-label="Follow us on Facebook" target="_blank" rel="noopener">{%- render 'icon-facebook' -%}</a>

                              <a href="{{ section.settings.social_spotify_link }}" target="_blank" aria-label="Listen on Spotify" target="_blank" rel="noopener"><i class="fab fa-spotify"></i> </a>
                              <a href="{{ settings.social_youtube_link }}" aria-label="Subscribe on YouTube" target="_blank" rel="noopener">{%- render 'icon-youtube' -%}</a>
                              <a href="{{ settings.social_tiktok_link }}" aria-label="Follow us on TikTok" target="_blank" rel="noopener">{%- render 'icon-tiktok' -%}</a>


                    </div>
                  </div>
                </div>
                    {% if block.settings.show_icon_payment %}
                      {%- for type in shop.enabled_payment_types -%}
                          <li class="list-payment__item">
                            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                          </li>
                      {%- endfor -%}
                    {% endif %}
                    {% if block.settings.image %}
                      <div class="pay">
                      <img loading="lazy"  src="{{ block.settings.image | image_url : width: 600 }}" alt="Payment methods accepted" data-aos="fade-up" data-aos-delay="000" width="332" height="25">
                      </div>
                    {% endif %}
                      <p class="font-s text-uppercase" data-aos="fade-up" data-aos-delay="000">{{ block.settings.copyright | newline_to_br }}</p>
                                          <p class="font-s disclaimer-text" style="text-transform: none !important; max-width: 500px;">{{ block.settings.content }}</p>

                  </div>
                {% endif %}
                {% endfor %}
              </div>
              <div class="col-lg-6 mt-5 mt-lg-0">
                  <div class="row menu-footer-group">
                     {%- for block in section.blocks -%} 
                      {%- case block.type -%}
                        {%- when 'link_list' -%}
                          <div class="col-md-6">
                            <div class="menu-footer">
                                <h2 class="text-uppercase" data-aos="fade-up" data-aos-delay="000">{{ block.settings.heading }}</h2>
                                <div class="menu-s">
                                    <ul data-aos="fade-up" data-aos-delay="000">
                                        {%- for link in block.settings.menu.links -%}
                                          <li><a href="{{ link.url }}" aria-label="Reach out to Tribe Organics for {{ link.title }} and more">{{ link.title }}</a></li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                          </div>
                           {%- when 'contact' -%} 
                             <div class="col-md-6">
                              <div class="menu-footer">
                                  <h2 class="text-uppercase" data-aos="fade-up" data-aos-delay="000">{{ block.settings.heading }}</h2>
                                  <div class="menu-s">
                                      <ul data-aos="fade-up" data-aos-delay="000">
                                          {{ block.settings.custom_html }}
                                      </ul>
                                  </div>
                            </div>
                          </div>
                        {% endcase %}
                       {%- endfor -%} 
                      
                  </div>
              </div>
          </div>
          <div class="d-block d-lg-none footer-social-right">
          {%- for block in section.blocks -%}
            {% if block.type == 'copyright' %}
              <div class="footer-social-media-custom-icons">
                <div class="footer-custom-new-icons">
                  <ul class="footer-iconnew-icons-lists">
                    <li>
                       {% if block.settings.icon_1 != blank %}<img loading="lazy" src="{{ block.settings.icon_1 | image_url: width: 2000 }}" alt="Certification badge">{% endif %}
                    </li>
                    <li>
                       {% if block.settings.icon_2 != blank %}<img loading="lazy" src="{{ block.settings.icon_2 | image_url: width: 2000 }}" alt="Certification badge">{% endif %}
                    </li>
                  </ul>
                </div>
                <div class="footer-social-media-icons">
                <h2 class="text-uppercase mt-4 pt-4 mt-md-5 pt-md-5 mb-2" data-aos="fade-up" data-aos-delay="000"  data-aos-anchor="#here-anchor">{{ block.settings.title }}</h2>
                <div class="socials mb-5 pb-lg-5" data-aos="fade-up" data-aos-delay="000"
                     data-aos-anchor="#here-anchor">


                              <a href="{{ settings.social_instagram_link }}" aria-label="Follow us on Instagram" target="_blank" rel="noopener">{%- render 'icon-instagram' -%}</a>


                              <a href="{{ settings.social_facebook_link }}" aria-label="Follow us on Facebook" target="_blank" rel="noopener">{%- render 'icon-facebook' -%}</a>

                              <a href="{{ section.settings.social_spotify_link }}" target="_blank" rel="noopener" aria-label="Listen on Spotify"><i class="fab fa-spotify"></i> </a>
