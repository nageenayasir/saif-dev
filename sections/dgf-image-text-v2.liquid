{% comment %}
  [DGF] Image and Text V2
  Author: Rodrigo Gesser
  Two-column section: Title + Text | Image (reversible)
{% endcomment %}

{% liquid
  assign bg_color = section.settings.background_color | default: '#ffffff'

  assign title_font = section.settings.title_font | default: 'HypatiaSansPro'
  assign title_font_size = section.settings.title_font_size | default: 22
  assign title_font_size_mobile = section.settings.title_font_size_mobile | default: 18
  assign title_font_weight = section.settings.title_font_weight | default: '700'
  assign title_transform = section.settings.title_transform | default: 'uppercase'
  assign title_color = section.settings.title_color | default: '#333333'

  assign text_font = section.settings.text_font | default: 'HypatiaSansPro'
  assign text_font_size = section.settings.text_font_size | default: 16
  assign text_font_size_mobile = section.settings.text_font_size_mobile | default: 14
  assign text_font_weight = section.settings.text_font_weight | default: '400'
  assign text_transform = section.settings.text_transform | default: 'none'
  assign text_color = section.settings.text_color | default: '#555555'

  assign image_position = section.settings.image_position | default: 'right'
  assign columns_gap = section.settings.columns_gap | default: 0
  assign columns_vertical_align = section.settings.columns_vertical_align | default: 'center'
  assign image_border_radius = section.settings.image_border_radius | default: 0
  assign icon_size = section.settings.icon_size | default: 24

  assign padding_top = section.settings.padding_top | default: 40
  assign padding_bottom = section.settings.padding_bottom | default: 40
  assign padding_left = section.settings.padding_left | default: 0
  assign padding_right = section.settings.padding_right | default: 0
  assign text_col_padding = section.settings.text_col_padding | default: 30

  assign sid = section.id
%}

<section id="dgf-itv2-{{ sid }}" style="background-color: {{ bg_color }};">
  <div class="container">
    <div class="dgf-itv2-columns" style="flex-direction: {% if image_position == 'left' %}row-reverse{% else %}row{% endif %};">

      <!-- Text Column -->
      <div class="dgf-itv2-col-text">
        {% if section.settings.title != blank %}
          <div class="dgf-itv2-title">
            {% if section.settings.title_icon != blank %}
              <img class="dgf-itv2-title-icon" src="{{ section.settings.title_icon | image_url }}" alt="">
            {% endif %}
            {{ section.settings.title }}
          </div>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="dgf-itv2-text">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      <!-- Image Column -->
      {% if section.settings.image != blank %}
        <div class="dgf-itv2-col-image">
          <img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt | default: '' }}">
        </div>
      {% endif %}

    </div>
  </div>
</section>

<style>
  #dgf-itv2-{{ sid }} {
    padding: {{ padding_top }}px {{ padding_right }}px {{ padding_bottom }}px {{ padding_left }}px;
  }

  #dgf-itv2-{{ sid }} .dgf-itv2-columns {
    display: flex;
    width: 100%;
    gap: {{ columns_gap }}px;
    align-items: {{ columns_vertical_align }};
  }

  #dgf-itv2-{{ sid }} .dgf-itv2-col-text {
    flex: 1;
    padding: {{ text_col_padding }}px;
  }

  #dgf-itv2-{{ sid }} .dgf-itv2-col-image {
    flex: 1;
  }

  #dgf-itv2-{{ sid }} .dgf-itv2-col-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: {{ image_border_radius }}px;
  }

  /* Title Icon */
  #dgf-itv2-{{ sid }} .dgf-itv2-title-icon {
    width: {{ icon_size }}px;
    height: auto;
    display: inline-block;
    vertical-align: middle;
    margin-right: 6px;
  }

  /* Title Font */
  #dgf-itv2-{{ sid }} .dgf-itv2-title,
  #dgf-itv2-{{ sid }} .dgf-itv2-title h1,
  #dgf-itv2-{{ sid }} .dgf-itv2-title h2,
  #dgf-itv2-{{ sid }} .dgf-itv2-title h3,
  #dgf-itv2-{{ sid }} .dgf-itv2-title h4,
  #dgf-itv2-{{ sid }} .dgf-itv2-title h5,
  #dgf-itv2-{{ sid }} .dgf-itv2-title h6,
  #dgf-itv2-{{ sid }} .dgf-itv2-title p,
  #dgf-itv2-{{ sid }} .dgf-itv2-title span,
  #dgf-itv2-{{ sid }} .dgf-itv2-title strong,
  #dgf-itv2-{{ sid }} .dgf-itv2-title em,
  #dgf-itv2-{{ sid }} .dgf-itv2-title i,
  #dgf-itv2-{{ sid }} .dgf-itv2-title u,
  #dgf-itv2-{{ sid }} .dgf-itv2-title a {
    font-family: {{ title_font }} !important;
    font-size: {{ title_font_size }}px !important;
    font-weight: {{ title_font_weight }} !important;
    text-transform: {{ title_transform }} !important;
    color: {{ title_color }} !important;
    line-height: 1.3 !important;
    margin: 0;
  }

  #dgf-itv2-{{ sid }} .dgf-itv2-title {
    margin-bottom: 15px;
  }

  /* Text Font */
  #dgf-itv2-{{ sid }} .dgf-itv2-text,
  #dgf-itv2-{{ sid }} .dgf-itv2-text h1,
  #dgf-itv2-{{ sid }} .dgf-itv2-text h2,
  #dgf-itv2-{{ sid }} .dgf-itv2-text h3,
  #dgf-itv2-{{ sid }} .dgf-itv2-text h4,
  #dgf-itv2-{{ sid }} .dgf-itv2-text h5,
  #dgf-itv2-{{ sid }} .dgf-itv2-text h6,
  #dgf-itv2-{{ sid }} .dgf-itv2-text p,
  #dgf-itv2-{{ sid }} .dgf-itv2-text span,
  #dgf-itv2-{{ sid }} .dgf-itv2-text strong,
  #dgf-itv2-{{ sid }} .dgf-itv2-text em,
  #dgf-itv2-{{ sid }} .dgf-itv2-text i,
  #dgf-itv2-{{ sid }} .dgf-itv2-text u,
  #dgf-itv2-{{ sid }} .dgf-itv2-text a {
    font-family: {{ text_font }} !important;
    font-size: {{ text_font_size }}px !important;
    font-weight: {{ text_font_weight }} !important;
    text-transform: {{ text_transform }} !important;
    color: {{ text_color }} !important;
    line-height: 1.5 !important;
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    #dgf-itv2-{{ sid }} .dgf-itv2-columns {
      flex-direction: column !important;
    }

    #dgf-itv2-{{ sid }} {
      margin-top: -2rem;
  }

    #dgf-itv2-{{ sid }} .dgf-itv2-title,
    #dgf-itv2-{{ sid }} .dgf-itv2-title h1,
    #dgf-itv2-{{ sid }} .dgf-itv2-title h2,
    #dgf-itv2-{{ sid }} .dgf-itv2-title h3,
    #dgf-itv2-{{ sid }} .dgf-itv2-title h4,
    #dgf-itv2-{{ sid }} .dgf-itv2-title h5,
    #dgf-itv2-{{ sid }} .dgf-itv2-title h6,
    #dgf-itv2-{{ sid }} .dgf-itv2-title p,
    #dgf-itv2-{{ sid }} .dgf-itv2-title span,
    #dgf-itv2-{{ sid }} .dgf-itv2-title strong,
    #dgf-itv2-{{ sid }} .dgf-itv2-title em,
    #dgf-itv2-{{ sid }} .dgf-itv2-title i,
    #dgf-itv2-{{ sid }} .dgf-itv2-title u,
    #dgf-itv2-{{ sid }} .dgf-itv2-title a {
      font-size: {{ title_font_size_mobile }}px !important;
    }

    #dgf-itv2-{{ sid }} .dgf-itv2-text,
    #dgf-itv2-{{ sid }} .dgf-itv2-text h1,
    #dgf-itv2-{{ sid }} .dgf-itv2-text h2,
    #dgf-itv2-{{ sid }} .dgf-itv2-text h3,
    #dgf-itv2-{{ sid }} .dgf-itv2-text h4,
    #dgf-itv2-{{ sid }} .dgf-itv2-text h5,
    #dgf-itv2-{{ sid }} .dgf-itv2-text h6,
    #dgf-itv2-{{ sid }} .dgf-itv2-text p,
    #dgf-itv2-{{ sid }} .dgf-itv2-text span,
    #dgf-itv2-{{ sid }} .dgf-itv2-text strong,
    #dgf-itv2-{{ sid }} .dgf-itv2-text em,
    #dgf-itv2-{{ sid }} .dgf-itv2-text i,
    #dgf-itv2-{{ sid }} .dgf-itv2-text u,
    #dgf-itv2-{{ sid }} .dgf-itv2-text a {
      font-size: {{ text_font_size_mobile }}px !important;
    }

    #dgf-itv2-{{ sid }} .dgf-itv2-col-text {
      padding: 20px 15px;
    }

    #dgf-itv2-{{ sid }} .dgf-itv2-col-image{
      margin: -4rem;
    }
  }
</style>

{% schema %}
  {
    "name": "[DGF] Image and Text V2",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "html",
        "id": "title",
        "label": "Title (HTML)"
      },
      {
        "type": "html",
        "id": "text",
        "label": "Text (HTML)"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "image_picker",
        "id": "title_icon",
        "label": "Title Icon"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "Image Position",
        "options": [
          { "value": "right", "label": "Right" },
          { "value": "left", "label": "Left" }
        ],
        "default": "right"
      },
      {
        "type": "select",
        "id": "columns_vertical_align",
        "label": "Columns Vertical Alignment",
        "options": [
          { "value": "flex-start", "label": "Top" },
          { "value": "center", "label": "Center" },
          { "value": "flex-end", "label": "Bottom" },
          { "value": "stretch", "label": "Stretch" }
        ],
        "default": "center"
      },
      {
        "type": "range",
        "id": "columns_gap",
        "label": "Gap Between Columns",
        "min": 0,
        "max": 60,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "image_border_radius",
        "label": "Image Border Radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "icon_size",
        "label": "Title Icon Size",
        "min": 12,
        "max": 60,
        "step": 1,
        "default": 24,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "text_col_padding",
        "label": "Text Column Padding",
        "min": 0,
        "max": 80,
        "step": 5,
        "default": 30,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Title Font"
      },
      {
        "type": "select",
        "id": "title_font",
        "label": "Title Font Family",
        "options": [
          { "value": "HypatiaSansPro", "label": "Hypatia Sans Pro" },
          { "value": "'Superior Title Italic'", "label": "Superior Title Italic" },
          { "value": "inherit", "label": "Inherit" }
        ],
        "default": "HypatiaSansPro"
      },
      {
        "type": "range",
        "id": "title_font_size",
        "label": "Title Font Size (Desktop)",
        "min": 12,
        "max": 60,
        "step": 1,
        "default": 22,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "title_font_size_mobile",
        "label": "Title Font Size (Mobile)",
        "min": 12,
        "max": 40,
        "step": 1,
        "default": 18,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "title_font_weight",
        "label": "Title Font Weight",
        "options": [
          { "value": "400", "label": "Normal" },
          { "value": "600", "label": "Semi Bold" },
          { "value": "700", "label": "Bold" },
          { "value": "800", "label": "Extra Bold" }
        ],
        "default": "700"
      },
      {
        "type": "select",
        "id": "title_transform",
        "label": "Title Text Transform",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "uppercase", "label": "Uppercase" },
          { "value": "lowercase", "label": "Lowercase" },
          { "value": "capitalize", "label": "Capitalize" }
        ],
        "default": "uppercase"
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Title Color",
        "default": "#333333"
      },
      {
        "type": "header",
        "content": "Text Font"
      },
      {
        "type": "select",
        "id": "text_font",
        "label": "Text Font Family",
        "options": [
          { "value": "HypatiaSansPro", "label": "Hypatia Sans Pro" },
          { "value": "'Superior Title Italic'", "label": "Superior Title Italic" },
          { "value": "inherit", "label": "Inherit" }
        ],
        "default": "HypatiaSansPro"
      },
      {
        "type": "range",
        "id": "text_font_size",
        "label": "Text Font Size (Desktop)",
        "min": 10,
        "max": 40,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "text_font_size_mobile",
        "label": "Text Font Size (Mobile)",
        "min": 10,
        "max": 30,
        "step": 1,
        "default": 14,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "text_font_weight",
        "label": "Text Font Weight",
        "options": [
          { "value": "400", "label": "Normal" },
          { "value": "600", "label": "Semi Bold" },
          { "value": "700", "label": "Bold" },
          { "value": "800", "label": "Extra Bold" }
        ],
        "default": "400"
      },
      {
        "type": "select",
        "id": "text_transform",
        "label": "Text Transform",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "uppercase", "label": "Uppercase" },
          { "value": "lowercase", "label": "Lowercase" },
          { "value": "capitalize", "label": "Capitalize" }
        ],
        "default": "none"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#555555"
      },
      {
        "type": "header",
        "content": "Styling"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 150,
        "step": 5,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom",
        "min": 0,
        "max": 150,
        "step": 5,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_left",
        "label": "Padding Left",
        "min": 0,
        "max": 150,
        "step": 5,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_right",
        "label": "Padding Right",
        "min": 0,
        "max": 150,
        "step": 5,
        "default": 0,
        "unit": "px"
      }
    ],
    "presets": [
      {
        "name": "[DGF] Image and Text V2"
      }
    ]
  }
{% endschema %}