<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }

  .first-homepage-featured-products-button-prev,
  .first-homepage-featured-products-button-next{
    z-index: 11!important;
  }
</style>
<section id="id-{{ section.id }}" class="section homepage-featured-product-first common-homepage-featured-products">
    <div class="container">
        <div class="row">
            <div class="col-md-4 col-lg-3 z-index-2">
                <h2 class="text-uppercase" data-aos="fade-up">{{ section.settings.title }}</h2>
                <p data-aos="fade-up">{{ section.settings.sub_title }}</p>
                <div class="mt-4" data-aos="fade-up">
                    <a class="btn btn-trans" href="{{ section.settings.url }}" target="_self">
                       {{ section.settings.button }}
                    </a>
                </div>
            </div>
            <div class="col-md-8 col-lg-9 z-index-1 common-swiper-column-wrapper">
                <div class="swiper-wrapper-box">
                    <div class="swiper homepage-featured-products-first-slider">
                        <div class="swiper-wrapper">
                          {% for block in section.blocks  %}
                          {% assign product = block.settings.product %}
                            <div class="swiper-slide">
                                <a href="{{ product.url }}" class="product-item">
                                    <div class="img-wrapper">
                                        <img loading="lazy"  alt="{{ product.featured_image.alt | default : product.title }}" class="lazyload no-hover-product-image" data-src="{{ product.featured_media | image_url: width: 800 }}">
                                        <img loading="lazy"  alt="{{ product.images[1].alt | default : product.title }}" class="lazyload hover-product-image" data-src="{{ product.images[1] | image_url: width: 800 }}">
                                        <form class="homepage-related-atc-btn" method="post" action="/cart/add">
                                          <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                                          {% if product.available %}
                                          <input type="submit" value="Add to cart" class="btn" aria-label="Add To Cart - Button"/>
                                            {% else %}
                                          <input id="sold-button" value="Sold Out" class="btn" disabled aria-label="Sold Out - Product unavailable"/>
                                          {% endif %}
                                        </form>
                                    </div>
                                    <div class="category">{% if product.metafields.custom.custom_category_badge %}{{ product.metafields.custom.custom_category_badge }}{% else %}{{ product.collections[0].title }}{% endif %}</div>
                                    <div class="p-title">{{ product.title }}</div>
                                    {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', jm_style: '', concierge_install: true, product: product %}
                                    {% if product.title == 'Ashwagandha KSM-66' %}
                                    {% assign second_variant = product.variants[0] %}
                                    <div class="price">
                                      {% if second_variant.compare_at_price and second_variant.compare_at_price > 0 %}
                                        <del>{{ second_variant.compare_at_price | money }}</del>
                                      {% endif %}
                                      {{ second_variant.price | money }}
                                    </div>
                                    {% else %}
                                      <div class="price">{% if product.selected_or_first_available_variant.compare_at_price and product.selected_or_first_available_variant.compare_at_price > 0 %}<del>{{ product.selected_or_first_available_variant.compare_at_price | money }}</del>{% endif %} {{ product.price | money }}</div>
                                    {% endif %}
                                </a>
                            </div>
                          {% endfor %} 
                        </div>
                    </div>
                    <!-- If we need navigation buttons -->
                    <div class="swiper-button-prev first-homepage-featured-products-button-prev"></div>
                    <div class="swiper-button-next first-homepage-featured-products-button-next"></div>  
                </div>
            </div>
        </div>
        {% comment %}
        <div class="swiper-wrapper-pagination position-relative">
            <div class="homepage-featured-products-first-swiper-scrollbar"></div>
        </div>
        {% endcomment %}
    </div>
</section>
{% comment %} RGD: 2026-01-04 {% endcomment %} 
{% comment %} 
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script> 
<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.5.1/js/swiper.min.js"></script> 
{% endcomment %}
{% # theme-check-disable ParserBlockingScript %}
<script type="text/javascript" src="{{ 'jquery-3.5.1.min.js' | asset_url }}"></script>
<script type="text/javascript" src="{{ 'swiper.min.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}
<script>
  new Swiper('.homepage-featured-products-first-slider', {
        loop: false,
        slidesPerView: 3,
        navigation: {
          nextEl: '.first-homepage-featured-products-button-next',
          prevEl: '.first-homepage-featured-products-button-prev',
        },
        spaceBetween: 10,
        breakpoints: {
            1024: {
                slidesPerView: 2
            },
            768: {
                slidesPerView: 1.5,
                spaceBetween: 10
            }
        }
    });
</script>
{% schema %}
  {
    "name": "Featured Product-1",
    "tag": "section",
    "class": "section",
    "settings": [
          {
            "type": "header",
            "content": "Content Style"
         },
  	     {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
		  "default" : "seasonal picks"
        },
		{
          "type": "textarea",
          "id": "sub_title",
          "label": "SubTitle",
		  "default" : "The seasons change and give us what we need to thrive through them. Here’s what Spring has sprung."
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button",
          "default" : "SHOP COLLECTION"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Url"
        }
	],
	"blocks": [
     {
      "type": "product",
      "name": "product",
      "limit" : 10,
      "settings": [
	  {
        "type": "product",
        "id": "product",
        "label": "Products"
      }
      ]
     }
	],
     "presets": [
    {
      "name": "Featured Product-1",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
  }
{% endschema %}