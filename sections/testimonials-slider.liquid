<section class="section-padding testimonials-section" id="shopify-section-{{ section.id }}"
  style="background:rgb(var(--color-base-background-2));">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="section-heading">
        <h2 class="section-heading__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="slider-wrapper">
      <div class="slider-track testimonials-track" id="TestimonialsTrack-{{ section.id }}"
           style="display:grid; grid-template-columns: repeat({{ section.blocks.size }}, min(100%, 36rem)); gap:2rem; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            <div class="testimonial-card" {{ block.shopify_attributes }}
                 style="scroll-snap-align:start; background:rgb(var(--color-base-background-1)); border-radius:1.2rem; padding:3rem; display:flex; flex-direction:column; gap:1.6rem; border:1px solid rgba(var(--color-base-text),0.08);">
              <!-- Stars -->
              <div style="display:flex; gap:0.3rem;">
                {%- for i in (1..5) -%}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="#f4a224" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M8 1l1.85 3.74L14 5.5l-3 2.92.71 4.12L8 10.5l-3.71 1.95.71-4.12L2 5.5l4.15-.76L8 1z"/>
                  </svg>
                {%- endfor -%}
              </div>

              <!-- Quote -->
              {%- if block.settings.quote != blank -%}
                <blockquote style="margin:0; font-size:1.6rem; line-height:1.65; color:rgb(var(--color-base-text)); font-style:italic;">
                  &ldquo;{{ block.settings.quote }}&rdquo;
                </blockquote>
              {%- endif -%}

              <!-- Author -->
              <div style="display:flex; align-items:center; gap:1.4rem; margin-top:auto;">
                {%- if block.settings.avatar != blank -%}
                  {{
                    block.settings.avatar
                    | image_url: width: 80
                    | image_tag:
                      loading: 'lazy',
                      width: 48,
                      height: 48,
                      style: 'width:4.8rem;height:4.8rem;border-radius:50%;object-fit:cover;flex-shrink:0;'
                  }}
                {%- else -%}
                  <div style="width:4.8rem;height:4.8rem;border-radius:50%;background:rgba(var(--color-base-text),0.1);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.8rem;font-weight:700;color:rgb(var(--color-base-text));">
                    {{ block.settings.author | slice: 0 }}
                  </div>
                {%- endif -%}
                <div>
                  {%- if block.settings.author != blank -%}
                    <p style="font-weight:700; font-size:1.4rem; color:rgb(var(--color-base-text)); margin:0;">{{ block.settings.author }}</p>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <p style="font-size:1.3rem; color:rgba(var(--color-base-text),0.55); margin:0.2rem 0 0;">{{ block.settings.title }}</p>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Navigation dots -->
    {%- if section.blocks.size > 1 -%}
      <div class="slider-nav" aria-label="Testimonial navigation">
        <button class="slider-nav__btn" data-direction="prev" aria-label="Previous" data-target="TestimonialsTrack-{{ section.id }}">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 13L5 8l5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="slider-dots">
          {%- for block in section.blocks -%}
            <button class="slider-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" data-target="TestimonialsTrack-{{ section.id }}" aria-label="Go to testimonial {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
        <button class="slider-nav__btn" data-direction="next" aria-label="Next" data-target="TestimonialsTrack-{{ section.id }}">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I see results, great quality and reasonably priced."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Happy Customer"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Author title/role"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author photo"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Hear why people love us..."
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "I see results, great quality and reasonably priced.", "author": "Yolonda King-Taylor", "title": "Holistic Health Practitioner" } },
        { "type": "testimonial", "settings": { "quote": "Immediately noticed a difference after switching.", "author": "Michelle" } },
        { "type": "testimonial", "settings": { "quote": "Best organic supplements I've found. Love this brand!", "author": "James R." } }
      ]
    }
  ]
}
{% endschema %}
