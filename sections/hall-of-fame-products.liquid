<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="hall-fame-products-section">
  <div class="hall-fame-products-wrapper">
    <div class="container">
      {% if section.settings.the_title1 or section.settings.the_title2 != blank %}
      <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12">
          <div class="hall-fame-products-title">
            <h3>{{ section.settings.the_title1 }}</h3>
            <h3>{{ section.settings.the_title2 }}</h3>
          </div>
        </div>
      </div>
      {% endif %}
      <div class="hall-fame-product-row-lists">
        <div class="row hall-fame-product-lists-wrap">
          {% for block in section.blocks  %}
            <div class="col-lg-2 col-md-2 col-sm-6 hall-fame-product-blocks">
              <div class="hall-fame-product-lists">
                <div class="hall-fame-product-img">
                  {% if block.settings.product_image != blank %}<img loading="lazy"  src="{{ block.settings.product_image | image_url: width: 2000 }}">{% endif %}
                </div>
                <div class="cstm-atc">
                  <a href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
                </div>
              </div>
            </div>
          {% endfor %} 
          
         <div class="hall-fame-right-content-wrap">
            <p><span>{{ section.settings.the_text }}</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Hall of Fame Products",
    "settings": [
        {
            "type": "header",
            "content": "Content Style"
        },
	    {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
        },
       {
          "type": "text",
          "id": "the_title1",
          "label": "Title-1"
      	},
        {
          "type": "text",
          "id": "the_title2",
          "label": "Title-2"
      	},
        {
          "type": "text",
          "id": "the_text",
          "label": "Text"
      	}
    ],
	"blocks": [
         {
          "type": "product_list",
          "name": "Product List",
          "settings": [
              {
                   "type": "image_picker",
                   "id": "product_image",
                    "label": "Image"
               },
                {
                   "type": "text",
                   "id": "button_text",
                   "label": "Text"
                },
        	    {
                   "type": "url",
                   "id": "button_link",
                   "label": "Link",
                   "info": "Specify the URL address if you want to make the Button clickable."
                }
          ]
         }
	],
	"presets": [{
      "name": "Hall of Fame Products"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}