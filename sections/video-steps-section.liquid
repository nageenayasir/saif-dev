<section id="id-{{section.id}}" class="col-step-one-rvw rvw-bg-main">
  <div class="container">
    <div class="inner-step-rvw">
      <div class="col-sm-12 col-md-6 col-lg-8 inner-step-left">
        <h2 data-aos="fade-up">{{ section.settings.the_title }}</h2>
        <p data-aos="fade-up">{{ section.settings.the_text }}</p>
        {% if section.settings.text_1 != blank %}<b data-aos="fade-up">{{ section.settings.text_1 }}</b>{% endif %}
        {% if section.settings.text_2 != blank %}<b data-aos="fade-up">{{ section.settings.text_2 }}<a href="{{ section.settings.link }}"><span> {{ section.settings.link_text }}</span></a></b>{% endif %}
      </div>
      <div class="col-sm-12 col-md-6 col-lg-4 inner-step-right" data-aos="fade-up">
        {% if section.settings.the_image !=blank %}<img loading="lazy" src="{{ section.settings.the_image | image_url: width: 2000 }}">{% endif %}
      </div>
    </div>
  </div>
</section> 
{% schema %}
  {
    "name": "Video Steps Section",
    "settings": [
      {
          "type": "text",
          "id": "the_title",
          "label": "Title"
      },
      {
          "type": "textarea",
          "id": "the_text",
          "label": "Text-1"
      }, {
          "type": "textarea",
          "id": "text_1",
          "label": "Text-2",
          "info": "Using <span> for change the text color"
      },
      {
          "type": "text",
          "id": "text_2",
          "label": "Text-3"
      },
      {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
      }, {
          "type": "url",
          "id": "link",
          "label": "Link"
      },
      {
          "type": "header",
          "content": "Image Settings"
      },
      {
          "type": "image_picker",
          "id": "the_image",
          "label": "Image"
      }
    ],
	"presets": [{
      "name": "Video Step Section"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}