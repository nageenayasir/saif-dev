<script>
  $(document).ready(function() {
    var targetNode = document.body;

    var observer = new MutationObserver(function(mutationsList, observer) {
      for (var mutation of mutationsList) {
        if (mutation.type === 'childList') {
          // Select all elements with class `.custom-products-loop`
          var elements = $('.custom-products-loop');

          // Check if there are at least 3 such elements
          if (elements.length >= 3) {
            // Add the `checking-3rd-element` class to the third `.custom-products-loop` element (index 2)
            if (!$(elements[2]).hasClass('checking-3rd-element')) {
              $(elements[2]).addClass('checking-3rd-element');
            }

            // Append a new div with custom text after the third element if not already added
            if ($('.custom-subscribe-image-div').length === 0) {
              $(elements[2]).after(
                '<div class="custom-subscribe-image-div spf-col-xl-4 spf-col-lg-4 spf-col-md-6 spf-col-sm-6 spf-col-6  mb-5">' +
                '<a>' +
                '<img loading="lazy" class="leaf" src="{{ section.settings.subscribe_image | img_url: 'master' }}">' +
                '</a></div>'
              );
            }
          }
        }
      }
    });

    // Observer configuration: listen for childList changes within the subtree
    var config = { childList: true, subtree: true };

    // Start observing
    observer.observe(targetNode, config);
  });
</script>

{% render 'quick-add-modal-wrapper' %}

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
      {
        "type": "checkbox",
        "id": "enable_breadcrumb",
        "label": "Enable Breadcrumb",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Background",
        "info": "This Banner Image will show only on Default Shopify All Products Collection"
      },
      {
        "type": "image_picker",
        "id": "mob_image",
        "label": "Mobile Background",
        "info": "This Banner Image will show only on Default Shopify All Products Collection"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content"
      },
     {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default" : "Take the Quiz"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Url"
    },
    {
      "type": "image_picker",
      "id": "subscribe_image",
      "label": "Subscribe Image"
    },
    {
      "type": "url",
      "id": "subscribe_link",
      "label": "Subscribe Link"
    }
  ]
}
{% endschema %}