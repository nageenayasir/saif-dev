<section class="product-recommendations section-padding" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <h2 style="font-family:var(--font-heading-family); font-size:2.4rem; font-weight:800; text-transform:uppercase; letter-spacing:-0.01em; color:rgb(var(--color-base-text)); margin:0 0 3rem; text-align:center;">
      {{ section.settings.title | default: 'Pairs Well With...' }}
    </h2>

    <div id="Recommendations-{{ section.id }}">
      <!-- Loaded via AJAX -->
    </div>
  </div>
</section>

<script>
(function() {
  var container = document.getElementById('Recommendations-{{ section.id }}');
  if (!container) return;

  var productId = {{ product.id }};
  var limit = {{ section.settings.products_to_show | default: 3 }};

  fetch('/recommendations/products.json?product_id=' + productId + '&limit=' + limit + '&intent=related')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.products || data.products.length === 0) {
        container.closest('.product-recommendations').style.display = 'none';
        return;
      }
      var grid = document.createElement('ul');
      grid.className = 'grid grid--3-col-desktop grid--2-col';
      grid.setAttribute('role', 'list');
      grid.style.cssText = '--grid-desktop-horizontal-spacing:2rem; --grid-mobile-horizontal-spacing:1.2rem;';

      data.products.forEach(function(product) {
        var li = document.createElement('li');
        var price = product.price_min ? ('$' + (product.price_min / 100).toFixed(2)) : '';
        li.innerHTML = '<div class="card"><div class="card__media"><div class="card__media-wrapper">' +
          '<a href="' + product.url + '" tabindex="-1">' +
          '<img src="' + product.featured_image + '" alt="' + product.title + '" loading="lazy" width="400" height="400" style="width:100%;height:100%;object-fit:cover;">' +
          '</a></div></div><div class="card__content"><p class="card__title"><a href="' + product.url + '">' + product.title + '</a></p>' +
          '<div class="price"><span class="price__regular">' + price + '</span></div>' +
          '</div><div class="card__footer"><a href="' + product.url + '" class="button button--secondary button--full-width button--small">View product</a></div></div>';
        grid.appendChild(li);
      });
      container.appendChild(grid);
    })
    .catch(function() {
      container.closest('.product-recommendations').style.display = 'none';
    });
})();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Pairs Well With...",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
