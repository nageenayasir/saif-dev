
<header id="masthead" class="site-header custom-site-header {% unless collection.title == 'Products' or  collection.title == 'All products' or collection.metafields.custom.default_banner_image == true %}collection-page-header-wrap{% endunless %}">
      {% comment %}
      <div class="top-header">
        <div class="d-flex">
          <a class="mx-4 text-center" href="{{ section.settings.url_1 }}">{{ section.settings.top_header }}</a> 
          <a class="mx-4 text-center top-header-wrap" href="{{ section.settings.url_2 }}">{{ section.settings.top_header_2 }}</a> 
          <a class="mx-4 text-center" href="{{ section.settings.url_3 }}">{{ section.settings.top_header_3 }}</a>
        </div>
        <div class="d-flex d-md-none">
          <a class="mx-4 text-center" href="{{ section.settings.url_1 }}">{{ section.settings.top_header }}</a> 
          <a class="mx-4 text-center top-header-wrap" href="{{ section.settings.url_2 }}">{{ section.settings.top_header_2 }}</a> 
          <a class="mx-4 text-center" href="{{ section.settings.url_3 }}">{{ section.settings.top_header_3 }}</a>
        </div>
      </div>
      {% endcomment %}
      <div class="wrapper custom-header">
          <div class="container">
              <div class="site-nav d-flex justify-content-between">
                  <div class="site-branding col-md-auto" fetchpriority="high">
                      <a href="{{ routes.root_url }}" aria-label="Go to homepage - {{ shop.name }}">
                        {% if section.settings.show_image and section.settings.logo != blank %}
                          {%- assign logo = section.settings.logo -%}
                          {%- assign w = 300 -%}
                          {%- assign h = w | divided_by: logo.aspect_ratio | round -%}
                          <img
                            data-dgf-optimized="true"
                            src="{{ logo | image_url: width: w }}"
                            alt="{{ logo.alt | default: shop.name | escape }}"
                            width="{{ w }}"
                            height="{{ h }}"
                            decoding="async"
                            loading="eager"
                          >
                        {% else %}
                          <span class="logo-svg" aria-label="{{ shop.name }}">
                            {{ section.settings.logo_svg }}
                          </span>
                        {% endif %}
                      </a>
                      {% comment %} 
                      <a href="{{ routes.root_url }}" aria-label="Go to homepage - {{ shop.name }}">
                        {% if section.settings.show_image == true %}
                           <img loading="lazy" src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ section.settings.logo.alt | default: shop.name }}"/>
                        {% else %}
                           {{ section.settings.logo_svg }}
                        {% endif %}
                      </a>
                      {% endcomment %}
                  </div><!-- .site-branding -->
                  <nav id="site-navigation" class="main-navigation navbar navbar-expand-lg navbar-light order-first order-lg-1">
                      <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                          <span class="navbar-toggler-icon"></span>
                          <span class="navbar-toggler-icon"></span>
                      </button>
                      <div class="collapse navbar-collapse width" id="navbarSupportedContent">
                          <div class="navbar-container d-flex flex-column justify-content-between">
                              <div class="menu-primary-container">
                                  <ul class="icon-list-mobile cstm-header-icn-lists d-flex d-lg-none">
                                      <li><a href="/search" aria-label="Search products"><i class="fa fa-search"></i><span>Search</span></a></li>
                                    {% comment %}
                                     {%- if customer -%}
                                      <li><a href="/pages/wishlist"><i class="fa fa-heart"></i><span>Wishlist</span></a></li>
                                    {% else %}
                                       <li><a href="#"><i class="fa fa-heart"></i><span>Wishlist</span></a></li>
                                    {% endif %}
                                    {% endcomment %}
                                      {%- if customer -%}
                                        <li><a href="{{ routes.account_url }}">{% render 'icon-account' %}<span>{{ 'customer.account_fallback' | t }}</span></a></li>
                                      {%- else -%}
                                        <li><a href="/account/login">{% render 'icon-account' %}<span>{{ 'customer.log_in' | t }}</span></a></li> 
                                      {%- endif -%}   
                                  </ul>
                                  <ul id="primary-menu" class="menu d-lg-flex web-menu">
                                    {%- for link in section.settings.menu.links -%} 
                                      <li class="{%- if link.links != blank -%}menu-item has-submenu{% else %}menu-item{% endif %} {% if link.active %}current-menu-item{% endif %} {% if link.title == 'More' %}submenu-arrow{% endif %}">
                                          <a href="{{ link.url }}" aria-label="Get in touch with Tribe Organics for {{ link.title | escape }}">{{ link.title }} {%- if link.links != blank -%}<span class="menu-arrow">{% render 'icon-caret' %}</span>{% endif %}</a>
                                          {%- if link.links != blank -%}
                                            <div class="dropdown mega-menu mega-01"  id="id-{{ forloop.index }}">
                                              <div class="container">
                                                  <div class="row justify-content-center">
                                                      <div class="col-lg-10 col-xl-8">
                                                          <div class="row">
                                                            
                                                            {% if link.title == section.settings.mega_menu_product %}
                                                              {% comment %}
                                                               {%- for childlink in link.links -%}
                                                                  {% if childlink.title == 'Quiz' %}
                                                                     <div class="col-6 col-md-3 mb-3 d-none d-md-block">
                                                                      <a href="{{ childlink.url }}" class="product-item-01">
                                                                          <div class="box">
                                                                              <div class="img-wrapper">
                                                                                  <img loading="lazy" src="{{ 'next.png' | asset_url }}">
                                                                              </div>
                                                                              <h5>{{ childlink.title }}</h5>
                                                                              <div class="desc">{{ section.settings.text_quiz }}</div>
                                                                          </div>
                                                                      </a>
                                                                  </div>
                                                                   
                                                                {% elsif childlink.title == 'Shop All' %}
                                                                  <div class="col-6 col-md-3 mb-3 d-none d-md-block align-menu">
                                                                    <a href="{{ routes.all_products_collection_url }}" class="product-item-01">
                                                                        <div class="box">
                                                                            <div class="img-wrapper" style="padding-top: 30%;">
                                                                                <img loading="lazy" class="shop-next-arrow" src="{{ 'next.png' | asset_url }}">
                                                                                <img loading="lazy" class="hover-shop-next-arrow" src="{{ 'arrown-next.png' | asset_url }}">
                                                                            </div>
                                                                            <h5 class="" style="font-size: 15px; text-transform: uppercase; min-height: auto;">{{ childlink.title }}</h5>
                                                                            <div class="desc">{{ section.settings.text_all }}</div>
                                                                        </div>
                                                                    </a>
                                                                </div>
                                                                {% else %}
                                                                    <div class="col-6 col-md-3 mb-3 align-menu">
                                                                        <a href="{{ childlink.url }}" class="product-item-01">
                                                                            <div class="box">
                                                                                {% assign handle = childlink.title | handle %}
                                                                                <div class="img-wrapper">
                                                                                    <img loading="lazy" src="{{ all_products[handle].featured_media | image_url: width: 800 }}" alt="{{ childlink.title | escape }}">
                                                                                </div>
                                                                                <h5>{{ childlink.title | escape }}</h5>
                                                                                <div class="desc">{{ section.settings.text_product }}</div>
                                                                            </div>
                                                                        </a>
                                                                    </div>
                                                                  {% endif %}
                                                                {% endfor %}
                                                                    <div class="col-12 d-block d-md-none mt-4 mb-5 align-menu">
                                                                        <a href="{{ routes.all_products_collection_url }}" class="mx-auto btn btn-trans">Shop All</a>
                                                                    </div>
                                                              {% endcomment %}
                                                              <div class="col-4 cstm-menu-items">
                                                                  <ul>
                                                                    {%- for childlink in link.links -%}
                                                                      <li><a href="{{ childlink.url }}" aria-label="{{ childlink.title | escape }} {{ 'now' | date: '%s' }}">{{ childlink.title | escape }}</a></li>
                                                                    {% endfor %}   
                                                                  </ul>
                                                                </div> 
                                                                 <div class="col-8 cstm-menu-img-links mb-5 text-md-end">
                                                                   <div class="row">
                                                                     <div class="col-4">
                                                                        <a href="{{ section.settings.prod_url_1 }}">
                                                                          {% if section.settings.prod_image_1 %}
                                                                            {%- assign img = section.settings.prod_image_1 -%}
                                                                            <img
                                                                              data-dgf-optimized="true"
                                                                              loading="lazy"
                                                                              src="{{ img | image_url: width : img.width }}" 
                                                                              alt="Menu image 01"
                                                                              width="{{ img.width }}"
                                                                              height="{{ img.height }}"
                                                                              style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                                                                            >
                                                                            {% comment %} <img loading="lazy" src="{{ section.settings.prod_image_1 | img_url:'master' }}"> {% endcomment %} 
                                                                          {% endif %}
                                                                          <p><span>{{ section.settings.prod_link_text_1 }}</span></p>
                                                                        </a>
                                                                     </div>
                                                                     <div class="col-4">
                                                                        <a href="{{ section.settings.prod_url_2 }}">
                                                                          {% if section.settings.prod_image_2 %}
                                                                            {%- assign img = section.settings.prod_image_2 -%}
                                                                            <img
                                                                              data-dgf-optimized="true"
                                                                              loading="lazy"
                                                                              src="{{ img | image_url: width : img.width }}" 
                                                                              alt="Menu image 02"
                                                                              width="{{ img.width }}"
                                                                              height="{{ img.height }}"
                                                                              style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                                                                            >
                                                                            {% comment %} <img loading="lazy" src="{{ section.settings.prod_image_2 | img_url:'master' }}"> {% endcomment %}                                                                          
                                                                          {% endif %}
                                                                          <p><span>{{ section.settings.prod_link_text_2 }}</span></p>
                                                                        </a>
                                                                     </div>
                                                                     <div class="col-4">
                                                                        <a href="{{ section.settings.prod_url_3 }}">
                                                                          {% if section.settings.prod_image_3 %}
                                                                            {%- assign img = section.settings.prod_image_3 -%}
                                                                            <img
                                                                              data-dgf-optimized="true"
                                                                              loading="lazy"
                                                                              src="{{ img | image_url: width : img.width }}" 
                                                                              alt="Menu image 03"
                                                                              width="{{ img.width }}"
                                                                              height="{{ img.height }}"
                                                                              style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                                                                            >
                                                                            {% comment %} <img loading="lazy" src="{{ section.settings.prod_image_3 | img_url:'master' }}"> {% endcomment %} 
                                                                          {% endif %}
                                                                          <p><span>{{ section.settings.prod_link_text_3 }}</span></p>
                                                                        </a>
                                                                     </div>
                                                                   </div>
                                                                   
                                                                </div>
                                                              {% elsif link.title == section.settings.mega_menu_category %}
