                                                                                    alt="{{ childlink.title | escape }}"
                                                                                    width="{{ img.width }}"
                                                                                    height="{{ img.height }}"
                                                                                    style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                                                                                  >
                                                                                  {% comment %} <img loading="lazy" src="{{ childlink.object.image | img_url: "500x" }}" alt="{{ childlink.title | escape }}">  {% endcomment %}
                                                                                </div>
                                                                                <h5>{{ childlink.title | escape }}</h5>
                                                                            </div>
                                                                        </a>
                                                                    </div>
                                                                {% endfor %}
                                                            {% else %}
                                                                <div class="col-4 cstm-menu-items">
                                                                  <ul class="web-sub-menu-items">
                                                                    {%- for childlink in link.links -%}
                                                                      <li><a href="{{ childlink.url }}" aria-label="{{ childlink.title | escape }} {{ 'now' | date: '%s' }}">{{ childlink.title | escape }}</a></li>
                                                                    {% endfor %}   
                                                                  </ul>
                                                                </div> 
                                                                 <div class="col-8 cstm-menu-img-links mb-5 text-md-end">
                                                                   <div class="row">
                                                                     <div class="col-4">
                                                                        <a href="{{ section.settings.url_1 }}">
                                                                          {% if section.settings.image_1 %}
                                                                            {%- assign img = section.settings.image_1 -%}
                                                                            <img
                                                                              data-dgf-optimized="true"
                                                                              loading="lazy"
                                                                              src="{{ img | image_url: width : img.width }}" 
                                                                              alt="{{ img.alt | default: section.settings.text_1 | default: 'More: Option 01' | escape }}"
                                                                              width="{{ img.width }}"
                                                                              height="{{ img.height }}"
                                                                              style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                                                                            >
                                                                            {% comment %} <img loading="lazy" src="{{ section.settings.image_1 | img_url:'master' }}"> {% endcomment %}
                                                                          {% endif %}
                                                                          <p><span>{{ section.settings.link_text_1 }}</span></p>
                                                                        </a>
                                                                     </div>
                                                                     <div class="col-4">
                                                                        <a href="{{ section.settings.url_2 }}">
                                                                          {% if section.settings.image_2 %}
                                                                            {%- assign img = section.settings.image_2 -%}
                                                                            <img
                                                                              data-dgf-optimized="true"
                                                                              loading="lazy"
                                                                              src="{{ img | image_url: width : img.width }}" 
                                                                              alt="{{ img.alt | default: section.settings.text_2 | default: 'More: Option 02' | escape }}"
                                                                              width="{{ img.width }}"
                                                                              height="{{ img.height }}"
                                                                              style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                                                                            >
                                                                            {% comment %} <img loading="lazy" src="{{ section.settings.image_2 | img_url:'master' }}"> {% endcomment %}
                                                                          {% endif %}
                                                                          <p><span>{{ section.settings.link_text_2 }}</span></p>
                                                                        </a>
                                                                     </div>
                                                                     <div class="col-4">
                                                                        <a href="{{ section.settings.url_3 }}">
                                                                          {% if section.settings.image_3 %}
                                                                            {%- assign img = section.settings.image_3 -%}
