                                                                          width="{{ img.width }}"
                                                                          height="{{ img.height }}"
                                                                          style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                                                                        >
                                                                        {% comment %} <img loading="lazy" src="{{ section.settings.image_2 | img_url:'master' }}"> {% endcomment %}
                                                                      {% endif %}
                                                                      <p><span>{{ section.settings.link_text_2 }}</span></p>
                                                                    </a>
                                                                  </div>
                                                                   <div class="mobile-menu-img-links">
                                                                     <a href="{{ section.settings.url_3 }}">
                                                                      {% if section.settings.image_3 %}
                                                                        {%- assign img = section.settings.image_3 -%}
                                                                        <img
                                                                          data-dgf-optimized="true"
                                                                          loading="lazy"
                                                                          src="{{ img | image_url: width : img.width }}" 
                                                                          alt="Mobile {{ img.alt | default: section.settings.text_1 | default: 'More: Option 02' | escape }}"
                                                                          width="{{ img.width }}"
                                                                          height="{{ img.height }}"
                                                                          style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                                                                        >
                                                                        {% comment %} <img loading="lazy" src="{{ section.settings.image_3 | img_url:'master' }}"> {% endcomment %}
                                                                      {% endif %}
                                                                      <p><span>{{ section.settings.link_text_3 }}</span></p>
                                                                    </a>
                                                                  </div>
                                                                </div>
                                                            {% endif %}
                                                          </div>
                                                      </div>
                                                  </div>
                                              </div>
                                          </div>
                                          {% endif %}
                                      </li>
                                    {% endfor %}   
                                  </ul>
                              </div>
                          </div>
                      </div>
                  </nav><!-- #site-navigation -->
                  <ul class="more-icon d-flex order-lg-2">
                      {% if section.settings.show_search == true %}<li class="d-none d-lg-flex"><a href="/search" aria-label="Search products"><i class="fa fa-search"></i></a></li>{% endif %}
                      {% if section.settings.show_wishlist == true %}
                         {%- if customer -%}
                            <li class="d-none d-lg-flex"><a href="/pages/wishlist"><i class="fa fa-heart"></i></a></li>
                        {% else %}
                            <li class="d-none d-lg-flex"><a href="#"><i class="fa fa-heart"></i></a></li>
                        {% endif %}
                      {% endif %}
                    {%- if customer -%}
                      <li class="d-none d-lg-flex"><a href="{{ routes.account_url }}" aria-label="My account">{% render 'icon-account' %}</a></li>
                    {%- else -%}
                      <li class="d-none d-lg-flex"><a href="/account/login" aria-label="Login to your account">{% render 'icon-account' %}</a></li>
                    {%- endif -%}
                      <li>
                        <a class="cart-btn-show" href="#" aria-label="Shopping cart - {{ cart.item_count }} items">
                          {% render 'icon-cart' %}
                            <span class="cart-count header-bar__cart-count {% if cart.item_count == 0 %}hidden-count{% endif %}" data-ajax-cart-bind-state="cart.item_count">{{ cart.item_count }}</span>
                        </a>
                      </li>
                  </ul>
              </div>
          </div>
      </div>
  </header>
