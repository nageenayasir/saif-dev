                                                                              data-dgf-optimized="true"
                                                                              loading="lazy"
                                                                              src="{{ img | image_url: width : img.width }}" 
                                                                              alt="{{ img.alt | default: section.settings.text_3 | default: 'More: Option 03' | escape }}"
                                                                              width="{{ img.width }}"
                                                                              height="{{ img.height }}"
                                                                              style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                                                                            >
                                                                            {% comment %} <img loading="lazy" src="{{ section.settings.image_3 | img_url:'master' }}"> {% endcomment %}
                                                                          {% endif %}
                                                                          <p><span>{{ section.settings.link_text_3 }}</span></p>
                                                                        </a>
                                                                     </div>
                                                                   </div>
                                                                   
                                                                </div>
                                                            {% endif %}
                                                          </div>
                                                      </div>
                                                  </div>
                                              </div>
                                          </div>
                                          {% endif %}
                                      </li>
                                    {% endfor %}   
                                  </ul>
