<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="why-choose-tribe-section">
  <div class="why-choose-tribe-wrapper">
    <div class="container">
        <div class="row common-section-head-row">
          <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="common-section-head-content">
              <h2 class="custom-heading-h2">
                {{ section.settings.the_title }}
              </h2>
              <p>{{ section.settings.the_text }}</p>
            </div>
          </div>
        </div>
        {% for block in section.blocks %}
          {% case block.type %}
            {% comment %}
              Tribe Icons
            {% endcomment %}
            {% when 'tribe_icons' %}
            <div class="row tribe-icon-row">
              <div class="tribe-icon-lists">
                <div class="tribe-orgainics-img">
                  {% if block.settings.tribe_image != blank %}<img loading="lazy" src="{{ block.settings.tribe_image | img_url: 'master' }}">{% endif %}
                </div>
                <div class="tribe-icons-wrap">
                  <ul>
                    <li>
                      {% if block.settings.tribe_icon_1 != blank %}<img loading="lazy" src="{{ block.settings.tribe_icon_1 | img_url: 'master' }}">{% endif %}
                      <p>{{ block.settings.icon_text_1 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_2 != blank %}<img loading="lazy" src="{{ block.settings.tribe_icon_2 | img_url: 'master' }}">{% endif %}
                      <p>{{ block.settings.icon_text_2 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_3 != blank %}<img loading="lazy" src="{{ block.settings.tribe_icon_3 | img_url: 'master' }}">{% endif %}
                      <p>{{ block.settings.icon_text_3 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_4 != blank %}<img loading="lazy" src="{{ block.settings.tribe_icon_4 | img_url: 'master' }}">{% endif %}
                      <p>{{ block.settings.icon_text_4 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_5 != blank %}<img loading="lazy" src="{{ block.settings.tribe_icon_5 | img_url: 'master' }}">{% endif %}
                      <p>{{ block.settings.icon_text_5 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_6 != blank %}<img loading="lazy" src="{{ block.settings.tribe_icon_6 | img_url: 'master' }}">{% endif %}
                      <p>{{ block.settings.icon_text_6 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_7 != blank %}<img loading="lazy" src="{{ block.settings.tribe_icon_7 | img_url: 'master' }}">{% endif %}
                      <p>{{ block.settings.icon_text_7 }}</p>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
            {% comment %}
              Reviews Section
            {% endcomment %}
            {% when 'review_section' %}
            <div class="row reviews-testimonail-row">
              <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="testimonial-content-wrap">
                  <span class="testimonial-rating">
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                  </span>
                  <p>{{ block.settings.rating_text }}</p>
                  <h4>{{ block.settings.author_name }}</h4>
                </div>
              </div>
          </div>
            {% comment %}
              rich_text
            {% endcomment %}
            {% when 'rich_text' %}
            <div class="row tribe-rich-text-row">
                <div class="col-lg-12 col-md-12 col-sm-12">
                  <div class="common-section-head-content">
                    <h2 class="custom-heading-h2">
                      {{ block.settings.the_title }}
                    </h2>
                    {% if block.settings.the_text != blank  %}{{ block.settings.the_text }}{% endif %}
                    {% if block.settings.button_text != blank %}<a class="custom-button-wrap" href="#custom-product-offers">{{ block.settings.button_text }}</a>{% endif %}
                  </div>
                </div>
            </div>
            {% comment %}
            Testimonial Section
            {% endcomment %}
            {% when 'image_with_text' %}
            <div class="row tribe-testimonial-row">
              <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="tribe-testimonial-content">
                  <span class="testimonial-rating">
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                  </span>
                  <p>{{ block.settings.rating_text }}</p>
                  <h4>{{ block.settings.author_name }}</h4>
                  {% if block.settings.author_position != blank %}<h6>{{ block.settings.author_position }}</h6>{% endif %}
                </div>
              </div>
              <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="tribe-testimonial-img">
                  {% if block.settings.author_image != blank %}<img loading="lazy" src="{{ block.settings.author_image | img_url: 'master' }}">{% endif %}
                </div>
              </div>
            </div>
          {% endcase %}
        {% endfor %}
    </div>
  </div>
</section>
