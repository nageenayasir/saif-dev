<script>
$(document).ready(function(){
  setTimeout(function(){
  $('.product-recommendations').click(function(){
		$('.product-recommend-wrap').toggle();
	});
    }, 2500);
  $('.product-recommendations').click(function(){
		$('.product-recommendations--loaded').toggleClass('transition-recommend');
	});

})
</script>
{% schema %}
  {
    "name": "Section Cart Popup",
    "settings": [
        {
          "type" : "header",
          "content" : "Show Product Recommendations"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 1,
          "label": "Products to show"
       },
       {
          "type" : "header",
          "content" : "Edit Content"
      },
       {
          "type": "text",
          "id": "title",
          "default": "We’ve got a feeling you’ll vibe with",
          "label": "Title"
      },
      {
          "type": "text",
          "id": "button",
          "default": "Select",
          "label": "Title Button"
      }, 
      {
          "type": "text",
          "id": "title_2",
          "default": "Pay safely & securely with:",
          "label": "Title"
      },
      {
          "type": "checkbox",
          "id": "show_icon_payment",
          "label": "Show icon payment ",
          "default": true
      },
      {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Payment"
      }
    ]  
  }
{% endschema %}
