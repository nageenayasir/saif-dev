<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{ section.id }}" class="affiliates-info-section">
  <div class="container">
    <div class="row">
      <div class="col-sm-12 col-md-6 col-lg-6 affiliates-info-column">
        <div class="affiliates-images-wrapper">
          <div class="affiliates-images">
            {% if section.settings.the_image_1 != blank %}<img loading="lazy"  src="{{ section.settings.the_image_1 | img_url: 'master' }}">{% endif %}
          </div>
           <div class="affiliates-images">
            {% if section.settings.the_image_2 != blank %}<img loading="lazy"  src="{{ section.settings.the_image_2 | img_url: 'master' }}">{% endif %}
          </div>
           <div class="affiliates-images">
            {% if section.settings.the_image_3 != blank %}<img loading="lazy"  src="{{ section.settings.the_image_3 | img_url: 'master' }}">{% endif %}
          </div>
        </div>
      </div>
      <div class="col-sm-12 col-md-6 col-lg-6 affiliates-info-text-column">
        <div class="affiliates-text-wrapper">
          <div class="affiliates-title-content common-heading-wrapper">
            <h2>{{ section.settings.the_title }}</h2>
          </div>
          <div class="affiliates-list-wrapper">
            {% for block in section.blocks %}
              <div class="affiliates-list-blocks">
                <div class="affiliates-icons">
                   {% if block.settings.the_icon != blank %}<img loading="lazy"  src="{{ block.settings.the_icon | img_url: 'master' }}">{% endif %}
                </div>
                <div class="affiliates-list-text">
                  {{ block.settings.the_text }}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Affiliates Info",
    "settings": [
           {
              "type": "header",
              "content": "Content Style"
           },
    	     {
               "type": "color",
               "id": "section_bg_color",
               "label": "Section background color"
           },
           {
              "type": "image_picker",
              "id": "the_image_1",
              "label": "Image-1"
           },
           {
              "type": "image_picker",
              "id": "the_image_2",
              "label": "Image-2"
           },
           {
              "type": "image_picker",
              "id": "the_image_3",
              "label": "Image-3"
           },
           {
            "type": "textarea",
            "id": "the_title",
            "label": "Title"
          }
    ],
    "blocks": [
       {
        "type": "tex_blocks",
        "name": "Text Blocks",
        "settings": [
          {
              "type": "image_picker",
              "id": "the_icon",
              "label": "Icon"
           },
          {
            "type": "richtext",
            "id": "the_text",
            "label": "Text"
          }
        ]
       }
	],
	"presets": [{
      "name": "Affiliates Info"
    }]
  }
{% endschema %}