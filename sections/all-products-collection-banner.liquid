{% if collection.metafields.custom.default_banner_image == true %}
<style>
  {% if collection.metafields.custom.collection_banner_image != blank and collection.metafields.custom.default_banner_image == true %}
 	#id-{{ section.id }}{
        background-image:url("{{ collection.metafields.custom.collection_banner_image | img_url: 'master'}}");
        background-repeat: no-repeat;
        background-size: cover;
  	}
    @media only screen and (max-width: 767px){
          #id-{{ section.id }} {
             background-image: url({{ collection.metafields.custom.mobile_banner_image | img_url: 'master'}}) !important;
          }
  }
  {% endif %}
</style>
<section id="id-{{section.id}}" class="section-banner section-title collection-page-wraper section-page-child cstm-banner-page-wrapper {% if collection.metafields.custom.default_banner_image == true %} all-products-banner-wrapper {% endif %}">
  {% if section.settings.enable_breadcrumb == true and collection.metafields.custom.default_banner_image == true %}
    <div class="common-page-breadcrumb">
      {%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
      {%- assign t = template | split: '.' | first -%}
      <div class="container">
      <nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
        <ol class="breadcrumbs__list">
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="/">Home</a>
          </li>
          {%- case t -%}
            {%- when 'page' -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ page.url }}" aria-current="page">{{ page.title }}</a>
              </li>
            {%- when 'product' -%}
              {%- if collection.url -%}
                <li class="breadcrumbs__item">
                  {{ collection.title | link_to: collection.url }}
                </li>
              {%- endif -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ product.url }}" aria-current="page">{{ product.title }}</a>
              </li>
            {%- when 'collection' and collection.handle -%}
              {%- if current_tags -%}
                <li class="breadcrumbs__item">
                  {{ collection.title | link_to: collection.url }}
                </li>
                <li class="breadcrumbs__item">
                  {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+"}}{%- endcapture -%}
                  <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + "}}</a>
                </li>
              {%- else -%}
                <li class="breadcrumbs__item">
                  <a class="breadcrumbs__link" href="{{ collection.url }}" aria-current="page">{{ collection.title }}</a>
                </li>
              {%- endif -%}
            {%- when 'blog' -%}
              {%- if current_tags -%}
                <li class="breadcrumbs__item">
                  {{ blog.title | link_to: blog.url }}
                </li>
                <li class="breadcrumbs__item">
                  {%- capture tag_url -%}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
                  <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + " }}</a>
                </li>
              {%- else -%}
                <li class="breadcrumbs__item">
                  <a class="breadcrumbs__link" href="{{ blog.url }}" aria-current="page">{{ blog.title }}</a>
                </li>
              {%- endif -%}
            {%- when 'article' -%}
              <li class="breadcrumbs__item">
                {{ blog.title | link_to: blog.url }}
              </li>
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ article.url }}" aria-current="page">{{ article.title }}</a>
              </li>
            {%- else -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ request.path }}" aria-current="page">{{ page_title }}</a>
              </li>
          {%- endcase -%}
        </ol>
      </nav>
      </div>
      {%- endunless -%}
    </div>
  {% endif %}

    <div class="content">
        <div class="container">
            {% comment %}
            <h1 class="text-uppercase" data-aos="fade-up">{% if collection.title == 'Products' %}WE’VE GOT YOU{% else %}{{ collection.title }}{% endif %}</h1>
            {% endcomment %}
            <div class="subtitle all-products-subtitle" data-aos="fade-up" data-aos-delay="200">
                {{ section.settings.content }}
            </div>
            {% comment %}
            <div class="btn-group">
                <div data-aos="fade-up" data-aos-delay="400">
                    <a class="btn btn-bg" href="{{ section.settings.url }}" target="_self">
                       {{ section.settings.button  }}
                    </a>
                </div>
            </div>
          {% endcomment %}
        </div>
    </div>
 
</section>
{% endif %}
{% schema %}
  {
    "name": "All Products Bannner",
    "settings": [
      {
        "type": "header",
        "content": "Banner Section is for All Products Collection Only"
      },
      {
        "type": "checkbox",
        "id": "enable_breadcrumb",
        "label": "Enable Breadcrumb",
        "default": true
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content"
      }
    ],
     "presets": [
      {
        "name": "All Products Bannner"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}