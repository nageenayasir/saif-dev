<section id="id-{{section.id}}" class="wholesale-products-bannner-section">
  <div class="wholesale-products-bannner-wrapper">
    <div class="wholesale-products-image">
      {% if section.settings.the_image != blank %}<img loading="lazy"  src="{{ section.settings.the_image | image_url: width: 2000 }}">{% endif %}
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Wholesale Product Bannner",
    "settings": [
      {
          "type": "image_picker",
          "id": "the_image",
          "label": "Image"
      }
    ],
	"presets": [{
      "name": "Wholesale Product Bannner"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

