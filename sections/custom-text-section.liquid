<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{ section.id }}" class="custom-page-text-section">
  <div class="custom-page-text-wrapper">
    <div class="container">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
          <div class="custom-page-text-head">
            {{ section.settings.the_text }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Custom Text Section",
    "settings": [
          {
                "type": "header",
                "content": "Content Style"
          },
    	  {
             "type": "color",
             "id": "section_bg_color",
             "label": "Section background color"
        },
        {
          "type": "richtext",
          "id": "the_text",
          "label": "Text"
        }
    ],
	"presets": [{
      "name": "Custom Text Section"
    }]
  }
{% endschema %}