{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
-%}

<section class="section-padding featured-products" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="section-heading">
        {%- if section.settings.title != blank -%}
          <h2 class="section-heading__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign products = collection.products | default: section.settings.products -%}
    {%- assign product_limit = section.settings.products_to_show -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      <ul class="grid grid--{{ columns_mobile }}-col grid--{{ columns_desktop }}-col-desktop" role="list"
          style="--grid-desktop-horizontal-spacing: 2rem; --grid-mobile-horizontal-spacing: 1.2rem;">
        {%- for product in collection.products limit: product_limit -%}
          <li>
            {%- render 'product-card', product: product -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <!-- Placeholder grid for theme editor -->
      <ul class="grid grid--{{ columns_mobile }}-col grid--{{ columns_desktop }}-col-desktop" role="list">
        {%- for i in (1..product_limit) -%}
          <li>
            <div class="card">
              <div class="card__media">
                <div class="card__media-wrapper">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
              <div class="card__content">
                <p class="card__title">{{ 'onboarding.product_title' | t }}</p>
                <span class="price">
                  <span class="price__regular">{{ 1999 | money }}</span>
                </span>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_view_all and collection != blank -%}
      <div style="text-align:center; margin-top:4rem;">
        <a href="{{ collection.url }}" class="button button--secondary">
          {{ section.settings.view_all_label | default: 'View all' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Mobile columns"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show \"View all\" button"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "default": "View all products",
      "label": "\"View all\" label"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
