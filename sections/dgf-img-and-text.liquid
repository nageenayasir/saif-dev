{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  try {
    if (window.innerWidth <= 767) {
      const mobileButton = document.querySelector('.dgf-mobile-button-wrapper');
      if (mobileButton) {
        let buttonOriginalPosition = mobileButton.offsetTop;
        let isSticky = false;

        // Get button URL and check if it's an internal section link
        const buttonLink = mobileButton.querySelector('a');
        let targetSectionId = null;

        if (buttonLink && buttonLink.href) {
          const href = buttonLink.getAttribute('href');
          // Check if href contains shopify-section pattern
          if (href.includes('#dgf-featured-product')) {
            targetSectionId = 'dgf-featured-product';
          }
        }

        function isInTargetSection() {
          try {
            if (!targetSectionId) return false;

            // Find the target section element
            const targetSection = document.getElementById(targetSectionId);
            if (!targetSection) return false;

            // Get exact section boundaries - no buffer
            const sectionTop = targetSection.offsetTop;
            const sectionBottom = targetSection.offsetTop + targetSection.offsetHeight;
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            const windowHeight = window.innerHeight;
            const viewportTop = scrollTop;
            const viewportBottom = scrollTop + windowHeight;

            // Check if viewport overlaps with the exact section boundaries
            return viewportBottom >= sectionTop && viewportTop <= sectionBottom;
          } catch(e) {
            return false;
          }
        }

        let scrollTimeout;
        function handleScroll() {
          try {
            // Clear previous timeout to prevent rapid fire
            clearTimeout(scrollTimeout);

            scrollTimeout = setTimeout(() => {
              const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
              const shouldBeSticky = scrollTop > buttonOriginalPosition + 100;
              const inTargetSection = isInTargetSection();

              // Show sticky button only if should be sticky AND not in target section
              if (shouldBeSticky && !inTargetSection && !isSticky) {
                mobileButton.classList.add('dgf-mobile-sticky-button');
                isSticky = true;
              } else if ((!shouldBeSticky || inTargetSection) && isSticky) {
                mobileButton.classList.remove('dgf-mobile-sticky-button');
                isSticky = false;
              }
            }, 10); // Small delay to prevent rapid changes
          } catch(e) { null; }
        }

        window.addEventListener('scroll', handleScroll);

        // Recalculate position if window is resized
        window.addEventListener('resize', function() {
          try {
            if (window.innerWidth <= 767) {
              buttonOriginalPosition = mobileButton.offsetTop;
            } else {
              mobileButton.classList.remove('dgf-mobile-sticky-button');
              isSticky = false;
            }
          } catch(e) { null; }
        });
      }
    }
  } catch(e) { null; }
});
{% endjavascript %}