<style>
  #id-{{ section.id }} {
    background-color: {{ section.settings.section_bg_color }};
  }

  .dgf-testimonial-text {
    font-size: 17px !important;
    font-weight: 500 !important;
    color: #07211F !important;
    line-height: 1.9;
    padding: 0 3rem;
  }

  .dgf-testimonial-author p {
    font-size: 15px !important;
    font-weight: bold !important;
    font-style: normal !important;
    text-transform: capitalize !important;
    color: #111111 !important;
  }

  .dgf-title-part1 {
    font-family: 'Superior Title Italic';
    font-size: 36px;
    text-transform: none;
    font-style: italic;
  }

  .dgf-title-part2 {
    font-family: HypatiaSansPro;
    font-size: 36px;
    text-transform: uppercase;
  }

  .swiper-button-next {
    background: url('https://cdn.shopify.com/s/files/1/0499/0425/5134/files/righty.png?v=1758148938')
    , #AC853B !important;
    transition: 0.3s ease;
  }

  .swiper-button-prev {
    background: url('https://cdn.shopify.com/s/files/1/0499/0425/5134/files/lefty.png?v=1758148934')
    , #AC853B !important;
    transition: 0.3s ease;
  }

  .home-testimonial-slider .swiper-wrapper {
    align-items: stretch;
  }

  .home-testimonial-slider .swiper-slide {
    height: auto;
  }

  .testi-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .testimonial-item-content {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .dgf-testimonial-text {
    margin-bottom: 0 !important;
  }

  .dgf-testimonial-author {
    margin-top: 0.5rem !important;
  }

  #id-{{ section.id }} .testimonial-bottom-text {
    position: {{ section.settings.author_position | default: 'absolute' }};
  }

  .dgf-testimonial-stars {
    margin-bottom: 2rem;
  }

  .dgf-testimonial-stars .fa-star {
    font-weight: bold !important;
    font-size: 16px !important;
  }

  /* Card structure: top (stars+text), center (author), bottom (disclaimer) */
  .dgf-testimonial-card {
    justify-content: space-between;
  }

  .dgf-testimonial-top {
    flex: 1;
    align-items: center;
    justify-content: center;
    display: flex;
    flex-direction: column;
  }

  .dgf-testimonial-author {
    text-align: center;
  }

  /* Disclaimer styles */
  .dgf-testimonial-disclaimer p {
    font-size: 14px;
    color: #000000 !important;
    font-style: italic;
    line-height: 1.5;
    margin: 0;
    text-align: center;
  }

  .dgf-testimonial-disclaimer--inside {
    margin-top: auto;
    padding-top: 1rem;
  }

  /* Desktop: show inside, hide outside */
  .dgf-testimonial-disclaimer--outside {
    display: none;
  }

  .dgf-testimonial-disclaimer--inside {
    display: block;
  }


  #id-{{ section.id }} .dgf-testimonial-pagination {
    justify-content: center;
    gap: 0px;
    margin-top: 1.5rem;
    position: relative;
    bottom: auto;
  }

  #id-{{ section.id }} .dgf-testimonial-pagination .swiper-pagination-bullet {
    width: 100%;
    border-radius: 0!important;
    background: #ccc;
    margin: 0!important;
    opacity: 1;
    transition: all 0.3s ease;
  }

  #id-{{ section.id }} .dgf-testimonial-pagination .swiper-pagination-bullet-active {
    background: #AC853B;
  }

  /* Desktop Navigation */
  @media (min-width: 768px) {
    #id-{{ section.id }} .homepage-custom-testimonial-button-prev,
    #id-{{ section.id }} .homepage-custom-testimonial-button-next {
      display: {% if section.settings.nav_type == 'arrows' %}flex{% else %}none{% endif %} !important;
    }

    #id-{{ section.id }} .dgf-testimonial-pagination {
      display: {% if section.settings.nav_type == 'pagination' %}flex{% else %}none{% endif %};
    }
  }

  @media (min-width: 1024px) {
    .homepage-custom-testimonial-button-prev {
      left: -17px !important;
    }
    .homepage-custom-testimonial-button-next {
      right: -15px !important;
    }
  }

  /* Mobile Navigation */
  @media (max-width: 767px) {
    #id-{{ section.id }} .homepage-custom-testimonial-button-prev,
    #id-{{ section.id }} .homepage-custom-testimonial-button-next {
      display: {% if section.settings.nav_type_mobile == 'arrows' %}flex{% else %}none{% endif %} !important;
    }

    #id-{{ section.id }} .dgf-testimonial-pagination {
      display: {% if section.settings.nav_type_mobile == 'pagination' %}flex{% else %}none{% endif %};
    }

    .homepage-custom-testimonial-button-prev {
      left: -8px !important;
    }
    .homepage-custom-testimonial-button-next {
      right: -7px !important;
    }

    .dgf-title-part1 {
      font-size: 27px;
    }

    .dgf-title-part2 {
      font-size: 27px;
    }

    .dgf-testimonial-text {
      font-size: 16px !important;
    }

    .testi-item .content {
      padding: 1rem !important;
    }

    .testimonial-item-content {
      min-height: 480px !important;
    }

    .dgf-testimonial-stars {
      margin-bottom: 0;
    }

    .dgf-testimonial-disclaimer--outside {
      display: block !important;
      padding: 0.75rem 1rem 0;
    }

    .dgf-testimonial-card {
      text-align: center;
    }

    .dgf-testimonial-disclaimer p {
        font-size: 10px;
    }

  }

</style>
