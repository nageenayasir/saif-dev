{% # theme-check-disable ParserBlockingScript %}
<script type="text/javascript" src="{{ 'jquery-3.5.1.min.js' | asset_url }}"></script>
<script type="text/javascript" src="{{ 'swiper.min.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}
<script>
  new Swiper('.home-testimonial-slider', {
        loop: false,
        slidesPerView: 3,
        navigation: {
          nextEl: '.homepage-custom-testimonial-button-next',
          prevEl: '.homepage-custom-testimonial-button-prev',
        },
        pagination: {
          el: '.dgf-testimonial-pagination',
          clickable: true,
        },
        spaceBetween: 20,
        breakpoints: {
            1920: {
                slidesPerView: 3,
                spaceBetween: 30
            },
            1028: {
                slidesPerView: 2,
                spaceBetween: 30
            },
            576: {
                slidesPerView: 1,
                spaceBetween: 10
            }
        }
    });
</script>
{% schema %}
  {
    "name": "[DGF] LP Testimonial",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "Content Style"
      },
      {
        "type": "color",
        "id": "section_bg_color",
        "label": "Section background color"
      },
      {
        "type": "textarea",
        "id": "custom_class",
        "label": "Add Class to the main section"
      },
      {
        "type": "text",
        "id": "title_part1",
        "label": "Title Part 1",
        "info": "First part of the title (different font style)",
        "default": "What People"
      }, {
        "type": "text",
        "id": "title_part2",
        "label": "Title Part 2",
        "info": "Second part of the title (different font style)",
        "default": "Say"
      }, {
        "type": "color",
        "id": "title_color",
        "label": "Title Color",
        "default": "#000000"
      },
      {
        "type": "header",
        "content": "Author"
      },
      {
        "type": "select",
        "id": "author_position",
        "label": "Author Position",
        "options": [
          { "value": "absolute", "label": "Absolute" },
          { "value": "relative", "label": "Relative" }
        ],
        "default": "absolute"
      },
      {
        "type": "header",
        "content": "Navigation"
      },
      {
        "type": "select",
        "id": "nav_type",
        "label": "Navigation Type (Desktop)",
        "options": [
          { "value": "arrows", "label": "Arrows" },
          { "value": "pagination", "label": "Pagination (Slider)" }
        ],
        "default": "arrows"
      },
      {
        "type": "select",
        "id": "nav_type_mobile",
        "label": "Navigation Type (Mobile)",
        "options": [
          { "value": "arrows", "label": "Arrows" },
          { "value": "pagination", "label": "Pagination (Slider)" }
        ],
        "default": "pagination"
      }
    ],
    "blocks": [
      {
        "type": "testimonial",
        "name": "Testimonial",
        "settings": [
          {
            "type": "html",
            "id": "stars",
            "label": "Stars",
            "info": "Add star rating HTML (e.g., ★★★★★)"
          }, {
            "type": "richtext",
            "id": "testimonial_text",
            "label": "Testimonial Text",
            "info": "The main testimonial content"
          }, {
            "type": "text",
            "id": "author_name",
            "label": "Author Name",
            "info": "Name of the person giving the testimonial"
          }, {
            "type": "textarea",
            "id": "disclaimer",
            "label": "Disclaimer",
            "info": "Disclaimer text shown below the author"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "[DGF] LP Testimonial"
      }
    ]
  }
{% endschema %}

