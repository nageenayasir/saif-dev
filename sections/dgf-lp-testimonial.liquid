<link rel="stylesheet" href="{{ 'swiper.min.css' | asset_url }}" type="text/css" media="all"/>
<section id="id-{{section.id}}" class="section section-testi homepage-custom-testimonial-wrapper dgf-testimonial {{ section.settings.custom_class }}">
  <div class="container">
    <h2
      class="text-center text-uppercase dgf-testimonial-title"
      data-aos="fade-up"
      data-aos-delay="000"
      style="color: {{ section.settings.title_color }};">
      <span class="dgf-title-part1">{{ section.settings.title_part1 }}</span>
      <span class="dgf-title-part2">{{ section.settings.title_part2 }}</span>
    </h2>
    <div class="row justify-content-center">
      <div class="col-lg-12">
        <div
          class="testimonial-box mt-3"
          data-aos="fade-in"
          data-aos-delay="400"
          data-aos-duration="800">
          <div class="swiper home-testimonial-slider">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                <div class="swiper-slide">
                  <div class="testi-item testimonial-item-content dgf-testimonial-card">
                    <div class="dgf-testimonial-top">
                      <div class="stars dgf-testimonial-stars">
                        {{ block.settings.stars }}
                      </div>
                      <div class="content dgf-testimonial-text">
                        {{ block.settings.testimonial_text }}
                      </div>
                    </div>
                    <div class="testimonial-bottom-text dgf-testimonial-author">
                      <p>{{ block.settings.author_name }}</p>
                    </div>
                    {% if block.settings.disclaimer != blank %}
                      <div class="dgf-testimonial-disclaimer dgf-testimonial-disclaimer--inside">
                        <p>{{ block.settings.disclaimer }}</p>
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          <!-- If we need navigation buttons -->
            <div class="swiper-pagination dgf-testimonial-pagination"></div>
          </div>
          <div class="swiper-button-prev homepage-custom-testimonial-button-prev"></div>
          <div class="swiper-button-next homepage-custom-testimonial-button-next"></div>
        </div>
      </div>
    </div>
  {% comment %} 
    <div class="testimonial-swiper-wrapper-pagination position-relative">
    <div class="testimonial-swiper-scrollbar"></div>
    </div> 
  {% endcomment %}
  </div>
</section>
