<section class="section-padding bundles-cta" id="shopify-section-{{ section.id }}"
  style="{% if section.settings.background_image != blank %}position:relative; overflow:hidden;{% else %}background:rgb(var(--color-base-background-2));{% endif %}">

  {%- if section.settings.background_image != blank -%}
    <div style="position:absolute; inset:0; z-index:0;">
      {{
        section.settings.background_image
        | image_url: width: 1920
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1920',
          sizes: '100vw',
          style: 'width:100%;height:100%;object-fit:cover;object-position:center;'
      }}
      <div style="position:absolute; inset:0; background:rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
    </div>
  {%- endif -%}

  <div class="page-width" style="position:relative; z-index:1;">
    <div style="display:grid; grid-template-columns:1fr; gap:4rem; align-items:center;">
      <div style="{% if section.settings.background_image != blank %}color:#fff;{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span style="display:block; font-size:1.2rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:rgb(var(--color-base-accent-1)); margin-bottom:1.2rem;">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 style="font-family:var(--font-heading-family); font-size:clamp(2.8rem, 4vw, 5rem); font-weight:800; line-height:1.1; margin:0 0 1.6rem; letter-spacing:-0.02em; text-transform:uppercase; {% if section.settings.background_image != blank %}color:#fff;{% else %}color:rgb(var(--color-base-text));{% endif %}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p style="font-size:1.7rem; line-height:1.7; margin:0 0 3rem; {% if section.settings.background_image != blank %}color:rgba(255,255,255,0.8);{% else %}color:rgba(var(--color-base-text),0.75);{% endif %}">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
        {%- if section.settings.price_prefix != blank -%}
          <p style="font-family:var(--font-heading-family); font-size:2.4rem; font-weight:800; color:rgb(var(--color-base-accent-1)); margin:0 0 2.4rem;">
            {{ section.settings.price_prefix }}
          </p>
        {%- endif -%}
        <div style="display:flex; gap:1.2rem; flex-wrap:wrap;">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_url | default: '#' }}" class="button button--primary">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_button_label != blank -%}
            <a href="{{ section.settings.secondary_button_url | default: '#' }}" class="button button--secondary">
              {{ section.settings.secondary_button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles CTA",
  "tag": "section",
  "class": "section-bundles-cta",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 45,
      "unit": "%",
      "label": "Overlay opacity"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Transform Your Habits: Bundle Up & Save!"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get more from your wellness routine by combining complementary supplements into powerful bundles."
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price text (e.g. 'From $64.54')",
      "default": "From $64.54"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Explore bundles"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "Bundles CTA"
    }
  ]
}
{% endschema %}
