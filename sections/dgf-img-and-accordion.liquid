{% stylesheet %}
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  // Make toggleAccordion function global
  window.toggleAccordion = function(header) {
    try {
      const content = header.nextElementSibling;
      const isActive = content.classList.contains('active');

      // Close all accordions in this section
      const sectionId = header.closest('section').id;
      const allContents = document.querySelectorAll(`#${sectionId} .dgf-accordion-content`);
      const allHeaders = document.querySelectorAll(`#${sectionId} .dgf-accordion-header`);

      allContents.forEach(item => item.classList.remove('active'));
      allHeaders.forEach(item => item.classList.remove('active'));

      // Open current accordion if it wasn't active
      if (!isActive) {
        content.classList.add('active');
        header.classList.add('active');
      }
    } catch(e) {
      console.error('Accordion toggle error:', e);
    }
  };
});
{% endjavascript %}