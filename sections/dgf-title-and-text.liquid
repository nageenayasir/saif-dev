{% comment %}
  [DGF] Title and Text
  Author: Rodrigo Gesser
{% endcomment %}

{% liquid
  assign bg_color = section.settings.background_color | default: '#ffffff'
  assign text_alignment = section.settings.text_alignment | default: 'center'

  assign title_font = section.settings.title_font | default: 'HypatiaSansPro'
  assign title_font_size = section.settings.title_font_size | default: 36
  assign title_font_size_mobile = section.settings.title_font_size_mobile | default: 26
  assign title_font_weight = section.settings.title_font_weight | default: '700'
  assign title_transform = section.settings.title_transform | default: 'none'
  assign title_color = section.settings.title_color | default: '#333333'
  assign title_margin_bottom = section.settings.title_margin_bottom | default: 20

  assign text_font = section.settings.text_font | default: "'Superior Title Italic'"
  assign text_font_size = section.settings.text_font_size | default: 18
  assign text_font_size_mobile = section.settings.text_font_size_mobile | default: 16
  assign text_font_weight = section.settings.text_font_weight | default: '400'
  assign text_transform = section.settings.text_transform | default: 'none'
  assign text_color = section.settings.text_color | default: '#333333'

  assign padding_top = section.settings.padding_top | default: 40
  assign padding_bottom = section.settings.padding_bottom | default: 40
  assign padding_left = section.settings.padding_left | default: 0
  assign padding_right = section.settings.padding_right | default: 0

  assign sid = section.id
%}

<section id="dgf-title-text-{{ sid }}" style="background-color: {{ bg_color }};">
  <div class="container">
    <div class="dgf-tt-content">
      {% if section.settings.title != blank %}
        <div class="dgf-tt-title">{{ section.settings.title }}</div>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="dgf-tt-text">{{ section.settings.text }}</div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #dgf-title-text-{{ sid }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }

  #dgf-title-text-{{ sid }} .dgf-tt-content {
    text-align: {{ text_alignment }};
    padding-left: {{ padding_left }}px;
    padding-right: {{ padding_right }}px;
  }

  /* Title font controls */
  #dgf-title-text-{{ sid }} .dgf-tt-title,
  #dgf-title-text-{{ sid }} .dgf-tt-title h1,
  #dgf-title-text-{{ sid }} .dgf-tt-title h2,
  #dgf-title-text-{{ sid }} .dgf-tt-title h3,
  #dgf-title-text-{{ sid }} .dgf-tt-title h4,
  #dgf-title-text-{{ sid }} .dgf-tt-title h5,
  #dgf-title-text-{{ sid }} .dgf-tt-title h6,
  #dgf-title-text-{{ sid }} .dgf-tt-title p,
  #dgf-title-text-{{ sid }} .dgf-tt-title span,
  #dgf-title-text-{{ sid }} .dgf-tt-title strong,
  #dgf-title-text-{{ sid }} .dgf-tt-title em,
  #dgf-title-text-{{ sid }} .dgf-tt-title i,
  #dgf-title-text-{{ sid }} .dgf-tt-title u,
  #dgf-title-text-{{ sid }} .dgf-tt-title a {
    font-family: {{ title_font }} !important;
    font-size: {{ title_font_size }}px !important;
    font-weight: {{ title_font_weight }} !important;
    text-transform: {{ title_transform }} !important;
    color: {{ title_color }} !important;
    line-height: 1.2 !important;
    margin: 0;
  }

  #dgf-title-text-{{ sid }} .dgf-tt-title {
    margin-bottom: {{ title_margin_bottom }}px !important;
  }

  /* Text font controls */
  #dgf-title-text-{{ sid }} .dgf-tt-text,
  #dgf-title-text-{{ sid }} .dgf-tt-text h1,
  #dgf-title-text-{{ sid }} .dgf-tt-text h2,
  #dgf-title-text-{{ sid }} .dgf-tt-text h3,
  #dgf-title-text-{{ sid }} .dgf-tt-text h4,
  #dgf-title-text-{{ sid }} .dgf-tt-text h5,
  #dgf-title-text-{{ sid }} .dgf-tt-text h6,
  #dgf-title-text-{{ sid }} .dgf-tt-text p,
  #dgf-title-text-{{ sid }} .dgf-tt-text span,
  #dgf-title-text-{{ sid }} .dgf-tt-text strong,
  #dgf-title-text-{{ sid }} .dgf-tt-text em,
  #dgf-title-text-{{ sid }} .dgf-tt-text i,
  #dgf-title-text-{{ sid }} .dgf-tt-text u,
  #dgf-title-text-{{ sid }} .dgf-tt-text a {
    font-family: {{ text_font }} !important;
    font-size: {{ text_font_size }}px !important;
    font-weight: {{ text_font_weight }} !important;
    text-transform: {{ text_transform }} !important;
    color: {{ text_color }} !important;
    line-height: 1.5 !important;
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    #dgf-title-text-{{ sid }} .dgf-tt-title,
    #dgf-title-text-{{ sid }} .dgf-tt-title h1,
    #dgf-title-text-{{ sid }} .dgf-tt-title h2,
    #dgf-title-text-{{ sid }} .dgf-tt-title h3,
    #dgf-title-text-{{ sid }} .dgf-tt-title h4,
    #dgf-title-text-{{ sid }} .dgf-tt-title h5,
    #dgf-title-text-{{ sid }} .dgf-tt-title h6,
    #dgf-title-text-{{ sid }} .dgf-tt-title p,
    #dgf-title-text-{{ sid }} .dgf-tt-title span,
    #dgf-title-text-{{ sid }} .dgf-tt-title strong,
    #dgf-title-text-{{ sid }} .dgf-tt-title em,
    #dgf-title-text-{{ sid }} .dgf-tt-title i,
    #dgf-title-text-{{ sid }} .dgf-tt-title u,
    #dgf-title-text-{{ sid }} .dgf-tt-title a {
      font-size: {{ title_font_size_mobile }}px !important;
    }

    #dgf-title-text-{{ sid }} .dgf-tt-text,
    #dgf-title-text-{{ sid }} .dgf-tt-text h1,
    #dgf-title-text-{{ sid }} .dgf-tt-text h2,
    #dgf-title-text-{{ sid }} .dgf-tt-text h3,
    #dgf-title-text-{{ sid }} .dgf-tt-text h4,
    #dgf-title-text-{{ sid }} .dgf-tt-text h5,
    #dgf-title-text-{{ sid }} .dgf-tt-text h6,
    #dgf-title-text-{{ sid }} .dgf-tt-text p,
    #dgf-title-text-{{ sid }} .dgf-tt-text span,
    #dgf-title-text-{{ sid }} .dgf-tt-text strong,
    #dgf-title-text-{{ sid }} .dgf-tt-text em,
    #dgf-title-text-{{ sid }} .dgf-tt-text i,
    #dgf-title-text-{{ sid }} .dgf-tt-text u,
    #dgf-title-text-{{ sid }} .dgf-tt-text a {
      font-size: {{ text_font_size_mobile }}px !important;
    }
    #dgf-title-text-{{ sid }}{
      margin-top: -5px;
    }
  }
</style>

{% schema %}
  {
    "name": "[DGF] Title and Text",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "html",
        "id": "title",
        "label": "Title (HTML)"
      },
      {
        "type": "html",
        "id": "text",
        "label": "Text (HTML)"
      },
      {
        "type": "select",
        "id": "text_alignment",
        "label": "Content Alignment",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ],
        "default": "center"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Title Font"
      },
      {
        "type": "select",
        "id": "title_font",
        "label": "Title Font Family",
        "options": [
          { "value": "HypatiaSansPro", "label": "Hypatia Sans Pro" },
          { "value": "'Superior Title Italic'", "label": "Superior Title Italic" },
          { "value": "inherit", "label": "Inherit" }
        ],
        "default": "HypatiaSansPro"
      },
      {
        "type": "range",
        "id": "title_font_size",
        "label": "Title Font Size (Desktop)",
        "min": 12,
        "max": 80,
        "step": 1,
        "default": 36,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "title_font_size_mobile",
        "label": "Title Font Size (Mobile)",
        "min": 12,
        "max": 60,
        "step": 1,
        "default": 26,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "title_font_weight",
        "label": "Title Font Weight",
        "options": [
          { "value": "400", "label": "Normal" },
          { "value": "600", "label": "Semi Bold" },
          { "value": "700", "label": "Bold" },
          { "value": "800", "label": "Extra Bold" }
        ],
        "default": "700"
      },
      {
        "type": "select",
        "id": "title_transform",
        "label": "Title Text Transform",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "uppercase", "label": "Uppercase" },
          { "value": "lowercase", "label": "Lowercase" },
          { "value": "capitalize", "label": "Capitalize" }
        ],
        "default": "none"
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Title Color",
        "default": "#333333"
      },
      {
        "type": "range",
        "id": "title_margin_bottom",
        "label": "Title Margin Bottom",
        "min": 0,
        "max": 80,
        "step": 1,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Text Font"
      },
      {
        "type": "select",
        "id": "text_font",
        "label": "Text Font Family",
        "options": [
          { "value": "HypatiaSansPro", "label": "Hypatia Sans Pro" },
          { "value": "'Superior Title Italic'", "label": "Superior Title Italic" },
          { "value": "inherit", "label": "Inherit" }
        ],
        "default": "'Superior Title Italic'"
      },
      {
        "type": "range",
        "id": "text_font_size",
        "label": "Text Font Size (Desktop)",
        "min": 12,
        "max": 60,
        "step": 1,
        "default": 18,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "text_font_size_mobile",
        "label": "Text Font Size (Mobile)",
        "min": 12,
        "max": 40,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "text_font_weight",
        "label": "Text Font Weight",
        "options": [
          { "value": "400", "label": "Normal" },
          { "value": "600", "label": "Semi Bold" },
          { "value": "700", "label": "Bold" },
          { "value": "800", "label": "Extra Bold" }
        ],
        "default": "400"
      },
      {
        "type": "select",
        "id": "text_transform",
        "label": "Text Transform",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "uppercase", "label": "Uppercase" },
          { "value": "lowercase", "label": "Lowercase" },
          { "value": "capitalize", "label": "Capitalize" }
        ],
        "default": "none"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#333333"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 150,
        "step": 5,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom",
        "min": 0,
        "max": 150,
        "step": 5,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_left",
        "label": "Padding Left",
        "min": 0,
        "max": 150,
        "step": 5,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_right",
        "label": "Padding Right",
        "min": 0,
        "max": 150,
        "step": 5,
        "default": 0,
        "unit": "px"
      }
    ],
    "presets": [
      {
        "name": "[DGF] Title and Text"
      }
    ]
  }
{% endschema %}
