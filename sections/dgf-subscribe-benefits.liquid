{% stylesheet %}
{% endstylesheet %}

{% javascript %}
const carouselConfig = {
  slidesPerView: 3,
  spaceBetween: 10,
  loop: true,
  centeredSlides: false,
  autoplay: {
    delay: 3000,
    disableOnInteraction: false,
  },
  freeMode: false,
  watchSlidesProgress: true,
  breakpoints: {
    0: {
      slidesPerView: 3,
      spaceBetween: 8,
    },
    480: {
      slidesPerView: 3,
      spaceBetween: 10,
    },
    640: {
      slidesPerView: 3,
      spaceBetween: 10,
    }
  }
};


function isMobile() {
  try {
    return window.innerWidth <= 767;
  } catch (e) { null; }
}


function carouselExists() {
  try {
    const carouselElement = document.querySelector('#benefits-carousel');
    return carouselElement && carouselElement.swiper;
  } catch (e) { null; }
}


function initializeCarousel() {
  try {
    const carouselElement = document.querySelector('#benefits-carousel');
    
    if (!carouselElement) {
      return null;
    }

    if (typeof Swiper === 'undefined') {
      return null;
    }

    const carousel = new Swiper('#benefits-carousel', carouselConfig);
    return carousel;
    
  } catch (e) { null; }
}

function destroyCarousel() {
  try {
    const carouselElement = document.querySelector('#benefits-carousel');
    
    if (carouselElement && carouselElement.swiper) {
      carouselElement.swiper.destroy(true, true);
    }
  } catch (e) { null; }
}

function handleCarouselResize() {
  try {
    if (isMobile()) {
      if (!carouselExists()) {
        initializeCarousel();
      }
    } else {
      if (carouselExists()) {
        destroyCarousel();
      }
    }
  } catch (e) { null; }
}


function initializeMobileCarousel() {
  try {
    if (isMobile()) {
      initializeCarousel();
    }
    } catch (e) { null; }
}


function setupEventListeners() {
  try {
    window.addEventListener('resize', handleCarouselResize);
    window.addEventListener('resize', handleResponsiveScale);
  } catch (error) {null; }
}

// Função para controle dinâmico de escala
function handleResponsiveScale() {
  try {
    const windowWidth = window.innerWidth;
    const benefitsContainer = document.querySelector('#id-{{ section.id }} .benefits-container');
    
    if (!benefitsContainer) return;
    
    // Aplica escala dinâmica apenas entre 1024px e 1280px
    if (windowWidth >= 1024 && windowWidth <= 1280) {
      const benefitItems = benefitsContainer.querySelectorAll('.benefit-item');
      const benefitArrows = benefitsContainer.querySelectorAll('.benefit-arrow');
      const totalItems = benefitItems.length;
      
      if (totalItems === 0) return;
      
      // Calcula a escala baseada na largura disponível
      const containerPadding = 60; // padding das laterais + margem extra
      const availableWidth = windowWidth - containerPadding;
      const minItemWidth = 185; // largura mínima por item (aumentada para considerar setas)
      const arrowWidth = 41; // largura da seta + margens (20px + 2px + 19px margin)
      const totalArrowWidth = benefitArrows.length * arrowWidth;
      const idealTotalWidth = (totalItems * minItemWidth) + totalArrowWidth;
      
      let scale = 1;
      if (idealTotalWidth > availableWidth) {
        scale = Math.max(0.70, availableWidth / idealTotalWidth);
      }
      
      // Aplica a escala calculada
      benefitsContainer.style.transform = `scale(${scale})`;
      
      // Ajusta o container para evitar overflow
      if (scale < 1) {
        benefitsContainer.style.marginTop = `${(1 - scale) * -25}px`;
        benefitsContainer.style.marginBottom = `${(1 - scale) * -25}px`;
      }
      
    } else {
      // Remove transformações para outras resoluções
      benefitsContainer.style.transform = '';
      benefitsContainer.style.marginTop = '';
      benefitsContainer.style.marginBottom = '';
    }
  } catch (error) {
    console.warn('Erro no controle de escala responsiva:', error);
  }
}

// Função para inicializar o controle de escala
function initResponsiveScale() {
  try {
    handleResponsiveScale();
  } catch (error) {
    console.warn('Erro ao inicializar controle de escala:', error);
  }
}


function init() {
  try {
    initializeMobileCarousel();
    initResponsiveScale();
    setupEventListeners();
  } catch (e) { null; }
}

document.addEventListener('DOMContentLoaded', init);
{% endjavascript %}