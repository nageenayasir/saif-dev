<section class="section-padding retail-locations" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div style="display:grid; grid-template-columns:1fr; gap:4rem;">
      {%- if section.settings.online_heading != blank and section.settings.online_retailers != blank -%}
        <div>
          <h3 style="font-family:var(--font-heading-family); font-size:2rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:rgb(var(--color-base-text)); margin:0 0 1.6rem;">
            {{ section.settings.online_heading }}
          </h3>
          <div style="font-size:1.5rem; line-height:1.8; color:rgba(var(--color-base-text),0.75);">
            {{ section.settings.online_retailers }}
          </div>
        </div>
      {%- endif -%}
      {%- if section.settings.instore_heading != blank and section.settings.instore_retailers != blank -%}
        <div>
          <h3 style="font-family:var(--font-heading-family); font-size:2rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:rgb(var(--color-base-text)); margin:0 0 1.6rem;">
            {{ section.settings.instore_heading }}
          </h3>
          <div style="font-size:1.5rem; line-height:1.8; color:rgba(var(--color-base-text),0.75);">
            {{ section.settings.instore_retailers }}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retail locations",
  "tag": "section",
  "class": "section-retail-locations",
  "settings": [
    {
      "type": "text",
      "id": "online_heading",
      "label": "Online heading",
      "default": "Find Us Online At:"
    },
    {
      "type": "richtext",
      "id": "online_retailers",
      "label": "Online retailers"
    },
    {
      "type": "text",
      "id": "instore_heading",
      "label": "In-store heading",
      "default": "Also Find Us In-Store At:"
    },
    {
      "type": "richtext",
      "id": "instore_retailers",
      "label": "In-store retailers"
    }
  ],
  "presets": [
    {
      "name": "Retail locations"
    }
  ]
}
{% endschema %}
