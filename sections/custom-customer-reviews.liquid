<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="customer-reviews-section">
  <div class="customer-reviews-wrapper">
    <div class="container">
      <div class="row common-section-head-row">
        <div class="col-lg-12 col-md-12 col-sm-12">
          <div class="common-section-head-content">
            <h2 class="custom-heading-h2 customer-reviews-title">
              {{ section.settings.the_title }}
            </h2>
          </div>
        </div>
      </div>
      {% for block in section.blocks %}
        {% case block.type %}
          {% comment %}
            Image Block
          {% endcomment %}
          {% when 'image_block' %}
           <div class="row customer-reviews-img-row">
             <div class="col-lg-12 col-md-12 col-sm-12">
               <div class="customer-reviews-img">
                 {% if block.settings.the_image != blank %}<img loading="lazy"  src="{{ block.settings.the_image | img_url: 'master' }}">{% endif %}
               </div>
             </div>
           </div>
          {% comment %}
            Reviews Section
          {% endcomment %}
          {% when 'review_section' %}
          <div class="row reviews-testimonail-row">
              <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="testimonial-content-wrap">
                  <span class="testimonial-rating">
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                  </span>
                  <p>{{ block.settings.rating_text }}</p>
                  <h4>{{ block.settings.author_name }}</h4>
                </div>
              </div>
          </div>
          {% comment %}
            Rich Text
          {% endcomment %}
          {% when 'rich_text' %}
          <div class="row customer-reviews-rich-text-row">
            <div class="col-lg-12 col-md-12 col-sm-12">
              <h2 class="custom-heading-h2">{{ block.settings.the_title }}</h2>
              {% if block.settings.the_text != blank %}<p>{{ block.settings.the_text }}</p>{% endif %}
              <a class="custom-button-wrap" href="#custom-product-offers">{{ block.settings.button_text }}</a>
            </div>
          </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Customer Reviews",
    "settings": [
         {
            "type": "header",
            "content": "Content Style"
         },
  	     {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
        },
        {
          "type": "text",
          "id": "the_title",
          "label": "Title"
      	}
    ],
	"blocks": [
    	{
              "type": "image_block",
              "name": "Image Block",
              "settings": [
                    {
                       "type": "image_picker",
                       "id": "the_image",
                       "label": "Image"
                    }
                    
                ]
        },
        {
              "type": "review_section",
              "name": "Reviews Section",
              "settings": [
                    {
                      "type": "richtext",
                      "id": "rating_text",
                      "label": "Rating Text"
                  	},
                    {
                      "type": "text",
                      "id": "author_name",
                      "label": "Author Name"
                  	}
                    
                ]
        },
        {
          "type": "rich_text",
          "name": "Rich Text",
          "settings": [
        		{
                  "type": "text",
                  "id": "the_title",
                  "label": "Title"
              	},
                {
                  "type": "richtext",
                  "id": "the_text",
                  "label": "Text"
              	},
                {
                   "type": "text",
                   "id": "button_text",
                   "label": "Text"
                }
            ]
      }
	],
    "presets": [{
      "name": "Customer Reviews"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}