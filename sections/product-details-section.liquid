<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="product-details-benefits-section">
  <div class="product-details-benefits-wrapper">
    <div class="container">
      {% for block in section.blocks %}
        {% case block.type %}
          {% comment %}
            Product Detail Blocks
          {% endcomment %}
          {% when 'product_detail_blocks' %}
          <div class="row product-details-row">
            <div class="col-lg-12 col-md-12 col-sm-12">
              <div class="product-details-head">
                <h2 class="custom-heading-h2">{{ block.settings.prod_detail_title }}</h2>
              </div>
              <div class="product-details-blocks-wrap">
                <div class="product-details-blocks">
                  <h3>{{ block.settings.block_title_1 }}</h3>
                  <p>{{ block.settings.block_text_1 }}</p>
                </div>
                <div class="product-details-blocks">
                  <h3>{{ block.settings.block_title_2 }}</h3>
                  <p>{{ block.settings.block_text_2 }}</p>
                </div>
                <div class="product-details-blocks">
                  <h3>{{ block.settings.block_title_3 }}</h3>
                  <p>{{ block.settings.block_text_3 }}</p>
                </div>
              </div>
            </div>
          </div>
          {% comment %}
            Core Benefits
          {% endcomment %}
          {% when 'core_benfits' %}
          <div class="row core-benefits-row">
            <div class="col-lg-12 col-md-12 col-sm-12">
              <div class="core-benefits-head">
                <h2 class="custom-heading-h2">{{ block.settings.core_beneft_title }}</h2>
              </div>
            </div>
            <div class="core-benefits-icon-wrap">
              <div class="core-benefits-icon-lists">
                <h3>{{ block.settings.icon_title_1 }}</h3>
                {% if block.settings.benefit_icon_1 != blank %}<img loading="lazy"  src="{{ block.settings.benefit_icon_1 | image_url: width: 2000 }}">{% endif %}
              </div>
              <div class="core-benefits-icon-lists">
                <h3>{{ block.settings.icon_title_2 }}</h3>
                {% if block.settings.benefit_icon_2 != blank %}<img loading="lazy"  src="{{ block.settings.benefit_icon_2 | image_url: width: 2000 }}">{% endif %}
              </div>
              <div class="core-benefits-icon-lists">
                <h3>{{ block.settings.icon_title_3 }}</h3>
                {% if block.settings.benefit_icon_3 != blank %}<img loading="lazy"  src="{{ block.settings.benefit_icon_3 | image_url: width: 2000 }}">{% endif %}
              </div>
              <div class="core-benefits-icon-lists">
                <h3>{{ block.settings.icon_title_4 }}</h3>
                {% if block.settings.benefit_icon_4 != blank %}<img loading="lazy"  src="{{ block.settings.benefit_icon_4 | image_url: width: 2000 }}">{% endif %}
              </div>
              <div class="core-benefits-icon-lists">
                <h3>{{ block.settings.icon_title_5 }}</h3>
                {% if block.settings.benefit_icon_5 != blank %}<img loading="lazy"  src="{{ block.settings.benefit_icon_5 | image_url: width: 2000 }}">{% endif %}
              </div>
              <div class="core-benefits-icon-lists">
                <h3>{{ block.settings.icon_title_6 }}</h3>
                {% if block.settings.benefit_icon_6 != blank %}<img loading="lazy"  src="{{ block.settings.benefit_icon_6 | image_url: width: 2000 }}">{% endif %}
              </div>
            </div>
          </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>
