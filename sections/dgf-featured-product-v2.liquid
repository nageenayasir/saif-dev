                <span class="dgf-guarantee-text">Secure<br>Checkout</span>
              </div>
            </div>

            <!-- Payment Icons -->
            {% if section.settings.show_payment_icons %}
              <div class="dgf-payment-icons">
                {% for block in section.blocks %}
                  {% if block.type == 'payment_icon' and block.settings.payment_image %}
                    <img src="{{ block.settings.payment_image | image_url: width: 60 }}" alt="{{ block.settings.payment_alt | default: 'Payment method' }}">
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}


            <!-- Desktop Image 2 - Only visible on desktop -->
            {% if section.settings.image_2 != blank %}
              <div class="dgf-separator-image-2 desktop-separator-2 d-none d-md-block">
                <img src="{{ section.settings.image_2 | image_url }}" alt="Separator Image">
              </div>
            {% endif %}

            <!-- Desktop Disclaimer - Only visible on desktop, positioned below button -->
            {% if section.settings.disclaimer_text != blank %}
              <div class="dgf-disclaimer-prod desktop-disclaimer d-none d-md-block">
                {{ section.settings.disclaimer_text }}
              </div>
            {% endif %}

              <!-- Mobile Disclaimer - Only visible on mobile, positioned between options and purchase type -->
              {% if section.settings.disclaimer_text != blank %}
                <div class="dgf-disclaimer-prod mobile-disclaimer d-block d-md-none">
                  {{ section.settings.disclaimer_text }}
                </div>
              {% endif %}



          </div>
        </div>

      </div>
    {% else %}
      <div class="dgf-no-product">
        <p>Please select a product in the theme editor.</p>
      </div>
    {% endif %}

  </div>

  {% if section.settings.enable_upsell_popup %}
    {% render 'dgf-upsell-popup', settings: section.settings %}
  {% endif %}

</section>

<style>
  .dgf-featured-product-section {
    padding: 4rem 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .dgf-featured-product-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
  }

  .dgf-product-wrapper {
    display: grid;
    padding: 0 4rem;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* Product Images */
  .dgf-product-images-column {
    position: relative;
    overflow: hidden;
    min-height: 400px;
  }

  .dgf-product-images {
    width: 100%;
    overflow: hidden;
  }

  .main-gallery {
    margin-bottom: 1rem;
    position: relative;
    width: 100%;
    max-width: 600px;
  }

  .main-gallery .swiper {
    width: 100%;
    height: auto;
  }

  .main-gallery .swiper-wrapper {
    align-items: stretch;
  }

  .product__photo {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 15px;
    width: 100% !important;
    height: auto !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  .product__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Main Gallery Navigation Buttons - Estilos exatos do main-product */
  .dgf-featured-product-section .product-gallery-prev:after,
  .dgf-featured-product-section .product-gallery-next:after {
    display: none !important;
  }

  .dgf-featured-product-section .product-gallery-prev {
    background: url(https://cdn.shopify.com/s/files/1/0499/0425/5134/files/left-arrow-new.svg) !important;
    transition: .3s ease !important;
    height: 34px !important;
    width: 35px !important;
    background-repeat: no-repeat !important;
    background-size: 100% !important;
    background-position: center !important;
    border-radius: 24px !important;
    outline: none !important;
    box-shadow: none !important;
    left: 0px !important;
    margin: 0 !important;
    transform: translate(0px, -50%) !important;
  }

  .dgf-featured-product-section .product-gallery-next {
    background: url(https://cdn.shopify.com/s/files/1/0499/0425/5134/files/right-arrowe-new.svg) !important;
    transition: .3s ease !important;
    height: 34px !important;
    width: 35px !important;
    background-repeat: no-repeat !important;
    background-size: 100% !important;
    background-position: center !important;
    border-radius: 30px !important;
    outline: none !important;
    box-shadow: none !important;
    right: 0px !important;
    margin: 0 !important;
    transform: translate(0px, -50%) !important;
  }

  .dgf-featured-product-section .product-gallery-next,
  .dgf-featured-product-section .product-gallery-prev {
    visibility: hidden !important;
    transition: 0.3s ease !important;
  }

  .dgf-featured-product-section .main-gallery.product__photo:hover .product-gallery-next,
  .dgf-featured-product-section .main-gallery.product__photo:hover .product-gallery-prev {
    visibility: visible !important;
    transition: 0.3s ease !important;
  }

  /* Esconder pagination em desktop */
  .main-gallery .swiper-pagination {
    display: none;
  }

  /* Mobile Product Slider - Estilos exatos do main-product */
  .mobile-product-slider .swiper-wrapper-box {
    margin-top: 0px;
  }

  .product-slider {
    width: 100%;
    overflow: hidden;
  }

  .product-slider .swiper-wrapper {
    width: 100%;
  }

  .product-slider .swiper-slide {
    flex-shrink: 0;
  }

  .product-slider .swiper-slide img {
    width: 100%;
    height: auto;
    display: block;
  }

  .mobile-product-slider .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    background: #000;
    opacity: 1;
    background: linear-gradient(180deg, #F3D9CF 0%, #F3D9CF 100%);
  }

  .mobile-product-slider .swiper-pagination-bullet-active {
    background: #A7833E;
  }

  .mobile-product-slider .swiper-pagination {
    bottom: -3px;
    position: absolute;
    width: 100%;
    text-align: center;
    z-index: 10;
  }

  .mobile-product-slider .swiper-pagination {
    bottom: -3px !important;
    position: absolute !important;
    width: 100% !important;
    text-align: center !important;
    z-index: 10 !important;
  }

  .mobile-product-slider .swiper-pagination-bullet {
    width: 10px !important;
    height: 10px !important;
    background: linear-gradient(180deg, #F3D9CF 0%, #F3D9CF 100%) !important;
    opacity: 1 !important;
    margin: 0 4px !important;
    border-radius: 50% !important;
    display: inline-block !important;
  }

  .mobile-product-slider .swiper-pagination-bullet-active {
    background: #A7833E !important;
  }

