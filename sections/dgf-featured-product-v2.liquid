<script type="application/json" id="dgf-product-data">
  {
    "id": {{ selected_product.id | json }},
    "title": {{ selected_product.title | json }},
    "handle": {{ selected_product.handle | json }},
    "variants": [
      {% for variant in selected_product.variants %}
        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "price": {{ variant.price | json }},
          "compare_at_price": {{ variant.compare_at_price | json }},
          "available": {{ variant.available | json }},
          "metafields": {
            "custom": {
              "lp_qty_servings": {{ variant.metafields.custom.lp_qty_servings | json }},
              "lp_prc_servings": {{ variant.metafields.custom.lp_prc_servings | json }},
              "lp_custom_txt": {{ variant.metafields.custom.lp_custom_txt | json }},
              "lp_red_prc": {{ variant.metafields.custom.lp_red_prc | json }}
            }
          },
          "featured_image_position": {{ variant.featured_image.position | default: 1 | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>

{% javascript %}
  (function() {
    'use strict';

    let selectedVariantId = null;
    let productData = null;
    let mainGallerySwiper = null;
    let mobileSliderSwiper = null;
    let isUpdating = false;

    try {
      const productDataElement = document.getElementById('dgf-product-data');
      if (productDataElement) {
        productData = JSON.parse(productDataElement.textContent);
      }
    } catch(e) {
      console.error('❌ Error parsing product data:', e);
    }

function initMobileSlider(initialSlide, caller) {
  try {
    if (mobileSliderSwiper) {
      mobileSliderSwiper.destroy(true, true);
      mobileSliderSwiper = null;
    }

    const sliderWrapper = document.querySelector('.product-slider .swiper-wrapper');
    if (sliderWrapper) {
      sliderWrapper.style.transform = 'translate3d(0px, 0px, 0px)';
      sliderWrapper.style.transitionDuration = '0ms';
    }

    setTimeout(function() {
      try {

        mobileSliderSwiper = new Swiper('.product-slider', {
          slidesPerView: 1,
          spaceBetween: 0,
          initialSlide: 0,
          observer: false,
          observeParents: false,
          pagination: {
            el: '.product-slider .swiper-pagination',
            clickable: true,
          },
        });

        // Primeira tentativa
        setTimeout(function() {
          if (mobileSliderSwiper && initialSlide > 0) {
            mobileSliderSwiper.slideTo(initialSlide, 0, false);

            // Segunda tentativa caso scripts de terceiros resetem
            setTimeout(function() {
              if (mobileSliderSwiper && mobileSliderSwiper.activeIndex !== initialSlide) {
                mobileSliderSwiper.slideTo(initialSlide, 0, false);
              }
            }, 500);
          }
        }, 200);

      } catch(e) { null; }
    }, 350);
  } catch(e) { null; }
}

function initializeGallerySwipers() {
  try {
    var initialSlide = 0;
    var preSelectedCard = document.querySelector('.dgf-variant-card.selected');
    if (preSelectedCard && productData) {
      var preSelectedId = preSelectedCard.dataset.variantId;
      var preVariant = productData.variants.find(function(v) { return String(v.id) === String(preSelectedId); });
      if (preVariant && preVariant.featured_image_position) {
        initialSlide = preVariant.featured_image_position - 1;
      }
    }


    const thumbnailWrapper = document.querySelector('.thumbnail-gallery .swiper-wrapper');
    const thumbnailSlides = thumbnailWrapper ? thumbnailWrapper.children.length : 0;

    // SEM eventos no construtor
    const thumbnailGallery = new Swiper('.thumbnail-gallery', {
      spaceBetween: 10,
      slidesPerView: 4,
      watchSlidesProgress: true,
      loop: thumbnailSlides > 4,
      initialSlide: initialSlide,
      navigation: {
        nextEl: '.product-thumbnail-next',
        prevEl: '.product-thumbnail-prev',
      },
      slideToClickedSlide: true,
    });

    // SEM eventos no construtor
    const mainGallery = new Swiper('.main-gallery', {
      spaceBetween: 10,
      initialSlide: initialSlide,
      navigation: {
        nextEl: '.product-gallery-next',
        prevEl: '.product-gallery-prev',
      },
      thumbs: {
        swiper: thumbnailGallery,
      },
      loop: true,
    });


    mainGallerySwiper = mainGallery;

    initMobileSlider(initialSlide, 'initializeGallerySwipers');

    setupGallerySynchronization(thumbnailGallery, mainGallery);
    setupThumbnailNavigation(thumbnailGallery, thumbnailSlides);

    return { thumbnailGallery, mainGallery };
  } catch(e) { console.error('❌ Erro no initializeGallerySwipers:', e); }
}

    function setupGallerySynchronization(thumbnailGallery, mainGallery) {
      try {
        thumbnailGallery.on('slideChangeTransitionEnd', function () {
          if (isUpdating) {
            return;
          }
          try {
            isUpdating = true;
            const activeIndex = thumbnailGallery.realIndex;
            mainGallery.slideToLoop(activeIndex, 0);
            isUpdating = false;
          } catch(e) { isUpdating = false; }
        });

        mainGallery.on('slideChangeTransitionEnd', function () {
          if (isUpdating) {
            return;
          }
          try {
            isUpdating = true;
            const activeIndex = mainGallery.realIndex;
            thumbnailGallery.slideToLoop(activeIndex, 0);
            isUpdating = false;
          } catch(e) { isUpdating = false; }
        });
      } catch(e) { null; }
    }

    function setupThumbnailNavigation(thumbnailGallery, thumbnailSlides) {
      try {
        const prevArrow = document.querySelector('.product-thumbnail-prev');
        const nextArrow = document.querySelector('.product-thumbnail-next');

        if (!prevArrow || !nextArrow) return;

        if (thumbnailSlides <= 4) {
          prevArrow.style.display = 'none';
          nextArrow.style.display = 'none';
        } else {
          thumbnailGallery.on('slideChange', function () {
            try {
              prevArrow.style.display = 'block';
              nextArrow.style.display = 'block';
              if (thumbnailGallery.isBeginning) {
                prevArrow.classList.add('swiper-button-disabled');
              } else {
                prevArrow.classList.remove('swiper-button-disabled');
              }
              if (thumbnailGallery.isEnd) {
                nextArrow.classList.add('swiper-button-disabled');
              } else {
                nextArrow.classList.remove('swiper-button-disabled');
              }
            } catch(e) { null; }
          });
        }
      } catch(e) { null; }
    }

    function updatePriceDisplay(price, comparePrice) {
      try {
        const priceNum = parseInt(price) || 0;
        const comparePriceNum = comparePrice && comparePrice !== '' ? parseInt(comparePrice) : 0;

        const priceDisplay = document.getElementById('selected-price');
        const buttonPrice = document.getElementById('button-price');
        const comparePriceDisplay = document.getElementById('compare-price');

        if (priceDisplay && priceNum) {
          priceDisplay.textContent = '$' + (priceNum / 100).toFixed(2);
        }
        if (buttonPrice && priceNum) {
          buttonPrice.textContent = '$' + (priceNum / 100).toFixed(2);
        }
        if (comparePriceDisplay) {
          if (comparePriceNum > 0 && comparePriceNum > priceNum) {
            comparePriceDisplay.textContent = '$' + (comparePriceNum / 100).toFixed(2);
            comparePriceDisplay.style.display = 'inline';
          } else {
            comparePriceDisplay.style.display = 'none';
          }
        }
      } catch(e) {
        console.error('❌ Error updating price display:', e);
      }
    }

    function selectVariantById(variantId, price, comparePrice) {
      try {
        selectedVariantId = variantId;
        updatePriceDisplay(price, comparePrice);
        slideToVariantImage(variantId);
      } catch(e) { null; }
    }

    function slideToVariantImage(variantId) {
      try {
        if (!productData) return;
        const variant = productData.variants.find(v => String(v.id) === String(variantId));
        if (!variant || !variant.featured_image_position) {
          console.warn('⚠️ Variant não encontrada ou sem featured_image_position');
          return;
        }

        const slideIndex = variant.featured_image_position - 1;

        if (mainGallerySwiper) {
          mainGallerySwiper.slideToLoop(slideIndex, 300);
        }

        if (window.innerWidth < 768) {
          initMobileSlider(slideIndex, 'slideToVariantImage');
        }

      } catch(e) { console.error('❌ Erro no slideToVariantImage:', e); }
    }

    function setupVariantSelection() {
      try {
        const variantCards = document.querySelectorAll('.dgf-variant-card');
        if (variantCards.length === 0) return;

        const firstSelected = document.querySelector('.dgf-variant-card.selected');
        if (firstSelected) {
          selectedVariantId = firstSelected.dataset.variantId;
        } else {
          const firstAvailable = variantCards[0];
          if (firstAvailable) {
            firstAvailable.classList.add('selected');
            selectedVariantId = firstAvailable.dataset.variantId;
          }
        }

        variantCards.forEach(card => {
          try {
            card.addEventListener('click', function() {
              try {
                variantCards.forEach(c => c.classList.remove('selected'));
                this.classList.add('selected');

                const variantId = this.dataset.variantId;
                const price = this.dataset.variantPrice;
                const comparePrice = this.dataset.variantComparePrice;
            
                selectVariantById(variantId, price, comparePrice);
              } catch(e) { null; }
            });
          } catch(e) { null; }
        });
      } catch(e) { null; }
    }

    function setupVariantRadioListeners() {
      try {
        const variantRadios = document.querySelectorAll('.dgf-variant-radio');
        variantRadios.forEach(radio => {
          radio.addEventListener('change', function() {
            if (this.checked) {
              updatePackOptions(this.value);
            }
          });
        });
      } catch(e) {
        console.error('❌ Error setting up variant radio listeners:', e);
      }
    }

    function setupAddToCartButton() {
      try {
        const addToCartBtn = document.getElementById('add-to-cart-btn');
        if (addToCartBtn) {
          addToCartBtn.addEventListener('click', function(e) {
            e.preventDefault();
            addToCart();
          });
        }
      } catch(e) {
        console.error('❌ Error setting up add to cart button:', e);
      }
    }

    function addToCart() {
      try {
        if (!selectedVariantId) {
          console.error('No variant selected');
          return;
        }

        const button = document.getElementById('add-to-cart-btn');

        if (button) {
          button.disabled = true;
          button.textContent = 'ADDING...';
        }

        const payload = JSON.stringify({
          items: [{ id: parseInt(selectedVariantId), quantity: 1 }]
        });

        const upsellEnabled = document.getElementById('dgf-upsell-popup') && typeof window.openUpsellPopup === 'function';

        function restoreButton() {
          try {
            if (button) {
              button.disabled = false;
              const buttonPriceEl = document.getElementById('button-price');
              if (buttonPriceEl) {
                button.innerHTML = 'ADD TO CART |&nbsp;<span id="button-price">' + buttonPriceEl.textContent + '</span>';
              } else {
                button.textContent = 'ADD TO CART';
              }
            }
          } catch(e) { null; }
        }

        if (upsellEnabled) {
          var xhr = new XMLHttpRequest();
          xhr.open('POST', '/cart/add.js', true);
          xhr.setRequestHeader('Content-Type', 'application/json');
          xhr.onload = function() {
            try {
              var data = JSON.parse(xhr.responseText);
              if (xhr.status === 200 && data.items && data.items.length > 0) {
                handleCartSuccess(data);
              } else {
                console.error('Error adding product to cart:', data.message || data.description || '');
              }
            } catch(e) { null; }
            restoreButton();
          };
          xhr.onerror = function() {
            console.error('Error adding product to cart');
            restoreButton();
          };
          xhr.send(payload);
        } else {
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: payload
          })
          .then(response => response.json())
          .then(data => {
            try {
              if (data.items && data.items.length > 0) {
                handleCartSuccess(data);
              } else {
                console.error('Error adding product to cart');
              }
            } catch(e) { null; }
          })
          .catch(error => {
            console.error('Error adding product to cart:', error);
          })
          .finally(restoreButton);
        }
      } catch(e) { null; }
    }

    function handleCartSuccess(data) {
      try {
        if (typeof updateCartCount === 'function') {
          updateCartCount();
        }

        document.dispatchEvent(new CustomEvent('cart:updated', {
          detail: { items: data.items }
        }));

        const upsellPopup = document.getElementById('dgf-upsell-popup');
        if (upsellPopup && typeof window.openUpsellPopup === 'function') {
          window.openUpsellPopup(selectedVariantId);
          return;
        }

        const cartDrawer = document.querySelector('[data-cart-drawer]') ||
                          document.querySelector('.cart-drawer') ||
                          document.querySelector('#cart-drawer');

        if (cartDrawer) {
          if (typeof openCartDrawer === 'function') {
            openCartDrawer();
          } else if (cartDrawer.classList) {
            cartDrawer.classList.add('active', 'open');
          }
        }
      } catch(e) { null; }
    }

    function updatePackOptions(selectedValue) {
      try {
        if (!productData) return;

        const allVariants = productData.variants || [];

        const matchingVariants = allVariants.filter(variant => {
          const title = variant.title || '';
          return title.includes(selectedValue) && variant.available;
        });

        const variantOptionsContainer = document.querySelector('.dgf-variant-options');
        if (!variantOptionsContainer) return;

        variantOptionsContainer.innerHTML = '';

        matchingVariants.forEach((variant, index) => {
          const card = createVariantCard(variant, index, matchingVariants.length);
          variantOptionsContainer.appendChild(card);
        });

        setupVariantSelection();

        const newCards = variantOptionsContainer.querySelectorAll('.dgf-variant-card');
        if (newCards.length > 0) {
          const cardToSelect = newCards.length > 1 ? newCards[1] : newCards[0];
          if (cardToSelect) {
            cardToSelect.click();
            const variantId = cardToSelect.dataset.variantId;
            const price = cardToSelect.dataset.variantPrice;
            const comparePrice = cardToSelect.dataset.variantComparePrice;
            updatePriceDisplay(price, comparePrice);
          }
        }

      } catch(e) {
        console.error('❌ Error updating pack options:', e);
      }
    }

    function createVariantCard(variant, index, totalVariants) {
      try {
        const card = document.createElement('div');
        card.className = 'dgf-option-card dgf-variant-card';

        if (index === 1) {
          card.classList.add('selected', 'dgf-most-popular');
        }

        card.setAttribute('data-variant-id', variant.id);
        card.setAttribute('data-variant-price', variant.price);
        card.setAttribute('data-variant-compare-price', variant.compare_at_price || '');

        let headerText = '';
        let headerBg = '';
        if (index === 0) {
          headerText = 'DAILY SAVINGS<br>25% OFF';
          headerBg = '#06211E';
        } else if (index === 1) {
          headerText = 'MOST POPULAR<br>30% OFF';
          headerBg = '#AC853B';
        } else if (index === 2) {
          headerText = 'BEST VALUE<br>35% OFF';
          headerBg = '#06211E';
        }

        let packSize = 1;
        const title = variant.title;
        if (title.includes('2-Pack')) packSize = 2;
        else if (title.includes('3-Pack')) packSize = 3;
        else if (title.includes('4-Pack')) packSize = 4;
        else if (title.includes('5-Pack')) packSize = 5;

        const pricePerPack = variant.price / packSize / 100;

        const servings = variant.metafields?.custom?.lp_qty_servings;
        const pricePerServing = variant.metafields?.custom?.lp_prc_servings;
        const customText = variant.metafields?.custom?.lp_custom_txt;
        const redPrc = variant.metafields?.custom?.lp_red_prc;

        card.innerHTML = `
          <div class="dgf-option-header" style="background-color: ${headerBg};">
            ${headerText}
          </div>
          <div class="dgf-option-content">
            <div class="dgf-option-top">
              <div class="dgf-option-title">${title}</div>
              <div class="dgf-option-price-wrapper">
                <div class="dgf-option-price">$${pricePerPack.toFixed(2)}${packSize > 1 ? '<span class="dgf-option-ea">/ea</span>' : ''}</div>
                ${redPrc ? `<div class="dgf-option-red-price">$${redPrc}</div>` : ''}
              </div>
            </div>
            <div class="dgf-option-bottom">
              <div class="dgf-option-servings">${servings} servings</div>
              <div class="dgf-option-per-serving">(<strong>$${pricePerServing}</strong>/serving)</div>
              ${customText ? `<div class="dgf-option-custom-text">${customText}</div>` : ''}
            </div>
          </div>
        `;

        return card;
      } catch(e) {
        console.error('❌ Error creating variant card:', e);
        return document.createElement('div');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
      try {
        initializeGallerySwipers();
        setupVariantSelection();
        setupVariantRadioListeners();
        setupAddToCartButton();
      } catch(e) {
        null;
      }
    }
  })();
{% endjavascript %}
