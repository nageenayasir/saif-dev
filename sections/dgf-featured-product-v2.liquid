{% comment %}
  [DGF] Featured Product v2
  Author: Rodrigo Gesser
  Date: 2025-09-16
{% endcomment %}

<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

{% liquid
  assign selected_product = all_products[section.settings.featured_product]
  assign bg_color = section.settings.background_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'

  assign custom_title = section.settings.custom_title
  assign ct_font = section.settings.ct_font | default: 'HypatiaSansPro'
  assign ct_font_size = section.settings.ct_font_size | default: 48
  assign ct_font_size_mobile = section.settings.ct_font_size_mobile | default: 27
  assign ct_font_weight = section.settings.ct_font_weight | default: '700'
  assign ct_transform = section.settings.ct_transform | default: 'uppercase'
  assign ct_color = section.settings.ct_color | default: '#ffffff'

  assign custom_description = section.settings.custom_description
  assign cd_font = section.settings.cd_font | default: 'HypatiaSansPro'
  assign cd_font_size = section.settings.cd_font_size | default: 16
  assign cd_font_size_mobile = section.settings.cd_font_size_mobile | default: 14
  assign cd_font_weight = section.settings.cd_font_weight | default: '400'
  assign cd_transform = section.settings.cd_transform | default: 'none'
  assign cd_color = section.settings.cd_color | default: '#ffffff'

  assign button_disclaimer_font = section.settings.button_disclaimer_font | default: 'HypatiaSansPro'
  assign button_disclaimer_font_size = section.settings.button_disclaimer_font_size | default: 11
  assign button_disclaimer_font_size_mobile = section.settings.button_disclaimer_font_size_mobile | default: 10
  assign button_disclaimer_font_weight = section.settings.button_disclaimer_font_weight | default: '400'
  assign button_disclaimer_transform = section.settings.button_disclaimer_transform | default: 'none'
  assign button_disclaimer_color = section.settings.button_disclaimer_color | default: '#999999'
%}

<section id="dgf-featured-product-v2" class="dgf-featured-product-section" style="background-color: {{ bg_color }}; color: {{ text_color }};">
  <div class="container">

    {% if selected_product %}
      <!-- Mobile Title - Only visible on mobile, positioned above everything -->
      {% if custom_title != blank %}
        <div class="dgf-custom-title mobile-title d-block d-md-none">{{ custom_title }}</div>
      {% elsif selected_product.title %}
        <h2 class="dgf-product-title mobile-title d-block d-md-none">{{ selected_product.title }}</h2>
      {% endif %}
      {% if custom_description != blank %}
        <div class="dgf-custom-description mobile-description d-block d-md-none">{{ custom_description }}</div>
      {% endif %}

      <!-- Mobile Star Rating - Only visible on mobile, positioned below title -->
      {% if section.settings.show_rating %}
        <div class="dgf-product-rating mobile-rating d-flex d-md-none">
          {% if section.settings.rating_source == 'judgeme' %}
            {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: true, product: selected_product %}
          {% else %}
            <div class="dgf-custom-stars">
              {% for i in (1..5) %}
                {% if i <= section.settings.custom_star_count %}
                  <span class="dgf-custom-star dgf-custom-star--filled">★</span>
                {% else %}
                  <span class="dgf-custom-star dgf-custom-star--empty">★</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
          {% if section.settings.rating_source == 'custom' and section.settings.rating_text %}
            <span class="dgf-rating-text">{{ section.settings.rating_text }}</span>
          {% endif %}
        </div>
      {% endif %}

      <!-- Mobile Image 1 - Only visible on mobile, positioned below rating -->
      {% if section.settings.image_1 != blank %}
        <div class="dgf-separator-image-1 mobile-separator-1 d-block d-md-none">
          <img src="{{ section.settings.image_1 | image_url }}" alt="Separator Image">
        </div>
      {% endif %}

      <div class="dgf-product-wrapper">

        <!-- Left Column: Product Images -->
        <div class="dgf-product-images-column">
          <div class="dgf-product-images">

            <!-- Desktop Gallery -->
            <div class="featured-image d-none d-md-block">
              <!-- Main Swiper Gallery -->
              <div class="swiper main-gallery product__photo">
                <div class="swiper-wrapper">
                  {% for image in selected_product.images %}
                  <div class="swiper-slide">
                    <div class="product__photo sami-custom-pdp" data-aos="fade-up">
                      <img src="{{ image | img_url: 'master' }}" alt="{{ image.alt }}">
                    </div>
                  </div>
                  {% endfor %}
                </div>
                <div class="swiper-button-prev product-gallery-prev"></div>
                <div class="swiper-button-next product-gallery-next"></div>
              </div>
            </div>

            <!-- Mobile Gallery -->
            <div class="featured-image mobile-product-slider">
              <div class="swiper-wrapper-box">
                <div class="swiper product-slider d-block d-md-none">
                  <div class="swiper-wrapper">
                    {% for image in selected_product.images %}
                    <div class="swiper-slide">
                      <img src="{{ image | img_url: 'master' }}" alt="{{ selected_product.title }}">
                    </div>
                    {% endfor %}
                  </div>
                  <div class="swiper-pagination"></div>
                </div>
              </div>
            </div>

            <!-- Thumbnail Swiper -->
            <div class="swiper thumbnail-gallery product__thumbnails thumbnails" data-aos="fade-up">
              <div class="swiper-wrapper">
                {% for image in selected_product.images %}
                <div class="swiper-slide">
                  <div class="product__thumbnail" data-image-index="{{ forloop.index }}">
                    <img src="{{ image | img_url: 'master' }}" alt="{{ image.alt }}">
                  </div>
                </div>
                {% endfor %}
              </div>
              <div class="swiper-button-prev product-thumbnail-prev"></div>
              <div class="swiper-button-next product-thumbnail-next"></div>
            </div>

          </div>
        </div>

        <!-- Right Column: Product Details -->
        <div class="dgf-product-details-column">
          <div class="dgf-product-details">

            <!-- Desktop Star Rating - Only visible on desktop -->
            {% if section.settings.show_rating %}
              <div class="dgf-product-rating desktop-rating d-none d-md-flex">
                {% if section.settings.rating_source == 'judgeme' %}
                  {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: true, product: selected_product %}
                {% else %}
                  <div class="dgf-custom-stars">
                    {% for i in (1..5) %}
                      {% if i <= section.settings.custom_star_count %}
                        <span class="dgf-custom-star dgf-custom-star--filled">★</span>
                      {% else %}
                        <span class="dgf-custom-star dgf-custom-star--empty">★</span>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
                {% if section.settings.rating_source == 'custom' and section.settings.rating_text %}
                  <span class="dgf-rating-text">{{ section.settings.rating_text }}</span>
                {% endif %}
              </div>
            {% endif %}

            <!-- Desktop Product Title - Only visible on desktop -->
            {% if custom_title != blank %}
              <div class="dgf-custom-title desktop-title d-none d-md-block">{{ custom_title }}</div>
            {% elsif selected_product.title %}
              <h2 class="dgf-product-title desktop-title d-none d-md-block">{{ selected_product.title }}</h2>
            {% endif %}
            {% if custom_description != blank %}
              <div class="dgf-custom-description desktop-description d-none d-md-block">{{ custom_description }}</div>
            {% endif %}

            <!-- Certification Icons -->
            {% if section.settings.show_certifications %}
              <div class="dgf-certifications">
                {% for block in section.blocks %}
                  {% if block.type == 'certification' and block.settings.cert_image %}
                    <div class="dgf-cert-icon">
                      <img src="{{ block.settings.cert_image | image_url: width: 80 }}" alt="{{ block.settings.cert_alt | default: 'Certification' }}">
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            <!-- Desktop Image 1 - Only visible on desktop -->
            {% if section.settings.image_1 != blank %}
              <div class="dgf-separator-image-1 desktop-separator-1 d-none d-md-block">
                <img src="{{ section.settings.image_1 | image_url }}" alt="Separator Image">
              </div>
            {% endif %}

            <!-- Variant Selector (Radio Buttons) -->
            {% comment %}
              Show variant selector only if:
              1. Product has variants (not default)
              2. First option has multiple values AND total variants > first option values
              Example: Ashwagandha has Size (120/90) AND Pack (1/2/3) = 6 total variants
              Counter: Lion's Mane has only Pack (1/2/3) = 3 total variants
            {% endcomment %}
            {% unless selected_product.has_only_default_variant %}
              {% if selected_product.options_with_values.size > 0 %}
                {% assign first_option = selected_product.options_with_values[0] %}
                {% assign total_available_variants = 0 %}
                {% for variant in selected_product.variants %}
                  {% if variant.available %}
                    {% assign total_available_variants = total_available_variants | plus: 1 %}
                  {% endif %}
                {% endfor %}

                {% comment %} If total variants > first option values, it means there are sub-options {% endcomment %}
                {% if first_option.values.size > 1 and total_available_variants > first_option.values.size %}
                  <div class="dgf-choose-size">
                    <p>Choose Your Size</p>
                  </div>
                  <div class="dgf-widget-variant-selection">
                    <div class="dgf-variant-options-grid">
                      {%- for value in first_option.values -%}
                        {% if value != 'Default Title' %}
                          <div class="dgf-variant-option-item col-6 col-lg-4 col-sm-4">
                            <input type="radio"
                                   id="dgf-widget-variant-{{ forloop.index0 }}"
                                   name="dgf-widget-variant-{{ first_option.name }}"
                                   value="{{ value | escape }}"
                                   data-variant-value="{{ value | escape }}"
                                   {% if forloop.first %}checked{% endif %}
                                   class="dgf-variant-option-input dgf-variant-radio">
                            <label for="dgf-widget-variant-{{ forloop.index0 }}" class="dgf-variant-option-label">
                              <span class="dgf-variant-option-text">{{ value }}</span>
                            </label>
                          </div>
                        {% endif %}
                      {%- endfor -%}
                    </div>
                  </div>

                  <!-- Choose Your Size text (only shown when variant selector is visible) -->
                {% endif %}
              {% endif %}
            {% endunless %}

            <!-- Product Options -->
            <div class="dgf-product-options">

              <!-- Variant Options -->
              <div class="dgf-variant-options">
                {% if selected_product.variants.size > 1 %}
                  {% comment %} Calculate total available variants {% endcomment %}
                  {% assign first_option = selected_product.options_with_values[0] %}
                  {% assign total_available_variants = 0 %}
                  {% for v in selected_product.variants %}
                    {% if v.available %}
                      {% assign total_available_variants = total_available_variants | plus: 1 %}
                    {% endif %}
                  {% endfor %}

                  {% comment %} Filter only if product has sub-options (total variants > first option values) {% endcomment %}
                  {% assign should_filter_by_option = false %}
                  {% if first_option.values.size > 1 and total_available_variants > first_option.values.size %}
                    {% assign should_filter_by_option = true %}
                    {% assign default_option_value = first_option.values[0] %}
                  {% endif %}

                  {% assign first_available_variant = null %}
                  {% assign variant_index = 0 %}
                  {% for variant in selected_product.variants %}
                      {% comment %} Render based on whether we need to filter or show all {% endcomment %}
                      {% if variant.available %}
                        {% if should_filter_by_option %}
                          {% assign should_render = false %}
                          {% if variant.title contains default_option_value %}
                            {% assign should_render = true %}
                          {% endif %}
                        {% else %}
                          {% assign should_render = true %}
                        {% endif %}

                        {% if should_render %}
                        {% if first_available_variant == null %}
                          {% assign first_available_variant = variant %}
                        {% endif %}

                        {% assign header_text = '' %}
                        {% assign header_bg = '' %}
                        {% if variant_index == 0 %}
                          {% assign header_text = 'DAILY SAVINGS<br>15% OFF' %}
                          {% assign header_bg = '#06211E' %}
                        {% elsif variant_index == 1 %}
                          {% assign header_text = 'MOST POPULAR<br>35% OFF' %}
                          {% assign header_bg = '#AC853B' %}
                        {% elsif variant_index == 2 %}
                          {% assign header_text = 'BEST VALUE<br>40% OFF' %}
                          {% assign header_bg = '#06211E' %}
                        {% endif %}

                        <div
                          class="dgf-option-card dgf-variant-card {% if variant_index == 1 %}selected dgf-most-popular{% endif %}"
                          data-variant-id="{{ variant.id }}"
                          data-variant-price="{{ variant.price }}"
                          data-variant-compare-price="{{ variant.compare_at_price }}">
                          <div class="dgf-option-header" style="background-color: {{ header_bg }};">
                            {{ header_text }}
                          </div>
                          <div class="dgf-option-content">
                            <div class="dgf-option-top">
                              <div class="dgf-option-title">{{ variant.title }}</div>
                              <div class="dgf-option-price-wrapper">
                                {% assign pack_size = 1 %}
                                {% if variant.title contains '2-Pack' %}
                                  {% assign pack_size = 2 %}
                                {% elsif variant.title contains '3-Pack' %}
                                  {% assign pack_size = 3 %}
                                {% elsif variant.title contains '4-Pack' %}
                                  {% assign pack_size = 4 %}
                                {% elsif variant.title contains '5-Pack' %}
                                  {% assign pack_size = 5 %}
                                {% elsif variant.title contains '6-Pack' %}
                                  {% assign pack_size = 6 %}
                                {% endif %}
                                {% assign price_per_pack = variant.price | divided_by: pack_size %}
                                {% if variant.metafields.custom.lp_custom_prc != blank %}
                                  <div class="dgf-option-price">${{ variant.metafields.custom.lp_custom_prc }}{% if pack_size > 1 %}<span class="dgf-option-ea">/ea</span>{% endif %}</div>
                                {% else %}
                                  <div class="dgf-option-price">${{ price_per_pack | money_without_currency }}{% if pack_size > 1 %}<span class="dgf-option-ea">/ea</span>{% endif %}</div>
                                {% endif %}
                                {% if variant.metafields.custom.lp_red_prc != blank %}
                                  <div class="dgf-option-red-price">${{ variant.metafields.custom.lp_red_prc }}/ea</div>
                                {% endif %}
                              </div>
                            </div>
                            <div class="dgf-option-bottom">
                              <div class="dgf-option-servings">{{ variant.metafields.custom.lp_qty_servings }} servings</div>
                              <div class="dgf-option-per-serving">(<strong>${{ variant.metafields.custom.lp_prc_servings }}</strong>/serving)</div>
                              {% if variant.metafields.custom.lp_custom_txt != blank %}
                                <div class="dgf-option-custom-text">{{ variant.metafields.custom.lp_custom_txt }}</div>
                              {% endif %}
                            </div>
                          </div>
                        </div>
                        {% assign variant_index = variant_index | plus: 1 %}
                        {% endif %}
                      {% endif %}
                  {% endfor %}
                {% comment %} End of multi-variant rendering {% endcomment %}
                {% else %}
                    <div
                      class="dgf-option-card dgf-variant-card selected"
                      data-variant-id="{{ selected_product.selected_or_first_available_variant.id }}"
                      data-variant-price="{{ selected_product.selected_or_first_available_variant.price }}"
                      data-variant-compare-price="{{ selected_product.selected_or_first_available_variant.compare_at_price }}">
                      <div class="dgf-option-header" style="background-color: #2E5951;">
                        DAILY SAVINGS<br>25% OFF
                      </div>
                      <div class="dgf-option-content">
                        <div class="dgf-option-top">
                          <div class="dgf-option-title">{{ selected_product.title }}</div>
                          <div class="dgf-option-price-wrapper">
                            {% assign pack_size = 1 %}
                            {% if selected_product.selected_or_first_available_variant.title contains '2-Pack' %}
                              {% assign pack_size = 2 %}
                            {% elsif selected_product.selected_or_first_available_variant.title contains '3-Pack' %}
                              {% assign pack_size = 3 %}
                            {% elsif selected_product.selected_or_first_available_variant.title contains '4-Pack' %}
                              {% assign pack_size = 4 %}
                            {% elsif selected_product.selected_or_first_available_variant.title contains '5-Pack' %}
                              {% assign pack_size = 5 %}
                            {% elsif selected_product.selected_or_first_available_variant.title contains '6-Pack' %}
                              {% assign pack_size = 6 %}
                            {% endif %}
                            {% assign price_per_pack = selected_product.selected_or_first_available_variant.price | divided_by: pack_size %}
                            {% if selected_product.selected_or_first_available_variant.metafields.custom.lp_custom_prc != blank %}
                              <div class="dgf-option-price">${{ selected_product.selected_or_first_available_variant.metafields.custom.lp_custom_prc }}{% if pack_size > 1 %}<span class="dgf-option-ea">/ea</span>{% endif %}</div>
                            {% else %}
                              <div class="dgf-option-price">${{ price_per_pack | money_without_currency }}{% if pack_size > 1 %}<span class="dgf-option-ea">/ea</span>{% endif %}</div>
                            {% endif %}
                            {% if selected_product.selected_or_first_available_variant.metafields.custom.lp_red_prc != blank %}
                              <div class="dgf-option-red-price">${{ selected_product.selected_or_first_available_variant.metafields.custom.lp_red_prc }}/ea</div>
                            {% endif %}
                          </div>
                        </div>
                        <div class="dgf-option-bottom">
                          <div class="dgf-option-servings">{{ selected_product.selected_or_first_available_variant.metafields.custom.lp_qty_servings }} servings</div>
                          <div class="dgf-option-per-serving">(<strong>${{ selected_product.selected_or_first_available_variant.metafields.custom.lp_prc_servings }}</strong>/serving)</div>
                          {% if selected_product.selected_or_first_available_variant.metafields.custom.lp_custom_txt != blank %}
                            <div class="dgf-option-custom-text">{{ selected_product.selected_or_first_available_variant.metafields.custom.lp_custom_txt }}</div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                {% endif %}
              </div>

                          {% comment %} Assign display_variant early so button price renders correctly {% endcomment %}
              {% assign display_variant = selected_product.selected_or_first_available_variant %}
              {% assign variant_counter = 0 %}
              {% for variant in selected_product.variants %}
                  {% if variant.available %}
                    {% if variant_counter == 1 %}
                      {% assign display_variant = variant %}
                      {% break %}
                    {% endif %}
                    {% assign variant_counter = variant_counter | plus: 1 %}
                  {% endif %}
              {% endfor %}

            <!-- Add to Cart Button -->
            <div class="dgf-add-to-cart btn btn-bg">
              <a
                class="dgf-cart-button"
                id="add-to-cart-btn">
                ADD TO CART{% if section.settings.show_button_price %} |&nbsp;<span id="button-price">${{ display_variant.price | money_without_currency }}</span>{% endif %}
              </a>
            </div>

            <!-- Button Disclaimer -->
            {% if section.settings.button_disclaimer_text != blank %}
              <div class="dgf-button-disclaimer">
                {{ section.settings.button_disclaimer_text }}
              </div>
            {% endif %}

              <!-- Purchase Type -->
              <div class="dgf-purchase-type">
                <div class="dgf-purchase-option selected">
                  <span class="dgf-purchase-dot"></span>
                  ONE-TIME PURCHASE
                </div>
              </div>

            </div>


            <!-- Pricing Display -->
            <div class="dgf-pricing-display">
              <span
                class="dgf-original-price"
                id="compare-price"
                {% unless display_variant.compare_at_price and display_variant.compare_at_price > display_variant.price %}
                style="display: none;"
                {% endunless %}>
                {% if display_variant.compare_at_price and display_variant.compare_at_price > display_variant.price %}
                  ${{ display_variant.compare_at_price | money_without_currency }}
                {% endif %}
              </span>
              <span class="dgf-sale-price" id="selected-price">${{ display_variant.price | money_without_currency }}</span>
            </div>

                  <!-- Mobile Guarantees - Only visible on mobile, positioned after image-2 -->
                  <div class="dgf-guarantees mobile-guarantees d-flex d-md-none">
                    <div class="dgf-guarantee">
                      <span class="dgf-guarantee-icon">
                        <svg width="25" height="25" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <g clip-path="url(#clip0_1720_12599)">
                            <path d="M10.5003 17.2661C7.43232 17.2661 4.7425 15.1973 3.95929 12.2343C3.90032 12.0119 4.03337 11.7835 4.25562 11.7248C4.47835 11.6661 4.70644 11.799 4.76541 12.0214C5.45212 14.6186 7.81053 16.4322 10.5003 16.4322C13.1063 16.4322 15.4448 14.6893 16.187 12.194C16.2528 11.9731 16.4848 11.8477 16.7056 11.9134C16.9264 11.9791 17.0521 12.2109 16.9863 12.4319C16.5794 13.8001 15.7255 15.0311 14.5816 15.8974C13.3988 16.793 11.9878 17.2661 10.5003 17.2661Z" fill="#06211E"/>
                            <path d="M10.5 21C4.71048 21 0 16.2896 0 10.5C0 4.7104 4.71048 0 10.5 0C16.2895 0 21 4.7104 21 10.5C21 16.2896 16.29 21 10.5 21ZM10.5 0.83391C5.17007 0.83391 0.833898 5.17014 0.833898 10.5C0.833898 15.8299 5.17007 20.1661 10.5 20.1661C15.8299 20.1661 20.1661 15.8299 20.1661 10.5C20.1661 5.17014 15.8299 0.83391 10.5 0.83391Z" fill="#06211E"/>
                            <path d="M7.13788 9.22954C7.66276 9.22954 8.08826 8.79515 8.08826 8.2593C8.08826 7.72345 7.66276 7.28906 7.13788 7.28906C6.613 7.28906 6.1875 7.72345 6.1875 8.2593C6.1875 8.79515 6.613 9.22954 7.13788 9.22954Z" fill="#06211E"/>
                            <path d="M13.8644 9.22954C14.3893 9.22954 14.8148 8.79515 14.8148 8.2593C14.8148 7.72345 14.3893 7.28906 13.8644 7.28906C13.3396 7.28906 12.9141 7.72345 12.9141 8.2593C12.9141 8.79515 13.3396 9.22954 13.8644 9.22954Z" fill="#06211E"/>
                            </g>
                            <defs>
                            <clipPath id="clip0_1720_12599">
                            <rect width="21" height="21" fill="white"/>
                            </clipPath>
                            </defs>
                        </svg>
                      </span>
                      <span class="dgf-guarantee-text">60 Day Money-back<br>guarantee</span>
                    </div>
                    <div class="dgf-guarantee">
                      <span class="dgf-guarantee-icon">
