<section class="section-padding product-quality" id="shopify-section-{{ section.id }}"
  style="background:rgb(var(--color-base-background-2));">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="section-heading">
        <h2 class="section-heading__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div style="display:grid; grid-template-columns:1fr; gap:4rem; align-items:start;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:start;">
        <!-- Always Column -->
        <div>
          <h3 style="font-family:var(--font-heading-family); font-size:1.8rem; font-weight:800; letter-spacing:0.05em; text-transform:uppercase; color:rgb(var(--color-base-accent-1)); margin:0 0 2rem; text-align:center;">
            {{ section.settings.always_heading | default: 'ARE ALWAYS...' }}
          </h3>
          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:1.2rem;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'always_item' -%}
                <li style="display:flex; align-items:center; gap:1.2rem; padding:1.2rem 1.6rem; background:rgb(var(--color-base-background-1)); border-radius:0.8rem;" {{ block.shopify_attributes }}>
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" style="flex-shrink:0; color:rgb(var(--color-base-accent-1));">
                    <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M6 10l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span style="font-size:1.5rem; font-weight:600; color:rgb(var(--color-base-text));">{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <!-- Never Column -->
        <div>
          <h3 style="font-family:var(--font-heading-family); font-size:1.8rem; font-weight:800; letter-spacing:0.05em; text-transform:uppercase; color:rgba(var(--color-base-text),0.6); margin:0 0 2rem; text-align:center;">
            {{ section.settings.never_heading | default: 'NEVER CONTAIN...' }}
          </h3>
          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:1.2rem;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'never_item' -%}
                <li style="display:flex; align-items:center; gap:1.2rem; padding:1.2rem 1.6rem; background:rgb(var(--color-base-background-1)); border-radius:0.8rem;" {{ block.shopify_attributes }}>
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" style="flex-shrink:0; color:#e53e3e;">
                    <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M7 7l6 6M13 7l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <span style="font-size:1.5rem; font-weight:600; color:rgb(var(--color-base-text));">{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      <!-- Certification badges -->
      {%- assign cert_blocks = section.blocks | where: 'type', 'certification' -%}
      {%- if cert_blocks.size > 0 -%}
        <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:3rem; padding-top:2rem; border-top:1px solid rgba(var(--color-base-text),0.1);">
          {%- for block in cert_blocks -%}
            <div style="display:flex; flex-direction:column; align-items:center; gap:0.8rem;" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    width: 72,
                    height: 72,
                    style: 'width:7.2rem;height:7.2rem;object-fit:contain;'
                }}
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span style="font-size:1.1rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:rgba(var(--color-base-text),0.6); text-align:center;">{{ block.settings.label }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product quality",
  "tag": "section",
  "class": "section-product-quality",
  "max_blocks": 20,
  "blocks": [
    {
      "type": "always_item",
      "name": "Always item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Ethically sourced" }
      ]
    },
    {
      "type": "never_item",
      "name": "Never item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Harmful additives" }
      ]
    },
    {
      "type": "certification",
      "name": "Certification badge",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Badge image" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Products"
    },
    {
      "type": "text",
      "id": "always_heading",
      "default": "ARE ALWAYS...",
      "label": "\"Always\" column heading"
    },
    {
      "type": "text",
      "id": "never_heading",
      "default": "NEVER CONTAIN...",
      "label": "\"Never\" column heading"
    }
  ],
  "presets": [
    {
      "name": "Product quality",
      "blocks": [
        { "type": "always_item", "settings": { "text": "Ethically sourced" } },
        { "type": "always_item", "settings": { "text": "Made in the USA" } },
        { "type": "always_item", "settings": { "text": "Third-party lab tested" } },
        { "type": "always_item", "settings": { "text": "USDA Certified Organic" } },
        { "type": "always_item", "settings": { "text": "Non-GMO Verified" } },
        { "type": "always_item", "settings": { "text": "Gluten Free Certified" } },
        { "type": "always_item", "settings": { "text": "Kosher Certified" } },
        { "type": "always_item", "settings": { "text": "Vegan Friendly" } },
        { "type": "never_item", "settings": { "text": "Harmful additives" } },
        { "type": "never_item", "settings": { "text": "Artificial colors" } },
        { "type": "never_item", "settings": { "text": "Artificial flavors" } },
        { "type": "never_item", "settings": { "text": "Synthetic fillers" } },
        { "type": "never_item", "settings": { "text": "Irradiated ingredients" } },
        { "type": "never_item", "settings": { "text": "Preservatives" } }
      ]
    }
  ]
}
{% endschema %}
