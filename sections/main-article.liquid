
<section class="section article-page-wrapper">
    {% comment %}
    <div class="leaf-box left-top">
        <img class="leaf" src="{{ 'leaf-n05.svg' | asset_url }}">
    </div>
    <div class="leaf-box right-top">
        <img class="leaf" src="{{ 'leaf-n02.svg' | asset_url }}">
    </div>
    {% endcomment %}
    <div class="leaf-box custom-article-content-box-right-bot right-bot">
        <img class="leaf custom-article-content-bot" src="{{ 'article-content-leaf.svg' | asset_url }}" alt="leaf bot" width="120" height="120">
    </div>
    <div class="container custom-article-container">  
       {% comment %}<h1 class="text-center text-uppercase">{{ article.title }}</h1>{% endcomment %}
       <div class="row justify-content-center custom-article-row">
          <div class="article__meta">
            <div class="article__meta__sticky">
              <style>
                .article__meta__sticky h2{
                  font-family: HypatiaSansPro;
                  font-weight: 700;
                  font-size: 25px;
                  line-height: 1.4;
                  margin: 0;
                }

                .article__meta-social h3{
                  font-family: HypatiaSansPro;
                  font-weight: 700;
                  font-size: 20px;
                  line-height: 1.4;
                  margin: 0;
                }
              </style>
              {% if article.metafields.custom.mentioned_title != blank %}<h2>{{ article.metafields.custom.mentioned_title }}</h2>{% endif %}
              {% assign sidebar_products = article.metafields.custom.side_bar_products.value %}
              {% for side_bar_products in sidebar_products %}
                <div class="product_related_item">
                  <a href="{{ side_bar_products.url }}" class="product-related-item__image">
                    {% comment %} 
                      TRIBE ORGANICS - Sidebar CLS Fix: 
                      Added explicit width and height (100x100) to reserve layout space.
                      Changed 'master' to '100x100' for better performance.
                    {% endcomment %}
                    <img 
                      src="{{ side_bar_products.featured_image | image_url: width: 100, crop: 'center' }}" 
                      alt="{{ side_bar_products.title | escape }}"
                      width="100"
                      height="100"
                      loading="lazy"
                    >
                  </a>
                  <div class="product-related-item__text">
                    <a href="{{ side_bar_products.url }}" class="product-related-item__title">
                      <span>{{ side_bar_products.title }}</span>
                    </a>
                    <span class="product-related-item__price" data-product-handle="{{ side_bar_products.handle }}">
                      <div class="product-rellate_price">
                        <span class="current-price">{{ side_bar_products.price | money }}</span>
                        <span class="compare-price" style="display:none;"></span>
                      </div>
                    </span>
                  </div>
                  <style>
                    .product-related-item__button .btn{
                      background: #917135;
                    }
                  </style>
                  <div class="product-related-item__button">
                    <form class="product-related-atc-btn" method="post" action="/cart/add">
                        <input type="hidden" name="id" value="{{ side_bar_products.variants.first.id }}" />
                        <input type="submit" value="Add to cart" class="btn" />
                    </form>
                  </div>
                </div>
              {% endfor %}
              {% comment %}
              {% for side_bar_products in sidebar_products %}
                <div class="product_related_item">
                  <a href="{{ side_bar_products.url }}" class="product-related-item__image">
                    <img src="{{ side_bar_products | image_url: width: 2000  }}" alt="{{  product.title }}">
                  </a>
                  <div class="product-related-item__text">
                    <a href="{{ side_bar_products.url }}" class="product-related-item__title">
                      <span>{{  side_bar_products.title }}</span>
                    </a>
                    <span class="product-related-item__price" data-product-handle="{{ side_bar_products.handle }}">
                      <div class="product-rellate_price">
                        <span class="current-price">{{ side_bar_products.price | money }}</span>
                        <span class="compare-price" style="display:none;"></span>
                      </div>
                    </span>
                  </div>
                  <div class="product-related-item__button">
                    <form class="product-related-atc-btn" method="post" action="/cart/add">
                         <input type="hidden" name="id" value="{{ side_bar_products.variants.first.id }}" />
                         <input type="submit" value="Add to cart" class="btn" />
                     </form>
                  </div>
                </div>
              {% endfor %}
