          <style>
            .article__content.rte img {
              min-height: 200px;
            }
            .article__content.rte > div:first-child {
              min-height: 226px;
            }
          </style>
          <div class="col-md-8 article__content rte">
            {{ article.content }}
          </div>
       </div>
       {% if article.metafields.custom.related_product != blank %}
        <div class="row justify-content-center mt-4 bottom-article">
            <div class="col-md-8">
                <h3 class="text-uppercase">{{ section.settings.title }}</h3>
                <div class="row">
                  {% assign products = article.metafields.custom.related_product.value %}
                  {% for product in products %}
                    <div class="col-md-4">
                        <a href="{{  product.url }}" class="product-item">
                            <div class="img-wrapper">
                                {% comment %} 
                                  TRIBE ORGANICS - Related Products CLS Fix: 
                                  Calculated dynamic height based on aspect ratio to reserve layout space.
                                {% endcomment %}
                                {%- assign image_height = 500 | divided_by: product.featured_image.aspect_ratio | ceil -%}
                                <img 
                                  src="{{ product | image_url: width: 500 }}" 
                                  alt="{{  product.title | escape }}"
                                  width="500"
                                  height="{{ image_height }}"
                                  loading="lazy"
                                >
                                <form class="article-related-atc-btn" method="post" action="/cart/add">
                                  <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                                  <input type="submit" value="Add to cart" class="btn" />
                                </form>
                            </div>
                            {% comment %}<div class="category">{{ product.collections[0].title }}</div>{% endcomment %}
                            <h5>{{  product.title }}</h5>
                            {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: false, product: product %}
                            {% if product.title == 'Ashwagandha KSM-66' %}
                            {% assign second_variant = product.variants[0] %}
                            <div class="price">
                                {{ second_variant.price | money }}
                            </div>
                            {% else %}
                            <div class="price">{{  product.price | money }}</div>
                            {% endif %}
                        </a>
                    </div>
                  {% endfor %}
                </div>
            </div>
        </div>
      {% endif %}
    </div>
