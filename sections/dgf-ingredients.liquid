<style>
  #id-{{ section.id }} {
    background-color: {{ section.settings.section_bg_color }};
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
  }

  #id-{{ section.id }} .dgf-ingredients-heading {
    font-family: {{ section.settings.heading_font }};
    font-size: {{ section.settings.heading_font_size }}px;
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
    line-height: 1.2;
  }

  #id-{{ section.id }} .dgf-ingredients-subheading {
    font-family: {{ section.settings.subheading_font }};
    font-size: {{ section.settings.subheading_font_size }}px;
    color: {{ section.settings.subheading_color }};
    text-align: {{ section.settings.subheading_alignment }};
    margin-bottom: {{ section.settings.subheading_margin_bottom }}px;
    font-style: italic;
    font-weight: 600;
    line-height: 1.5;
  }

  #id-{{ section.id }} .dgf-ingredient-card {
    background-color: transparent;
    border-radius: 0;
    overflow: visible;
    height: 100%;
    padding: 0 4rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
  }

  #id-{{ section.id }} .dgf-ingredient-card:hover {
    transform: {{ section.settings.card_hover_transform }};
  }

  #id-{{ section.id }} .dgf-ingredient-image-container {
    width: 100%;
    height: 208px;
    margin: 0 auto {{ section.settings.image_margin_bottom }}px;
    position: relative;
    overflow: visible;
    background-color: {{ section.settings.image_bg_color }};
    border-radius: {{ section.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #id-{{ section.id }} .dgf-ingredient-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  #id-{{ section.id }} .dgf-ingredient-content {
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  #id-{{ section.id }} .dgf-ingredient-title {
    font-family: {{ section.settings.card_title_font }};
    font-size: {{ section.settings.card_title_font_size }}px;
    color: {{ section.settings.card_title_color }};
    text-align: left;
    margin-bottom: {{ section.settings.card_title_margin_bottom }}px;
    font-weight: {{ section.settings.card_title_font_weight }};
    line-height: 1.3;
    text-transform: {{ section.settings.card_title_transform }};
  }

  #id-{{ section.id }} .dgf-ingredient-description {
    font-family: {{ section.settings.card_description_font }};
    font-size: {{ section.settings.card_description_font_size }}px;
    color: {{ section.settings.card_description_color }};
    text-align: {{ section.settings.card_description_alignment }};
    line-height: {{ section.settings.card_description_line_height }};
    flex: 1;
  }

  #id-{{ section.id }} .dgf-ingredient-description p {
    margin: 0;
  }

  #id-{{ section.id }} .swiper-button-next,
  #id-{{ section.id }} .swiper-button-prev {
    background: {{ section.settings.arrow_bg_color }} !important;
    transition: 0.3s ease;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    border-radius: {{ section.settings.arrow_border_radius }}px;
  }

  #id-{{ section.id }} .swiper-button-next::after,
  #id-{{ section.id }} .swiper-button-prev::after {
    font-size: {{ section.settings.arrow_icon_size }}px;
    color: {{ section.settings.arrow_color }};
  }

  #id-{{ section.id }} .swiper-button-next:hover,
  #id-{{ section.id }} .swiper-button-prev:hover {
    background: {{ section.settings.arrow_hover_bg_color }} !important;
  }

  #id-{{ section.id }} .home-ingredients-slider .swiper-wrapper {
    align-items: stretch;
  }

  #id-{{ section.id }} .home-ingredients-slider .swiper-slide {
    height: auto;
  }

  @media (min-width: 1024px) {
    #id-{{ section.id }} .homepage-custom-ingredients-button-prev {
      left: {{ section.settings.arrow_position_desktop }}px !important;
    }
    #id-{{ section.id }} .homepage-custom-ingredients-button-next {
      right: {{ section.settings.arrow_position_desktop }}px !important;
    }
  }

  @media (max-width: 767px) {
    #id-{{ section.id }} .homepage-custom-ingredients-button-prev {
      left: {{ section.settings.arrow_position_mobile }}px !important;
    }
    #id-{{ section.id }} .homepage-custom-ingredients-button-next {
      right: {{ section.settings.arrow_position_mobile }}px !important;
    }

    #id-{{ section.id }} .dgf-ingredients-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    #id-{{ section.id }} .dgf-ingredients-subheading {
      font-size: {{ section.settings.subheading_font_size_mobile }}px;
    }

    #id-{{ section.id }} .dgf-ingredient-title {
      font-size: {{ section.settings.card_title_font_size_mobile }}px;
    }

    #id-{{ section.id }} .dgf-ingredient-description {
      font-size: {{ section.settings.card_description_font_size_mobile }}px;
    }
  }
</style>



<section id="id-{{section.id}}" class="section section-ingredients dgf-ingredients {{ section.settings.custom_class }}">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2
        class="dgf-ingredients-heading"
        data-aos="fade-up"
        data-aos-delay="000">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div
        class="dgf-ingredients-subheading"
        data-aos="fade-up"
        data-aos-delay="100">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    <div class="row justify-content-center">
      <div class="col-lg-12">
        <div
          class="ingredients-box mt-3"
          data-aos="fade-in"
          data-aos-delay="400"
          data-aos-duration="800">
          <div class="swiper home-ingredients-slider">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  <div class="dgf-ingredient-card">
                    {% if block.settings.image != blank %}
                      <div class="dgf-ingredient-image-container">
                        <img
                          class="dgf-ingredient-image"
                          src="{{ block.settings.image | image_url: width: 800 }}"
                          alt="{{ block.settings.image_alt | default: block.settings.title }}"
                          loading="lazy" width="262" height="173">
                      </div>
                    {% endif %}
                    <div class="dgf-ingredient-content">
                      {% if block.settings.title != blank %}
                        <h3 class="dgf-ingredient-title">
                          {{ block.settings.title }}
                        </h3>
                      {% endif %}
                      {% if block.settings.description != blank %}
                        <div class="dgf-ingredient-description">
                          {{ block.settings.description }}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
          <div class="swiper-button-prev homepage-custom-ingredients-button-prev"></div>
          <div class="swiper-button-next homepage-custom-ingredients-button-next"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  new Swiper('#id-{{section.id}} .home-ingredients-slider', {
    loop: {{ section.settings.enable_loop }},
    slidesPerView: {{ section.settings.slides_mobile }},
    navigation: {
      nextEl: '#id-{{section.id}} .homepage-custom-ingredients-button-next',
      prevEl: '#id-{{section.id}} .homepage-custom-ingredients-button-prev',
    },
    spaceBetween: {{ section.settings.space_between_mobile }},
    breakpoints: {
      1920: {
        slidesPerView: {{ section.settings.slides_desktop }},
        spaceBetween: {{ section.settings.space_between_desktop }}
      },
      1028: {
        slidesPerView: {{ section.settings.slides_tablet }},
        spaceBetween: {{ section.settings.space_between_tablet }}
      },
      576: {
        slidesPerView: {{ section.settings.slides_mobile }},
        spaceBetween: {{ section.settings.space_between_mobile }}
      }
    }
  });
</script>

