{% comment %}{% endcomment %}
{% for block in section.blocks %}
  {% if forloop.first %}
    
    {% comment %} Background images (LCP - highest priority) {% endcomment %}
    {% comment %} Mobile {% endcomment %}
    {% if block.settings.bg_mob_image != blank %}
      {% capture mobile_bg %}{{ block.settings.bg_mob_image | image_url: width : 767 }}{% endcapture %}
      <link rel="preload" as="image" href="{{ mobile_bg }}" media="(max-width: 767px)" fetchpriority="high">
    {% endif %}

    {% comment %} Desktop {% endcomment %}
    {% if block.settings.background_the_image != blank %}
      {% capture desktop_bg %}{{ block.settings.background_the_image | image_url: width : block.settings.background_the_image.width }}{% endcapture %}
      <link rel="preload" as="image" href="{{ desktop_bg }}" media="(min-width: 768px)" fetchpriority="high">
    {% endif %}

  {% endif %}
{% endfor %}

<style>
  {%- for block in section.blocks -%}
    {%- assign d = block.settings.background_the_image -%}
    {%- assign m = block.settings.bg_mob_image -%}
    {%- if d != blank -%}
      @media (min-width: 768px){
        #cst-{{ block.id }}{
          background-image: url("{{ d | image_url: width: d.width }}");
        }
      }
    {%- endif -%}

    {%- if m != blank -%}
      @media (max-width: 767px){
        #cst-{{ block.id }}{
          background-image: url("{{ m | image_url: width: 767 }}") !important;
        }
      }
    {%- endif -%}
  {%- endfor -%}
</style>

<section id="id-{{section.id}}" class="cstm-site-slider-banner-section">
  <div class="swiper custom-slider-banner-wrap">
    <div class="swiper-wrapper">
    {% for block in section.blocks %}
        <div class="swiper-slide cstm-site-banner-section single-banner-wrap-mn single-banner-section-{{ block.id }} {% if block.settings.class_text %}{{ block.settings.class_text }}{% endif %}" id="cst-{{block.id}}">
          <div class="container">
            <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">
              <div class="main-site-head-wrap">
                  <div class="cstm-site-head-title">
                    {% if block.settings.the_text %}<p class="web-banner-sub-title" data-aos="fade-up">{{ block.settings.the_text }}</p>{% endif %}
                    <h2 class="web-banner-title" data-aos="fade-up">{{ block.settings.title }}</h2>
                    {% if block.settings.mob_image != blank %}
                      <div class="banner-percentage-offer mob-banner-percentage-offer" data-aos="fade-up">
                        {%- assign img = block.settings.mob_image -%}
                        <img
                          loading="lazy"
                          src="{{ img | image_url: width : 767 }}" 
                          alt="{{ block.settings.title | default: 'Special offer banner' }}"
                          width="{{ img.width }}"
                          height="{{ img.height }}"
                          style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                        >
                        {% comment %} <img loading="lazy"  src="{{ block.settings.mob_image | img_url: '767x' }}" alt="{{ block.settings.title | default: 'Special offer banner' }}"> {% endcomment %}
                      </div>
                    {%- endif -%}
                    {% if block.settings.custom_title != blank %}<h3 class="custom-title" data-aos="fade-up">{{ block.settings.custom_title }}</h3>{% endif %}
                  </div>
                  {% if block.settings.enable_gift_content == true %}
                    <div class="gift-banner-content-wrapper" data-aos="fade-up">
                      <div class="gift-percentage-offer-content-columns">
                        {% if block.settings.the_icon_1 != blank %}
                          {%- assign img = block.settings.the_icon_1 -%}
                          <img
                            loading="lazy"
                            src="{{ img | image_url: width : img.width }}" 
                            alt="{{ block.settings.sub_title_1 | default: 'Offer icon' }}"
                            width="{{ img.width }}"
                            height="{{ img.height }}"
                            style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                          >
                          {% comment %} <img loading="lazy"  src="{{ block.settings.the_icon_1 | img_url: 'master' }}" alt="{{ block.settings.sub_title_1 | default: 'Offer icon' }}"> {% endcomment %}
                        {%- endif -%}
                        <h3>{{ block.settings.sub_title_1 }}</h3>
                        {{ block.settings.text_1 }}
                        {% if block.settings.button_1 != blank %}
                        <div class="gift-banner-btns">
                          <div class="btn-group">
                            {% if block.settings.button_1 != blank %}
                              <div data-aos="fade-up" data-aos-delay="400">
                                  <a class="btn btn-bg" href="{{ block.settings.url_1 }}" target="_self">
                                      {{ block.settings.button_1 }}
                                  </a>
                              </div>
                           {% endif %}
                          </div>
                        </div>
                        {% endif %}
                      </div>
                      {% if block.settings.and_text != blank %}
                      <div class="gift-banner-and-text">
                        <p>{{ block.settings.and_text }}</p>
                      </div>
                      {% endif %}
                      <div class="gift-percentage-offer-content-columns">
                        {% if block.settings.the_icon_2 != blank %}
                          {%- assign img = block.settings.the_icon_2 -%}
                          <img
                            loading="lazy"
                            src="{{ img | image_url: width : img.width }}" 
                            alt="{{ block.settings.sub_title_2 | default: 'Offer icon' }}"
                            width="{{ img.width }}"
                            height="{{ img.height }}"
                            style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                          >
                          {% comment %} <img loading="lazy"  src="{{ block.settings.the_icon_2 | img_url: 'master' }}" alt="{{ block.settings.sub_title_2 | default: 'Offer icon' }}"> {% endcomment %}
                        {%- endif -%}
                        <h3>{{ block.settings.sub_title_2 }}</h3>
                        {{ block.settings.text_2 }}
                        {% if block.settings.button_2 != blank %}
                        <div class="gift-banner-btns">
                          <div class="btn-group">
                            {% if block.settings.button_2 != blank %}
                              <div data-aos="fade-up" data-aos-delay="500">
                                  <a class="btn btn-trans" href="{{ block.settings.url_2 }}" target="_self">
                                      {{ block.settings.button_2 }}
                                  </a>
                              </div>
                            {% endif %}
                          </div>
                        </div>
                        {% endif %}
                      </div>
                    </div>
                    {% if block.settings.button_3 != blank %}
                        <div class="gift-banner-btns full-gift-btn">
                            <div class="btn-group">
                              {% if block.settings.button_3 != blank %}
                                <div data-aos="fade-up" data-aos-delay="400">
                                    <a class="btn btn-bg" href="{{ block.settings.url_3 }}" target="_self">
                                        {{ block.settings.button_3 }}
                                    </a>
                                </div>
                             {% endif %}
                            </div>
                        </div>
                      {% endif %}
                  {% endif %}
                  <div class="site-sub-title-btn">
                  {% if block.settings.the_image != blank %}
                    <div class="banner-percentage-offer web-banner-percentage-offer">
                        {%- assign img = block.settings.the_image -%}
                        <img
                          loading="lazy"
                          src="{{ img | image_url: width : img.width }}" 
                          alt="{{ block.settings.title | default: 'Special offer banner' }}"
                          width="{{ img.width }}"
                          height="{{ img.height }}"
                          style="aspect-ratio: {{ img.width }} / {{ img.height }};"
                        >
                        {% comment %} <img loading="lazy"  src="{{ block.settings.the_image | img_url: 'master' }}" alt="{{ block.settings.title | default: 'Special offer banner' }}"> {% endcomment %}                      
                    </div>
                  {%- endif -%}
                    {% if block.settings.fade_text_1 != blank or block.settings.fade_text_2 != blank or block.settings.fade_text_3 != blank or block.settings.fade_text_4 != blank or block.settings.fade_text_5 != blank %}
                    <div class="custom-fade-in-out-text">
                      <p class="custom-quotes">{{ block.settings.fade_text_1 }}</p>
                      <p class="custom-quotes">{{ block.settings.fade_text_2 }}</p>
                      <p class="custom-quotes">{{ block.settings.fade_text_3 }}</p>
                      <p class="custom-quotes">{{ block.settings.fade_text_4 }}</p>
                      <p class="custom-quotes">{{ block.settings.fade_text_5 }}</p>
                    </div>
                    {% endif %}
                    {% if block.settings.mob_the_text %}<p class="mob-banner-text" data-aos="fade-up">{{ block.settings.mob_the_text }}</p>{% endif %}
                    {% if block.settings.mob_title != blank %}<h2 class="mob-banner-title" data-aos="fade-up">{{ block.settings.mob_title }}</h2>{% endif %}
                    {% if block.settings.sub_title != blank %}<h1 data-aos="fade-up" data-aos-delay="200">{{ block.settings.sub_title }}</h1>{% endif %}
                    <div class="site-banner-btns">
                       <div class="btn-group">
                         {% if block.settings.button_1 != blank %}
                            <div data-aos="fade-up" data-aos-delay="400">
                                <a class="btn btn-bg" href="{{ block.settings.url_1 }}" target="_self">
                                    {{ block.settings.button_1 }}
                                </a>
                            </div>
                         {% endif %}
                         {% if block.settings.button_2 != blank %}
                          <div data-aos="fade-up" data-aos-delay="500">
                              <a class="btn btn-trans" href="{{ block.settings.url_2 }}" target="_self">
                                  {{ block.settings.button_2 }}
                              </a>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                    {% if block.settings.text_under_button != blank %}
                      <div class="text-under-button">
                        {{ block.settings.text_under_button }}
                      </div>  
                    {% endif %}
                  </div>
                </div>
            </div>
          </div>
        </div>
        {% if block.settings.lion_img != blank %}
          <div class="slider-lion-image-graphics">
            {%- assign img = block.settings.lion_img -%}
            <img
              loading="lazy"
              src="{{ img | image_url: width : img.width }}" 
              alt="Lion graphic decoration"
              width="{{ img.width }}"
              height="{{ img.height }}"
              style="aspect-ratio: {{ img.width }} / {{ img.height }};"
            >
            {% comment %} <img loading="lazy" src="{{ block.settings.lion_img | img_url : "master" }}" alt="Lion graphic decoration"> {% endcomment %}                      
          </div>
        {% endif %}
        {% if block.settings.elephant_img != blank %}
          <div class="slider-elephant-image-graphics">
            {%- assign img = block.settings.elephant_img -%}
            <img
              loading="lazy"
              src="{{ img | image_url: width : img.width }}" 
              alt="Elephant graphic decoration"
              width="{{ img.width }}"
              height="{{ img.height }}"
              style="aspect-ratio: {{ img.width }} / {{ img.height }};"
            >
            {% comment %} <img loading="lazy" src="{{ block.settings.elephant_img | img_url : "master" }}" alt="Elephant graphic decoration"> {% endcomment %}     
          </div>
        {% endif %}
      </div>
    {% endfor %}
    </div>
    <div class="banner-swiper-pagination"></div>
  </div>
  {%- if section.settings.show_social -%}
    <div class="social-banner">
        <span>{{ section.settings.text }}</span>
        {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" aria-label="Follow us on Instagram" target="_blank" rel="noopener">{%- render 'icon-instagram' -%}</a>
        {%- endif -%}
         {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" aria-label="Follow us on Facebook" target="_blank" rel="noopener">{%- render 'icon-facebook' -%}</a>
        {%- endif -%}
        <a href="{{ section.settings.social_spotify_link }}" target="_blank" rel="noopener" aria-label="Listen on Spotify"><i class="fab fa-spotify"></i> </a>
        {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" aria-label="Subscribe on YouTube" target="_blank" rel="noopener">{%- render 'icon-youtube' -%}</a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}" aria-label="Follow us on Twitter" target="_blank" rel="noopener">{%- render 'icon-twitter' -%}</a>
        {%- endif -%}

        {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" aria-label="Follow us on Pinterest" target="_blank" rel="noopener">{%- render 'icon-pinterest' -%}</a>
        {%- endif -%}


        {%- if settings.social_tumblr_link != blank -%}
            <a href="{{ settings.social_tumblr_link }}" aria-label="Follow us on Tumblr" target="_blank" rel="noopener">{%- render 'icon-tumblr' -%}</a>
        {%- endif -%}
        {%- if settings.social_snapchat_link != blank -%}
            <a href="{{ settings.social_snapchat_link }}" aria-label="Follow us on Snapchat" target="_blank" rel="noopener">{%- render 'icon-snapchat' -%}</a>
        {%- endif -%}

        {%- if settings.social_vimeo_link != blank -%}
            <a href="{{ settings.social_vimeo_link }}" aria-label="Watch us on Vimeo" target="_blank" rel="noopener">{%- render 'icon-vimeo' -%} </a>
        {%- endif -%}
    </div>
  {% endif %}
</section>
