<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="reason-rich-text-section {{ section.settings.add_class }}">
  <div class="reason-rich-text-wrapper">
     <div class="container">
       <div class="row">
         <div class="col-lg-12 col-md-12 col-sm-12">
           <div class="reason-rich-text-main">
             {% if section.settings.the_title != blank %}<h1>{{ section.settings.the_title }}</h1>{% endif %}
           </div>
         </div>
         <div class="col-lg-12 col-md-12 col-sm-12">
           <div class="reason-rich-text-content">
             {{ section.settings.the_text }}
           </div>
         </div>
       </div>
     </div>
  </div>
</section>
{% schema %}
  {
    "name": "Reason Rich Text",
    "settings": [
       {
            "type": "header",
            "content": "Content Style"
        },
	    {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
        },
        {
          "type": "text",
          "id": "add_class",
          "label": "Add Class"
      	},
       {
          "type": "text",
          "id": "the_title",
          "label": "Title"
      	},
       {
          "type": "richtext",
          "id": "the_text",
          "label": "Text"
      	}
    ],
	"presets": [{
      "name": "Reason Rich Text"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}