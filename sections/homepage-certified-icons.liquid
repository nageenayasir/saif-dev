<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{ section.id }}" class="homepage-certified-icons">
  <div class="container">
    <div class="row">
      <div class="homepage-certified-icon-lists">
        {% for block in section.blocks %}
          <div class="homepage-certificed-icon-lists-wrapper">
            {% if block.settings.icon != blank %}<img loading="lazy"  src="{{ block.settings.icon | img_url: 'master' }}" alt="Certification badge" width="70" height="50">{% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Homepage Certified Icons",
    "settings": [
      {
            "type": "header",
            "content": "Content Style"
      },
  	  {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
      }
    ],
    "blocks": [
     {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        }
      ]
     }
	],
	"presets": [{
      "name": "Homepage Certified Icons"
    }]
  }
{% endschema %}