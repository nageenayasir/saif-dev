<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="kids-teenager-main-product common-kids-teenager-section">
  <div class="kids-teenager-main-product-wrapper">
    <div class="container">
      <div class="teenager-main-product-row">
        <div class="kids-teenage-main-product-head" data-aos="fade-up">
          <h2>{{ section.settings.the_title }}</h2>
          <div class="kids-teenage-main-product-logo">
            {% if section.settings.logo_image != blank %}<img loading="lazy"  src="{{ section.settings.logo_image | img_url: 'master' }}">{% endif %}
          </div>
        </div>
        <div class="kids-teenage-main-product-img-text">
          <div class="kids-teenager-product-img" data-aos="fade-up">
              <a href="{{ section.settings.button_url }}">
                <div class="kids-teen-image-wrapper">
                  {% if section.settings.the_image != blank %}<img loading="lazy"  src="{{ section.settings.the_image | img_url: 'master' }}">{% endif %}
                </div>
              </a>
            </div>
            <div class="kids-teenager-main-product-btn-wrap" data-aos="fade-up">
              <a href="{{ section.settings.button_url }}">{{ section.settings.button_text }}</a>
            </div>
        </div>
      </div>
    </div>
    <div class="kids-teenager-main-product-box-left-bot">
        <img loading="lazy"  class=" kids-teenager-main-product-left-bot" src="{{ 'kids-teen-prod-character.svg' | asset_url }}">
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Kids-Teenager Ashwagandha",
    "settings": [
          {
              "type": "header",
              "content": "Content Style"
          },
          {
              "type": "color",
              "id": "section_bg_color",
              "label": "Section background color"
           },
           {
              "type": "text",
              "id": "the_title",
              "label": "Title"
            },
            {
                  "type": "image_picker",
                  "id": "logo_image",
                  "label": "Logo Image"
            },
            {
                  "type": "image_picker",
                  "id": "the_image",
                  "label": "Image"
            },
            {
                "type": "text",
                "id": "button_text",
                "label": "Text"
            },
            {
                "type": "url",
                "id": "button_url",
                "label": "Url"
            }
    ],
	"presets": [{
      "name": "Kids-Teenager Ashwagandha"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}