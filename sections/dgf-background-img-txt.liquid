<style>
  .dgf-bg-img-txt {
    width: 100%;
  }

  .dgf-bg-img-txt .dgf-content-column {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 3rem;
    min-height: 100vh;
  }

  .dgf-bg-img-txt .dgf-content-wrapper {
    width: 100%;
    max-width: 600px;
    text-align: center;
  }

  .dgf-bg-img-txt .dgf-heading {
    font-size: 38px;
    font-family: HypatiaSansPro;
    font-weight: 700;
    margin-bottom: 1rem;
    margin-top: 0;
    color: #111111;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .dgf-bg-img-txt .dgf-rich-text {
    font-size: 20px;
    line-height: 1.6;
    font-weight: 500;
    margin-bottom: 4rem;
    margin-top: 0;
    color: #111111;
    text-align: center;
  }

  .dgf-bg-img-txt .dgf-product-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .dgf-bg-img-txt .dgf-stars {
    display: flex;
    gap: 2px;
  }

  .dgf-bg-img-txt .dgf-star {
    color: #AC853B;
    font-size: 25px;
  }

  .dgf-bg-img-txt .dgf-rating-text {
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #333;
  }

  .dgf-bg-img-txt .dgf-bg-guarantees {
    margin-bottom: 1rem;
    margin-top: 0;
    display: flex;
    flex-direction: row;
