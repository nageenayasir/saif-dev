{% comment %}
  [DGF] Background Image Text
  Author: Rodrigo Gesser
  Date: 2025-09-18
{% endcomment %}

{% liquid
  assign left_bg_color = section.settings.left_bg_color | default: '#ffffff'
  assign right_bg_color = section.settings.right_bg_color | default: '#f5f5f5'
%}

<section class="dgf-background-img-txt-section dgf-bg-img-txt" id="dgf-bg-img-txt-{{ section.id }}">
  <div class="container-fluid p-0">
    <div class="row g-0">

      <!-- Desktop Layout -->
      <div class="d-none d-md-flex col-md-6 dgf-content-column" style="background-color: {{ left_bg_color }};">
        <div class="dgf-content-wrapper">

          <!-- Heading -->
          {% if section.settings.heading != blank %}
            <h2 class="dgf-heading">{{ section.settings.heading }}</h2>
          {% endif %}

          <!-- Rich Text -->
          {% if section.settings.rich_text != blank %}
            <div class="dgf-rich-text">
              {{ section.settings.rich_text }}
            </div>
