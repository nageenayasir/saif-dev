            </div>
          </div>

          <!-- Button -->
          {% if section.settings.button_text != blank %}
            <div class="dgf-button-wrapper">
              <a class="btn btn-bg" href="{{ section.settings.button_url }}" target="_self" style="color: {{ section.settings.button_text_color | default: '#fff' }};">
                {{ section.settings.button_text }}
              </a>
            </div>
          {% endif %}

          <!-- Star Rating -->
          {% if section.settings.show_rating %}
            <div class="dgf-product-rating">
              <div class="dgf-stars">
                {% for i in (1..5) %}
                  <span class="dgf-star">★</span>
                {% endfor %}
              </div>
              {% if section.settings.rating_text %}
                <span class="dgf-rating-text">{{ section.settings.rating_text }}</span>
              {% endif %}
            </div>
          {% endif %}

        </div>
      </div>

      <!-- Desktop Image Column -->
      <div class="d-none d-md-block col-md-6 dgf-image-column" style="background-color: {{ right_bg_color }};">
        <div class="dgf-image-wrapper">
          {% if section.settings.main_image != blank %}
            <img src="{{ section.settings.main_image | image_url: width: 800 }}" alt="{{ section.settings.main_image_alt | default: 'Main Image' }}" class="dgf-main-image">
          {% else %}
            <div class="dgf-image-placeholder">
              <p>Upload an image</p>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Mobile Layout -->
      <div class="d-block d-md-none col-12">
        <!-- Mobile Title -->
        {% if section.settings.heading != blank %}
          <div class="dgf-mobile-title-section" style="background-color: {{ left_bg_color }};">
            <h2 class="dgf-heading">{{ section.settings.heading }}</h2>
          </div>
        {% endif %}

        <!-- Mobile Image -->
        <div class="dgf-mobile-image-section" style="background-color: {{ right_bg_color }};">
          <div class="dgf-image-wrapper">
            {% if section.settings.main_image != blank %}
              <img src="{{ section.settings.main_image | image_url: width: 800 }}" alt="{{ section.settings.main_image_alt | default: 'Main Image' }}" class="dgf-main-image">
            {% else %}
              <div class="dgf-image-placeholder">
                <p>Upload an image</p>
              </div>
            {% endif %}
          </div>
        </div>

