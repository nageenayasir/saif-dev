<section class="section-padding rewards-program" id="shopify-section-{{ section.id }}"
  style="background:rgb(var(--color-base-text)); color:rgb(var(--color-base-solid-button-labels));">
  <div class="page-width">
    <div style="display:grid; grid-template-columns:1fr; gap:4rem; align-items:center;">
      <div style="text-align:center;">
        {%- if section.settings.eyebrow != blank -%}
          <span style="display:block; font-size:1.2rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:rgb(var(--color-base-accent-1)); margin-bottom:1.2rem;">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 style="font-family:var(--font-heading-family); font-size:clamp(2.8rem, 4vw, 4.8rem); font-weight:800; line-height:1.1; color:rgb(var(--color-base-solid-button-labels)); margin:0 0 1.6rem; text-transform:uppercase; letter-spacing:-0.02em;">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p style="font-size:1.7rem; line-height:1.6; color:rgba(255,255,255,0.75); max-width:55rem; margin:0 auto 4rem;">
            {{ section.settings.description }}
          </p>
        {%- endif -%}

        <!-- Tier list -->
        <div style="display:flex; flex-direction:column; gap:1rem; max-width:60rem; margin:0 auto 4rem; text-align:left;">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tier' -%}
              <div style="display:flex; align-items:center; gap:1.6rem; padding:1.8rem 2rem; background:rgba(255,255,255,0.08); border-radius:0.8rem; border:1px solid rgba(255,255,255,0.12);" {{ block.shopify_attributes }}>
                <div style="width:4.8rem; height:4.8rem; border-radius:50%; background:rgb(var(--color-base-accent-1)); display:flex; align-items:center; justify-content:center; flex-shrink:0; font-family:var(--font-heading-family); font-size:1.6rem; font-weight:800; color:#fff;">
                  {{ forloop.index }}
                </div>
                <div style="flex:1;">
                  <p style="font-size:1.5rem; font-weight:700; color:#fff; margin:0 0 0.3rem;">{{ block.settings.title }}</p>
                  {%- if block.settings.description != blank -%}
                    <p style="font-size:1.3rem; color:rgba(255,255,255,0.6); margin:0;">{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
                {%- if block.settings.discount != blank -%}
                  <span style="font-family:var(--font-heading-family); font-size:2rem; font-weight:800; color:rgb(var(--color-base-accent-1)); flex-shrink:0;">{{ block.settings.discount }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url | default: '#' }}" class="button button--accent button--large button--pill">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rewards program",
  "tag": "section",
  "class": "section-rewards",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "tier",
      "name": "Reward tier",
      "settings": [
        { "type": "text", "id": "title", "label": "Tier title", "default": "First Order" },
        { "type": "text", "id": "description", "label": "Description", "default": "Start your wellness journey" },
        { "type": "text", "id": "discount", "label": "Discount amount", "default": "10% OFF" }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Subscribe & Save"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "It's Like A Reward That Keeps Getting Better"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Subscribe to any product and save more with each order. Plus enjoy lifetime free shipping."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe & Save"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Rewards program",
      "blocks": [
        { "type": "tier", "settings": { "title": "First order", "description": "+ extra 5% for starting your journey", "discount": "10% OFF" } },
        { "type": "tier", "settings": { "title": "2nd order", "description": "Keep the momentum going", "discount": "15% OFF" } },
        { "type": "tier", "settings": { "title": "3rd order", "description": "Building healthy habits", "discount": "20% OFF" } },
        { "type": "tier", "settings": { "title": "4th order", "description": "Loyalty rewards kick in", "discount": "25% OFF" } },
        { "type": "tier", "settings": { "title": "5th order +", "description": "Lifetime free shipping on all orders", "discount": "25% + Free Ship" } }
      ]
    }
  ]
}
{% endschema %}
