<style>
  #shopify-section-{{ section.id }} .hero {
    min-height: {{ section.settings.height_mobile }}px;
    background-color: {{ section.settings.overlay_color }};
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .hero {
      min-height: {{ section.settings.height_desktop }}px;
    }
  }
</style>

<div class="hero" style="position:relative; overflow:hidden; display:flex; align-items:center;">
  {%- if section.settings.image != blank -%}
    <div style="position:absolute; inset:0; z-index:0;">
      {{
        section.settings.image
        | image_url: width: 1920
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1920',
          sizes: '100vw',
          style: 'width:100%;height:100%;object-fit:cover;object-position:center;'
      }}
      {%- if section.settings.overlay_opacity > 0 -%}
        <div style="position:absolute; inset:0; background:{{ section.settings.overlay_color }}; opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="page-width" style="position:relative; z-index:1; padding-top:6rem; padding-bottom:6rem; width:100%;">
    <div class="hero__content" style="max-width:{{ section.settings.content_max_width }}px; {% if section.settings.content_position == 'center' %}margin:0 auto; text-align:center;{% elsif section.settings.content_position == 'right' %}margin-left:auto;{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span style="display:block; font-size:1.2rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:{{ section.settings.text_color }}; margin-bottom:1.2rem; opacity:0.8;">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 style="font-family:var(--font-heading-family); font-weight:var(--font-heading-weight); font-size:clamp(3.2rem, 6vw, 7rem); line-height:1; letter-spacing:-0.02em; text-transform:uppercase; color:{{ section.settings.text_color }}; margin:0 0 1.6rem;">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p style="font-size:clamp(1.5rem, 2vw, 1.8rem); line-height:1.6; color:{{ section.settings.text_color }}; opacity:0.85; margin:0 0 3rem; max-width:50rem; {% if section.settings.content_position == 'center' %}margin-left:auto; margin-right:auto;{% endif %}">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url }}"
          class="button {% if section.settings.button_style == 'primary' %}button--primary{% else %}button--secondary{% endif %}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 400,
      "max": 900,
      "step": 20,
      "default": 700,
      "unit": "px",
      "label": "Desktop height"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 300,
      "max": 700,
      "step": 20,
      "default": 500,
      "unit": "px",
      "label": "Mobile height"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "default": "#000000",
      "label": "Overlay color"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%",
      "label": "Overlay opacity"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Content alignment"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 300,
      "max": 900,
      "step": 50,
      "default": 600,
      "unit": "px",
      "label": "Content max width"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "World's Best Ashwagandha"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Made with patented and clinically proven KSM-66 Ashwagandha root extract"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#FFFFFF",
      "label": "Text color"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Ashwagandha"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        { "value": "primary", "label": "Primary (solid)" },
        { "value": "secondary", "label": "Secondary (outlined)" }
      ],
      "default": "primary",
      "label": "Button style"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
