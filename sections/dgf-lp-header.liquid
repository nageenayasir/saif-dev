{% comment %}
  [DGF] LP Header
  Author: Rodrigo Gesser
  Date: 2025-09-18
  Landing Page Header with logo, nav items, button and icons
{% endcomment %}

{% liquid
  assign bg_color = section.settings.section_bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#333333'
  assign button_bg_color = section.settings.button_bg_color | default: '#AC853B'
  assign button_text_color = section.settings.button_text_color | default: '#ffffff'
%}

<style>
  #dgf-lp-header-{{ section.id }} {
    background-color: {{ bg_color }};
  }

  .custom-ashwagandha-pack-page .custom-announcement-bar {
    display: block!important;
}
</style>

<section id="dgf-lp-header-{{ section.id }}" class="dgf-lp-header-section">
  <div class="dgf-lp-header-wrapper">
    <div class="container">
      <div class="row align-items-center{% if section.settings.hide_menu_items and section.settings.hide_customer_icons and section.settings.hide_mobile_menu %} dgf-header-minimal{% endif %}">

        <!-- Logo -->
        <div class="dgf-lp-header-logo col-auto">
          {% if section.settings.site_logo_image != blank %}

              <img loading="lazy" src="{{ section.settings.site_logo_image | img_url: 'master' }}" alt="{{ shop.name }}" class="d-none d-lg-block">

          {% endif %}
          {% if section.settings.site_logo_image_mobile != blank %}

              <img loading="lazy" src="{{ section.settings.site_logo_image_mobile | img_url: 'master' }}" alt="{{ shop.name }}" class="d-block d-lg-none" style="filter: blur(0)!important">

          {% endif %}
        </div>

        <!-- Navigation Items (Left-aligned) -->
        {% unless section.settings.hide_menu_items %}
        <div class="dgf-lp-header-nav col d-none d-lg-block">
          <ul class="dgf-nav-list">
            {% for block in section.blocks %}
              {% if block.type == 'nav_item' %}
                <li class="dgf-nav-item {% if block.settings.enable_megamenu %}has-megamenu{% endif %}" {{ block.shopify_attributes }}>
                  {% if block.settings.enable_megamenu %}
                    <a href="javascript:void(0);" style="color: {{ block.settings.nav_text_color | default: text_color }}; cursor: pointer;">
                      {{ block.settings.nav_text }}
                    </a>
                  {% else %}
                    <a href="{{ block.settings.nav_url }}" style="color: {{ block.settings.nav_text_color | default: text_color }};">
                      {{ block.settings.nav_text }}
                    </a>
                  {% endif %}

                  {% if block.settings.enable_megamenu %}
                    <div class="dgf-megamenu" style="background-color: {{ block.settings.megamenu_bg_color | default: bg_color }}; --megamenu-text-color: {{ block.settings.megamenu_text_color | default: text_color }};">
                      <div class="container">
                        <div class="dgf-megamenu-inner">
                          {% if block.settings.megamenu_type == 'products' %}
                            <!-- Products Mega Menu with Text and Image -->
                            <div class="dgf-megamenu-products-layout">
                              <!-- Text Section -->
                              {% if block.settings.megamenu_text != blank %}
                                <div class="dgf-megamenu-text-section">
                                  <div class="dgf-megamenu-text-content">
                                    {{ block.settings.megamenu_text }}
                                  </div>
                                </div>
                              {% endif %}

                              <!-- Products Section -->
                              <div class="dgf-megamenu-products">
                                {% if block.settings.megamenu_product_1 != blank %}
                                  {% assign product_1 = all_products[block.settings.megamenu_product_1] %}
                                  {% assign product_1_url = block.settings.megamenu_product_1_url | default: product_1.url %}
                                  <div class="dgf-megamenu-product-item" data-product-id="{{ product_1.id }}">
                                    <a href="{{ product_1_url }}" data-product-url="{{ product_1_url }}">
                                      <div class="product-image-wrapper">
                                        {% if product_1.featured_image %}
                                          <img src="{{ product_1.featured_image | img_url: '400x400' }}" alt="{{ product_1.title }}" loading="lazy" data-product-image>
                                        {% endif %}
                                      </div>
                                      <h4>{{ product_1.title }}</h4>
                                      {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: false, product: product_1 %}
                                      <div class="product-price">
                                        <span class="price">{{ product_1.price | money }}</span>
                                        {% if product_1.compare_at_price > product_1.price %}
                                          <span class="compare-price">{{ product_1.compare_at_price | money }}</span>
                                        {% endif %}
                                      </div>
                                    </a>
                                  </div>
                                {% endif %}

                                {% if block.settings.megamenu_product_2 != blank %}
                                  {% assign product_2 = all_products[block.settings.megamenu_product_2] %}
                                  {% assign product_2_url = block.settings.megamenu_product_2_url | default: product_2.url %}
                                  <div class="dgf-megamenu-product-item" data-product-id="{{ product_2.id }}">
                                    <a href="{{ product_2_url }}" data-product-url="{{ product_2_url }}">
                                      <div class="product-image-wrapper">
                                        {% if product_2.featured_image %}
                                          <img src="{{ product_2.featured_image | img_url: '400x400' }}" alt="{{ product_2.title }}" loading="lazy" data-product-image>
                                        {% endif %}
                                      </div>
                                      <h4>{{ product_2.title }}</h4>
                                      {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: false, product: product_2 %}
                                      <div class="product-price">
                                        <span class="price">{{ product_2.price | money }}</span>
                                        {% if product_2.compare_at_price > product_2.price %}
                                          <span class="compare-price">{{ product_2.compare_at_price | money }}</span>
                                        {% endif %}
                                      </div>
                                    </a>
                                  </div>
                                {% endif %}

                                {% if block.settings.megamenu_product_3 != blank %}
                                  {% assign product_3 = all_products[block.settings.megamenu_product_3] %}
                                  {% assign product_3_url = block.settings.megamenu_product_3_url | default: product_3.url %}
                                  <div class="dgf-megamenu-product-item" data-product-id="{{ product_3.id }}">
                                    <a href="{{ product_3_url }}" data-product-url="{{ product_3_url }}">
                                      <div class="product-image-wrapper">
                                        {% if product_3.featured_image %}
                                          <img src="{{ product_3.featured_image | img_url: '400x400' }}" alt="{{ product_3.title }}" loading="lazy" data-product-image>
                                        {% endif %}
                                      </div>
                                      <h4>{{ product_3.title }}</h4>
                                      {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: false, product: product_3 %}
                                      <div class="product-price">
                                        {% if product_3.compare_at_price > product_3.price %}
                                          <span class="compare-price">{{ product_3.compare_at_price | money }}</span>
                                        {% endif %}
                                        <span class="price">{{ product_3.price | money }}</span>
                                      </div>
                                    </a>
                                  </div>
                                {% endif %}
                              </div>

                              <!-- Image Section -->
                              {% if block.settings.megamenu_side_image != blank %}
                                <div class="dgf-megamenu-image-section">
                                  <img src="{{ block.settings.megamenu_side_image | img_url: 'master' }}" alt="Megamenu" loading="lazy">
                                </div>
                              {% endif %}
                            </div>

                          {% elsif block.settings.megamenu_type == 'images' %}
                          <!-- Images with Links Mega Menu -->
                          <div class="dgf-megamenu-images">
                            {% if block.settings.megamenu_image_1 != blank %}
                              <div class="dgf-megamenu-image-item">
                                <a href="{{ block.settings.megamenu_link_1 }}">
                                  <div class="img-wrapper">
                                    <img src="{{ block.settings.megamenu_image_1 | img_url: '400x400' }}" alt="{{ block.settings.megamenu_text_1 }}" loading="lazy">
                                  </div>
                                  {% if block.settings.megamenu_text_1 != blank %}
                                    <h3>{{ block.settings.megamenu_text_1 }}</h3>
                                  {% endif %}
                                </a>
                              </div>
                            {% endif %}

                            {% if block.settings.megamenu_image_2 != blank %}
                              <div class="dgf-megamenu-image-item">
                                <a href="{{ block.settings.megamenu_link_2 }}">
                                  <div class="img-wrapper">
                                    <img src="{{ block.settings.megamenu_image_2 | img_url: '400x400' }}" alt="{{ block.settings.megamenu_text_2 }}" loading="lazy">
                                  </div>
                                  {% if block.settings.megamenu_text_2 != blank %}
                                    <h3>{{ block.settings.megamenu_text_2 }}</h3>
                                  {% endif %}
                                </a>
                              </div>
                            {% endif %}

                            {% if block.settings.megamenu_image_3 != blank %}
                              <div class="dgf-megamenu-image-item">
                                <a href="{{ block.settings.megamenu_link_3 }}">
                                  <div class="img-wrapper">
                                    <img src="{{ block.settings.megamenu_image_3 | img_url: '400x400' }}" alt="{{ block.settings.megamenu_text_3 }}" loading="lazy">
                                  </div>
                                  {% if block.settings.megamenu_text_3 != blank %}
                                    <h3>{{ block.settings.megamenu_text_3 }}</h3>
                                  {% endif %}
                                </a>
                              </div>
                            {% endif %}

                            {% if block.settings.megamenu_image_4 != blank %}
                              <div class="dgf-megamenu-image-item">
                                <a href="{{ block.settings.megamenu_link_4 }}">
                                  <div class="img-wrapper">
                                    <img src="{{ block.settings.megamenu_image_4 | img_url: '400x400' }}" alt="{{ block.settings.megamenu_text_4 }}" loading="lazy">
                                  </div>
                                  {% if block.settings.megamenu_text_4 != blank %}
                                    <h3>{{ block.settings.megamenu_text_4 }}</h3>
                                  {% endif %}
                                </a>
                              </div>
                            {% endif %}
                          </div>

                          <!-- Button for Images Megamenu -->
                          {% if block.settings.show_megamenu_button %}
                            <div class="dgf-megamenu-button-wrapper">
                              <a href="{{ block.settings.megamenu_button_url }}" class="dgf-megamenu-button" style="color: #111111;">
                                {{ block.settings.megamenu_button_text }}
                              </a>
                            </div>
                          {% endif %}
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
        {% endunless %}

        <!-- Right Side: Button + Icons -->
        <div class="dgf-lp-header-right col-auto ml-auto d-flex align-items-center">
          <div class="dgf-header-actions">

            <!-- CTA Button - Desktop only -->
            {% if section.settings.button_text != blank %}
              <a href="{{ section.settings.button_url }}" class="dgf-lp-hdr btn btn-bg d-none d-lg-inline-block" style="color: {{ button_text_color }};">
                {{ section.settings.button_text }}
              </a>
            {% endif %}

            <!-- Header Icons -->
            {% unless section.settings.hide_customer_icons %}
            <ul class="more-icon d-flex order-lg-2">
              {% if section.settings.show_search == true %}<li class="d-none d-lg-flex"><a href="/search" aria-label="Search products"><i class="fa fa-search"></i></a></li>{% endif %}
              {%- if customer -%}
                <li class="d-none d-lg-flex"><a href="{{ routes.account_url }}" aria-label="My account">{% render 'icon-account' %}</a></li>
              {%- else -%}
                <li class="d-none d-lg-flex"><a href="/account/login" aria-label="Login to your account">{% render 'icon-account' %}</a></li>
              {%- endif -%}
              <!-- Cart icon shows on all devices -->
              <li>
                <a class="cart-btn-show" href="#" aria-label="Shopping cart - {{ cart.item_count }} items">
                  {% render 'icon-cart' %}
                    <span class="cart-count header-bar__cart-count {% if cart.item_count == 0 %}hidden-count{% endif %}" data-ajax-cart-bind-state="cart.item_count">{{ cart.item_count }}</span>
                </a>
              </li>
            </ul>
            {% endunless %}

          </div>
        </div>

        <!-- Mobile Menu Toggle -->
        {% unless section.settings.hide_mobile_menu %}
        <nav id="site-navigation" class="main-navigation navbar navbar-expand-lg navbar-light order-first order-lg-1 d-lg-none">
          <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dgfMobileNav" aria-controls="dgfMobileNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
            <span class="navbar-toggler-icon"></span>
          </button>
        </nav>
        {% endunless %}

      </div>

      <!-- Mobile Navigation -->
      {% unless section.settings.hide_mobile_menu %}
      <div class="collapse d-lg-none" id="dgfMobileNav">
        <div class="dgf-mobile-nav">

          <!-- Mobile Tabs Navigation -->
          <div class="dgf-mobile-tabs">
            {% for block in section.blocks %}
              {% if block.type == 'nav_item' and block.settings.enable_megamenu %}
                <button class="dgf-mobile-tab {% if forloop.first %}active{% endif %}" data-tab="{{ block.id }}" style="color: {{ block.settings.nav_text_color | default: text_color }};">
                  {{ block.settings.nav_text }}
                </button>
              {% endif %}
            {% endfor %}
          </div>

          <!-- Mobile Tab Content -->
          <div class="dgf-mobile-tab-content">
            {% for block in section.blocks %}
              {% if block.type == 'nav_item' and block.settings.enable_megamenu %}
                <div class="dgf-mobile-tab-pane {% if forloop.first %}active{% endif %}" id="tab-{{ block.id }}" style="background-color: {{ block.settings.megamenu_bg_color | default: bg_color }};">

                  {% if block.settings.megamenu_type == 'products' %}
                    <!-- Products Mobile Megamenu -->
                    <div class="dgf-mobile-megamenu-products">
                      {% if block.settings.mobile_megamenu_title != blank %}
                        <div class="dgf-mobile-megamenu-header">
                          {{ block.settings.mobile_megamenu_title }}
                        </div>
                      {% endif %}

                      <div class="dgf-mobile-megamenu-products-grid">
                        {% if block.settings.megamenu_product_1 != blank %}
                          {% assign product_1 = all_products[block.settings.megamenu_product_1] %}
                          {% assign product_1_url = block.settings.megamenu_product_1_url | default: product_1.url %}
                          <div class="dgf-mobile-megamenu-product-item" data-product-id="{{ product_1.id }}">
                            <a href="{{ product_1_url }}" data-product-url="{{ product_1_url }}">
                              <div class="product-image-wrapper">
                                {% if product_1.featured_image %}
                                  <img src="{{ product_1.featured_image | img_url: '400x400' }}" alt="{{ product_1.title }}" loading="lazy" data-product-image>
                                {% endif %}
                              </div>
                              <h4>{{ product_1.title }}</h4>
                              {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: false, product: product_1 %}
                              <div class="product-price">
                                <span class="price">{{ product_1.price | money }}</span>
                                {% if product_1.compare_at_price > product_1.price %}
                                  <span class="compare-price">{{ product_1.compare_at_price | money }}</span>
                                {% endif %}
                              </div>
                            </a>
                          </div>
                        {% endif %}

                        {% if block.settings.megamenu_product_2 != blank %}
                          {% assign product_2 = all_products[block.settings.megamenu_product_2] %}
                          {% assign product_2_url = block.settings.megamenu_product_2_url | default: product_2.url %}
                          <div class="dgf-mobile-megamenu-product-item" data-product-id="{{ product_2.id }}">
                            <a href="{{ product_2_url }}" data-product-url="{{ product_2_url }}">
                              <div class="product-image-wrapper">
                                {% if product_2.featured_image %}
                                  <img src="{{ product_2.featured_image | img_url: '400x400' }}" alt="{{ product_2.title }}" loading="lazy" data-product-image>
                                {% endif %}
                              </div>
                              <h4>{{ product_2.title }}</h4>
                              {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: false, product: product_2 %}
                              <div class="product-price">
                                <span class="price">{{ product_2.price | money }}</span>
                                {% if product_2.compare_at_price > product_2.price %}
                                  <span class="compare-price">{{ product_2.compare_at_price | money }}</span>
                                {% endif %}
                              </div>
                            </a>
                          </div>
                        {% endif %}

                        {% if block.settings.megamenu_product_3 != blank %}
                          {% assign product_3 = all_products[block.settings.megamenu_product_3] %}
                          {% assign product_3_url = block.settings.megamenu_product_3_url | default: product_3.url %}
                          <div class="dgf-mobile-megamenu-product-item" data-product-id="{{ product_3.id }}">
                            <a href="{{ product_3_url }}" data-product-url="{{ product_3_url }}">
                              <div class="product-image-wrapper">
                                {% if product_3.featured_image %}
                                  <img src="{{ product_3.featured_image | img_url: '400x400' }}" alt="{{ product_3.title }}" loading="lazy" data-product-image>
                                {% endif %}
                              </div>
                              <h4>{{ product_3.title }}</h4>
                              {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: false, product: product_3 %}
                              <div class="product-price">
                                <span class="price">{{ product_3.price | money }}</span>
                                {% if product_3.compare_at_price > product_3.price %}
                                  <span class="compare-price">{{ product_3.compare_at_price | money }}</span>
                                {% endif %}
                              </div>
                            </a>
                          </div>
                        {% endif %}
                      </div>

                      {% if block.settings.mobile_megamenu_image != blank %}
                        <div class="dgf-mobile-megamenu-image">
                          <img src="{{ block.settings.mobile_megamenu_image | img_url: 'master' }}" alt="Mobile Megamenu" loading="lazy">
                        </div>
                      {% endif %}

                      {% if block.settings.mobile_megamenu_link_text != blank %}
                        <div class="dgf-mobile-megamenu-link">
                          <a href="{{ block.settings.mobile_megamenu_link_url }}" style="color: #111">
                            {{ block.settings.mobile_megamenu_link_text }}
                          </a>
                        </div>
                      {% endif %}
                    </div>

                  {% elsif block.settings.megamenu_type == 'images' %}
                    <!-- Images Mobile Megamenu -->
                    <div class="dgf-mobile-megamenu-images">
                      {% if block.settings.megamenu_image_1 != blank %}
                        <div class="dgf-mobile-megamenu-image-item">
                          <a href="{{ block.settings.megamenu_link_1 }}">
                            <div class="img-wrapper">
                              <img src="{{ block.settings.megamenu_image_1 | img_url: '400x400' }}" alt="{{ block.settings.megamenu_text_1 }}" loading="lazy">
                            </div>
                            {% if block.settings.megamenu_text_1 != blank %}
                              <h3>{{ block.settings.megamenu_text_1 }}</h3>
                            {% endif %}
                          </a>
                        </div>
                      {% endif %}

                      {% if block.settings.megamenu_image_2 != blank %}
                        <div class="dgf-mobile-megamenu-image-item">
                          <a href="{{ block.settings.megamenu_link_2 }}">
                            <div class="img-wrapper">
                              <img src="{{ block.settings.megamenu_image_2 | img_url: '400x400' }}" alt="{{ block.settings.megamenu_text_2 }}" loading="lazy">
                            </div>
                            {% if block.settings.megamenu_text_2 != blank %}
                              <h3>{{ block.settings.megamenu_text_2 }}</h3>
                            {% endif %}
                          </a>
                        </div>
                      {% endif %}

                      {% if block.settings.megamenu_image_3 != blank %}
                        <div class="dgf-mobile-megamenu-image-item">
                          <a href="{{ block.settings.megamenu_link_3 }}">
                            <div class="img-wrapper">
                              <img src="{{ block.settings.megamenu_image_3 | img_url: '400x400' }}" alt="{{ block.settings.megamenu_text_3 }}" loading="lazy">
                            </div>
                            {% if block.settings.megamenu_text_3 != blank %}
                              <h3>{{ block.settings.megamenu_text_3 }}</h3>
                            {% endif %}
                          </a>
                        </div>
                      {% endif %}

                      {% if block.settings.megamenu_image_4 != blank %}
                        <div class="dgf-mobile-megamenu-image-item">
                          <a href="{{ block.settings.megamenu_link_4 }}">
                            <div class="img-wrapper">
                              <img src="{{ block.settings.megamenu_image_4 | img_url: '400x400' }}" alt="{{ block.settings.megamenu_text_4 }}" loading="lazy">
                            </div>
                            {% if block.settings.megamenu_text_4 != blank %}
                              <h3>{{ block.settings.megamenu_text_4 }}</h3>
                            {% endif %}
                          </a>
                        </div>
                      {% endif %}
                    </div>
                    {% if block.settings.show_megamenu_button %}
                      <div class="dgf-mobile-megamenu-button">
                        <a href="{{ block.settings.megamenu_button_url }}" class="dgf-megamenu-button" style="background-color: #FFD2BF; color: #111111;">
                          {{ block.settings.megamenu_button_text }}
                        </a>
                      </div>
                    {% endif %}
                  {% endif %}

                </div>
              {% endif %}
            {% endfor %}
          </div>

        </div>
      </div>
      {% endunless %}

    </div>
  </div>
</section>

<style>
  .dgf-header-minimal {
    display: flex !important;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
  }

  .dgf-header-minimal .dgf-lp-header-logo {
    flex: 0 1 auto;
  }

  .dgf-header-minimal .dgf-lp-header-right {
    margin-left: auto !important;
    flex: 0 0 auto;
  }

  .dgf-header-minimal .dgf-lp-hdr.btn {
    display: inline-block !important;
    white-space: nowrap;
  }

  .dgf-header-minimal .dgf-lp-header-logo img {
    max-width: 100%;
    height: auto;
  }

  .dgf-lp-header-section {
    padding: 14px 0;
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 1045; /* Medium z-index for sticky mode */
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform, box-shadow;
  }

  .dgf-lp-header-section.header-floating {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    transform: translateY(0);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    animation: slideInFromTop 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    visibility: visible;
    opacity: 1;
    z-index: 1050; /* Higher z-index when floating, but not too high */
  }

  .dgf-lp-header-section.header-floating.header-hidden {
    transform: translateY(-100%);
    transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .dgf-lp-header-section.header-floating:not(.header-hidden) {
    transform: translateY(0);
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Floating header animations */
  @keyframes slideInFromTop {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes slideOutToTop {
    from {
      transform: translateY(0);
      opacity: 1;
    }
    to {
      transform: translateY(-100%);
      opacity: 0;
    }
  }

  .dgf-lp-header-wrapper {
    position: relative;
  }

  .dgf-lp-header-wrapper .row {
    align-items: center;
  }

  .dgf-lp-header-logo img {
    width: 252px;
    height: auto;
  }

  .more-icon{
      margin-bottom: 0!important;
    }

  /* Navigation Styles */
  .dgf-lp-header-nav {
    position: relative;
  }

  .dgf-nav-list {
    margin: 0 0 0 8rem;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 5rem;
    list-style: none;
  }

  .dgf-nav-item a {
