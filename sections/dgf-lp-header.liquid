<script>
jQuery(document).ready(function($) {
  try {
    // Floating Header Functionality
    let lastScrollTop = 0;
    let scrollThreshold = 30; // Even lower threshold for immediate floating
    let hideThreshold = 5; // Lower minimum scroll distance
    let isFloating = false;
    let scrollTimer = null;
    const header = $('.dgf-lp-header-section');

    // Update header height CSS variable
    function updateHeaderHeight() {
      const headerHeight = header.outerHeight();
      document.documentElement.style.setProperty('--header-height', headerHeight + 'px');
    }

    // Initial update
    updateHeaderHeight();

    // Update on window resize
    $(window).on('resize', updateHeaderHeight);

  $(window).on('scroll', function() {
    try {
      const currentScroll = $(this).scrollTop();
      const scrollDifference = Math.abs(currentScroll - lastScrollTop);

      // Clear any existing timer
      if (scrollTimer) {
        clearTimeout(scrollTimer);
      }

      // Switch to floating mode immediately after small scroll
      if (currentScroll > scrollThreshold && !isFloating) {
        header.addClass('header-floating');
        header.removeClass('header-hidden');
        isFloating = true;
      }

      // Switch back to sticky only at very top
      if (currentScroll <= scrollThreshold && isFloating) {
        header.removeClass('header-floating header-hidden');
        isFloating = false;
      }

      // More responsive show/hide logic when floating
      if (isFloating) {
        // NEVER hide header if mobile dropdown is open
        const isMobileNavOpen = mobileNav.hasClass('show') || mobileNav.hasClass('collapsing');

        if (!isMobileNavOpen) {
          if (currentScroll > lastScrollTop && scrollDifference > hideThreshold) {
            // Scrolling down - hide header with delay (only if dropdown is closed)
            scrollTimer = setTimeout(function() {
              try {
                if (currentScroll > scrollThreshold + 30 && !mobileNav.hasClass('show')) {
                  header.addClass('header-hidden');
                }
              } catch(e) { null }
            }, 100); // Small delay before hiding
          } else if (currentScroll < lastScrollTop && scrollDifference > hideThreshold) {
            // Scrolling up - show header immediately
            header.removeClass('header-hidden');
          }
        } else {
          // Force header to be visible when dropdown is open
          header.removeClass('header-hidden');
        }
      }

      // Update dropdown position based on header state
      updateDropdownPosition();

      lastScrollTop = currentScroll;
    } catch(e) { null }
  });

  // Check if Rebuy is available
  let hasRebuy = false;
  try {
    hasRebuy = typeof window.Rebuy !== 'undefined' ||
               document.querySelector('#rebuy-smartcart') ||
               document.querySelector('.rebuy-cart');
  } catch(e) { null }


  // Bind click event specifically for dgf-lp-header cart buttons
  $('#dgf-lp-header-{{ section.id }} .cart-btn-show').on('click', function(e) {
    try {
      e.preventDefault();
      console.log('DGF LP Header cart button clicked');

      // Always try to open Rebuy cart
      console.log('Opening Rebuy cart');

      // Try clicking the original cart button to trigger Rebuy
      const originalCartBtn = document.querySelector('.site-header .cart-btn-show');
      if (originalCartBtn && originalCartBtn !== e.target) {
        console.log('Found original cart button, clicking it to trigger Rebuy');
        originalCartBtn.click();
      } else {
        console.log('Could not find original cart button');
      }
    } catch(e) { null }
  });

  // Bind click event specifically for dgf-lp-header cart count
  $('#dgf-lp-header-{{ section.id }} .cart-count.header-bar__cart-count').on('click', function(e) {
    try {
      e.preventDefault();
      e.stopPropagation(); // Prevent event bubbling
      console.log('DGF LP Header cart count clicked');

      // Always try to open Rebuy cart
      console.log('Opening Rebuy cart via count click');

      // Try clicking the original cart button to trigger Rebuy
      const originalCartBtn = document.querySelector('.site-header .cart-btn-show');
      if (originalCartBtn) {
        console.log('Found original cart button, clicking it to trigger Rebuy');
        originalCartBtn.click();
      } else {
        console.log('Could not find original cart button');
        // Alternative: try to trigger Rebuy directly
        try {
          if (window.Rebuy && window.Rebuy.Cart) {
            console.log('Triggering Rebuy cart directly');
            window.Rebuy.Cart.show();
          }
        } catch(e) { null }
      }
    } catch(e) { null }
  });

  // Enhanced dropdown behavior with scroll management
  const mobileNav = $('#dgfMobileNav');
  const navbar = $('.dgf-lp-header-section');
  const navToggler = $('.dgf-lp-header-section .navbar-toggler');
  let scrollPosition = 0;
  let isDropdownOpen = false;

  // Update dropdown position when header state changes
  function updateDropdownPosition() {
    try {
      // Force recalculation of dropdown positioning
      if (mobileNav.hasClass('show')) {
        // If dropdown is open, update its position immediately
        if (header.hasClass('header-floating')) {
          mobileNav.css('top', '60px');
        } else {
          mobileNav.css('top', '60px');
        }
      }
    } catch(e) { null }
  }

  // Function to lock scroll - Enhanced version
  function lockScroll() {
    try {
      if (isDropdownOpen) return; // Prevent double-locking

      console.log('Locking scroll...');
      scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
      isDropdownOpen = true;

      // Add class to both body and html
      $('body, html').addClass('dgf-dropdown-open');

      // Store original styles for restoration
      const originalBodyStyle = $('body').attr('style') || '';
      const originalHtmlStyle = $('html').attr('style') || '';
      $('body').data('original-style', originalBodyStyle);
      $('html').data('original-style', originalHtmlStyle);

      // Enhanced scroll blocking methods
      $('body').css({
        'overflow': 'hidden !important',
        'position': 'fixed !important',
        'top': `-${scrollPosition}px`,
        'left': '0',
        'right': '0',
        'width': '100% !important',
        'height': '100vh !important',
        'touch-action': 'none',
        '-webkit-overflow-scrolling': 'auto'
      });

      $('html').css({
        'overflow': 'hidden !important',
        'position': 'fixed !important',
        'width': '100% !important',
        'height': '100vh !important'
      });

      // Prevent all scroll-related events with immediate capture
      $(window).on('wheel.dgfDropdown DOMMouseScroll.dgfDropdown mousewheel.dgfDropdown touchmove.dgfDropdown', function(e) {
        try {
          e.preventDefault();
          e.stopImmediatePropagation();
          return false;
        } catch(e) { null }
      });

      // Prevent touch events that cause scrolling - more comprehensive
      $(document).on('touchstart.dgfDropdown', function(e) {
        try {
          // Allow touch inside dropdown content only
          if (!$(e.target).closest('.dgf-mobile-nav').length) {
            e.preventDefault();
            e.stopImmediatePropagation();
            return false;
          }
        } catch(e) { null }
      });

      $(document).on('touchmove.dgfDropdown', function(e) {
        try {
          // Block all touch move events outside dropdown
          if (!$(e.target).closest('.dgf-mobile-nav').length) {
            e.preventDefault();
            e.stopImmediatePropagation();
            return false;
          }
        } catch(e) { null }
      });

      // Prevent key scroll (arrow keys, space, page up/down, home, end)
      $(document).on('keydown.dgfDropdown', function(e) {
        try {
          const scrollKeys = [32, 33, 34, 35, 36, 37, 38, 39, 40]; // space, page up/down, end, home, arrows
          if (scrollKeys.includes(e.keyCode)) {
            e.preventDefault();
            e.stopImmediatePropagation();
            return false;
          }
        } catch(e) { null }
      });

      // Additional iOS Safari specific fixes
      try {
        if (/iPad|iPhone|iPod/.test(navigator.userAgent)) {
          $(document).on('touchforcechange.dgfDropdown', function(e) {
            try {
              e.preventDefault();
              return false;
            } catch(e) { null }
          });
        }
      } catch(e) { null }
    } catch(e) { null }
  }

  // Function to unlock scroll - Enhanced version
  function unlockScroll() {
    try {
      if (!isDropdownOpen) return; // Prevent double-unlocking

      console.log('Unlocking scroll...');
      isDropdownOpen = false;

      // Remove class from both body and html
      $('body, html').removeClass('dgf-dropdown-open');

      // Restore original styles if they existed
      const originalBodyStyle = $('body').data('original-style');
      const originalHtmlStyle = $('html').data('original-style');

      if (originalBodyStyle !== undefined) {
        $('body').attr('style', originalBodyStyle);
      } else {
        $('body').removeAttr('style');
      }

      if (originalHtmlStyle !== undefined) {
        $('html').attr('style', originalHtmlStyle);
      } else {
        $('html').removeAttr('style');
      }

      // Fallback: Remove all scroll restrictions explicitly
      $('body, html').css({
        'overflow': '',
        'position': '',
        'top': '',
        'left': '',
        'right': '',
        'width': '',
        'height': '',
        'touch-action': '',
        '-webkit-overflow-scrolling': ''
      });

      // Remove all event listeners with specific namespaces
      $(window).off('.dgfDropdown');
      $(document).off('.dgfDropdown');

      // Clear any data attributes
      $('body, html').removeData('original-style');

      // Restore scroll position with proper timing
      setTimeout(function() {
        try {
          // Double-check that styles are cleared
          if ($('body').css('position') === 'fixed') {
            $('body').css({
              'position': '',
              'top': '',
              'overflow': ''
            });
          }

          // Restore scroll position
          window.scrollTo(0, scrollPosition);

          // Force a repaint to ensure everything is restored
          document.body.style.display = 'none';
          document.body.offsetHeight; // Trigger reflow
          document.body.style.display = '';
        } catch(e) { null }
      }, 100);
    } catch(e) { null }
  }

  // Monitor dropdown state changes with better event handling
  mobileNav.on('show.bs.collapse', function() {
    try {
      console.log('Bootstrap show event triggered');
      updateDropdownPosition(); // Update position when opening
      // Force header to be visible when dropdown opens
      if (header.hasClass('header-floating')) {
        header.removeClass('header-hidden');
      }
      lockScroll();
    } catch(e) { null }
  });

  mobileNav.on('shown.bs.collapse', function() {
    try {
      console.log('Bootstrap shown event triggered');
      updateDropdownPosition(); // Update position after opening
      // Ensure header stays visible
      if (header.hasClass('header-floating')) {
        header.removeClass('header-hidden');
      }
    } catch(e) { null }
  });

  mobileNav.on('hide.bs.collapse', function() {
    try {
      console.log('Bootstrap hide event triggered');
      unlockScroll();
    } catch(e) { null }
  });

  mobileNav.on('hidden.bs.collapse', function() {
    try {
      console.log('Bootstrap hidden event triggered - force unlock');
      unlockScroll();
    } catch(e) { null }
  });

  // Emergency unlock on any click outside when dropdown should be closed
  $(document).on('click', function(e) {
    try {
      // Small delay to check final state
      setTimeout(function() {
        try {
          if (!mobileNav.hasClass('show') && !mobileNav.hasClass('collapsing') && isDropdownOpen) {
            console.log('Emergency unlock triggered');
            unlockScroll();
          }
        } catch(e) { null }
      }, 100);
    } catch(e) { null }
  });

  // Close dropdown when clicking outside (optional enhancement)
  $(document).on('click', function(e) {
    try {
      if (mobileNav.hasClass('show') &&
          !$(e.target).closest('.dgf-lp-header-section').length) {
        $('.navbar-toggler').click();
      }
    } catch(e) { null }
  });

  // Close dropdown on window resize to larger screen
  $(window).on('resize', function() {
    try {
      if ($(window).width() > 991 && mobileNav.hasClass('show')) {
        $('.navbar-toggler').click();
      }
      // Force unlock scroll on resize as safety measure
      if ($(window).width() > 991 && isDropdownOpen) {
        console.log('Force unlock on resize');
        unlockScroll();
      }
      // Ensure header is visible after resize
      if ($(window).width() > 991) {
        header.removeClass('header-hidden');
      }
    } catch(e) { null }
  });

  // Additional safety checks
  setInterval(function() {
    try {
      // Prevent header from hiding when dropdown is open
      if (mobileNav.hasClass('show') && header.hasClass('header-floating') && header.hasClass('header-hidden')) {
        console.log('Safety check: forcing header visible due to open dropdown');
        header.removeClass('header-hidden');
      }

      // Ensure scroll is locked when dropdown is open but scroll isn't locked
      if (mobileNav.hasClass('show') && !isDropdownOpen) {
        console.log('Safety check: dropdown open but scroll not locked - fixing');
        lockScroll();
      }

      // Ensure scroll is unlocked when dropdown is closed but scroll is still locked
      if (!mobileNav.hasClass('show') && !mobileNav.hasClass('collapsing') && isDropdownOpen) {
        console.log('Safety check: dropdown closed but scroll still locked - fixing');
        unlockScroll();
      }
    } catch(e) { null }
  }, 500); // Check every 500ms

  // Force unlock scroll on page unload/refresh
  $(window).on('beforeunload', function() {
    try {
      if (isDropdownOpen) {
        console.log('Page unloading - force unlock scroll');
        unlockScroll();
      }
    } catch(e) { null }
  });

  // Handle visibility change (tab switching, etc.)
  $(document).on('visibilitychange', function() {
    try {
      if (document.hidden && isDropdownOpen) {
        console.log('Page hidden - maintaining scroll lock');
      } else if (!document.hidden && isDropdownOpen && !mobileNav.hasClass('show')) {
        console.log('Page visible - checking scroll state');
        unlockScroll();
      }
    } catch(e) { null }
  });

  // Cart count update functionality
  function updateCartCount() {
    try {
      // Get cart data from Shopify's cart.js
      fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {
          const cartCount = cart.item_count;
          const cartCountElement = $('#dgf-lp-header-{{ section.id }} .cart-count.header-bar__cart-count');

          if (cartCountElement.length) {
            cartCountElement.text(cartCount);

            // Show/hide cart count based on item count
            if (cartCount === 0) {
              cartCountElement.addClass('hidden-count');
            } else {
              cartCountElement.removeClass('hidden-count');
            }
          }
        })
        .catch(error => {
          console.log('Error updating cart count:', error);
        });
    } catch(e) { null }
  }

  // Listen for cart update events
  $(document).on('cart:updated cart:changed', function(e) {
    try {
      console.log('Cart update event detected:', e.type);
      updateCartCount();
    } catch(e) { null }
  });

  // Listen for Shopify cart events
  $(document).on('cart:build cart:add cart:remove cart:clear', function(e) {
    try {
      console.log('Shopify cart event detected:', e.type);
      setTimeout(updateCartCount, 100); // Small delay to ensure cart is updated
    } catch(e) { null }
  });

  // Listen for Ajax Cart events (common in Shopify themes)
  if (typeof window.ajaxCart !== 'undefined') {
    $(document).on('ajaxCart:updated', function(e) {
      try {
        console.log('Ajax cart update detected');
        updateCartCount();
      } catch(e) { null }
    });
  }

  // Listen for custom cart events that might be triggered by other scripts
  $(document).on('cartUpdated cart_updated shopify:cart:updated', function(e) {
    try {
      console.log('Custom cart event detected:', e.type);
      updateCartCount();
    } catch(e) { null }
  });

  // Mutation Observer to watch for cart count changes in the DOM
  if (window.MutationObserver) {
    const cartCountElements = document.querySelectorAll('.cart-count, [data-cart-count]');
    cartCountElements.forEach(element => {
      if (element && !element.closest('#dgf-lp-header-{{ section.id }}')) {
        const observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            if (mutation.type === 'childList' || mutation.type === 'characterData') {
              try {
                updateCartCount();
              } catch(e) { null }
            }
          });
        });

        observer.observe(element, {
          childList: true,
          subtree: true,
          characterData: true
        });
      }
    });
  }

  // Watch for changes in cart item count data attribute
  if (window.MutationObserver) {
    const targetElement = document.querySelector('#dgf-lp-header-{{ section.id }}');
    if (targetElement) {
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.type === 'attributes' &&
              mutation.attributeName === 'data-cart-count') {
            try {
              updateCartCount();
            } catch(e) { null }
          }
        });
      });

      observer.observe(targetElement, {
        attributes: true,
        attributeFilter: ['data-cart-count']
      });
    }
  }

  // Emergency unlock function accessible globally for debugging
  window.forceUnlockScroll = function() {
    try {
      console.log('Force unlock called manually');
      isDropdownOpen = true; // Set to true so unlockScroll will run
      unlockScroll();
    } catch(e) { null }
  };

  // Safety check every 2 seconds to ensure scroll isn't stuck
  setInterval(function() {
    try {
      if (isDropdownOpen && !mobileNav.hasClass('show') && !mobileNav.hasClass('collapsing')) {
        console.log('Safety unlock - dropdown state mismatch detected');
        unlockScroll();
      }
    } catch(e) { null }
  }, 2000);

  // MutationObserver: remove overflow:hidden from body unless upsell popup is visible
  try {
    if (window.MutationObserver) {
      var _bodyOverflowRemoving = false;
      var _bodyOverflowObserver = new MutationObserver(function(mutations) {
        try {
          if (_bodyOverflowRemoving) return;
          for (var i = 0; i < mutations.length; i++) {
            if (mutations[i].attributeName !== 'style') continue;
            if (document.body.style.overflow === 'hidden') {
              // Check if dropdown nav is open — if so, do NOT remove (legitimate lock)
              if (isDropdownOpen) return;
              // Check if upsell popup is visible — if so, do NOT remove
              var upsellPopup = document.getElementById('dgf-upsell-popup');
              if (upsellPopup && upsellPopup.style.display === 'flex') return;
              // Safe to remove
              _bodyOverflowRemoving = true;
              document.body.style.removeProperty('overflow');
              _bodyOverflowRemoving = false;
              return;
            }
          }
        } catch(e) { _bodyOverflowRemoving = false; }
      });
      _bodyOverflowObserver.observe(document.body, {
        attributes: true,
        attributeFilter: ['style']
      });
    }
  } catch(e) { /* silent */ }

  // Initialize Samita Product Labels for megamenu products
  function initSamitaForMegamenu() {
    try {
      if (typeof window.Samita !== 'undefined' &&
          typeof window.Samita.ProductLabels !== 'undefined' &&
          typeof window.Samita.ProductLabels.initialize === 'function') {
        console.log('Initializing Samita for megamenu products');
        window.Samita.ProductLabels.initialize();
      } else {
        console.log('Samita not available, retrying...');
        setTimeout(initSamitaForMegamenu, 500);
      }
    } catch(e) {
      console.log('Error initializing Samita:', e);
    }
  }

  // Initialize on page load
  setTimeout(initSamitaForMegamenu, 1000);

  // Re-initialize Samita when hovering over megamenu items
  $('.dgf-nav-item.has-megamenu').on('mouseenter', function() {
    try {
      setTimeout(function() {
        if (typeof window.Samita !== 'undefined' &&
            typeof window.Samita.ProductLabels !== 'undefined' &&
            typeof window.Samita.ProductLabels.initialize === 'function') {
          window.Samita.ProductLabels.initialize();
        }
      }, 100);
    } catch(e) { null }
  });

  // Mobile Tabs Switching
  $('.dgf-mobile-tab').on('click', function(e) {
    try {
      e.preventDefault();

      const $tab = $(this);
      const tabId = $tab.data('tab');

      // Remove active class from all tabs and panes
      $('.dgf-mobile-tab').removeClass('active');
      $('.dgf-mobile-tab-pane').removeClass('active');

      // Add active class to clicked tab
      $tab.addClass('active');

      // Show corresponding pane
      $('#tab-' + tabId).addClass('active');

      // Initialize Judge.me widgets
      setTimeout(function() {
        try {
          if (typeof window.JudgeMe !== 'undefined') {
            if (typeof window.JudgeMe.reload === 'function') {
              window.JudgeMe.reload();
            }
            if (typeof window.JudgeMe.init === 'function') {
              window.JudgeMe.init();
            }
          }
          if (typeof jdgm !== 'undefined' && typeof jdgm.customizeBadges === 'function') {
            jdgm.customizeBadges();
          }
        } catch(e) {
          console.log('Judge.me tab switch error:', e);
        }
      }, 100);

      // Initialize Samita for mobile megamenu products
      setTimeout(function() {
        try {
          if (typeof window.Samita !== 'undefined' &&
              typeof window.Samita.ProductLabels !== 'undefined' &&
              typeof window.Samita.ProductLabels.initialize === 'function') {
            window.Samita.ProductLabels.initialize();
          }
        } catch(e) { null }
      }, 400);
    } catch(e) { null }
  });

  // Initialize Judge.me on mobile nav open
  mobileNav.on('shown.bs.collapse', function() {
    try {
      setTimeout(function() {
        // Try multiple Judge.me initialization methods
        if (typeof window.JudgeMe !== 'undefined') {
          if (typeof window.JudgeMe.reload === 'function') {
            window.JudgeMe.reload();
          }
          if (typeof window.JudgeMe.init === 'function') {
            window.JudgeMe.init();
          }
        }

        // Try triggering jdgm.customizeBadges
        if (typeof jdgm !== 'undefined' && typeof jdgm.customizeBadges === 'function') {
          jdgm.customizeBadges();
        }
      }, 300);
    } catch(e) {
      console.log('Judge.me init error:', e);
    }
  });

  } catch(e) { null }
});
</script>

