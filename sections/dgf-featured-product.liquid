                   <path d="M1.61744 10.4733H5.97445H9.07978C9.32557 10.4733 9.52523 10.2726 9.52523 10.0257C9.52523 9.77872 9.32557 9.57812 9.07978 9.57812H1.61744C1.37141 9.57812 1.17188 9.77872 1.17188 10.0257C1.172 10.2727 1.37141 10.4733 1.61744 10.4733Z" fill="#06211E" stroke="#06211E" stroke-width="0.1" stroke-miterlimit="10"/>
