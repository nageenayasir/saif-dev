                <span>FREE US shipping over $75</span>
              </div>
            </div>

            <!-- Payment Icons -->
            {% if section.settings.show_payment_icons %}
              <div class="dgf-payment-icons">
                {% for block in section.blocks %}
                  {% if block.type == 'payment_icon' and block.settings.payment_image %}
                    <img src="{{ block.settings.payment_image | image_url: width: 60 }}" alt="{{ block.settings.payment_alt | default: 'Payment method' }}">
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}


            <!-- Desktop Image 2 - Only visible on desktop -->
            {% if section.settings.image_2 != blank %}
              <div class="dgf-separator-image-2 desktop-separator-2 d-none d-md-block">
                <img src="{{ section.settings.image_2 | image_url }}" alt="Separator Image">
              </div>
            {% endif %}

            <!-- Add to Cart Button -->
            <div class="dgf-add-to-cart btn btn-bg">
              <a
                class="dgf-cart-button"
                id="add-to-cart-btn">
                ADD TO CART |&nbsp;<span id="button-price">${{ display_variant.price | money_without_currency }}</span>
              </a>
            </div>

            <!-- Desktop Disclaimer - Only visible on desktop, positioned below button -->
            {% if section.settings.disclaimer_text != blank %}
              <div class="dgf-disclaimer desktop-disclaimer d-none d-md-block">
                {{ section.settings.disclaimer_text }}
              </div>
            {% endif %}

          </div>
        </div>

      </div>
    {% else %}
      <div class="dgf-no-product">
        <p>Please select a product in the theme editor.</p>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .dgf-featured-product-section {
    padding: 4rem 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .dgf-featured-product-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
  }

  .dgf-product-wrapper {
    display: grid;
    padding: 0 4rem;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* Product Images */
  .dgf-product-images-column {
    position: relative;
    overflow: hidden;
    min-height: 400px;
  }

  .dgf-product-images {
    width: 100%;
    overflow: hidden;
  }

  .main-gallery {
    margin-bottom: 1rem;
    position: relative;
    width: 100%;
    max-width: 600px;
  }

  .main-gallery .swiper {
    width: 100%;
    height: auto;
  }

  .main-gallery .swiper-wrapper {
    align-items: stretch;
  }

  .product__photo {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 15px;
    width: 100% !important;
    height: auto !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  .product__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Main Gallery Navigation Buttons - Estilos exatos do main-product */
  .dgf-featured-product-section .product-gallery-prev:after,
  .dgf-featured-product-section .product-gallery-next:after {
    display: none !important;
  }

  .dgf-featured-product-section .product-gallery-prev {
    background: url(https://cdn.shopify.com/s/files/1/0499/0425/5134/files/left-arrow-new.svg) !important;
    transition: .3s ease !important;
    height: 34px !important;
    width: 35px !important;
    background-repeat: no-repeat !important;
    background-size: 100% !important;
    background-position: center !important;
    border-radius: 24px !important;
    outline: none !important;
    box-shadow: none !important;
    left: 0px !important;
    margin: 0 !important;
    transform: translate(0px, -50%) !important;
  }

  .dgf-featured-product-section .product-gallery-next {
    background: url(https://cdn.shopify.com/s/files/1/0499/0425/5134/files/right-arrowe-new.svg) !important;
    transition: .3s ease !important;
    height: 34px !important;
    width: 35px !important;
    background-repeat: no-repeat !important;
    background-size: 100% !important;
    background-position: center !important;
    border-radius: 30px !important;
    outline: none !important;
    box-shadow: none !important;
    right: 0px !important;
    margin: 0 !important;
    transform: translate(0px, -50%) !important;
  }

  .dgf-featured-product-section .product-gallery-next,
  .dgf-featured-product-section .product-gallery-prev {
    visibility: hidden !important;
    transition: 0.3s ease !important;
  }

  .dgf-featured-product-section .main-gallery.product__photo:hover .product-gallery-next,
  .dgf-featured-product-section .main-gallery.product__photo:hover .product-gallery-prev {
    visibility: visible !important;
    transition: 0.3s ease !important;
  }

  /* Esconder pagination em desktop */
  .main-gallery .swiper-pagination {
    display: none;
  }

  /* Mobile Product Slider - Estilos exatos do main-product */
  .mobile-product-slider .swiper-wrapper-box {
    margin-top: 0px;
  }

  .product-slider {
    width: 100%;
    overflow: hidden;
  }

  .product-slider .swiper-wrapper {
    width: 100%;
  }

  .product-slider .swiper-slide {
    width: 100% !important;
    flex-shrink: 0;
  }

  .product-slider .swiper-slide img {
    width: 100%;
    height: auto;
    display: block;
  }

  .mobile-product-slider .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    background: #000;
    opacity: 1;
    background: linear-gradient(180deg, #F3D9CF 0%, #F3D9CF 100%);
  }

  .mobile-product-slider .swiper-pagination-bullet-active {
    background: #A7833E;
  }

  .mobile-product-slider .swiper-pagination {
    bottom: -3px;
    position: absolute;
    width: 100%;
    text-align: center;
    z-index: 10;
  }

  .mobile-product-slider .swiper-pagination {
    bottom: -3px !important;
    position: absolute !important;
    width: 100% !important;
    text-align: center !important;
    z-index: 10 !important;
  }

  .mobile-product-slider .swiper-pagination-bullet {
    width: 10px !important;
    height: 10px !important;
    background: linear-gradient(180deg, #F3D9CF 0%, #F3D9CF 100%) !important;
    opacity: 1 !important;
    margin: 0 4px !important;
    border-radius: 50% !important;
    display: inline-block !important;
  }

  .mobile-product-slider .swiper-pagination-bullet-active {
    background: #A7833E !important;
  }

  /* Media Queries para resoluções 1025px - 1440px */
  @media screen and (max-width: 1440px) and (min-width: 1200px) {
    .dgf-featured-product-container {
      max-width: 1200px;
      padding: 0 1.5rem;
    }

    .dgf-product-wrapper {
      padding: 0 3rem;
      gap: 3rem;
    }

    .dgf-product-title {
      font-size: 42px;
    }

    .dgf-product-description {
      font-size: 16px;
    }

    .main-gallery {
      max-width: 550px;
    }
  }

  @media screen and (max-width: 1199px) and (min-width: 1025px) {
    .dgf-featured-product-container {
      max-width: 1024px;
      padding: 0 1rem;
    }

    .dgf-product-wrapper {
      padding: 0 2rem;
      gap: 2.5rem;
    }

    .dgf-product-title {
      font-size: 36px;
      line-height: 1.1;
    }

    .dgf-product-description {
      font-size: 15px;
      line-height: 1.4;
    }

    .dgf-product-price {
      font-size: 28px;
    }

    .dgf-add-to-cart-btn {
      padding: 0.8rem 2rem;
      font-size: 16px;
    }

    .main-gallery {
      max-width: 480px;
    }

    .product__thumbnails.thumbnails {
      max-width: 400px;
      margin: 15px auto !important;
    }

    .dgf-variant-option {
      padding: 0.7rem 1.2rem;
      font-size: 14px;
    }

    /* Ajustar botões de navegação para telas menores */
    .product-gallery-prev, .product-gallery-next {
      height: 30px !important;
      width: 31px !important;
    }

    .product-thumbnail-prev, .product-thumbnail-next {
      height: 20px !important;
      width: 8px !important;
    }
  }

  /* Media Queries para Mobile */
  @media screen and (max-width: 1024px) and (min-width: 769px) {
    .dgf-featured-product-container {
      max-width: 768px;
      padding: 0 1rem;
    }

    .dgf-product-wrapper {
      padding: 0 1.5rem;
      gap: 2rem;
    }

    .dgf-product-title {
      font-size: 32px;
      line-height: 1.1;
    }

    .dgf-product-description {
      font-size: 14px;
    }

    .main-gallery {
      max-width: 400px;
    }

    .product__thumbnails.thumbnails {
      max-width: 350px;
    }
  }

  @media screen and (max-width: 768px) {
    .dgf-featured-product-section {
      padding: 2rem 0;
      min-height: auto;
    }

    .dgf-featured-product-container {
      max-width: 100%;
      padding: 0 1rem;
    }

    .dgf-product-wrapper {
      display: block;
      padding: 0;
      gap: 0;
    }

    .dgf-product-images-column {
      margin-bottom: 2rem;
      min-height: auto;
    }

    .main-gallery {
      max-width: 100%;
      margin-bottom: 1rem;
    }

    .product__photo {
      border-radius: 12px;
    }

    .product__thumbnails.thumbnails {
      display: none;
    }

    /* Mobile slider usa os estilos da classe .mobile-product-slider */

    .dgf-product-details-column {
      text-align: center;
    }

    .dgf-product-title {
      font-size: 27px;
      line-height: 1.2;
      margin-bottom: 1rem;
    }

    .dgf-product-description {
      font-size: 14px;
      line-height: 1.4;
      margin-bottom: 1.5rem;
    }

    .dgf-product-price {
      font-size: 24px;
      margin-bottom: 1.5rem;
    }

    .dgf-variant-options {
      margin-bottom: 1.5rem;
    }

    .dgf-variant-option {
      padding: 0.6rem 1rem;
      font-size: 13px;
      margin: 0.3rem;
    }

    .dgf-add-to-cart-btn {
      width: 100%;
      padding: 1rem;
      font-size: 16px;
      margin-top: 1rem;
    }

    /* Botões de navegação mobile */
    .product-gallery-prev, .product-gallery-next {
      height: 28px !important;
      width: 29px !important;
    }

    .product-thumbnail-prev, .product-thumbnail-next {
      height: 18px !important;
      width: 7px !important;
    }

    /* Melhorar touch targets */
    .product__thumbnail {
      padding: 0 5px !important;
    }

    .product__thumbnail img {
      border-radius: 0 8px;
    }
  }

  @media screen and (max-width: 480px) {
    .dgf-featured-product-section {
      padding: 1.5rem 0;
    }

    .dgf-featured-product-container {
      padding: 0 0.5rem;
    }

    .dgf-product-images-column {
      margin-bottom: 1.5rem;
    }

    .dgf-product-title {
      font-size: 24px;
      line-height: 1.1;
    }

    .dgf-product-description {
      font-size: 13px;
      margin-bottom: 1rem;
    }

    .dgf-product-price {
      font-size: 22px;
      margin-bottom: 1rem;
    }

    .dgf-variant-option {
      padding: 0.5rem 0.8rem;
      font-size: 12px;
      margin: 0.2rem;
    }

    .dgf-add-to-cart-btn {
      padding: 0.9rem;
      font-size: 15px;
    }

    /* Esconder thumbnails em mobile pequeno também */
    .product__thumbnails.thumbnails {
      display: none;
    }

    /* Botões ainda menores */
    .product-gallery-prev, .product-gallery-next {
      height: 24px !important;
      width: 25px !important;
    }

    .product-thumbnail-prev, .product-thumbnail-next {
      height: 16px !important;
      width: 6px !important;
    }
  }

  /* Thumbnails - Estilos exatos do main-product */
  .product__thumbnails.thumbnails {
    max-width: 490px;
    margin: 18px auto !important;
    padding: 0;
    width: 100%;
    position: initial;
    transform: translateY(0) !important;
    text-align: center;
  }

  .product__thumbnails.thumbnails .product__thumbnail {
    padding: 0 10px;
    display: inline-block;
  }

  .product__thumbnail img {
    border-radius: 0 12px;
    border: 2px solid #cdcdcd;
    cursor: pointer;
  }

  .swiper-slide-thumb-active .product__thumbnail img {
    border: 1px solid #000000;
  }

  /* Thumbnail Navigation Buttons - Estilos exatos do main-product */
  .dgf-featured-product-section .product-thumbnail-prev:after,
  .dgf-featured-product-section .product-thumbnail-next:after {
    display: none !important;
  }

  .dgf-featured-product-section .product-thumbnail-prev {
    background: url(https://cdn.shopify.com/s/files/1/0499/0425/5134/files/single-arrow-left.svg) !important;
    transition: .3s ease !important;
    height: 22px !important;
    width: 9px !important;
    background-repeat: no-repeat !important;
    background-size: 100% !important;
    background-position: center !important;
    outline: none !important;
    box-shadow: none !important;
    left: 0px !important;
    margin: 0 !important;
    transform: translate(0px, -50%) !important;
  }

  .dgf-featured-product-section .product-thumbnail-next {
    background: url(https://cdn.shopify.com/s/files/1/0499/0425/5134/files/single-arrow-rgt.svg) !important;
    transition: .3s ease !important;
    height: 22px !important;
    width: 9px !important;
    background-repeat: no-repeat !important;
    background-size: 100% !important;
    background-position: center !important;
    outline: none !important;
    box-shadow: none !important;
    right: 0px !important;
    margin: 0 !important;
    transform: translate(0px, -50%) !important;
  }

  /* Product Details */
  .dgf-product-title {
    font-size: 48px;
    font-weight: 700;
    text-transform: uppercase;
    font-family: HypatiaSansPro;
    margin: 0!important;
  }

  .dgf-product-rating {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .dgf-stars {
    display: flex;
    gap: 2px;
  }

  .dgf-star {
    color: #AC853B;
    font-size: 20px;
  }

  .dgf-rating-text {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Judge.me Integration Styles */
