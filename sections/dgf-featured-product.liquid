                     <clipPath id="clip0_1720_12599">
                     <rect width="21" height="21" fill="white"/>
                     </clipPath>
                     </defs>
                 </svg>
                </span>
                <span>100% money-back guarantee</span>
              </div>
              <div class="dgf-guarantee">
                <span>
                  <svg width="25" height="25" viewBox="0 0 29 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                   <g clip-path="url(#clip0_1720_12606)">
