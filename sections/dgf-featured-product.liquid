                   </g>
                   <defs>
                   <clipPath id="clip0_1720_12606">
                   <rect width="29" height="26" fill="white"/>
                   </clipPath>
                   </defs>
                 </svg>
                </span>
                <span>FREE US shipping over $75</span>
              </div>
            </div>

            <!-- Desktop Guarantees - Only visible on desktop -->
