<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="stress-relief-section">
  <div class="stress-relief-wrapper">
    <div class="container">
      <div class="row stress-relief-content-row">
        <div class="col-lg-12 col-md-12 col-sm-12">
          <div class="stress-content-wrap">
            {{ section.settings.stress_text }}
            <h2 class="main-heading-h2">
              {{ section.settings.stress_title }}
            </h2>
            <a class="custom-button-wrap" href="#custom-product-offers">{{ section.settings.button_text }}</a>
          </div>
        </div>
      </div>
      <div class="row guarantee-logos">
        <ul class="guarantee-logos-lists">
        {% for block in section.blocks %}
          <li>{% if block.settings.the_image != blank %}<img loading="lazy"  src="{{ block.settings.the_image | image_url: width: 2000 }}">{% endif %}</li>
        {% endfor %}
        </ul>
      </div>
      <div class="row cstm-image-text-row">
        {% if section.settings.alignment == 'left' %}
          <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="custom-img-wrap">
              {% if section.settings.the_image != blank %}<img loading="lazy"  src="{{ section.settings.the_image | image_url: width: 2000 }}">{% endif %}
            </div>
          </div>
        {% endif %}
        <div class="col-lg-6 col-md-6 col-sm-12">
          <div class="custom-img--content-wrap">
            <h3>{{ section.settings.img_txt_title }}</h3>
            <p>{{ section.settings.img_txt_text }}</p>
          </div>
        </div>
        {% if section.settings.alignment == 'right' %}
          <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="custom-img-wrap">
              {% if section.settings.the_image != blank %}<img loading="lazy"  src="{{ section.settings.the_image | image_url: width: 2000 }}">{% endif %}
            </div>
          </div>
        {% endif %}
      </div>
      <div class="row tribe-icon-row">
              <div class="tribe-icon-lists">
                <div class="tribe-orgainics-img">
                  {% if section.settings.tribe_image != blank %}<img loading="lazy"  src="{{ section.settings.tribe_image | image_url: width: 2000 }}">{% endif %}
                </div>
                <div class="tribe-icons-wrap">
                  <ul>
                    <li>
                      {% if section.settings.tribe_icon_1 != blank %}<img loading="lazy"  src="{{ section.settings.tribe_icon_1 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ section.settings.icon_text_1 }}</p>
                    </li>
                    <li>
                      {% if section.settings.tribe_icon_2 != blank %}<img loading="lazy"  src="{{ section.settings.tribe_icon_2 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ section.settings.icon_text_2 }}</p>
                    </li>
                    <li>
                      {% if section.settings.tribe_icon_3 != blank %}<img loading="lazy"  src="{{ section.settings.tribe_icon_3 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ section.settings.icon_text_3 }}</p>
                    </li>
                    <li>
                      {% if section.settings.tribe_icon_4 != blank %}<img loading="lazy"  src="{{ section.settings.tribe_icon_4 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ section.settings.icon_text_4 }}</p>
                    </li>
                    <li>
                      {% if section.settings.tribe_icon_5 != blank %}<img loading="lazy"  src="{{ section.settings.tribe_icon_5 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ section.settings.icon_text_5 }}</p>
                    </li>
                    <li>
                      {% if section.settings.tribe_icon_6 != blank %}<img loading="lazy"  src="{{ section.settings.tribe_icon_6 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ section.settings.icon_text_6 }}</p>
                    </li>
                    <li>
                      {% if section.settings.tribe_icon_7 != blank %}<img loading="lazy"  src="{{ section.settings.tribe_icon_7 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ section.settings.icon_text_7 }}</p>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
      <div class="row defend-content-row">
        <div class="col-lg-12 col-md-12 col-sm-12">
          <h2 class="custom-heading-h2">
            {{ section.settings.defend_title }}
          </h2>
          <a class="custom-button-wrap" href="#custom-product-offers">{{ section.settings.defend_button_text }}</a>
          {{ section.settings.the_text }}
          <ul class="stress-reasons-lists">
            <li>{{ section.settings.list_text1 }}</li>
            <li>{{ section.settings.list_text2 }}</li>
            <li>{{ section.settings.list_text3 }}</li>
            <li>{{ section.settings.list_text4 }}</li>
            <li>{{ section.settings.list_text5 }}</li>
          </ul>
        </div>
      </div>
      <div class="row testimonial-row-content">
        <div class="col-lg-12 col-md-12 col-sm-12">
          <div class="testimonial-content-wrap">
            <span class="testimonial-rating">
              <i class="fa fa-star" aria-hidden="true"></i>
              <i class="fa fa-star" aria-hidden="true"></i>
              <i class="fa fa-star" aria-hidden="true"></i>
              <i class="fa fa-star" aria-hidden="true"></i>
              <i class="fa fa-star" aria-hidden="true"></i>
            </span>
            <p>{{ section.settings.rating_text }}</p>
            <h4>{{ section.settings.author_name }}</h4>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
