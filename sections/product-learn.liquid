<section class="section-padding product-learn" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 style="font-family:var(--font-heading-family); font-size:clamp(2.4rem, 3vw, 3.6rem); font-weight:800; text-transform:uppercase; letter-spacing:-0.01em; color:rgb(var(--color-base-text)); margin:0 0 3.2rem; text-align:center;">
        {{ section.settings.title }}
      </h2>
    {%- endif -%}

    {%- if section.settings.blog != blank -%}
      {%- assign blog_obj = blogs[section.settings.blog] -%}
      {%- if blog_obj != blank -%}
        <ul class="grid grid--2-col grid--4-col-desktop" role="list"
            style="--grid-desktop-horizontal-spacing:2rem; --grid-mobile-horizontal-spacing:1.2rem; --grid-desktop-vertical-spacing:0; --grid-mobile-vertical-spacing:0;">
          {%- for article in blog_obj.articles limit: section.settings.posts_to_show -%}
            <li>
              <article style="display:flex; flex-direction:column; gap:1.2rem;">
                {%- if article.image -%}
                  <a href="{{ article.url }}" tabindex="-1">
                    {{
                      article.image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 400, 600',
                        sizes: '(min-width: 990px) 25vw, 50vw',
                        style: 'width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:0.8rem;'
                    }}
                  </a>
                {%- endif -%}
                <div>
                  {%- if article.tags contains 'topic' -%}
                    <span style="font-size:1.1rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:rgb(var(--color-base-accent-1));">{{ article.tags | first }}</span>
                  {%- endif -%}
                  <h3 style="font-family:var(--font-heading-family); font-size:1.6rem; font-weight:700; line-height:1.3; color:rgb(var(--color-base-text)); margin:0.4rem 0;">
                    <a href="{{ article.url }}" style="color:inherit; text-decoration:none;">{{ article.title }}</a>
                  </h3>
                  {%- if article.excerpt != blank -%}
                    <p style="font-size:1.4rem; color:rgba(var(--color-base-text),0.65); line-height:1.5; margin:0;">{{ article.excerpt | strip_html | truncate: 100 }}</p>
                  {%- endif -%}
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product learn articles",
  "tag": "section",
  "class": "section-product-learn",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Learn Something Today"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Posts to show"
    }
  ],
  "presets": [
    {
      "name": "Product learn articles"
    }
  ]
}
{% endschema %}
