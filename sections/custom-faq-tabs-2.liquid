<section id="id-{{section.id}}" class="faq-tabs-wrapper-2">
  <div class="container">
    <div class="row">
      {% if section.settings.title != blank %}
        <div class="col-lg-12 col-md-12 col-sm-12">
          <div class="faq-tab-head">
            <h1>{{ section.settings.title }}</h1>
          </div>
        </div>
      {% endif %}
      <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="custom-faq-tabs">
    		{% if section.settings.tab_heading_1 != blank %}<li class="custom-tab-link current" data-tab="custom-tab-6">{{ section.settings.tab_heading_1 }}</li>{% endif %}
    		{% if section.settings.tab_heading_2 != blank %}<li class="custom-tab-link" data-tab="custom-tab-7">{{ section.settings.tab_heading_2 }}</li>{% endif %}
            {% if section.settings.tab_heading_3 != blank %}<li class="custom-tab-link" data-tab="custom-tab-8">{{ section.settings.tab_heading_3 }}</li>{% endif %}
		</ul>
        <div id="custom-tab-6" class="custom-tab-content current">
          <h6>{{ section.settings.tab_heading_1 }}</h6>
          <div class="custom-tabs">
            {%- for block in section.blocks -%}
            {% if block.type == 'refunds' %}
                <div class="custom-FAQ-tab">
                        <input type="checkbox" id="refunds{{ forloop.index }}">
                        <label class="custom-FAQ-tab-label" for="refunds{{ forloop.index }}">{{ block.settings.faq_qus }}</label>
                        <div class="custom-FAQ-tab-content">
                          {{ block.settings.faq_ans }}
                        </div>
                      </div>	
              {% endif %}
            {%- endfor -%}
          </div>
      </div>
      <div id="custom-tab-7" class="custom-tab-content">
            <h6>{{ section.settings.tab_heading_2 }}</h6>
            <div class="custom-tabs">
              {%- for block in section.blocks -%}
              {% if block.type == 'subscriptions' %}
                  <div class="custom-FAQ-tab">
                          <input type="checkbox" id="subscriptions{{ forloop.index }}">
                          <label class="custom-FAQ-tab-label" for="subscriptions{{ forloop.index }}">{{ block.settings.faq_qus }}</label>
                          <div class="custom-FAQ-tab-content">
                            {{ block.settings.faq_ans }}
                          </div>
                        </div>	
                {% endif %}
              {%- endfor -%}
            </div>
    	</div>
     <div id="custom-tab-8" class="custom-tab-content">
       <h6>{{ section.settings.tab_heading_3 }}</h6>
          <div class="custom-tabs">
            {%- for block in section.blocks -%}
            {% if block.type == 'account' %}
                <div class="custom-FAQ-tab">
                        <input type="checkbox" id="account{{ forloop.index }}">
                        <label class="custom-FAQ-tab-label" for="account{{ forloop.index }}">{{ block.settings.faq_qus }}</label>
                        <div class="custom-FAQ-tab-content">
                          {{ block.settings.faq_ans }}
                        </div>
                      </div>	
              {% endif %}
            {%- endfor -%}
          </div>
    	</div>
      </div>
    </div>
  </div>
</section>
{% comment %} RGD: 2026-01-07 {% endcomment %} 
{% comment %} 
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script> 
{% endcomment %}
{% # theme-check-disable ParserBlockingScript %}
<script type="text/javascript" src="{{ 'jquery-3.5.1.min.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}
<script>
  $(document).ready(function(){
	
	$('.faq-tabs-wrapper-2 .custom-faq-tabs li').click(function(){
		var tab_id = $(this).attr('data-tab');

		$('.faq-tabs-wrapper-2 .custom-faq-tabs li').removeClass('current');
		$('.faq-tabs-wrapper-2 .custom-tab-content').removeClass('current');

		$(this).addClass('current');
		$("#"+tab_id).addClass('current');
	});

});
</script>
