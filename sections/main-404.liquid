<section class="section-banner section-title section-form bg-line-02">
<!--      <div class="leaf-box left-top">
        <img loading="lazy"  class="leaf" src="{{ 'leaf-n05.svg' | asset_url }}" style="margin-top: 120px">
    </div> -->
    <div class="leaf-box right-top">
        <img loading="lazy"  class="leaf" src="{{ 'leaf-n02.svg' | asset_url }}">
    </div>
    <div class="content">
        <div class="container">
            <h2 class="text-uppercase" data-aos="fade-up">{{ 'templates.404.title' | t }}</h2>
            <div class="subtitle mw-700" data-aos="fade-up" data-aos-delay="200">
                {{ 'templates.404.subtext' | t }}
            </div>
            <form action="{{ routes.search_url }}" method="get" role="search" class="form">
                <div class="form-group" data-aos="fade-up">
                    <div class="d-flex input-search">
                        <button type="submit" class=""><i class="fa fa-search"></i></button>
                        <input class="form-default" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.search' | t }}">
                    </div>
                </div>
                <div class="form-group" data-aos="fade-up">
                    Or
                </div>
                <div class="form-group last" data-aos="fade-up">
                    <a href="{{ routes.all_products_collection_url }}" class="btn btn-bg-full">{{ 'general.continue_shopping' | t }}</a>
                </div>
            </form>
        </div>
    </div>
</section>