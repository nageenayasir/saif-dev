<style>
  {% if section.settings.background_the_image != blank %}
 	#id-{{ section.id }}{
        background-image:url("{{section.settings.background_the_image | image_url: width: 2000}}");
        background-repeat: no-repeat;
        background-size: cover;
  	}
  {% endif %}
  
</style>
<section id="id-{{section.id}}" class="reason-banner-section reason-footer-banner-section">
  <div class="reason-banner-wrapper">
    <div class="container">
      <div class="row">
        <div class="reason-site-logo-left-column">
          <div class="reason-site-logo">
            {% if section.settings.site_logo_image != blank %}<img loading="lazy"  src="{{ section.settings.site_logo_image | image_url: width: 2000 }}">{% endif %}
          </div>
        </div>
        <div class="reason-text-center-column">
          {% if section.settings.the_title != blank %}<h1>{{ section.settings.the_title }}</h1>{% endif %}
        </div>
        <div class="reason-logos-right-column">
          <ul>
            <li>
            {% if section.settings.logo_image_1 != blank %}<img loading="lazy"  src="{{ section.settings.logo_image_1 | image_url: width: 2000 }}">{% endif %}
            </li>
            <li>
            {% if section.settings.logo_image_2 != blank %}<img loading="lazy"  src="{{ section.settings.logo_image_2 | image_url: width: 2000 }}">{% endif %}
            </li>
            <li>
            {% if section.settings.logo_image_3 != blank %}<img loading="lazy"  src="{{ section.settings.logo_image_3 | image_url: width: 2000 }}">{% endif %}
            </li>
            <li>
            {% if section.settings.logo_image_4 != blank %}<img loading="lazy"  src="{{ section.settings.logo_image_4 | image_url: width: 2000 }}">{% endif %}
            </li>
          </ul>
        </div>  
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Reason Footer Banner",
    "settings": [
        {
          "type": "image_picker",
          "id": "background_the_image",
          "label": "Background-Image"
      	 },
         {
          "type": "header",
          "content": "Content Settings"
        },
        {
          "type": "image_picker",
          "id": "site_logo_image",
          "label": "Site Logo Image"
      	},
        {
          "type": "text",
          "id": "the_title",
          "label": "Title"
      	},
        {
          "type": "header",
          "content": "Logo Settings"
        },
        {
          "type": "image_picker",
          "id": "logo_image_1",
          "label": "Logo Image-1"
      	},
        {
          "type": "image_picker",
          "id": "logo_image_2",
          "label": "Logo Image-2"
      	},
        {
          "type": "image_picker",
          "id": "logo_image_3",
          "label": "Logo Image-3"
      	},
        {
          "type": "image_picker",
          "id": "logo_image_4",
          "label": "Logo Image-4"
      	}
    ],
	"presets": [{
      "name": "Reason Footer Banner"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}