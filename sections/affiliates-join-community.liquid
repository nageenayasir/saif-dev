<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{ section.id }}" class="affiliates-join-community">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 col-md-12 col-sm-12">
        <div class="affiliates-join-community-wrappper">
          <div class="affiliates-join-community-blocks">
            <h2 >{{ section.settings.title }}</h2>
            {{ section.settings.the_text }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Affiliates Join Community",
    "settings": [
        {
            "type": "header",
              "content": "Content Style"
        },
    	  {
             "type": "color",
             "id": "section_bg_color",
             "label": "Section background color"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "the_text",
          "label": "Text"
        }
    ],
	"presets": [{
      "name": "Affiliates Join Community"
    }]
  }
{% endschema %}