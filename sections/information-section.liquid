<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="information-section">
  <div class="information-section-wrapper">
    <div class="container">
      {% comment %}
      <div class="row information-img-row">
        {% for block in section.blocks %}
          <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="information-img-lists">
              {% if block.settings.the_image != blank %}<img loading="lazy"  src="{{ block.settings.the_image | image_url: width: 2000 }}">{% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% endcomment %}
      <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12">
          <div class="infromation-text">
            {{ section.settings.the_text }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Information Section",
    "settings": [
         {
            "type": "header",
            "content": "Content Style"
         },
  	     {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
        },
        {
            "type": "richtext",
            "id": "the_text",
            "label": "Text"
         }
    ],
	"blocks": [
    	{
              "type": "two_blocks",
              "name": "Two Blocks",
              "settings": [
                    {
                        "type": "header",
                        "content": "Block Items Content"
                     },
                    {
                       "type": "image_picker",
                       "id": "the_image",
                       "label": "Image"
                    }
                    
                ]
        }
	],
    "presets": [{
      "name": "Information Section"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}