{{ 'section-collection.css' | asset_url | stylesheet_tag }}

<div class="collection-page" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <!-- Collection Header -->
    <div class="collection-header">
      {%- if collection.image -%}
        <div style="margin-bottom:2.4rem; border-radius:1.2rem; overflow:hidden; aspect-ratio:21/6; max-height:32rem;">
          {{
            collection.image
            | image_url: width: 1920
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1920',
              sizes: '100vw',
              style: 'width:100%;height:100%;object-fit:cover;object-position:center;'
          }}
        </div>
      {%- endif -%}
      <h1 class="collection-header__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-header__desc">{{ collection.description }}</div>
      {%- endif -%}
      <p class="collection-header__count">{{ collection.products_count }} products</p>
    </div>

    <!-- Toolbar -->
    <div class="collection-toolbar">
      <!-- Filter tags -->
      <div class="collection-toolbar__filters" role="navigation" aria-label="Filter products">
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'list' -%}
            {%- for filter_value in filter.values -%}
              <a href="{{ filter_value.url_to_add }}"
                class="filter-tag {% if filter_value.active %}is-active{% endif %}"
                aria-label="{{ filter.label }}: {{ filter_value.label }}{% if filter_value.active %} (active){% endif %}">
                {{ filter_value.label }}
                {%- if filter_value.count > 0 -%}
                  <span style="opacity:0.55; font-size:1.1rem;">({{ filter_value.count }})</span>
                {%- endif -%}
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if collection.filters != empty -%}
          {%- assign active_filters_count = 0 -%}
          {%- for filter in collection.filters -%}
            {%- assign active_filters_count = active_filters_count | plus: filter.active_values.size -%}
          {%- endfor -%}
          {%- if active_filters_count > 0 -%}
            <a href="{{ collection.url }}" class="filter-tag" style="border-color:rgba(var(--color-base-text),0.5);">
              Clear all ({{ active_filters_count }})
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>

      <!-- Sort -->
      <div style="display:flex; align-items:center; gap:0.8rem;">
        <label for="SortBy-{{ section.id }}" style="font-size:1.3rem; color:rgba(var(--color-base-text),0.6); white-space:nowrap;">Sort by:</label>
        <select name="sort_by" id="SortBy-{{ section.id }}" class="sort-select"
          aria-label="Sort products by">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size == 0 -%}
        <div style="text-align:center; padding:8rem 0;">
          <h2 style="font-size:2.4rem; color:rgb(var(--color-base-text)); margin:0 0 1rem;">No products found</h2>
          <p style="color:rgba(var(--color-base-text),0.6);">Try adjusting your filters or <a href="{{ collection.url }}">clear all filters</a>.</p>
        </div>
      {%- else -%}
        <ul class="collection-grid" role="list">
          {%- for product in collection.products -%}
            <li>
              {%- render 'product-card', product: product -%}
            </li>
          {%- endfor -%}
        </ul>

        <!-- Pagination -->
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="Previous page">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 13L5 8l5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </a>
            {%- else -%}
              <span class="pagination__item pagination__item--disabled" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 13L5 8l5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="pagination__item">{{ part.title }}</a>
              {%- elsif part.title == '...' -%}
                <span class="pagination__item pagination__item--ellipsis" style="border:none; pointer-events:none;">…</span>
              {%- else -%}
                <span class="pagination__item is-current" aria-current="page" aria-label="Page {{ part.title }}">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="Next page">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </a>
            {%- else -%}
              <span class="pagination__item pagination__item--disabled" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<script>
(function() {
  var sortSelect = document.getElementById('SortBy-{{ section.id }}');
  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', this.value);
      window.location.href = url.toString();
    });
  }
})();
</script>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    }
  ],
  "presets": [
    {
      "name": "Collection"
    }
  ]
}
{% endschema %}
