<style>
  .product-certified-icon img {
    width: 70px;
}
.one-time-price-wrap {
    display: none;
}
.display-one-time-price {
    display: inline-block;
}
.hide-subscribe-price {
    display: none;
}
.product-triibe-organics-gift-card-25 .one-time-price-wrap {
    display: inline-block;
}
.product-triibe-organics-gift-card-25 .subscribe-price-wrap {
    display: none;
}

/* Sticky CTA Mobile */
.sticky-cta-clone {
  position: fixed !important;
  top: auto !important;
  bottom: 0 !important;
  left: 0 !important;
  right: 0 !important;
  width: 100vw !important;
  max-width: 100vw !important;
  z-index: 999999 !important;
  padding: 0 !important;
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15) !important;
  margin: 0 !important;
  visibility: visible !important;
  opacity: 1 !important;
  display: block !important;
  transform: translateY(0) !important;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
              box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.sticky-cta-clone.hidden {
  transform: translateY(120%) !important;
  opacity: 0 !important;
  pointer-events: none !important;
  box-shadow: 0 0 0 rgba(0, 0, 0, 0) !important;
}

@media (min-width: 768px) {
  .sticky-cta-clone {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
}

.sticky-cta-clone * {
  visibility: visible !important;
  opacity: 1 !important;
}

.sticky-cta-clone .product-form__buttons {
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
  max-width: 100% !important;
}

.sticky-cta-clone .box-button {
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
  max-width: 100% !important;
}

.sticky-cta-clone .add-to-cart-block,
.sticky-cta-clone .klaviyo-button-block {
  width: 100% !important;
  max-width: 100% !important;
  padding: 0 !important;
  margin: 0 !important;
}

.sticky-cta-clone button,
.sticky-cta-clone .btn {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 !important;
  border-radius: 0 !important;
  font-size: 15px !important;
}
</style>
{% assign discount = 0 %}
{% assign discount_percentage = 0 %}
{% for selling_plan_group in product.selling_plan_groups %}
  {% for plan in selling_plan_group.selling_plans %}
    {% assign discount = 100 | minus: plan.price_adjustments[0].value | divided_by: 100.0 %}
    {% assign discount_percentage = plan.price_adjustments[0].value %}
    {% break %}
  {% endfor %}
{% endfor %}
<section class="product-content section-{{ section.id }}-padding" data-section="{{ section.id }}" id="MainProduct-{{ section.id }}">
    {{ 'component-price.css' | asset_url | stylesheet_tag }}
    {{ 'component-rte.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    <div class="top-leaf-box-right leaf-box right-top d-none d-md-block">
        <img class="leaf" src="{{ 'side-leaf.svg' | asset_url }}">
    </div>

    <div class="bgp2"></div>
  <div class="tribe-product-page-wrapper">
      <div class="product-page-container container">
          <div class="product-page-row-wrap">
              <div class="col-md-6">
                  <div class="featured-image d-none d-md-block">
                    <div class="product-images">
                    <div class="product__photo" data-aos="fade-up">
                      <img src="{{ product.images[1] | img_url: 'master' }}" class="main-image" >
                    </div>
                      <div class="product__thumbnails thumbnails" data-aos="fade-up">
                        {% for image in product.images %}
                          {% if forloop.index != 1 %}
                          <div class="product__thumbnail" data-image-index="{{ forloop.index }}">
                            <img src="{{ image | img_url: 'master' }}" alt="{{ image.alt }}">
                          </div>
                          {% endif %}
                        {% endfor %}
                     </div>
                    </div>
                  {% comment %}
                    {%- for media in product.media -%} 
                      {% if forloop.index != 1 %}
                        <div class="parallax-window" data-parallax="scroll" data-speed="0.8" data-bleed="10" data-image-src="{{ media | image_url : width : 1024 }}"></div>
                      {% endif %}
                    {%- endfor -%}   
                    {% endcomment %}
                  </div>
                  <div class="featured-image mobile-product-slider">
                      <div class="swiper-wrapper-box">
                          <div class="swiper product-slider d-block d-md-none">
                              <div class="swiper-wrapper">
                                {%- for media in product.media -%} 
                                  {% if forloop.index != 1 %}
                                    <div class="swiper-slide">
                                        <img src="{{ media | img_url : 'master' }}" alt="{{ product.title }}">
                                    </div>
                                  {% endif %}
                                {%- endfor -%}   
                              </div>
                              <div class="swiper-pagination"></div>
                          </div>
                      </div>
                  </div>
              </div>
                <div class="col-md-6 details-box position-md-fixed pt-3 pt-md-0" data-aos="fade-up">
                    <div class="product-content-details">
                        <div class="product-details ps-xl-4">
                          {%- assign product_form_id = 'product-form-' | append: section.id -%}
                           {%- for block in section.blocks -%}
                             {%- case block.type -%}
                            {%- when '@app' -%}
                              {% render block %}
                            {%- when 'custom_liquid' -%}
                              {{ block.settings.custom_liquid }}
                            {%- when 'custom_html' -%}
                              {{ block.settings.custom_html }}     
                            {%- when 'title' -%}
                            <h1 class="text-uppercase mb-2" {{ block.shopify_attributes }}>
                              {% if product.metafields.custom.custom_product_title != blank %}
                                {{ product.metafields.custom.custom_product_title }}
                              {% else %}
                              {{ product.title }}
                                {% endif %}
                            </h1>
                            {%- when 'category' -%}
                               {% if product.metafields.custom.custom_product_badges %}
                                 {% for title in product.metafields.custom.custom_product_badges.value %}
                                  <span class="category">{{ title }}</span>
                                {% endfor %}
                              {% else %}
                                {% for collection in product.collections reversed %}
                                  {% if forloop.index < 3 %}
                                    <a href="{{ collection.url }}" class="category" {{ block.shopify_attributes }}>{{ collection.title }}</a> 
                                  {% endif %}
                                {% endfor %}
                            {% endif %}
                                
                            {%- when 'price' -%}
                                  <div class="no-js-hidden" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }} style="display: none;">
                                    {%- render 'price', product: product, use_variant: true, show_badges: false, price_class: 'price--large' -%}
                                  </div>
                               {% if section.settings.show_tax %}
                                  {%- if shop.taxes_included or shop.shipping_policy.body != blank -%}
                                    <div class="product__tax caption rte">
                                      {%- if shop.taxes_included -%}
                                        {{ 'products.product.include_taxes' | t }}
                                      {%- endif -%}
                                      {%- if shop.shipping_policy.body != blank -%}
                                        {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                                      {%- endif -%}
                                    </div>
                                  {%- endif -%}
                                {% endif %}
                               <div {{ block.shopify_attributes }}>
                                  {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                                  {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                                    {{ form | payment_terms }}
                                  {%- endform -%}
                                </div>
                            {%- when 'quantity_selector' -%}
                              <div class="d-flex align-items-center mt-3 mb-3 product-quantity-wrap" {{ block.shopify_attributes }}>
                                  <div class="p-quantity">
                                      <input type='button' value='-' class="qtyminus minus" field='quantity'/>
                                      <input id="Quantity-{{ section.id }}" form="{{ product_form_id }}" type='text' name="quantity" min="1" value='1' class='qty input-quantity'/>
                                      <input type='button' value='+' class='qtyplus plus' field='quantity'/>
                                  </div>
                                  <span >{{ block.settings.text }}</span>
                              </div>
                            {%- when 'variant_picker' -%}
                                {% if product.tags contains 'bundle' %}
                                  {% render 'dgf_bundles_crd' %}
                                {% elsif product.selling_plan_groups.size > 0 %}
                                  {% render 'dgf_subscription_wdg' %}
                                {% else %}
                                  <div class="container" {{ block.shopify_attributes }}>
                                    {%- unless product.has_only_default_variant -%}
                                      {%- if block.settings.picker_type == 'button' -%}
                                        <variant-radios class="no-js-hidden default-prdct-variants" data-section="{{ section.id }}" data-url="{{ product.url }}" {{ block.shopify_attributes }}>
                                          {%- for option in product.options_with_values -%}
                                              <fieldset class="js product-form__input">
                                                {% assign current_variant = product.selected_or_first_available_variant %}
                                                {%- for value in option.values -%}
                                                  {% if value != 'Default Title' %}
                                                      <div class="col-6 col-sm-4 mt-3">
                                                          <label class="button-radio" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" id="label-{{ value | escape }}">
                                                              <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                                                    name="{{ option.name }}"
                                                                    value="{{ value | escape }}"
                                                                    form="{{ product_form_id }}"
                                                                    {% if option.selected_value == value %}checked{% endif %}
                                                              >
                                                              <span class="radio-bg">
                                                              <span class="varaint-wrap">{{ value  }} {% if value == '3-Pack' %} <span>Save 10%</span>{% elsif value == '4-Pack' %}<span>Save 12%</span>{% endif %}</span>
                                                            </span>
                                                          </label>
                                                      </div>
                                                  {% endif %}
                                                {%- endfor -%}
                                              </fieldset>
                                          {%- endfor -%}
                                          <script type="application/json">
                                            {{ product.variants | json }}
                                          </script>
                                        </variant-radios>
                                      {%- else -%}
                                        <variant-selects class="no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}" {{ block.shopify_attributes }}>
                                          {%- for option in product.options_with_values -%}
                                            <div class="product-form__input product-form__input--dropdown">
                                              <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                                                {{ option.name }}
                                              </label>
                                              <div class="select">
                                                <select id="Option-{{ section.id }}-{{ forloop.index0 }}"
                                                  class="select__select"
                                                  name="options[{{ option.name | escape }}]"
                                                  form="{{ product_form_id }}"
                                                >
                                                  {%- for value in option.values -%}
                                                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                                                      {{ value }}
                                                    </option>
                                                  {%- endfor -%}
                                                </select>
                                                {% render 'icon-caret' %}
                                              </div>
                                            </div>
                                          {%- endfor -%}
                        
                                          <script type="application/json">
                                            {{ product.variants | json }}
                                          </script>
                                        </variant-selects>
                                      {%- endif -%}
                                    {%- endunless -%}
                        
                                    <noscript class="product-form__noscript-wrapper-{{ section.id }}">
                                      <div class="product-form__input{% if product.has_only_default_variant %} hidden{% endif %}">
                                        <label class="form__label" for="Variants-{{ section.id }}">{{ 'products.product.product_variants' | t }}</label>
                                        <div class="select">
                                          <select name="id" id="Variants-{{ section.id }}" class="select__select" form="{{ product_form_id }}">
                                            {%- for variant in product.variants -%}
                                              <option
                                                {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}
                                                {% if variant.available == false %}disabled{% endif %}
                                                value="{{ variant.id }}"
                                              >
                                                {{ variant.title }}
                                                {%- if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                                                - {{ variant.price | money | strip_html }}
                                              </option>
                                            {%- endfor -%}
                                          </select>
                                          {% render 'icon-caret' %}
                                        </div>
                                      </div>
                                    </noscript>
                                    
                                  </div>
                                 {% endif %}
                          
                           {%- when 'buy_buttons' -%} 
                          <div {{ block.shopify_attributes }} class="cart-btn-wrap">
                             <product-form class="product-form">
                        
      
                                  {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
                                    <input type="hidden" class="selling-plan-id" name="selling_plan" value="{% for selling_plan_group in product.selling_plan_groups %}{% for plan in selling_plan_group.selling_plans %}{% if forloop.last == true %}{{ plan.id }}{% endif %}{% endfor %}{% endfor %}" disabled>
                                    <div class="product-form__buttons box-button">
                                      <button
                                        type="button"
                                        name="add"
                                        class="subscription-addtocart btn btn-bg btn-bg-full mt-4 mb-4" {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                                      >
                                          <span>
                                              {%- if product.selected_or_first_available_variant.available -%}
                                                {{ 'products.product.add_to_cart' | t }}
                                              {%- else -%}
                                                {{ 'products.product.sold_out' | t }}
                                              {%- endif -%}
                                            </span>
                                        {% if product.selected_or_first_available_variant.available %}
                                          <span id="suscribe-price-button-{{ section.id }}" class="subscribe-price-wrap">
                                            | {{ product.selected_or_first_available_variant.price | times: discount | money }}
                                          </span>
                                        {% endif %}
                                        {% if product.selected_or_first_available_variant.available %}
                                          <span id="price-button-{{ section.id }}" class="one-time-price-wrap">
                                            | {{ product.selected_or_first_available_variant.price | money }}
                                          </span>
                                        {% endif %}
                                      </button>
                                      {%- if block.settings.show_dynamic_checkout -%}
                                        {{ form | payment_button }}
                                      {%- endif -%}
                                    </div>
                                    
                                  {%- endform -%}
                                </product-form>
                            
                          </div>
                           <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
                            {%- when 'social' -%}  
                              <div class="d-md-flex justify-content-center mt-4 share-box d-none">
                                  <span>{{ block.settings.title }}</span>
                                  <a href="//www.facebook.com/sharer.php?u={{ shop.url | append: share_permalink }}" target="_blank"><i class="fab fa-facebook-f"></i> </a>
                                  <a href="//pinterest.com/pin/create/button/?url={{ shop.url | append: share_permalink }}&amp;media={{ share_image | img_url: '1024x1024' }}&amp;description={{ share_title | url_param_escape }}" target="_blank"><i class="fab fa-pinterest-p"></i> </a>
                              </div>
                            {%- when 'icon' -%} 
                            <div class="d-flex mt-4" {{ block.shopify_attributes }}>
                              {% assign icons =  product.metafields.custom.icon.value  %}
                               {% assign titles =  product.metafields.custom.title_icon.value  %}
                              {% for icon in icons %}
                                <div class="iconp-item">
                                    <img src="{{ icon | image_url: width: 500 }}" alt="{{ titles[forloop.index0] }}">
                                    <span>{{ titles[forloop.index0] }}</span>
                                </div>
                              {% endfor %}
                            </div>
                            {%- when 'custom_icon' -%}
                             <div class="product-custom-icons-wrap">
                               <ul class="custom-prdct-icons-lists">
                                 <li>
                                   <span>
                                     {% if block.settings.icon_1 != blank %}
                                       <img src="{{ block.settings.icon_1 | img_url: 'master' }}">
                                     {% elsif  block.settings.face_svg %}
                                       <svg width="29" height="26" viewBox="0 0 29 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                                          <g clip-path="url(#clip0_1720_12599)">
