<script>
  // Sticky CTA functionality for mobile
  (function() {
    'use strict';

    try {
      document.addEventListener('DOMContentLoaded', function() {
        try {
          if (window.innerWidth > 767) return;

          const cartBtnWrap = document.querySelector('.cart-btn-wrap');
          if (!cartBtnWrap) return;

          let originalOffset = null;
          let originalHeight = null;
          let isSticky = false;
          let stickyClone = null;

          function calculateOffset() {
            try {
              if (!isSticky && cartBtnWrap) {
                const rect = cartBtnWrap.getBoundingClientRect();
                originalOffset = rect.top + window.pageYOffset;
                originalHeight = rect.height;
              }
            } catch (e) {
              // Silent fail
            }
          }

          function createStickyClone() {
            try {
              if (!cartBtnWrap) return null;

              stickyClone = cartBtnWrap.cloneNode(true);
              stickyClone.classList.add('sticky-cta-clone', 'hidden');

              // Remove IDs to avoid duplicates
              stickyClone.querySelectorAll('[id]').forEach(function(el) {
                try {
                  el.removeAttribute('id');
                } catch (e) {
                  // Silent fail
                }
              });

              // Append to body
              if (document.body) {
                document.body.appendChild(stickyClone);
              }

              // Copy event listeners for add to cart button
              try {
                const originalBtn = cartBtnWrap.querySelector('.subscription-addtocartMine');
                const cloneBtn = stickyClone.querySelector('.subscription-addtocartMine');

                if (originalBtn && cloneBtn) {
                  cloneBtn.addEventListener('click', function() {
                    try {
                      originalBtn.click();
                    } catch (e) {
                      // Silent fail
                    }
                  });
                }
              } catch (e) {
                // Silent fail
              }

              return stickyClone;
            } catch (e) {
              return null;
            }
          }

          function handleScroll() {
            try {
              if (originalOffset === null) {
                calculateOffset();
                return;
              }

              const scrollTop = window.pageYOffset;
              const windowHeight = window.innerHeight;
              const ctaTop = originalOffset;
              const ctaBottom = ctaTop + originalHeight;

              // Check if CTA is in viewport
              const ctaInViewport = ctaTop <= (scrollTop + windowHeight) && ctaBottom >= scrollTop;
              const shouldBeSticky = !ctaInViewport;

              if (shouldBeSticky && !isSticky) {
                try {
                  if (!stickyClone) {
                    stickyClone = createStickyClone();
                  }
                  if (stickyClone) {
                    stickyClone.classList.remove('hidden');
                  }
                  isSticky = true;
                } catch (e) {
                  // Silent fail
                }
              } else if (!shouldBeSticky && isSticky) {
                try {
                  if (stickyClone) {
                    stickyClone.classList.add('hidden');
                  }
                  isSticky = false;
                } catch (e) {
                  // Silent fail
                }
              }
            } catch (e) {
              // Silent fail
            }
          }

          // Initial calculation
          try {
            setTimeout(calculateOffset, 500);
          } catch (e) {
            // Silent fail
          }

          // Handle scroll with throttle
          try {
            let scrollTimeout;
            window.addEventListener('scroll', function() {
              try {
                if (scrollTimeout) {
                  window.cancelAnimationFrame(scrollTimeout);
                }
                scrollTimeout = window.requestAnimationFrame(handleScroll);
              } catch (e) {
                // Silent fail
              }
            });
          } catch (e) {
            // Silent fail
          }

          // Recalculate on resize
          try {
            let resizeTimeout;
            window.addEventListener('resize', function() {
              try {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(function() {
                  try {
                    if (window.innerWidth <= 767) {
                      // Mobile: recalculate position
                      originalOffset = null;
                      isSticky = false;
                      if (stickyClone) {
                        stickyClone.classList.add('hidden');
                      }
                      setTimeout(calculateOffset, 100);
                    } else {
                      // Desktop: completely remove sticky clone
                      if (stickyClone) {
                        stickyClone.classList.add('hidden');
                        try {
                          if (stickyClone.parentNode) {
                            stickyClone.parentNode.removeChild(stickyClone);
                          }
                        } catch (e) {
                          // Silent fail
                        }
                        stickyClone = null;
                      }
                      isSticky = false;
                      originalOffset = null;
                    }
                  } catch (e) {
                    // Silent fail
                  }
                }, 250);
              } catch (e) {
                // Silent fail
              }
            });
          } catch (e) {
            // Silent fail
          }
        } catch (e) {
          // Silent fail
        }
      });
    } catch (e) {
      // Silent fail
    }
  })();
</script>

