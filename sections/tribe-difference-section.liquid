<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="tribe-difference-section {{ section.settings.add_class }}">
  <div class="tribe-difference-wrapper">
    <div class="container">
      <div class="row tribe-difference-head-img-row">
        <div class="col-lg-12 col-md-12 col-sm-12">
          <div class="tribe-difference-head-img">
            {% if section.settings.main_image != blank %}<img loading="lazy" src="{{ section.settings.main_image | img_url: 'master' }}" style=" aspect-ratio: auto;">{% endif %}
          </div>
        </div>
      </div>
      <div class="row tribe-diffence-img-row">
        <ul class="tribe-difference-img">
          <li>{% if section.settings.image_1 != blank %}<img loading="lazy" src="{{ section.settings.image_1 | img_url: 'master' }}">{% endif %}</li>
          <li>{% if section.settings.image_2 != blank %}<img loading="lazy" src="{{ section.settings.image_2 | img_url: 'master' }}">{% endif %}</li>
          <li>{% if section.settings.image_3 != blank %}<img loading="lazy" src="{{ section.settings.image_3 | img_url: 'master' }}">{% endif %}</li>
          <li>{% if section.settings.image_4 != blank %}<img loading="lazy" src="{{ section.settings.image_4 | img_url: 'master' }}">{% endif %}</li>
          <li>{% if section.settings.image_5 != blank %}<img loading="lazy" src="{{ section.settings.image_5 | img_url: 'master' }}">{% endif %}</li>
        </ul>
      </div>
      <div class="row tribe-difference-blocks-row">
        {% for block in section.blocks %}
          <div class="col-lg-4 col-md-4 col-sm-12">
            <div class="tribe-difference-three-blocks">
              <ul>
                {% if block.settings.list_text_1 != blank %}
                  <li>
                    {% if block.settings.leaf_image != blank %}<img loading="lazy" src="{{ block.settings.leaf_image | img_url: 'master' }}">{% endif %}
                    <p>{{ block.settings.list_text_1 }}</p>
                   </li>
                {% endif %}
                {% if block.settings.list_text_2 != blank %}
                  <li>
                    {% if block.settings.leaf_image != blank %}<img loading="lazy" src="{{ block.settings.leaf_image | img_url: 'master' }}">{% endif %}
                    <p>{{ block.settings.list_text_2 }}</p>
                   </li>
                {% endif %}
                {% if block.settings.list_text_3 != blank %}
                  <li>
                    {% if block.settings.leaf_image != blank %}<img loading="lazy" src="{{ block.settings.leaf_image | img_url: 'master' }}">{% endif %}
                    <p>{{ block.settings.list_text_3 }}</p>
                   </li>
                {% endif %}
                {% if block.settings.list_text_4 != blank %}
                  <li>
                    {% if block.settings.leaf_image != blank %}<img loading="lazy" src="{{ block.settings.leaf_image | img_url: 'master' }}">{% endif %}
                    <p>{{ block.settings.list_text_4 }}</p>
                   </li>
                {% endif %}
                {% if block.settings.list_text_5 != blank %}
                  <li>
                    {% if block.settings.leaf_image != blank %}<img loading="lazy" src="{{ block.settings.leaf_image | img_url: 'master' }}">{% endif %}
                    <p>{{ block.settings.list_text_5 }}</p>
                   </li>
                {% endif %}
                {% if block.settings.list_text_6 != blank %}
                  <li>
                    {% if block.settings.leaf_image != blank %}<img loading="lazy" src="{{ block.settings.leaf_image | img_url: 'master' }}">{% endif %}
                    <p>{{ block.settings.list_text_6 }}</p>
                   </li>
                {% endif %}
                {% if block.settings.list_text_7 != blank %}
                  <li>
                    {% if block.settings.leaf_image != blank %}<img loading="lazy" src="{{ block.settings.leaf_image | img_url: 'master' }}">{% endif %}
                    <p>{{ block.settings.list_text_7 }}</p>
                   </li>
                {% endif %}
              </ul>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Tribe Difference",
    "settings": [
         {
            "type": "text",
            "id": "add_class",
            "label": "Add Class On Main Section"
         },
         {
            "type": "header",
            "content": "Content Style"
         },
  	     {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
        },
        {
           "type": "image_picker",
           "id": "main_image",
           "label": "Main Image"
         },
         {
            "type": "image_picker",
            "id": "image_1",
            "label": "Image-1"
         },
         {
            "type": "image_picker",
            "id": "image_2",
            "label": "Image-2"
         },
         {
            "type": "image_picker",
            "id": "image_3",
            "label": "Image-3"
         },
         {
            "type": "image_picker",
            "id": "image_4",
            "label": "Image-4"
         },
         {
            "type": "image_picker",
            "id": "image_5",
            "label": "Image-5"
         }
    ],
	"blocks": [
    	{
              "type": "three_blocks",
              "name": "Three Blocks",
              "settings": [
                    {
                        "type": "header",
                        "content": "Block Items Content"
                     },
                    {
                       "type": "image_picker",
                       "id": "leaf_image",
                       "label": "Leaf Image"
                    },
                    {
                      "type": "text",
                      "id": "list_text_1",
                      "label": "List text-1"
                  	},
                    {
                      "type": "text",
                      "id": "list_text_2",
                      "label": "List text-2"
                  	},
                    {
                      "type": "text",
                      "id": "list_text_3",
                      "label": "List text-3"
                  	},
                    {
                      "type": "text",
                      "id": "list_text_4",
                      "label": "List text-4"
                  	},
                    {
                      "type": "text",
                      "id": "list_text_5",
                      "label": "List text-5"
                  	},
                    {
                      "type": "text",
                      "id": "list_text_6",
                      "label": "List text-6"
                  	},
                    {
                      "type": "text",
                      "id": "list_text_7",
                      "label": "List text-7"
                  	}
                    
                ]
        }
	],
    "presets": [{
      "name": "Tribe Difference"
    }]
  }
{% endschema %}

