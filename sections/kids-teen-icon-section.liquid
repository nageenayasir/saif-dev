<style>
      {% if section.settings.background_the_image != blank %}
            #id-{{section.id}}{
                background-image:url("{{section.settings.background_the_image | img_url: 'master'}}");
            }
      {% endif %}
      {% if section.settings.bg_mob_image !=blank %}
        @media only screen and (max-width: 767px){
          #id-{{section.id}} {
             background-image: url({{ section.settings.bg_mob_image | img_url: 'master'}}) !important;
          }
        }
      {% endif %}
</style>
<section id="id-{{section.id}}" class="kids-teen-page-icon-section">
  <div class="eagle-image eagle-left-top">
          <img loading="lazy"  class="eagle-leaf" src="{{ 'Eagle.svg' | asset_url }}">
   </div>
  <div class="container">
    <div class="row">
      <div class="col-sm-12 col-md-12 col-lg-12 kids-teen-page-icon-full-column">
        <ul class="kids-teen-page-icon--wrapper" data-aos="fade-up">
          {% for block in section.blocks %}
            <li>
              {% if block.settings.logo != blank %}<img loading="lazy"  src="{{ block.settings.logo | img_url: 'master' }}">{% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Kids Teen Icon Section",
    "settings": [
      {
          "type": "image_picker",
          "id": "background_the_image",
          "label": "Background-Image"
      	},
        {
          "type": "image_picker",
          "id": "bg_mob_image",
          "label": "Background Mobile Image"
        }
    ],
    "blocks": [
     {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
     }
	],
	"presets": [{
      "name": "Kids Teen Icon Section"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}