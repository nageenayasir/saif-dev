<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
  .teenager-product-img-text-wrap {
    text-align: center;
}
</style>
<section id="id-{{section.id}}" class="kids-teenager-product-section common-kids-teenager-section">
  <div class="kids-teenager-product-wrapper">
    <div class="leaf-box kids-teenager-product-box-left-top left-top">
        <img loading="lazy"  class="leaf kids-teenager-product-left-top" src="{{ 'side-character.svg' | asset_url }}">
    </div>
    <div class="leaf-box kids-teenager-product-box-right-top right-top">
        <img loading="lazy"  class="leaf kids-teenager-product-right-top" src="{{ 'page-elephant.svg' | asset_url }}">
    </div>
    <div class="container">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
          <div class="teenager-product-img-text-wrap">
            <div class="kids-teenager-product-img" data-aos="fade-up">
              <a href="{{ section.settings.button_url }}">
                {% if section.settings.the_image != blank %}<img loading="lazy"  src="{{ section.settings.the_image | image_url: width: 2000 }}" class="web-kids-teenager-product-img">{% endif %}
                {% if section.settings.mob_image != blank %}<img loading="lazy"  src="{{ section.settings.mob_image | image_url: width: 2000 }}" class="mob-kids-teenager-product-img">{% endif %}
              </a>
            </div>
            <div class="kids-teenager-product-btn-wrap" data-aos="fade-up">
              <a href="{{ section.settings.button_url }}">{{ section.settings.button_text }}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Kids Teenager Product",
    "settings": [
      {
            "type": "header",
            "content": "Content Style"
      },
  	  {
           "type": "color",
           "id": "section_bg_color",
           "label": "Section background color"
      },
      {
            "type": "header",
            "content": "Content Settings"
      },
      {
            "type": "image_picker",
            "id": "the_image",
            "label": "Image"
      },
      {
            "type": "image_picker",
            "id": "mob_image",
            "label": "Mobile Image"
      },
      {
          "type": "text",
          "id": "button_text",
          "label": "Text"
      },
      {
          "type": "url",
          "id": "button_url",
          "label": "Url"
      }
    ],
	"presets": [{
      "name": "Kids Teenager Product"
    }]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}