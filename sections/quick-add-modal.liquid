<!-- Quick Add Modal Section -->
<div class="quick-add-modal-body">
  <div class="quick-add-modal-columns" style="display: flex">
    <!-- Left Column: Image Gallery -->
    <div class="quick-add-modal-left" style="width: 50%">
      <div class="quick-add-product-images">
        <!-- Main Swiper Gallery -->
        <div class="swiper main-gallery quick-add-swipper product__photo">
          <div class="swiper-wrapper">
            {% for image in product.images %}
              <div class="swiper-slide">
                <div class="product__photo sami-custom-pdp">
                  <img src="{{ image | image_url: width: 2000 }}" alt="{{ image.alt }}">
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="swiper-button-prev product-gallery-prev"></div>
          <div class="swiper-button-next product-gallery-next"></div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- Thumbnail Swiper -->
        <div class="swiper thumbnail-gallery product__thumbnails thumbnails">
          <div class="swiper-wrapper">
            {% for image in product.images %}
              <div class="swiper-slide">
                <div class="product__thumbnail" data-image-index="{{ forloop.index }}">
                  <img src="{{ image | image_url: width: 2000 }}" alt="{{ image.alt }}">
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="swiper-button-prev product-thumbnail-prev"></div>
          <div class="swiper-button-next product-thumbnail-next"></div>
        </div>
      </div>

      <!-- Tabs usando metafields do produto -->
      {% assign has_tab_1 = false %}
      {% assign has_tab_2 = false %}
      {% assign has_tab_3 = false %}

      {% if product.metafields.custom.content_tab_2 != blank %}
        {% assign has_tab_1 = true %}
      {% endif %}

      {% if product.metafields.custom.content_tab_1 != blank %}
        {% assign has_tab_2 = true %}
      {% endif %}

      {% if product.metafields.custom.content_tab_3 != blank %}
        {% assign has_tab_3 = true %}
      {% endif %}

      {% if has_tab_1 or has_tab_2 or has_tab_3 %}
      <div class="quick-add-tabs-section tabs-desktop">
        <div class="product-tabs-image-wrapper">
          <div class="prdct-tabs-wrapper cstm-menu-footer-group">

            <!-- Tab 1: It's great for you -->
            {% if has_tab_1 %}
            <div class="cstm-menu-footer menu-page">
              <h2>
                <span>
                  <svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.02994 9.01803L7.99986 14.5376C8.15069 14.677 8.2261 14.7468 8.30856 14.7809C8.43113 14.8317 8.56887 14.8317 8.69144 14.7809C8.7739 14.7468 8.84931 14.677 9.00013 14.5376L9.00014 14.5376L14.9701 9.01803C16.6806 7.4365 16.8876 4.80554 15.4454 2.976L15.2153 2.68418C13.5081 0.518546 10.1234 0.885611 8.92017 3.36688C8.74998 3.71783 8.25002 3.71783 8.07983 3.36688C6.87659 0.885611 3.49188 0.518545 1.78469 2.68418L1.55465 2.976C0.112401 4.80554 0.319362 7.4365 2.02994 9.01803Z" stroke="#06211E"></path>
                  </svg>
                  It's great for you
                </span>
                <img loading="lazy" class="d-md-block float-end mt-1" src="{{ '__down.svg' | asset_url }}">
              </h2>
              <div class="cstm-menu-s" style="display: none;">
                {{ product.metafields.custom.content_tab_2 | newline_to_br }}
              </div>
            </div>
            {% endif %}

            <!-- Tab 2: How to use -->
            {% if has_tab_2 %}
            <div class="cstm-menu-footer menu-page">
              <h2>
                <span>
                  <svg width="16" height="20" viewBox="0 0 16 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.089 14V8.225H7.87V14H7.089ZM7.485 6.949C7.32367 6.949 7.188 6.894 7.078 6.784C6.968 6.674 6.913 6.542 6.913 6.388C6.913 6.234 6.968 6.10567 7.078 6.003C7.188 5.893 7.32367 5.838 7.485 5.838C7.64633 5.838 7.782 5.88933 7.892 5.992C8.002 6.09467 8.057 6.223 8.057 6.377C8.057 6.53833 8.002 6.674 7.892 6.784C7.78933 6.894 7.65367 6.949 7.485 6.949Z" fill="#06211E"></path>
                    <circle cx="8" cy="10" r="7.5" stroke="#06211E"></circle>
                  </svg>
                  How to use
                </span>
                <img loading="lazy" class="d-md-block float-end mt-1" src="{{ '__down.svg' | asset_url }}">
              </h2>
              <div class="cstm-menu-s" style="display: none;">
                {{ product.metafields.custom.content_tab_1 }}
              </div>
            </div>
            {% endif %}

            <!-- Tab 3: INGREDIENTS -->
            {% if has_tab_3 %}
            <div class="cstm-menu-footer menu-page">
              <h2>
                <span>
                  <svg width="14" height="17" viewBox="0 0 14 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9.78677 13.5172C13.8994 10.2852 12.8908 1 12.8908 1C12.8908 1 3.30268 3.6672 1.4725 8.44828C0.409375 11.2255 1.4725 16 1.4725 16C1.4725 16 7.17919 15.5665 9.78677 13.5172Z" fill="#FAEEE9" stroke="#06211E"></path>
                  </svg>
                  INGREDIENTS
                </span>
                <img loading="lazy" class="d-md-block float-end mt-1" src="{{ '__down.svg' | asset_url }}">
              </h2>
              <div class="cstm-menu-s" style="display: none;">
                {{ product.metafields.custom.content_tab_3 | newline_to_br }}
              </div>
            </div>
            {% endif %}

          </div>
        </div>
      </div>
      {% endif %}
    </div>

    <!-- Right Column: Product Details -->
    <div class="quick-add-modal-right" style="width: 50%">
      <h2>{{ product.title }}</h2>

      <!-- Judge.me Reviews - Same as dgf-featured-product -->
      <div class="quick-add-product-rating dgf-product-rating">
        {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', product: product %}
      </div>

      <!-- Product Certified Icons - Same as main-product.liquid -->
      {% if product.metafields.custom.enable_certified_icons == true %}
      <div class="custom-product-certified-icn">
        <div class="custom-wrap">
          {% if product.metafields.custom.certified_icon_1 != blank %}
            <div class="product-certified-icon">
              <img loading="lazy" src="{{ product.metafields.custom.certified_icon_1 | image_url: width: 2000 }}">
            </div>
          {% endif %}
          {% if product.metafields.custom.certified_hover_text_1 != blank %}
            <div class="product-certified-icon-text">
              {{ product.metafields.custom.certified_hover_text_1 }}
            </div>
          {% endif %}
        </div>
        <div class="custom-wrap">
          {% if product.metafields.custom.certified_icon_2 != blank %}
            <div class="product-certified-icon">
              <img loading="lazy" src="{{ product.metafields.custom.certified_icon_2 | image_url: width: 2000 }}">
            </div>
          {% endif %}
          {% if product.metafields.custom.certiied_hover_text_2 != blank %}
            <div class="product-certified-icon-text">
              {{ product.metafields.custom.certiied_hover_text_2 }}
            </div>
          {% endif %}
        </div>
        <div class="custom-wrap">
          {% if product.metafields.custom.certfied_icon_3 != blank %}
            <div class="product-certified-icon">
              <img loading="lazy" src="{{ product.metafields.custom.certfied_icon_3 | image_url: width: 2000 }}">
            </div>
          {% endif %}
          {% if product.metafields.custom.certified_hover_text_3 != blank %}
            <div class="product-certified-icon-text">
              {{ product.metafields.custom.certified_hover_text_3 }}
            </div>
          {% endif %}
        </div>
        <div class="custom-wrap">
          {% if product.metafields.custom.certifed_icon_4 != blank %}
            <div class="product-certified-icon">
              <img loading="lazy" src="{{ product.metafields.custom.certifed_icon_4 | image_url: width: 2000 }}">
            </div>
          {% endif %}
          {% if product.metafields.custom.certified_hover_text_4 != blank %}
            <div class="product-certified-icon-text">
              {{ product.metafields.custom.certified_hover_text_4 }}
            </div>
          {% endif %}
        </div>
        <div class="custom-wrap">
          {% if product.metafields.custom.certified_icon_5 != blank %}
            <div class="product-certified-icon">
              <img loading="lazy" src="{{ product.metafields.custom.certified_icon_5 | image_url: width: 2000 }}">
            </div>
          {% endif %}
          {% if product.metafields.custom.certified_hover_text_5 != blank %}
            <div class="product-certified-icon-text">
              {{ product.metafields.custom.certified_hover_text_5 }}
            </div>
          {% endif %}
        </div>
      </div>
      {% endif %}

      <div class="quick-add-product-info">

          <div class="product-content" style="margin-bottom: 20px; line-height: 1.6;">
            <p>{{ product.metafields.custom.description| newline_to_br }}</p>
          </div>

        {%- assign product_form_id = 'quick-add-product-form-' | append: product.id -%}

        {% if product.tags contains 'Bundles' %}

        {% render 'dgf_bundles_crd', product: product %}

        {% else %}

        {% render 'dgf_subscription_wdg', product: product %}

        {% endif %}

        <!-- Product Form with Add to Cart Button -->
        <product-form class="product-form">
          {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
            <input type="hidden" class="selling-plan-id" name="selling_plan" value="{% for selling_plan_group in product.selling_plan_groups %}{% for plan in selling_plan_group.selling_plans %}{% if forloop.last %}{{ plan.id }}{% endif %}{% endfor %}{% endfor %}" disabled>

            <div class="product-form__buttons">
              <!-- Quantity Selector + Add to Cart Button on same line -->
              <div class="add-to-cart-block-with-quantity" {% unless product.selected_or_first_available_variant.available %}style="display: none;"{% endunless %}>
                <div class="product-quantity-wrap">
                  <div class="p-quantity">
                    <input type='button' value='-' class="qtyminus minus" field='quantity'/>
                    <input id="Quantity-quick-add-{{ product.id }}" form="{{ product_form_id }}" type='text' name="quantity" min="1" value='1' class='qty input-quantity'/>
                    <input type='button' value='+' class='qtyplus plus' field='quantity'/>
                  </div>
                  <span class="quantity-label">Quantity</span>
                </div>
                <div class="cart-btn-wrap">
                  <button
                    type="button"
                    name="add"
                    class="subscription-addtocartMine btn btn-bg btn-bg-full mt-4 mb-4"
                  >
                    <span>
                      {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
                    </span>
                    <span id="suscribe-price-button-{{ section.id }}" class="subscribe-price-wrap">
                      | {{ product.selected_or_first_available_variant.price | money }}
                    </span>
                  </button>
                </div>
              </div>
            </div>
          {%- endform -%}
        </product-form>

