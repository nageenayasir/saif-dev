<style>
  #id-{{ section.id }}{
  	background-color:{{ section.settings.section_bg_color }};
  }
</style>
<section id="id-{{section.id}}" class="organic-kss-66-section">
  <div class="organic-kss-66-wrapper">
    <div class="container">
      <div class="row common-section-head-row">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="common-section-head-content">
              <h2 class="custom-heading-h2 organic-kss-66-title">
                {{ section.settings.the_title }}
              </h2>
              {% if section.settings.the_image != blank %}<img loading="lazy"  src="{{ section.settings.the_image | image_url: width: 2000 }}">{% endif %}
            </div>
          </div>
      </div>
      {% for block in section.blocks %}
        {% case block.type %}
          {% comment %}
            Custom Video
          {% endcomment %}
          {% when 'custom_video' %}
          <div class="row organic-ksm66-video-row">
            <div class="col-lg-12 col-md-12 col-sm-12">
              <div class="ksm66-video-head">
                <h2 class="custom-heading-h2">{{ block.settings.video_title }}</h2>
              </div>
              <div class="ksm66-video-wrap">
                <div class="custom-embed-responsive custom-embed-responsive-16by9">
                  {% assign videoId = block.settings.video_url | split: '?v=' %}
                    <iframe width="560" height="315" src="https://www.youtube.com/embed/{{ videoId[1] }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                </div>
              </div>
            </div>
          </div>
          {% comment %}
            Benefits Blocks
          {% endcomment %}
          {% when 'benefits_blocks' %}
          <div class="row organic-ksm66-benefits-row">
            <div class="col-lg-12 col-md-12 col-sm-12">
              <div class="ksm66-benefits-head">
                <h2 class="custom-heading-h2">{{ block.settings.benefits_title }}</h2>
              </div>
              <div class="ksm66-benefits-blocks-wrap">
                <div class="ksm66-benefits-blocks">
                  <h3>{{ block.settings.block_title_1 }}</h3>
                  <p>{{ block.settings.block_text_1 }}</p>
                </div>
                <div class="ksm66-benefits-blocks">
                  <h3>{{ block.settings.block_title_2 }}</h3>
                  <p>{{ block.settings.block_text_2 }}</p>
                </div>
                <div class="ksm66-benefits-blocks">
                  <h3>{{ block.settings.block_title_3 }}</h3>
                  <p>{{ block.settings.block_text_3 }}</p>
                </div>
                <div class="ksm66-benefits-blocks">
                  <h3>{{ block.settings.block_title_4 }}</h3>
                  <p>{{ block.settings.block_text_4 }}</p>
                </div>
              </div>
            </div>
          </div>
          {% comment %}
              rich_text
            {% endcomment %}
          {% when 'rich_text' %}
            <div class="row organic-ksm66-rich-text-row">
                <div class="col-lg-12 col-md-12 col-sm-12">
                  <div class="common-section-head-content">
                    <h2 class="custom-heading-h2">
                      {{ block.settings.the_title }}
                    </h2>
                    {% if block.settings.the_text != blank  %}{{ block.settings.the_text }}{% endif %}
                    {% if block.settings.button_text != blank %}<a class="custom-button-wrap" href="#custom-product-offers">{{ block.settings.button_text }}</a>{% endif %}
                  </div>
                </div>
           </div>
           {% comment %}
              Reviews Section
            {% endcomment %}
            {% when 'review_section' %}
            <div class="row reviews-testimonail-row">
              <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="testimonial-content-wrap">
                  <span class="testimonial-rating">
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                    <i class="fa fa-star" aria-hidden="true"></i>
                  </span>
                  <p>{{ block.settings.rating_text }}</p>
                  <h4>{{ block.settings.author_name }}</h4>
                </div>
              </div>
          </div>
          {% comment %}
              Image Blocks
          {% endcomment %}
          {% when 'image_blocks' %}
          <div class="row orgainc-kss66-images-row">
            <div class="col-lg-6 col-md-6 col-sm-12">
              <div class="orgaince-kss66-left-img">
                {% if block.settings.image_block_1 != blank %}<img loading="lazy"  src="{{ block.settings.image_block_1 | image_url: width: 2000 }}">{% endif %}
              </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12">
              <div class="organic-kss66-right-img">
                {% if block.settings.image_block_2 != blank %}<img loading="lazy"  src="{{ block.settings.image_block_2 | image_url: width: 2000 }}">{% endif %}
              </div>
            </div>
          </div>
          {% comment %}
              Tribe Icons
            {% endcomment %}
            {% when 'tribe_icons' %}
            <div class="row tribe-icon-row">
              <div class="tribe-icon-lists">
                <div class="tribe-orgainics-img">
                  {% if block.settings.tribe_image != blank %}<img loading="lazy"  src="{{ block.settings.tribe_image | image_url: width: 2000 }}">{% endif %}
                </div>
                <div class="tribe-icons-wrap">
                  <ul>
                    <li>
                      {% if block.settings.tribe_icon_1 != blank %}<img loading="lazy"  src="{{ block.settings.tribe_icon_1 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ block.settings.icon_text_1 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_2 != blank %}<img loading="lazy"  src="{{ block.settings.tribe_icon_2 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ block.settings.icon_text_2 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_3 != blank %}<img loading="lazy"  src="{{ block.settings.tribe_icon_3 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ block.settings.icon_text_3 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_4 != blank %}<img loading="lazy"  src="{{ block.settings.tribe_icon_4 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ block.settings.icon_text_4 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_5 != blank %}<img loading="lazy"  src="{{ block.settings.tribe_icon_5 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ block.settings.icon_text_5 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_6 != blank %}<img loading="lazy"  src="{{ block.settings.tribe_icon_6 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ block.settings.icon_text_6 }}</p>
                    </li>
                    <li>
                      {% if block.settings.tribe_icon_7 != blank %}<img loading="lazy"  src="{{ block.settings.tribe_icon_7 | image_url: width: 2000 }}">{% endif %}
                      <p>{{ block.settings.icon_text_7 }}</p>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>
