<section class="section-padding brand-mission" id="shopify-section-{{ section.id }}" style="position:relative; overflow:hidden;">
  <div class="page-width" style="position:relative; z-index:1;">
    <div style="display:grid; grid-template-columns:1fr; gap:5rem; align-items:center;">
      <div style="{% if section.settings.image != blank %}max-width:60rem;{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span style="display:block; font-size:1.2rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:rgb(var(--color-base-accent-1)); margin-bottom:1.2rem;">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 style="font-family:var(--font-heading-family); font-size:clamp(3rem, 4vw, 5rem); font-weight:800; line-height:1.1; color:rgb(var(--color-base-text)); margin:0 0 2rem; letter-spacing:-0.02em;">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div style="font-size:1.7rem; line-height:1.7; color:rgba(var(--color-base-text),0.75);">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div style="margin-top:3rem;">
            <a href="{{ section.settings.button_url | default: '#' }}" class="button button--secondary">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div style="border-radius:1.2rem; overflow:hidden;">
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800',
              sizes: '(min-width: 990px) 45vw, 100vw',
              style: 'width:100%; height:auto; display:block;'
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

@media screen and (min-width: 990px) {
  #shopify-section-{{ section.id }} .page-width > div {
    grid-template-columns: 1fr 1fr;
  }
}

{% schema %}
{
  "name": "Brand mission",
  "tag": "section",
  "class": "section-brand-mission",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Crystal Clear Vision"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>We believe in a world where physical, mental, and spiritual wellness are all connected. Every product we make is crafted with intention — ethically sourced, scientifically backed, and made with love.</p><p>We're proud members of 1% for the Planet, committing a portion of all sales to environmental causes.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "There's more..."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Brand mission"
    }
  ]
}
{% endschema %}
