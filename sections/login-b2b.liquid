<section class="section-banner section-title section-form bg-line-02 customer-account-details">
  <div class="leaf-box right-top">
      <img class="leaf" src="{{ 'leaf-n02.svg' | asset_url }}">
  </div>
  <div class="content">
      <div class="container">
          <h1 class="text-uppercase" data-aos="fade-up">{{ section.settings.title }}</h1>
          <div class="subtitle" data-aos="fade-up" data-aos-delay="200">
              <a href="{{ section.settings.url }}">{{ section.settings.sub_title }}</a>
          </div>
          {%- form 'customer_login', class: 'form' -%}
               {%- if form.errors -%}
                  <h5 class="form__message" tabindex="-1" autofocus>
                    <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
                    {{ 'templates.contact.form.error_heading' | t }}
                  </h5>
                  {{ form.errors | default_errors }}
              {%- endif -%}
              <div class="form-group" data-aos="fade-up">
                <input  class="form-default" type="email" name="customer[email]" id="CustomerEmail" placeholder="{{ 'customer.login_page.email' | t }}">
              </div>
              <div class="form-group" data-aos="fade-up">
                <input class="form-default" type="password" value="" name="customer[password]" id="CustomerPassword"  placeholder="{{ 'customer.login_page.password' | t }}">
              </div>
              <div class="text-start" data-aos="fade-up">
                  <a href="/pages/account-forgot">{{ 'customer.login_page.forgot_password' | t }}</a>
              </div>
              <div class="form-group last" data-aos="fade-up">
                  <button type="submit" class="btn btn-bg-full">{{ 'customer.login_page.sign_in' | t }}</button>
              </div>
              <div class="" data-aos="fade-up">
                <a href="{{ routes.account_register_url }}">
                  {{ 'customer.login_page.create_account' | t }}
                </a>
              </div>
          {% endform %}
      </div>
  </div>
</section>
{% schema %}
  {
    "name": "Section Login B2B",
    "settings": [
      {
          "type": "text",
          "id": "title",
          "default": "B2B page",
          "label": "Title"
      }, 
      {
          "type": "text",
          "id": "sub_title",
          "default": " What’s the secret password?",
          "label": "SubTitle"
      }, 
      {
          "type": "url",
          "id": "url",   
          "label": "Url"
      }
    ]
  }
{% endschema %}