<section id="id-{{section.id}}" class="faq-tabs-wrapper">
  <div class="container">
    <div class="row">
      {% if section.settings.title != blank %}
        <div class="col-lg-12 col-md-12 col-sm-12">
          <div class="faq-tab-head">
            <h1>{{ section.settings.title }}</h1>
          </div>
        </div>
      {% endif %}
      <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="custom-faq-tabs">
    		{% if section.settings.tab_heading_1 != blank %}<li class="custom-tab-link current" data-tab="custom-tab-1">{{ section.settings.tab_heading_1 }}</li>{% endif %}
    		{% if section.settings.tab_heading_2 != blank %}<li class="custom-tab-link" data-tab="custom-tab-2">{{ section.settings.tab_heading_2 }}</li>{% endif %}
            {% if section.settings.tab_heading_3 != blank %}<li class="custom-tab-link" data-tab="custom-tab-3">{{ section.settings.tab_heading_3 }}</li>{% endif %}
            {% if section.settings.tab_heading_4 != blank %}<li class="custom-tab-link" data-tab="custom-tab-4">{{ section.settings.tab_heading_4 }}</li>{% endif %}
            {% if section.settings.tab_heading_5 != blank %}<li class="custom-tab-link" data-tab="custom-tab-5">{{ section.settings.tab_heading_5 }}</li>{% endif %}
		</ul>
    	<div id="custom-tab-1" class="custom-tab-content current">
          <h6>{{ section.settings.tab_heading_1 }}</h6>
            <div class="custom-tabs">
            {%- for block in section.blocks -%}
              {% if block.type == 'general_question' %}
                <div class="custom-FAQ-tab">
                          <input type="checkbox" id="general{{ forloop.index }}">
                          <label class="custom-FAQ-tab-label" for="general{{ forloop.index }}">{{ block.settings.faq_qus }}</label>
                          <div class="custom-FAQ-tab-content {% if forloop.index == 1 %}active{% endif %}">
                            {{ block.settings.faq_ans }}
                          </div>
                        </div>	
                {% endif %}
              {%- endfor -%}
              </div>
       </div>
    	<div id="custom-tab-2" class="custom-tab-content">
        <h6>{{ section.settings.tab_heading_2 }}</h6>
          <div class="custom-tabs">
            {%- for block in section.blocks -%}
            {% if block.type == 'manufacture_question' %}
                <div class="custom-FAQ-tab">
                        <input type="checkbox" id="manu{{ forloop.index }}">
                        <label class="custom-FAQ-tab-label" for="manu{{ forloop.index }}">{{ block.settings.faq_qus }}</label>
                        <div class="custom-FAQ-tab-content">
                          {{ block.settings.faq_ans }}
                        </div>
                      </div>	
              {% endif %}
            {%- endfor -%}
          </div>
    	</div>
    	<div id="custom-tab-3" class="custom-tab-content">
          <h6>{{ section.settings.tab_heading_3 }}</h6>
          <div class="custom-tabs">
            {%- for block in section.blocks -%}
            {% if block.type == 'order_inquries' %}
                <div class="custom-FAQ-tab">
                        <input type="checkbox" id="order-inqury{{ forloop.index }}">
                        <label class="custom-FAQ-tab-label" for="order-inqury{{ forloop.index }}">{{ block.settings.faq_qus }}</label>
                        <div class="custom-FAQ-tab-content">
                          {{ block.settings.faq_ans }}
                        </div>
                      </div>	
              {% endif %}
            {%- endfor -%}
          </div>
    	</div>
        <div id="custom-tab-4" class="custom-tab-content">
            <h6>{{ section.settings.tab_heading_4 }}</h6>
            <div class="custom-tabs">
              {%- for block in section.blocks -%}
              {% if block.type == 'shipping_billing' %}
                  <div class="custom-FAQ-tab">
                          <input type="checkbox" id="shipping{{ forloop.index }}">
                          <label class="custom-FAQ-tab-label" for="shipping{{ forloop.index }}">{{ block.settings.faq_qus }}</label>
                          <div class="custom-FAQ-tab-content">
                            {{ block.settings.faq_ans }}
                          </div>
                        </div>	
                {% endif %}
              {%- endfor -%}
            </div>
    	</div>
      <div id="custom-tab-5" class="custom-tab-content">
            <h6>{{ section.settings.tab_heading_5 }}</h6>
            <div class="custom-tabs">
              {%- for block in section.blocks -%}
              {% if block.type == 'international' %}
                  <div class="custom-FAQ-tab">
                          <input type="checkbox" id="international{{ forloop.index }}">
                          <label class="custom-FAQ-tab-label" for="international{{ forloop.index }}">{{ block.settings.faq_qus }}</label>
                          <div class="custom-FAQ-tab-content">
                            {{ block.settings.faq_ans }}
                          </div>
                        </div>	
                {% endif %}
              {%- endfor -%}
            </div>
    	</div>
      </div>
    </div>
  </div>
</section>
{% comment %} RGD: 2026-01-07 {% endcomment %} 
{% comment %} 
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script> 
{% endcomment %}
{% # theme-check-disable ParserBlockingScript %}
<script type="text/javascript" src="{{ 'jquery-3.5.1.min.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}
<script>
  $(document).ready(function(){
	
	$('.faq-tabs-wrapper .custom-faq-tabs li').click(function(){
		var tab_id = $(this).attr('data-tab');

		$('.faq-tabs-wrapper .custom-faq-tabs li').removeClass('current');
		$('.faq-tabs-wrapper .custom-tab-content').removeClass('current');

		$(this).addClass('current');
		$("#"+tab_id).addClass('current');
	});

});
</script>
