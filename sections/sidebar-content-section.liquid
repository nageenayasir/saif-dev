      <div class="row sidebar-content-row">
        <div class="col-lg-4 col-md-4 col-sm-12 sidebar-sticky-left-content-column">
          <div class="sidebar-sticky-content">
            <div class="sidebar-article-head">
              {{ section.settings.the_title }}
            </div>
            <div class="sidebar-article-text">
              {% if section.settings.text_1 != blank %}{{ section.settings.text_1 }}{% endif %}
              {% if section.settings.text_2 != blank %}{{ section.settings.text_2 }}{% endif %}
              {% if section.settings.text_3 != blank %}{{ section.settings.text_3 }}{% endif %}
              {% if section.settings.text_4 != blank %}{{ section.settings.text_4 }}{% endif %}
              {% if section.settings.text_5 != blank %}{{ section.settings.text_5 }}{% endif %}
              {% if section.settings.text_6 != blank %}{{ section.settings.text_6 }}{% endif %}
              {% if section.settings.text_7 != blank %}{{ section.settings.text_7 }}{% endif %}
              {% if section.settings.text_8 != blank %}{{ section.settings.text_8 }}{% endif %}
              {% if section.settings.text_9 != blank %}{{ section.settings.text_9 }}{% endif %}
              {% if section.settings.text_10 != blank %}{{ section.settings.text_10 }}{% endif %}
              {% if section.settings.text_11 != blank %}{{ section.settings.text_11 }}{% endif %}
              {% if section.settings.text_12 != blank %}{{ section.settings.text_12 }}{% endif %}
              {% if section.settings.text_13 != blank %}{{ section.settings.text_13 }}{% endif %}
              {% if section.settings.text_14 != blank %}{{ section.settings.text_14 }}{% endif %}
              {% if section.settings.text_15 != blank %}{{ section.settings.text_15 }}{% endif %}
              {% if section.settings.text_16 != blank %}{{ section.settings.text_16 }}{% endif %}
              {% if section.settings.text_17 != blank %}{{ section.settings.text_17 }}{% endif %}
            </div>
          </div>
        </div>
        <div class="col-lg-8 col-md-8 col-sm-12 sidebar-sticky-right-content-column">
          <div class="sidebar-sticky-right-content-wrapper">
          {% for block in section.blocks %}
            {% case block.type %}
               {% comment %}
                Rich Text
              {% endcomment %}
              {% when 'rich_text' %}
              <div id="sidebar-richtext-id" class="sidebar-rich-text-wrapper custom-section">
                <div class="sidebar-rich-text">
                  {{ block.settings.the_text }}
                </div>
              </div>
              {% comment %}
                Product Grid
              {% endcomment %}
              {% when 'product_grid' %}
              <div id="{{ block.settings.add_id }}" class="sidebar-product-grid-wrapper custom-section">
                <div class="sidebar-product-grid-col">
                  <div class="sidebar-product-title">
                    <h2 class="custom-sidebar-heading-wrapper">{{ block.settings.the_title }}</h2>
                  </div>
                  <div class="sidebar-product-grid-column-wrapper">
                    {% if block.settings.the_image != blank %}
                      <div class="sidebar-product-grid-image-column common-sidebar-product-grid-column">
                        <div class="sidebar-product-image"><img loading="lazy"  src="{{ block.settings.the_image | img_url: 'master' }}">
                        </div>
                      </div>
                    {% endif %}
                    <div class="sidebar-product-grid-content-column common-sidebar-product-grid-column">
                        <div class="sidebar-product-cotnent">
                          <div class="sidebar-product-info">
                            {{ block.settings.info_text }}
                          </div>
                          {% if block.settings.price_text != blank or block.settings.button_text != blank %}
                            <div class="sidebar-product-price-button">
                              {% if block.settings.button_text != blank %}
                              <div class="sidebar-product-button">
                                <a href="{{ block.settings.button_url }}">{{ block.settings.button_text }}</a>
                              </div>
                              {% endif %}
                              <div class="sidebar-product-price">
                                <p>{{ block.settings.price_text }}</p>
                              </div>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                   <div class="sidebar-product-full-text">
