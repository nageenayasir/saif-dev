{% comment %} 
  DigiFlow NYC Subscribe Journey Section
  Custom subscription rewards journey section for Shopify
  Author: Rodrigo Gesser
  Date: 2025-07-15 
{% endcomment %}

<section class="dgf-subscribe-journey" id="dgf-journey-sec" style="background-color: {{ section.settings.background_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="container" data-aos="fade-up">

    <!-- Header -->
    <div class="dgf-journey-header">
      <h2 class="dgf-journey-title" style="color: {{ section.settings.title_color }};">
        {{ section.settings.title | default: "YOUR SUBSCRIPTION JOURNEY STARTS HERE" }}
      </h2>
      <p class="dgf-journey-subtitle" style="color: {{ section.settings.subtitle_color }};">
        {{ section.settings.subtitle_line1 | default: "Unlock exclusive rewards with every order." }}<br>
        {{ section.settings.subtitle_line2 | default: "The more you shop, the more you save and the better your benefits become." }}
      </p>
    </div>

    <!-- Journey Cards -->
    {%- comment -%}
 <div class="dgf-journey-cards{% if section.settings.cards_bg_image_mobile %} mobile-bg{% endif %}" 
     style="{% if section.settings.cards_bg_image %}background-image: url('{{ section.settings.cards_bg_image | image_url: width: 1200 }}'); background-position: center; background-repeat: no-repeat;{% endif %}">
  {% for block in section.blocks %}
    {% if forloop.index <= 5 %}
      <div class="dgf-journey-card{% if forloop.last %} dgf-final-card{% endif %}{% if forloop.first %} dgf-first-card{% endif %}" 
           style="background-color: {{ block.settings.card_bg_color }}; height: {{ block.settings.card_height }}px;"
           {{ block.shopify_attributes }}>
            
          <div class="dgf-card-icon" 
              style="{% if block.settings.icon_bg_image %}background-image: url('{{ block.settings.icon_bg_image | image_url: width: 120 }}'); background-size: cover; background-position: center;{% else %}background-color: {{ block.settings.icon_bg_color }};{% endif %}">
            
            {% if block.settings.card_icon != blank %}
              <!-- Se existe ícone personalizado, usar ele -->
              <img src="{{ block.settings.card_icon | image_url: width: 56 }}" 
                  alt="Card Icon" 
                  class="dgf-icon-image"
                  style="width: 56px; height: 56px; object-fit: contain;">
            {% else %}
              <!-- Se não existe ícone personalizado, usar SVGs padrão -->
              {% case forloop.index %}
                {% when 1 %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L13.09 8.26L20 9L13.09 9.74L12 16L10.91 9.74L4 9L10.91 8.26L12 2Z" fill="currentColor" />
                  </svg>
                {% when 2 %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L15.09 8.26L22 9L15.09 9.74L12 16L8.91 9.74L2 9L8.91 8.26L12 2Z" fill="currentColor" />
                  </svg>
                {% when 3 %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" fill="currentColor" />
                  </svg>
                {% when 4 %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 3C5.9 3 5.01 3.9 5.01 5V19C5.01 20.1 5.9 21 7 21H17C18.1 21 19 20.1 19 19V5C19 3.9 18.1 3 17 3H7ZM7 5H17V19H7V5ZM12 6L10.5 9H8L10.5 11L9.5 14L12 12.5L14.5 14L13.5 11L16 9H13.5L12 6Z" fill="currentColor" />
                  </svg>
                {% else %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 7H18V6C18 3.79 16.21 2 14 2H10C7.79 2 6 3.79 6 6V7H5C3.9 7 3 7.9 3 9V20C3 21.1 3.9 22 5 22H19C20.1 22 21 21.1 21 20V9C21 7.9 20.1 7 19 7ZM10 4H14C15.1 4 16 4.9 16 6V7H8V6C8 4.9 8.9 4 10 4ZM19 20H5V9H19V20ZM12 12C10.9 12 10 12.9 10 14C10 15.1 10.9 16 12 16C13.1 16 14 15.1 14 14C14 12.9 13.1 12 12 12Z" fill="currentColor" />
                  </svg>
              {% endcase %}
            {% endif %}
          </div>
            
            <div class="dgf-card-content-wrapper"
                 style="{% if block.settings.content_bg_image %}background-image: url('{{ block.settings.content_bg_image | image_url: width: 400 }}'); background-size: cover; background-position: center;{% else %}background-color: {{ block.settings.content_bg_color }};{% endif %}">
              <div class="dgf-card-content" >
                <h3 class="dgf-card-discount" style="color: {{ block.settings.card_text_color }};">
                  {{ block.settings.card_discount | default: "10% OFF" }}
                </h3>
                {% if block.settings.card_benefits %}
                  <p class="dgf-card-benefits" style="color: {{ block.settings.card_text_color }};">
                    {{ block.settings.card_benefits }}
                  <p>
                {% endif %}
                <div class="dgf-card-order" style="color: {{ block.settings.card_text_color }};">
                  {{ block.settings.card_order | default: "1ST ORDER" }}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
      {%- endcomment -%}

       <!-- Substituição por imagem -->
    <div class="dgf-journey-cards-image" style="margin-bottom:40px;">
      <picture>
        <!-- Mobile -->
        <source
          media="(max-width: 768px)"
          srcset="https://cdn.shopify.com/s/files/1/0499/0425/5134/files/tier-mobile.webp?v=1756328946"
        >
        <!-- Desktop -->
        <img
          src="https://cdn.shopify.com/s/files/1/0499/0425/5134/files/tier-desktop.webp?v=1756328945"
          alt="Subscription journey tiers"
          style="display:block;border-radius:20px;"
          loading="lazy"
          decoding="async"
          width="100%" height="auto"
        >
      </picture>
    </div>

    <!-- CTA Button -->
    {% if section.settings.show_cta_button %}
            <div class="dgf-journey btn-group justify-content-center" style="width: 100%; margin-bottom: 5rem;" data-aos="fade-up" data-aos-delay="400">
              <div data-aos="fade-up" data-aos-delay="600">
                <a
                  class="btn btn-bg"
                  href="{{ section.settings.cta_link }}"
                  target="_self" style="width: 307px; background: linear-gradient(101.4deg, #ac853b 26.01%, #cfa34e 68.58%); background-size: 449px; background-position: -105px; color: {{ section.settings.cta_text_color }}">
                  {{ section.settings.cta_text }}
                </a>
              </div>
            </div>
    {% endif %}

    <!-- Footer Text -->
    {% if section.settings.footer_text %}
      <div class="dgf-journey-footer">
        <p style="color: {{ section.settings.footer_text_color }};">
          {{ section.settings.footer_text }}
        </p>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .dgf-subscribe-journey {
    padding: 60px 0;
  }

  .dgf-subscribe-journey .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .dgf-journey-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .dgf-journey-title {
    font-family: HypatiaSansPro;
    font-weight: 700;
    font-size: 36px;
    line-height: 45px;
    letter-spacing: 2%;
    text-align: center;
    text-transform: uppercase;

  }

  .dgf-journey-subtitle {
    font-family: Work Sans,sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 20px;
    letter-spacing: 2%;
    text-align: center;
  }

  .dgf-journey-cards {
    display: flex;
    gap: 5rem;
    justify-content: center;
    align-items: flex-end;
    flex-wrap: wrap;
    margin-bottom: 40px;
    position: relative;
    padding: 40px 0;
    border-radius: 20px
    background-clip: padding-box;
    overflow: hidden;
  }

  .dgf-journey-cards::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: inherit;
    z-index: 0;
    /* Cria um recorte que se ajusta ao primeiro e último card */
    mask: linear-gradient(90deg, 
      transparent 0%, 
      black 10%, 
      black 90%, 
      transparent 100%);
    -webkit-mask: linear-gradient(90deg, 
      transparent 0%, 
      black 10%, 
      black 90%, 
      transparent 100%);
  }

  .dgf-journey-card {
    border-radius: 25px 0 25px 0;
    text-align: center;
    min-width: 180px;
    flex: 1;
    max-width: 177px;
    min-height: 195px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    z-index: 2;
  }

  .dgf-journey-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .dgf-final-card {
    border: 3px solid #B8860B;
    position: relative;
    overflow: hidden;
    flex-grow: 0;
  }

  .dgf-final-card .dgf-card-content-wrapper{
    flex-grow: 0!important;
  }

  .dgf-final-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: rotate(45deg);
    animation: shine 3s infinite;
    z-index: 1;
  }

  @keyframes shine {
    0% {
      transform: translateX(-100%) translateY(-100%) rotate(45deg);
    }
    50% {
      transform: translateX(100%) translateY(100%) rotate(45deg);
    }
    100% {
      transform: translateX(-100%) translateY(-100%) rotate(45deg);
    }
  }

  .dgf-card-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    position: relative;
    z-index: 3;
    top: 30px;
  }

  .dgf-icon-image {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .dgf-card-content-wrapper {
    flex-grow: 1;
    border-radius: 12px;
    margin: 0 8px 8px 8px;
    padding: 40px 16px 24px;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .dgf-card-content {
    position: relative;
    z-index: 2;
    width: 155px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .dgf-card-discount {
    font-family: HypatiaSansPro;
    font-weight: 900;
    font-size: 32px;
    text-align: center;
    text-transform: uppercase;
    line-height: 1!important;
    margin-bottom: 8px;
    margin: 0!important;
  }

  .dgf-card-order {
    font-family: Work Sans,sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0%;
    text-align: center;
    text-transform: uppercase;
  }

  .dgf-card-order p {
    margin: 0;
    line-height: 1.4;
  }

  .dgf-card-order strong {
    font-weight: 700;
  }

  .dgf-card-order em {
    font-style: italic;
  }

  .dgf-card-benefits {
    font-family: HypatiaSansPro;
    font-weight: 700;
    font-size: 15px;
    text-align: center;
    text-transform: uppercase;
    margin-bottom: 8px;
    line-height: 16px;
    margin: 0!important;
  }

  .dgf-journey-cta {
    text-align: center;
    margin-bottom: 30px;
  }

  .dgf-cta-button {
    display: inline-block;
    padding: 16px 48px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .dgf-cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  .dgf-journey-footer {
    font-family: Work Sans,sans-serif;
    font-weight: 400;
    font-size: 15px;
    font-style: italic;
    line-height: 20px;
    letter-spacing: 1px;
    text-align: center;
  }

  .dgf-journey .btn {
    font-weight: 700!important;
    font-size: 16px!important;
    letter-spacing: 1.6px!important;
    text-transform: uppercase!important;
    color: #fff!important;
    display: block!important;
    overflow: hidden!important;
    position: relative!important;
    transition: all .3s ease-in-out!important;
    font-family: Work Sans, sans-serif!important;
    line-height: 20px!important;
    padding: 0.5rem!important;
    
}


@media (max-width: 768px) {
  .dgf-journey-cards {
    flex-direction: column;
    align-items: flex-start;
    padding: 20px;
    gap: 2rem;
    position: relative;
    background-image: none !important;
  }

  .dgf-journey-title {
    font-size: 25px!important;
  }

  .dgf-journey-subtitle {
    font-size: 15px!important;
  }

  .dgf-journey{
    margin: 0!important;
    align-items: center!important;
    display: flex!important;
  }

  
  .dgf-journey-cards.mobile-bg {
    background-position: center !important;
    background-repeat: no-repeat !important;
  }

    .dgf-journey-cards.mobile-bg {
      background-image: url('{{ section.settings.cards_bg_image_mobile | image_url: '800x600' }}') !important;
    }

  .dgf-journey-cards::before {
    display: none;
  }

  .dgf-journey-card {
    width: 153px;
    max-width: 153px;
    min-width: 153px;
    position: relative;
    margin: 0;
  }


  .dgf-journey-card:nth-child(odd) {
    align-self: flex-start;
    margin-left: 0;
  }

  .dgf-journey-card:nth-child(even) {
    align-self: flex-end;
    margin-right: 0;
  }


  .dgf-journey-card:not(:last-child)::after {
    content: '';
    position: absolute;
    width: 2px;
    height: 30px;
    background-color: #ccc;
    bottom: -46px;
    z-index: 1;
  }


  .dgf-journey-card:nth-child(odd):not(:last-child)::after {
    right: -50px;
    transform: rotate(25deg);
    transform-origin: top;
  }


  .dgf-journey-card:nth-child(even):not(:last-child)::after {
    left: -50px;
    transform: rotate(-25deg);
    transform-origin: top;
  }

  .dgf-journey-title {
    font-size: 28px;
    line-height: 35px;
  }

  .dgf-journey-subtitle {
    font-size: 16px;
    line-height: 18px;
  }


  .dgf-card-icon {
    width: 60px;
    height: 60px;
    top: 20px;
  }

  .dgf-icon-image {
    width: 40px;
    height: 40px;
  }

  .dgf-card-content-wrapper {
    padding: 30px 12px 20px;
    margin: 0 6px 6px 6px;
  }

  .dgf-card-content {
    width: 100%;
  }

  .dgf-card-discount {
    font-size: 24px;
    margin-bottom: 6px;
  }

  .dgf-card-order {
    font-size: 14px;
  }

  .dgf-card-benefits {
    font-size: 12px;
    line-height: 14px;
    margin-bottom: 6px;
  }
}

@media (max-width: 480px) {
  .dgf-journey-cards {
    padding: 15px;
    gap: 1.5rem;
  }

  .dgf-journey-title {
    font-size: 24px;
    line-height: 30px;
  }

  .dgf-journey-subtitle {
    font-size: 14px;
    line-height: 16px;
  }

  .dgf-card-discount {
    font-size: 20px;
  }

  .dgf-card-order {
    font-size: 12px;
  }

  .dgf-card-benefits {
    font-size: 11px;
    line-height: 13px;
  }

  .dgf-journey-card:nth-of-type(2) {
      margin-top: -72px;
    }

    .dgf-journey-card:nth-of-type(3) {
      margin-top: -72px;
    }

    .dgf-journey-card:nth-of-type(4) {
      margin-top: -72px;
    }

    .dgf-journey-card:nth-of-type(5) {
      margin-top: -72px;
    }

  .dgf-journey-card:not(:last-child)::after {
    height: 25px;
    bottom: -40px;
  }

  .dgf-journey-card:nth-child(odd):not(:last-child)::after {
    right: -40px;
  }

  .dgf-journey-card:nth-child(even):not(:last-child)::after {
    left: -40px;
  }
}
</style>

{% schema %}
  {
    "name": "[DGF] Subscribe Journey",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#F5E6D3"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top Padding",
        "min": 0,
        "max": 100,
        "step": 10,
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom Padding",
        "min": 0,
        "max": 100,
        "step": 10,
        "default": 60
      },
      {
        "type": "header",
        "content": "Header Content"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "YOUR SUBSCRIPTION JOURNEY STARTS HERE"
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Title Color",
        "default": "#2D3748"
      },
      {
        "type": "text",
        "id": "subtitle_line1",
        "label": "Subtitle Line 1",
        "default": "Unlock exclusive rewards with every order."
      },
      {
        "type": "text",
        "id": "subtitle_line2",
        "label": "Subtitle Line 2",
        "default": "The more you shop, the more you save and the better your benefits become."
      },
      {
        "type": "color",
        "id": "subtitle_color",
        "label": "Subtitle Color",
        "default": "#4A5568"
      },
      {
        "type": "header",
        "content": "Cards Background"
      },
      {
        "type": "image_picker",
        "id": "cards_bg_image",
        "label": "Cards Background Image (Desktop)",
        "info": "Background image for the cards container area on desktop"
      },
      {
        "type": "image_picker",
        "id": "cards_bg_image_mobile",
        "label": "Cards Background Image (Mobile)",
        "info": "Background image for the cards container area on mobile - creates zig-zag layout"
      },
      {
        "type": "header",
        "content": "CTA Button"
      },
      {
        "type": "checkbox",
        "id": "show_cta_button",
        "label": "Show CTA Button",
        "default": true
      },
      {
        "type": "textarea",
        "id": "cta_text",
        "label": "CTA Button Text",
        "default": "START YOUR SUBSCRIPTION NOW"
      },
      {
        "type": "url",
        "id": "cta_link",
        "label": "CTA Button Link"
      },
      {
        "type": "color",
        "id": "cta_text_color",
        "label": "CTA Button Text Color",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "Footer"
      },
      {
        "type": "text",
        "id": "footer_text",
        "label": "Footer Text",
        "default": "If you cancel, your discount will reset and you'll lose your progress. Stay subscribed for continuous savings and perks!"
      },
      {
        "type": "color",
        "id": "footer_text_color",
        "label": "Footer Text Color",
        "default": "#4A5568"
      }
    ],
    "blocks": [
      {
        "type": "journey_card",
        "name": "Journey Card",
        "limit": 5,
        "settings": [
          {
            "type": "header",
            "content": "Card Settings"
          },
          {
            "type": "range",
            "id": "card_height",
            "label": "Card Height",
            "min": 195,
            "max": 400,
            "step": 5,
            "default": 195,
            "unit": "px"
          },
          {
            "type": "color",
            "id": "card_bg_color",
            "label": "Card Background Color",
            "default": "#5A6C5B"
          },
          {
            "type": "color",
            "id": "card_text_color",
            "label": "Card Text Color",
            "default": "#FFFFFF"
          },
          {
            "type": "header",
            "content": "Icon Settings"
          },
          {
            "type": "image_picker",
            "id": "card_icon",
            "label": "Card Icon"
          },
          {
            "type": "image_picker",
            "id": "icon_bg_image",
            "label": "Icon Background Image"
          },
          {
            "type": "color",
            "id": "icon_bg_color",
            "label": "Icon Background Color (fallback)",
            "default": "#F7FAFC"
          },
          {
            "type": "header",
            "content": "Content Background"
          },
          {
            "type": "image_picker",
            "id": "content_bg_image",
            "label": "Content Background Image"
          },
          {
            "type": "color",
            "id": "content_bg_color",
            "label": "Content Background Color (fallback)",
            "default": "rgba(0, 0, 0, 0.1)"
          },
          {
            "type": "header",
            "content": "Card Content"
          },
          {
            "type": "text",
            "id": "card_discount",
            "label": "Discount Text",
            "default": "10% OFF"
          },
          {
            "type": "text",
            "id": "card_order",
            "label": "Order Text",
            "default": "1ST ORDER"
          },
          {
            "type": "textarea",
            "id": "card_benefits",
            "label": "Benefits Text (optional)",
            "info": "Additional benefits text (mainly for the final card)"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "[DGF] Subscribe Journey",
        "category": "Custom",
        "blocks": [
          {
